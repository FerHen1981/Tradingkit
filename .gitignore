# Data (large; keep out of git) — but DO track the prop-firm registry JSON
*.csv
*.zip
nqdata/
data/*.csv
data/*.parquet

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Outputs
*.out
trades*.csv

# Backtest Lab data room (server-side; never in git)
data/lab/
lab_data/
*.parquet
results/*/

# User-built strategies from the Lab 4th-variant builder (kept local to the VPS)
backtest/specs/custom_*.yaml

# Web (Astro sites)
node_modules/
web/sites/*/dist/
web/sites/*/.astro/
web/**/.env
web/portal/users.yaml
web/portal/*.db
.wrangler/

# .NET build-artefacten (D-06) — nooit committen, ze zijn groot en machine-specifiek
middleware/dotnet-receiver/**/bin/
middleware/dotnet-receiver/**/obj/
# appsettings dragen doorgaans tokens; de receiver leest zijn secrets uit systemd Environment=
middleware/dotnet-receiver/**/appsettings*.json
