# Copy to .env (git-ignored) and fill in. Load with: set -a; . ./.env; set +a
MIDDLEWARE_SECRET=change-me-to-a-long-random-string
DRY_RUN=true                 # true = build+log payloads but DON'T send. Flip to false when ready.
PMT_URL=                     # PickMyTrade webhook (Tradovate) — from the PMT dashboard
PMT_RITHMIC_URL=             # PickMyTrade webhook (Rithmic), if you use that route
PMT_TOKEN=                   # your PickMyTrade API token (referenced by accounts.yaml)
PC_URL=                      # your PineConnector webhook URL (for FTMO/MT5 accounts)
PC_LICENSE=                  # your PineConnector license id (referenced by accounts.yaml)
ACCOUNTS_FILE=accounts.yaml
JOURNAL_DB=journal.db
# Phase 4 — reliability
IDEM_TTL_SECONDS=3           # drop identical signals that arrive within N seconds
RETRY_MAX=3                  # PMT POST attempts on network error / 5xx
RETRY_BACKOFF_SECONDS=0.5    # exponential: 0.5s, 1s, 2s...
ALERT_WEBHOOK=              # Discord/Telegram webhook to ping on dispatch FAILURE (optional)
NOTIFY_WEBHOOK=             # Discord webhook to notify on EVERY trade (live channel; optional)
# D-28 · notify routing — priority: per-firm > per-phase > global.
# NOTIFY_WEBHOOK_FUNDED=    # trades on funded (PAAPEX*) accounts, wins over NOTIFY_WEBHOOK
# NOTIFY_WEBHOOK_EVAL=      # trades on eval (APEX* without PA) accounts
# NOTIFY_WEBHOOK_APEX=      # per-firm override, wins over FUNDED/EVAL
# NOTIFY_WEBHOOK_FTMO=      # per-firm override
# TELEGRAM_NOTIFY_WEBHOOK=  # Telegram parity (same priority + phase/firm suffixes work here too)
# TELEGRAM_ALERT_WEBHOOK=   # failure alerts to Telegram
# Phase 5 — risk overlay
MAX_ENTRIES_PER_DAY=0        # per-account daily entry cap default (0 = unlimited; yaml per-account overrides)
# Live fleet tracking — Tradovate read API (pulls real P&L for /performance + LifeOS)
TRADOVATE_MOCK=false         # true = run the tracker with fake data (no credentials, for testing)
TRADOVATE_BASE=https://live.tradovateapi.com/v1   # demo: https://demo.tradovateapi.com/v1
TRADOVATE_NAME=              # your Tradovate username
TRADOVATE_PASSWORD=          # your Tradovate password
TRADOVATE_APPID=             # API key / app id (from Tradovate API Access)
TRADOVATE_CID=               # API cid (if issued)
TRADOVATE_SEC=               # API secret (if issued)
PERF_POLL_SECONDS=60         # how often to refresh fleet P&L
# LifeOS / Notion fleet dashboard (optional — pushes live P&L to a Notion database)
NOTION_TOKEN=                # Notion internal integration token (share the DB with it)
NOTION_DB_ID=                # the Fleet Performance database id
NOTION_JOURNAL_DB=           # the Trade Journal database id (one row per trade; optional)
NOTION_RECON_DB=             # the Reconciliation database id (trade x venue discrepancies; optional)
# Phase 6 — MetaAPI (MT5/FTMO fills for reconciliation)
METAAPI_MOCK=false           # true = fake MT5 fills (no token, for testing)
METAAPI_TOKEN=               # metaapi.cloud auth token
METAAPI_ACCOUNT_ID=          # your MT5 account id in MetaAPI
METAAPI_BASE=https://mt-client-api-v1.new-york.agiliumtrade.ai   # your MetaAPI region base
# Discord trade-cards
DISCORD_WEBHOOK_URL=         # kanaal voor de gerenderde kaarten
RENDER_CMD=node render-signal.js
RENDER_DIR=/var/www/charts
CHARTS_BASE_URL=             # bv. https://mw.mex-traders.com/charts (leeg = multipart upload)
MEX_CHROMIUM_PATH=           # optioneel: vast pad naar Chromium voor Playwright
