# Copy to .env (git-ignored) and fill in. Load with: set -a; . ./.env; set +a
MIDDLEWARE_SECRET=change-me-to-a-long-random-string
DRY_RUN=true                 # true = build+log payloads but DON'T send. Flip to false when ready.
PMT_URL=                     # your PickMyTrade webhook URL (from the PMT dashboard)
PMT_TOKEN=                   # your PickMyTrade API token (referenced by accounts.yaml)
ACCOUNTS_FILE=accounts.yaml
JOURNAL_DB=journal.db
