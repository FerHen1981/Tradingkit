# Recomputes survival buffers + health every 5 minutes (after the journal has upserted trades).
# Enable with: sudo systemctl enable --now mex-account-health.timer
[Unit]
Description=Run MEX account health every 5 minutes

[Timer]
OnBootSec=4min
OnUnitActiveSec=5min
Unit=mex-account-health.service
Persistent=true

[Install]
WantedBy=timers.target
