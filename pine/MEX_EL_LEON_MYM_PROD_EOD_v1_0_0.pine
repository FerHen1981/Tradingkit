// === BIAS & VWAP =============================================================
useSweepFilter = false
sweepLookback  = 20
useVwapVeto   = input.bool(false, "VWAP side veto (long above / short below only)", group=GROUP_BIAS,
     tooltip="Enige richtingsfilter die in beide datahelften consistent was: tegen-VWAP-trades waren structureel negatief.")

// === 9 · SIGNAL — Filters ====================================================
// Elke regel is een filter: schakelaar plus zijn parameters op één rij. Allemaal default
// UIT of neutraal, dus in deze stand is het gedrag identiek aan voor deze toevoeging.
// BBWP = volatiliteitspercentiel (Bollinger; percentiel-variant van The_Caretaker).
useBbwpFilter = input.bool(false, "BBWP", inline="sf_bbwp", group=GROUP_SIG, tooltip="Volatility percentile: what share of the lookback had a NARROWER band than now. Raise min to skip dead volatility, lower max to skip exhaustion.")
bbwpMin       = input.float(0,   "min", minval=0, maxval=100, step=1, inline="sf_bbwp", group=GROUP_SIG)
bbwpMax       = input.float(100, "max", minval=0, maxval=100, step=1, inline="sf_bbwp", group=GROUP_SIG)
bbwpBasisType = input.string("SMA", "BBWP basis", options=["SMA","EMA","VWMA"], group=GROUP_SIG, display=display.none)
bbwpLen       = input.int(20,  "BBWP length",   minval=1, group=GROUP_SIG, display=display.none)
bbwpLookback  = input.int(255, "BBWP lookback", minval=2, group=GROUP_SIG, tooltip="Bars the current width is ranked against.", display=display.none)

useEmaFilter  = input.bool(false, "EMA trend", inline="sf_ema", group=GROUP_SIG, tooltip="Longs only above the EMA, shorts only below it.")
emaLen        = input.int(200, "len", minval=1, inline="sf_ema", group=GROUP_SIG)

useMfiFilter  = input.bool(false, "MFI side", inline="sf_mfi", group=GROUP_SIG, tooltip="Candle-value money flow. Longs only while it is above zero, shorts only below. The multiplier from the original is omitted: a positive scale factor cannot change the sign.")
mfiPeriod     = input.int(60, "HMA", minval=1, inline="sf_mfi", group=GROUP_SIG)

usePocFilter  = input.bool(false, "Volume profile", inline="sf_poc", group=GROUP_SIG, tooltip="Session volume profile (MEX Volume Pack). Longs only above the reference level, shorts only below. Uses intrabar data, so the level moves while the bar forms - the gate reads it on bar close.")
pocRef        = input.string("POC", "vs", options=["POC","VAH","VAL"], inline="sf_poc", group=GROUP_SIG)
pocSession    = input.string("Daily", "session", options=["Daily","Weekly","Tokyo","London","New York"], inline="sf_poc", group=GROUP_SIG)
pocResolution = input.int(30, "Profile resolution", minval=5, maxval=100, group=GROUP_SIG, tooltip="More bins = finer profile, more computation.", display=display.none)
pocVaWidth    = input.int(70, "Value area volume %", minval=1, maxval=100, group=GROUP_SIG, display=display.none)
pocLowerTf    = input.timeframe("1", "Intrabar timeframe", group=GROUP_SIG, tooltip="Lower timeframe the profile is built from.", display=display.none)

useDpFilter   = input.bool(false, "Discount/Premium", inline="sf_dp", group=GROUP_SIG, tooltip="Position inside the recent range. Longs only in the discount half, shorts only in the premium half.")
dpLookback    = input.int(60, "bars", minval=5, inline="sf_dp", group=GROUP_SIG)
dpMid         = input.float(50, "mid %", minval=1, maxval=99, step=1, inline="sf_dp", group=GROUP_SIG)

allowLongs    = input.bool(true, "Longs",  inline="sf_dir", group=GROUP_SIG)
allowShorts   = input.bool(true, "Shorts", inline="sf_dir", group=GROUP_SIG, tooltip="Master direction switches. Off = that side never enters.")
useBiasFilter = false
htf_tf        = "30"
htfBosLen     = 7
ltfBosLen     = 5
allowScalp    = true
vwapDistMin   = 0.05

// === DELTA / CVD FILTER ======================================================
// Canonical scratch-research default:
// "Research OHLCV proxy" reproduces the Python/.NET multi-market proxy exactly:
// close>open = +1, close<open = -1, doji -> previous close, unresolved -> carry polarity.
// CVD N = N consecutive proxy-direction bars aligned with FVG direction.
// The TradingView volume-delta engine is retained as an optional experiment only.
useCVDFilter  = input.bool(true, "Use Delta Filter", group=GROUP_CVD,
     tooltip="Default uses the deterministic OHLCV research proxy for Python/.NET/Pine parity. TradingView volume delta remains available as an optional experimental engine.")
cvdEngine     = input.string("Research OHLCV proxy", "Delta engine",
     options=["Research OHLCV proxy","TradingView volume delta"], group=GROUP_CVD,
     tooltip="Keep Research OHLCV proxy for this MES parity test. TradingView volume delta is NOT the research baseline.")
string cvdLowerTf = "1"
string deltaBorrowSym = ""
useCvdStreak  = input.bool(true, "Streak", inline="cv", group=GROUP_CVD, display=display.none)
cvdTrendCount = input.int(6, "Count", minval=1, inline="cv", group=GROUP_CVD, tooltip="Consecutive same-direction delta bars required.")
bool useCVDFilterEff = useCVDFilter
int cvdTrendCountEff = cvdTrendCount

// === FVG =====================================================================
useGapFilter = input.bool(true, "Use FVG Size Range Filter", group=GROUP_FVG,
     tooltip="Size does not predict the outcome, but the range controls trade frequency and thus cost pressure. 9-13 is the", display=display.none)
// MYM Production scratch parity: FVG 12–20 ticks = 12–20 index points.
gapMinSize   = input.float(12, "Min FVG Size (units)", minval=0.01, group=GROUP_FVG, tooltip="Minimum FVG size. Do not widen — smaller gaps are noise.")
gapMaxSize   = input.float(20, "Max FVG Size (units)", minval=0.01, group=GROUP_FVG, tooltip="Maximum FVG size.")
float gapMinSizeEff = gapMinSize
float gapMaxSizeEff = gapMaxSize
confirmBarsIn = input.int(0, "Confirmation window (bars)", minval=0, maxval=20, group=GROUP_FVG,
     tooltip="v6.1 FVG confirmation memory. 0 = OFF = exact v6.0 behaviour. With X>0, a size-passing FVG whose confirmation (delta filter, VWAP veto, bias, sweep, time gate) is not present on the gap bar itself stays valid for X bars; the signal fires on the first bar inside the window where all strategy rules pass and the account is flat. One signal per gap, newest gap first; entry limit and stop reference the stored gap. HONEST VALIDATION NOTE: walk-forward funnel simulation (Sep 2018–Jun 2026, 878 paired starts, B exit configuration only): payout/funnel $171 (0) -> $305 (3) -> $355 (5), monotone in X; paired bootstrap at X=3: +$134/funnel, z=1.86 — positive but NOT 95%-significant. Effect is throughput/tempo (+66% trades, near-equal pass rate), not signal quality. Do NOT combine with break-even exits (weaker there, and BE variants stay below B). Fleet recommendation: core stream 0, tempo stream 3, explorer stream 5.")



int confirmBars = confirmBarsIn
// === ROLL / OPEX / NEWS FACTORY (event-regime filters) ======================
// Validated on 3y OOS: for the mean-reversion engine the losses concentrate in the
// quarterly roll/triple-witching window (esp. quiet, no-news days), while macro news
// (NFP tailwind, FOMC on ES/GC) sits on the profit side. This block lets you AVOID the
// loss-regimes per strategy / account-type / phase. Preset "Auto" = the validated default
// for THIS script; pick another to borrow its config, or "Off / Custom" to drive the
// toggles yourself. Survival over winning — don't fight the bull in the witching-week chaos.
// Roll/OpEx/news-factory verwijderd 25-08 (besluit Ferry). De master stond op false, dus
// evtBlock was altijd onwaar en de poort altijd open.
// === EXECUTION / ROUTING =====================================================
// v6.8.13 — independent per-destination toggles; ALL config lives in these inputs
// (single-select "Alert destination" dropdown removed). Enable any combination.
// NOTE: TradingView delivers one alert to ONE webhook URL and Pine cannot POST to
// a URL itself. So TODAY: enable ONE route per alert and put that route's webhook
// on the alert. Enabling several at once is for the planned MIDDLEWARE step: the
// alert URL points only at the middleware, which reads the enabled routes and
// fans out. Per-route webhooks then live in the middleware (Pine can't send them).
routePMT           = input.bool(false, "→ PMT Tradovate", group=GROUP_EXEC, tooltip="PickMyTrade, Tradovate route (PMT JSON). Needs PMT Token + the Account ID (group 0).")
routeRithmic       = input.bool(false, "→ PMT Rithmic", group=GROUP_EXEC, tooltip="PickMyTrade, Rithmic route. Same PMT JSON payload; needs PMT Token + Account ID.")
routePineConnector = input.bool(false, "→ PineConnector (MT4/5)", group=GROUP_EXEC, tooltip="MT4/5 comma command (forex/CFD, e.g. FTMO on EURUSD). Needs license + symbol + risk below.")
routeDiscord       = input.bool(false, "→ Discord", group=GROUP_EXEC, tooltip="Discord embeds (fills/exits/halts/derisk/eval/payout).")
routeJournal       = input.bool(false, "→ Journal (CSV)", group=GROUP_EXEC, tooltip="CSV journal rows for the Notion pipeline.")
usePMT       = routePMT
pmtToken     = input.string("", "PMT Token", group=GROUP_EXEC, tooltip="PickMyTrade API token (Tradovate route).", display=display.none)
useDiscord   = routeDiscord
useRithmic   = routeRithmic
usePineConnector = routePineConnector
pcLicense    = input.string("", "PineConnector license ID", group=GROUP_EXEC, tooltip="Your PineConnector license ID — the number your MT4/5 EA listens on. Used only when Alert destination = PineConnector.", display=display.none)
pcSymbol     = input.string("", "PineConnector symbol (empty = chart)", group=GROUP_EXEC, tooltip="Broker symbol for the MT4/5 order, e.g. EURUSD. Empty = this chart's ticker. Set it when your broker's symbol differs from the chart symbol.", display=display.none)
pcRisk       = input.float(1.0, "PineConnector risk / lots", minval=0, group=GROUP_EXEC, tooltip="The 'risk' value sent to PineConnector (lot size, or risk units, per your EA's configuration).", display=display.none)
routeMiddleware = input.bool(false, "→ Middleware (fan-out)", group=GROUP_EXEC, tooltip="Send one lean signal to your middleware /webhook; it fans out to every account subscribed to this strategy. Put the webhook URL on the TradingView alert itself.")
mwSecret   = input.string("", "Middleware secret", group=GROUP_EXEC, tooltip="Must match MIDDLEWARE_SECRET on your server.", display=display.none)
mwStrategy = input.string("LEO-MYM-P", "Middleware strategy key", group=GROUP_EXEC, tooltip="Sleutel waarop de middleware accounts opzoekt. Default is de shorttitle van dit script; moet overeenkomen met de sleutel in accounts.yaml.", display=display.none)
useMiddleware = routeMiddleware
// Stond in alle negen scripts op "MΞX ΞL TΞSORO", dus elke Discord-kaart van de hele
// vloot kwam binnen onder de naam TESORO. Leeg laten = de naam van dit script.
string botName = ""   // leeg = SCRIPT_NAME; de kaart draagt altijd de naam van dit script
lockBufTicks = input.float(4, "Lock cost buffer (ticks)", minval=0, group=GROUP_PHASE, tooltip="Extra open-profit buffer (in ticks, per contract) required above the target before the intra-trade lock closes all — covers fees & slippage.")
lockOnCap    = input.bool(true, "Close all when payout cap is reached intra-trade", group=GROUP_ALRT, tooltip="Once projected withdrawable (incl. open PnL) covers the FULL ladder cap plus the cost buffer, close everything (PMT + Discord) and bank the payout.")
avatarURL  = ""
titleURL  = ""
roleID  = ""
notifyRiskOff = useDiscord
notifyRegime  = input.bool(false, "Notify: regime-shift", group=GROUP_ALRT, tooltip="Discord message on a regime flip (informational only).", display=display.none)
notifyEval = useDiscord
notifyFills = useDiscord
notifyStart = useDiscord
notifyDerisk = useDiscord
notifyBlocked = input.bool(true, "Alert: signal blocked by non-strategy rule", group=GROUP_ALRT,
     tooltip="Fires a TradingView alert (and Discord, if enabled) when a setup satisfies ALL strategy rules (FVG + CVD + bias + VWAP veto + sweep) but is blocked by an operational rule: MAE guard, DD guard, day halt, account halt, time gate or flat window. Being in a position or having a pending order does NOT trigger this alert — that is normal system behaviour.", display=display.none)


// === 11 · VISUALS — STRATEGY =================================================
showDashboard = input.bool(true, "Dashboard", inline="d1", group=GROUP_DASH, display=display.none)
dashPos       = input.string("Bottom Right", "", options=["Top Right","Top Left","Bottom Right","Bottom Left"], inline="d1", group=GROUP_DASH, display=display.none)
visTheme      = input.string("Auto", "", options=["Auto","Dark","Light"], inline="d1", group=GROUP_DASH,
     tooltip="Auto reads the chart background. Applies to dashboard, trade info, exit text and zones.", display=display.none)
txtSize       = input.string(size.tiny, "", options=[size.huge,size.large,size.small,size.tiny,size.auto,size.normal], inline="d1", group=GROUP_DASH, tooltip="Position · theme · text size of the dashboard.", display=display.none)
dashLayout    = input.string("Wide (4 columns)", "Layout", options=["Wide (4 columns)","Compact (mobile)"], group=GROUP_DASH,
     tooltip="Wide: the classic 4-column dashboard. Compact (mobile): two narrow columns with the same information stacked on separate lines inside each cell — fits a phone screen without horizontal squeezing. Visual only; no strategy impact.", display=display.none)
showSignals     = input.bool(true, "Signals", inline="s1", group=GROUP_DASH, display=display.none)
showTradeLevels = input.bool(true, "TP/SL Levels", inline="s1", group=GROUP_DASH, display=display.none)
showPending     = input.bool(true, "Order Levels", inline="s1", group=GROUP_DASH, display=display.none)
showExpired     = input.bool(true, "Unfilled Orders", inline="s1", group=GROUP_DASH,
     tooltip="Signals: entry triangles. TP/SL Levels: the active stop/target/entry lines AND the shaded risk/reward zones. Order Levels: the resting limit and its planned stop while an order is pending. Unfilled Orders: a box marking a limit that expired without a fill.", display=display.none)
// Trade labels — what is written next to a trade, and which account events get marked.
lblParams   = input.bool(true, "Params", inline="s2", group=GROUP_DASH, display=display.none)
lblOutcome  = input.bool(true, "PnL / MFE / MAE", inline="s2", group=GROUP_DASH, display=display.none)
lblDll      = input.bool(true, "DLL reached $", inline="s2", group=GROUP_DASH,
     tooltip="Params: FVG size, CVD state, order age and R:R next to the open trade. PnL / MFE / MAE: realized result at the exit plus the best and worst excursion in ticks. DLL reached $: label on the bar where the daily loss limit halted the day.", display=display.none)
lblDayCap   = input.bool(true, "Day cap reached $", inline="s3", group=GROUP_DASH, display=display.none)
lblPayout   = input.bool(true, "Payout reached", inline="s3", group=GROUP_DASH, display=display.none)
lblBreach   = input.bool(true, "Account breached", inline="s3", group=GROUP_DASH, display=display.none)
lblTrail    = input.bool(true, "Trail activated", inline="s3", group=GROUP_DASH,
     tooltip="Account-level events, each marked once on the bar where it happens: the day-cap halt with the banked amount, the moment the account becomes payout-ready, the breach that halts the account, and the arming of the day trail (risk gate).", display=display.none)
// Aliases: the drawing code below still speaks the old names. TP/SL Levels now
// covers the lines AND the fills, which is what Ferry asked for (25-08).
bool showTradeZones  = showTradeLevels
bool showTradeLabels = lblParams
bool showExitLabels  = lblOutcome

// === 12 · VISUALS — INDICATORS ===============================================
fvgFillMode = input.string("Both", "FVG", options=["Filled","Unfilled","Both"], inline="i1", group=GROUP_VIS, display=display.none)
fvgSizeMode = input.string("In range", "", options=["In range","All"], inline="i1", group=GROUP_VIS,
     tooltip="Left: which gaps stay visible — Filled = price has traded back into the gap, Unfilled = still untouched, Both = show all. Right: In range = only gaps that pass the FVG size filter (group 9), i.e. the ones this strategy can actually trade; All = every gap on the chart. Visual only — neither dropdown touches the signal logic.", display=display.none)
showFiltersBg  = input.bool(false, "Filters valid", inline="i2", group=GROUP_VIS, display=display.none)
showTimeGateBg = input.bool(false, "TimeGate open", inline="i2", group=GROUP_VIS, display=display.none)
showGateBg     = input.bool(true, "Trade Gate open", inline="i2", group=GROUP_VIS,
     tooltip="Three background layers, from loosest to strictest. Filters valid: the signal filters of group 9 (BBWP/EMA/MFI/POC/Discount-Premium and the long-short switch) pass on at least one side. TimeGate open: the trading day, hour window, market regime and flat window allow trading. Trade Gate open: the FULL gate — time gate plus day halt, account status, CVD, VWAP veto, bias and sweep — teal = long tradable, red = short, amber = both. A stronger amber flash marks a valid signal blocked by an operational rule (MAE guard, halts).", display=display.none)
// Cosmetics with no operational meaning are fixed here rather than in the panel.
int   maxBoxes     = 40
int   drawLast     = 2000
int   gateBgTransp = 90
color bullColor    = color.new(color.green, 85)
color bearColor    = color.new(color.red, 85)
color testedColor  = color.new(color.gray, 88)
bool  inDrawWin    = drawLast <= 0 or (last_bar_index - bar_index) <= drawLast


// === v5.5: THEMA-PALET =======================================================
float _bgLum = 0.299 * color.r(chart.bg_color) + 0.587 * color.g(chart.bg_color) + 0.114 * color.b(chart.bg_color)
bool visIsDark = visTheme == "Dark" ? true : visTheme == "Light" ? false : _bgLum < 128
color vPOS    = #089981
color vNEG    = #F23645
color vText   = visIsDark ? #ECECEC : #1E222D
color vMuted  = visIsDark ? color.new(#B2B5BE, 15) : color.new(#5A5D68, 0)
color vPosTxt = visIsDark ? #34D1B2 : #056656
color vNegTxt = visIsDark ? #FF7A85 : #B22833
color zRiskBg   = color.new(vNEG, visIsDark ? 90 : 92)
color zRewardBg = color.new(vPOS, visIsDark ? 90 : 92)

// === v5: EVAL / PA TRACKING ==================================================
var string GROUP_EVAL = "13 · DEVELOPER — Settings"
// Eval-tracking verwijderd als knop 25-08 (besluit Ferry: onduidelijk wat het doet, en
// Phase=Custom dekt hetzelfde). De motor eronder staat achter een constante false en is
// daarmee dood; hij wordt in een aparte ronde gestript zodra niets hem meer leest.
bool evalTrack    = false
bool evalTrailEod = true
tradeFromStart  = input.bool(true, "No entries before start date", group=GROUP_EVAL, tooltip="Gates ENTRIES on the same start date below: before that moment the strategy takes no trades, so the backtester, dashboard and TV key stats reflect ONLY this account. Indicators still warm up on full history. Turn OFF on research charts where you want the full-history backtest. With the default (past) date this toggle has no effect.", display=display.none)
evalStartTime   = input.time(timestamp("01 Jan 2025 00:00 -0400"), "Start date/time (measure from)", group=GROUP_EVAL,
     tooltip="Measurement starts here. PnL from before this moment does NOT count. The date picker interprets in your chart/exchange timezone. NOTE: this is the lightweight tracker (use either this or group 8, not both).", display=display.none)
evalUseEnd      = input.bool(false, "Use end date (exact tester match)", group=GROUP_EVAL,
     tooltip="OFF (live): the tracker keeps counting to the latest bar — what you want live. ON (verification): counts only up to the end date below, to match a bounded backtester window exactly.", display=display.none)
evalEndTime     = input.time(timestamp("01 Jan 2027 00:00 -0400"), "End date/time (measure through)", group=GROUP_EVAL,
     tooltip="Only active when 'Use end date' is on. Set equal to your backtester period end date for an exact match.", display=display.none)
evalStartBal    = input.float(0, "Start balance ($)", step=100, group=GROUP_EVAL,
     tooltip="Balance at the start date. Use when tracking an account already underway (e.g. a PA at +$800). On day 1 = peak; floor = start - trailing DD.", display=display.none)
evalProfitTgt   = acctGoal
evalTrailDD     = acctTrailDD

// === v5.4: APEX LEGACY 30% MAE-GUARD =========================================
var string GROUP_MAE = GROUP_PHASE
useMaeGuard  = input.bool(false, "MAE guard on (only active in Apex PA phase)", group=GROUP_MAE,
     tooltip="Apex Legacy 30% Negative P&L (MAE) rule: open negative P&L may never exceed 30% of the profit balance at the START of the day. New/low-profit accounts: 30% of the trailing drawdown (50k: $750). Once EOD profit reaches 2x the safety net (trailing DD + $100): 50%. This guard automatically scales contracts down so stop risk fits, and only blocks a trade if even 1 contract does not fit. Active only when Account phase (group 8) is Apex PA, with the live-sync PnL offset filled in.", display=display.none)
maeBasePct   = input.float(30, "Base limit (% of profit balance)", minval=5, maxval=100, step=5, group=GROUP_MAE, tooltip="Apex base MAE limit: open loss as % of start-of-day profit balance (rule: 30%).", display=display.none)
maeGrownPct  = input.float(50, "Limit after 2x safety net (%)", minval=5, maxval=100, step=5, group=GROUP_MAE, tooltip="MAE limit once EOD profit has reached 2x the safety net (rule: 50%).", display=display.none)
maeMarginPct = input.float(10, "Safety margin (%)", minval=0, maxval=50, step=5, group=GROUP_MAE,
     tooltip="Extra buffer below the Apex limit for slippage and open-PnL swings. 10% means the guard uses 90% of the allowed room.", display=display.none)

// === v5: CSV TRADE-JOURNAAL (Notion) =========================================
var string GROUP_JRNL = GROUP_EVAL
useJournal   = routeJournal
jrnlJsonWrap = true
string jrnlAcctName = ""   // leeg = automatisch uit account-id + datum
// === v6.0: AUTO ALERT MESSAGE ================================================
var string GROUP_AMSG = GROUP_EXEC
alertMsgAuto    = usePMT or useRithmic
sendCfgOnStart  = input.bool(true, "Send CONFIG message on first live bar", group=GROUP_AMSG,
     tooltip="When an alert instance starts running, the script sends ONE fully labeled settings message (key=value for every strategy-relevant parameter) with the standard header. This makes every alert stream self-describing: you can always read back exactly which settings this chart runs, with the parameter name in front of each value. If the CSV journal is enabled, the CONFIG line is shaped as a journal row (event=CONFIG, settings in the last field) so the Notion pipeline stores it cleanly.")
alertIncludeCfg = input.bool(true, "Append full parameter config (|CFG|)", group=GROUP_AMSG,
     tooltip="Appends every relevant script parameter as key=value pairs after a |CFG| marker — same idea as the Properties tab of a backtest export. Your Notion/webhook pipeline can reconstruct exactly which settings produced each fill. Turn off if your webhook target has a small payload limit.", display=display.none)

f_autoAcctName() =>
    string _id = accountID
    int _n = str.length(_id)
    string _pfx = _n >= 2 ? str.upper(str.substring(_id, 0, 2)) : str.upper(_id)
    string _sfx = _n >= 3 ? str.substring(_id, _n - 3, _n) : _id
    string _bal = str.tostring(math.round(evalStartBal / 1000), "#") + "k"
    string _dt = str.format_time(evalStartTime, "yyMMdd", "America/New_York")
    _pfx + _sfx + "-" + _bal + "-" + _dt
string jrnlAcct = str.length(jrnlAcctName) > 0 ? jrnlAcctName : f_autoAcctName()
// D-41: de routing per kanaal leest het account uit de EERSTE kolom van de description en
// herkent alleen twee letters + drie cijfers + koppelteken (PA016-0k-260813). Staat de
// Account ID leeg of wijkt hij af, dan valt de routing STIL terug op de globale webhook --
// je merkt het niet. Daarom hier een zichtbare waarschuwing in plaats van die stille terugval.
bool jrnlAcctRoutable = str.length(jrnlAcct) >= 6 and str.match(jrnlAcct, "^[A-Za-z][A-Za-z][0-9][0-9][0-9]-") != ""
if barstate.islast and useDiscord and not jrnlAcctRoutable
    var label _acctWarn = na
    label.delete(_acctWarn)
    _acctWarn := label.new(bar_index, high, "⚠️ Account ID leeg of afwijkend - Discord-kaarten routeren naar het GLOBALE kanaal (jrnlAcct = " + jrnlAcct + ")",
         style=label.style_label_down, color=color.new(color.orange, 10), textcolor=color.white, size=size.small)
f_msgHead() =>
    "MPT " + currentVersion + " | " + jrnlAcct + " | " + str.format_time(timenow, "yyyy-MM-dd HH:mm:ss", activeTz)
bool plainAlertsOK = not usePMT and not useRithmic and not usePineConnector and not useDiscord and not useJournal and not useMiddleware
bool execInstance = usePMT or useRithmic or usePineConnector or useMiddleware

// ============================================================================
// === TIME GATE ==============================================================
// ============================================================================
hourEnabled = array.from(timeHour00,timeHour01,timeHour02,timeHour03,timeHour04,timeHour05,timeHour06,timeHour07,timeHour08,timeHour09,timeHour10,timeHour11,timeHour12,timeHour13,timeHour14,timeHour15,timeHour16,timeHour17,timeHour18,timeHour19,timeHour20,timeHour21,timeHour22,timeHour23)
bool dirHourLongPass  = true    // richtings-uurmap verwijderd 25-08; stand was UIT, dus identiek
bool dirHourShortPass = true    // idem
f_toMOD(_h,_m) => _h*60+_m
f_inRangeMOD(_sh,_sm,_eh,_em) =>
    _cur = f_minuteOfDay()
    _s = f_toMOD(_sh,_sm)
    _e = f_toMOD(_eh,_em)
    _e > _s ? (_cur >= _s and _cur < _e) : (_cur >= _s or _cur < _e)
tradeDOW = dayofweek(time, activeTz)
f_isTradingDay() =>
    (tradeDOW == dayofweek.sunday and tradeSunday) or (tradeDOW == dayofweek.monday and tradeMonday) or
     (tradeDOW == dayofweek.tuesday and tradeTuesday) or (tradeDOW == dayofweek.wednesday and tradeWednesday) or
     (tradeDOW == dayofweek.thursday and tradeThursday) or (tradeDOW == dayofweek.friday and tradeFriday) or
     (tradeDOW == dayofweek.saturday and tradeSaturday)
monEarlyBlock = false   // Skip-Monday verwijderd 25-08: oude aanname, de statistiek bepaalt dit zelf
bool _mregLondon = f_inRangeMOD(2, 0, 5, 0)
bool _mregUsMorning = f_inRangeMOD(7, 0, 12, 0)
bool _mregGlobex = f_inRangeMOD(18, 0, 19, 0)
bool _mregAsia = f_inRangeMOD(19, 0, 2, 0)
bool _mregLunch = f_inRangeMOD(11, 30, 13, 0)   // was 12:00-14:00; had geen schakelaar, dus dit verandert niets aan bestaand gedrag
bool _mregInitBal = f_inRangeMOD(9, 30, 10, 30)
bool _mregNyAm = f_inRangeMOD(9, 30, 11, 30)
bool _mregNyPm = f_inRangeMOD(13, 0, 15, 0)
bool _mregPower = f_inRangeMOD(15, 0, 16, 0)
bool marketRegimePass = marketRegimeMode == "All sessions" ? true : marketRegimeMode == "Liquidity Core" ? (_mregLondon or _mregUsMorning or _mregGlobex) : ((customLondon and _mregLondon) or (customUsMorning and _mregUsMorning) or (customGlobexOpen and _mregGlobex) or (customAsia and _mregAsia) or (customLunch and _mregLunch) or (customPowerHour and _mregPower) or (customInitBal and _mregInitBal) or (customNyAm and _mregNyAm) or (customNyPm and _mregNyPm))
timeGatePassRaw = f_isTradingDay() and array.get(hourEnabled, f_getHour()) and not monEarlyBlock and marketRegimePass

// === MEX OR-BREAKOUT — tracking (per sessie, repaint-vrij) ===================
var float orHi = na
var float orLo = na
var bool  orDone = false
var bool  orBrokeLong = false
var bool  orBrokeShort = false
if isNewTradingDay
    orHi := na
    orLo := na
    orDone := false
    orBrokeLong := false
    orBrokeShort := false
int _modNow = f_minuteOfDay()
bool _inOR = _modNow >= orStartMin and _modNow < orEndMin
if _inOR
    orHi := na(orHi) ? high : math.max(orHi, high)
    orLo := na(orLo) ? low  : math.min(orLo, low)
if _modNow >= orEndMin and not orDone and not na(orHi)
    orDone := true
float _brkDist = orBreakoutUnit == "Points" ? orBreakoutT : orBreakoutT * syminfo.mintick
if orDone and barstate.isconfirmed
    if not orBrokeLong and not na(orHi) and close >= orHi + _brkDist
        orBrokeLong := true
    if not orBrokeShort and not na(orLo) and close <= orLo - _brkDist
        orBrokeShort := true
var bool orUsedLong = false
var bool orUsedShort = false
if isNewTradingDay
    orUsedLong := false
    orUsedShort := false
bool orGateLong  = not useOrBreakout or (orBrokeLong  and not (orOneSetup and orUsedLong))
bool orGateShort = not useOrBreakout or (orBrokeShort and not (orOneSetup and orUsedShort))

// === PA CONTEXT FILTERS — berekening (ex-ante, geen repaint) =================
// Het oude PA-filterblok (relatief volume / BBWP / RTH-open-blok) is 25-08 verwijderd:
// usePaFilters, useRelVolFilter en useBbwpFilter stonden alle drie als harde constante
// op false, dus paFiltersOK was altijd true. De BBWP daarin botste bovendien in naam
// met de werkende BBWP uit groep 9 · SIGNAL — Filters.
bool paFiltersOK = true

timeGatePass = timeGatePassRaw and paFiltersOK
inFlatWindow = useAutoFlat and f_inRangeMOD(flatHour, flatMinute, resumeHour, resumeMinute)

// De hele event-kalender (roll / triple witching / OpEx / FOMC / NFP) is 25-08 verwijderd
// samen met zijn poort: de master stond op false, dus geen enkele tak kon ooit blokkeren.
bool evtGateOK = true

var bool hasTraded = false
if not timeGatePass
    hasTraded := false

// ============================================================================
// === FVG ENGINE + BOXES =====================================================
// ============================================================================
int fvgDirection = 0
float fvgTop = na
float fvgBottom = na
if bar_index >= 2
    fvgDirection := low[2] >= high ? -1 : low >= high[2] ? 1 : 0
    fvgTop    := fvgDirection > 0 ? low : fvgDirection < 0 ? low[2] : na
    fvgBottom := fvgDirection > 0 ? high[2] : fvgDirection < 0 ? high : na
fvgSizePrice = not na(fvgTop) ? math.abs(fvgTop - fvgBottom) : na
fvgMid = not na(fvgTop) ? (fvgTop + fvgBottom) / 2.0 : na
fvgPasses = not useGapFilter or (not na(fvgSizePrice) and fvgSizePrice >= f_distPrice(gapMinSizeEff) and fvgSizePrice <= f_distPrice(gapMaxSizeEff) and fvgSizePrice > 0)
bullCandle = fvgDirection == 1 and fvgPasses
bearCandle = fvgDirection == -1 and fvgPasses

// Drawing only. "In range" keeps the old behaviour (gaps that pass the size filter,
// i.e. the tradable ones); "All" also draws gaps the strategy would never take, so you
// can see what the size filter is throwing away. The Filled/Unfilled dropdown hides
// boxes by repainting them transparent — the boxes themselves keep existing, so the
// filled-state bookkeeping stays correct whichever view is selected.
var array<box>  fvgBoxes  = array.new<box>()
var array<int>  fvgDirs   = array.new<int>()
var array<bool> fvgFilled = array.new<bool>()
bool fvgDrawOK = fvgDirection != 0 and (fvgSizeMode == "All" or fvgPasses)
if fvgDrawOK and barstate.isconfirmed and inDrawWin
    _bx = box.new(bar_index - 2, fvgTop, bar_index, fvgBottom, border_color=na, bgcolor=na)
    array.push(fvgBoxes, _bx)
    array.push(fvgDirs, fvgDirection)
    array.push(fvgFilled, false)
    if array.size(fvgBoxes) > maxBoxes
        box.delete(array.shift(fvgBoxes))
        array.shift(fvgDirs)
        array.shift(fvgFilled)
if barstate.isconfirmed and array.size(fvgBoxes) > 0 and inDrawWin
    for i = 0 to array.size(fvgBoxes) - 1
        _b = array.get(fvgBoxes, i)
        _d = array.get(fvgDirs, i)
        bool _fl = array.get(fvgFilled, i)
        if not _fl and bar_index > box.get_right(_b)
            _fl := _d > 0 ? low <= box.get_top(_b) : high >= box.get_bottom(_b)
            if _fl
                array.set(fvgFilled, i, true)
        bool _vis = fvgFillMode == "Both" or (fvgFillMode == "Filled" and _fl) or (fvgFillMode == "Unfilled" and not _fl)
        color _base = _d > 0 ? bullColor : bearColor
        box.set_bgcolor(_b, not _vis ? na : _fl ? testedColor : _base)
        box.set_border_color(_b, not _vis ? na : color.new(_base, 40))

// ============================================================================
// === SWING STRUCTURE (bevestigde pivots) ====================================
// ============================================================================
float pivL = ta.pivotlow(low, pivotK, pivotK)
float pivH = ta.pivothigh(high, pivotK, pivotK)
float lastPivLow  = fixnan(pivL)
float lastPivHigh = fixnan(pivH)

// ============================================================================
// === BIAS / VWAP (repaint-vrij) =============================================
// ============================================================================
float vwapVal = ta.vwap
float distToVWAP = vwapVal != 0 and not na(vwapVal) ? ((close - vwapVal) / vwapVal) * 100.0 : 0.0
float htfC  = na
float htfHH = na
float htfLL = na
if useBiasFilter
    [c1, hh, ll] = request.security(syminfo.tickerid, htf_tf,
         [close[1], ta.highest(high, htfBosLen)[2], ta.lowest(low, htfBosLen)[2]],
         lookahead=barmerge.lookahead_on)
    htfC := c1
    htfHH := hh
    htfLL := ll
var int htfBias = 0
if useBiasFilter and not na(htfC)
    if htfC > htfHH
        htfBias := 1
    else if htfC < htfLL
        htfBias := -1
var int ltfBias = 0
float ltfHi = ta.highest(high[1], ltfBosLen)
float ltfLo = ta.lowest(low[1], ltfBosLen)
if high > ltfHi
    ltfBias := 1
else if low < ltfLo
    ltfBias := -1
int structBias = ltfBias == htfBias ? ltfBias : 0
string phase = structBias == 1 ? "Expansion ↑" : structBias == -1 ? "Expansion ↓" :
     ltfBias != htfBias and ltfBias != 0 and htfBias != 0 ? "Transition" : "Contraction"
int bias = structBias != 0 ? structBias : htfBias
biasLongOK  = phase == "Expansion ↑" and close > vwapVal and bias == 1
biasShortOK = phase == "Expansion ↓" and close < vwapVal and bias == -1
scalpOK     = allowScalp and (phase == "Contraction" or phase == "Transition") and math.abs(distToVWAP) > vwapDistMin
canLong  = not useBiasFilter or biasLongOK or scalpOK
canShort = not useBiasFilter or biasShortOK or scalpOK

bool sweepLongEvt  = low < lastPivLow[1] and close > lastPivLow[1]
bool sweepShortEvt = high > lastPivHigh[1] and close < lastPivHigh[1]
int  barsSinceSweepLong  = ta.barssince(sweepLongEvt)
int  barsSinceSweepShort = ta.barssince(sweepShortEvt)
bool sweepLongOK  = not useSweepFilter or nz(barsSinceSweepLong, 99999) <= sweepLookback
bool sweepShortOK = not useSweepFilter or nz(barsSinceSweepShort, 99999) <= sweepLookback
plotshape(useSweepFilter and sweepLongEvt, "Sweep Low", shape.diamond, location.belowbar, color=color.new(color.teal, 30), size=size.tiny)
plotshape(useSweepFilter and sweepShortEvt, "Sweep High", shape.diamond, location.abovebar, color=color.new(color.maroon, 30), size=size.tiny)

vetoLongOK  = not useVwapVeto or close > vwapVal
vetoShortOK = not useVwapVeto or close < vwapVal

// ============================================================================
// === DELTA / CVD FILTER — RESEARCH PARITY ====================================
// ============================================================================
// Canonical reconstructed OHLCV proxy used by the scratch research engine.
// IMPORTANT: this is intentionally independent of ta.requestVolumeDelta().
// Per 1m bar:
//   close > open        => +1
//   close < open        => -1
//   doji, close > close[1] => +1
//   doji, close < close[1] => -1
//   unresolved doji     => carry previous polarity
// CVD Count = consecutive proxy-direction bars aligned with FVG direction.

bool hasBorrow = str.length(deltaBorrowSym) > 0
bool useResearchProxy = cvdEngine == "Research OHLCV proxy"

var int proxyDir = -1
int _proxyDirNow = close > open ? 1 :
     close < open ? -1 :
     (not na(close[1]) and close > close[1]) ? 1 :
     (not na(close[1]) and close < close[1]) ? -1 :
     nz(proxyDir[1], -1)
proxyDir := _proxyDirNow

var int proxyBullStreak = 0
var int proxyBearStreak = 0
proxyBullStreak := proxyDir == 1 ? nz(proxyBullStreak[1], 0) + 1 : 0
proxyBearStreak := proxyDir == -1 ? nz(proxyBearStreak[1], 0) + 1 : 0

float perBarDelta = na
bool bullDirOk = false
bool bearDirOk = false
bool bullStreakOk = false
bool bearStreakOk = false
int cvdBullStreakDisplay = 0
int cvdBearStreakDisplay = 0
bool cvdEff = useCVDFilterEff

if cvdEff and useResearchProxy
    bullDirOk := proxyDir == 1
    bearDirOk := proxyDir == -1
    bullStreakOk := not useCvdStreak or proxyBullStreak >= cvdTrendCountEff
    bearStreakOk := not useCvdStreak or proxyBearStreak >= cvdTrendCountEff
    cvdBullStreakDisplay := proxyBullStreak
    cvdBearStreakDisplay := proxyBearStreak
else if cvdEff
    // Optional legacy / experimental TradingView volume-delta engine.
    if hasBorrow
        [_upV, _dnV] = request.security_lower_tf(deltaBorrowSym, cvdLowerTf, [close > open ? volume : 0.0, close < open ? volume : 0.0])
        perBarDelta := array.sum(_upV) - array.sum(_dnV)
    else
        [vdO, vdH, vdL, vdC] = ta.requestVolumeDelta(cvdLowerTf, "1D")
        perBarDelta := vdC - vdO
    bullDirOk := perBarDelta > 0
    bearDirOk := perBarDelta < 0
    int barsSinceNotBull = ta.barssince(not bullDirOk)
    int barsSinceNotBear = ta.barssince(not bearDirOk)
    cvdBullStreakDisplay := nz(barsSinceNotBull, 0)
    cvdBearStreakDisplay := nz(barsSinceNotBear, 0)
    bullStreakOk := not useCvdStreak or nz(barsSinceNotBull, 99999) >= cvdTrendCountEff
    bearStreakOk := not useCvdStreak or nz(barsSinceNotBear, 99999) >= cvdTrendCountEff

bullCvdPass = not cvdEff or (bullDirOk and bullStreakOk)
bearCvdPass = not cvdEff or (bearDirOk and bearStreakOk)

// --- SIGNAL FILTERS ---------------------------------------------------------
f_bbwpMa(_src, _len, _type) =>
    _type == "SMA" ? ta.sma(_src, _len) : _type == "EMA" ? ta.ema(_src, _len) : ta.vwma(_src, _len)

f_bbwp(_src, _len, _lookback, _type) =>
    float _basis = f_bbwpMa(_src, _len, _type)
    float _dev   = ta.stdev(_src, _len)
    float _bbw   = _basis == 0 ? na : 2 * _dev / _basis     // (basis+dev)-(basis-dev) = 2*dev
    int   _cnt   = 0
    for _i = 1 to _lookback
        _cnt += nz(_bbw[_i]) > nz(_bbw) ? 0 : 1
    100.0 * _cnt / _lookback

// Sessie-volumeprofiel, overgenomen uit [MEX] Volume Pack v1.2. Alleen de rekenkant:
// intrabar-data verzamelen, volume over body en wicks verdelen, POC en value area.
// Alle tekenwerk (boxes, lijnen, kleuren) is weggelaten - een strategie heeft een
// PRIJSNIVEAU nodig, geen profiel op het scherm.
// Eén array in plaats van de groene/rode splitsing: die splitsing bestond alleen om de
// balken te kunnen kleuren en verandert de POC niet.
f_volSlice(_y11, _y12, _y21, _y22, _height, _vol) =>
    nz(math.max(math.min(math.max(_y11, _y12), math.max(_y21, _y22)) - math.max(math.min(_y11, _y12), math.min(_y21, _y22)), 0) * _vol / _height)

var float[] vpVol      = array.new_float(pocResolution, 0.0)
var float[] vpBounds   = array.new_float(pocResolution, 0.0)
var float[] ltfO = array.new_float(0)
var float[] ltfH = array.new_float(0)
var float[] ltfL = array.new_float(0)
var float[] ltfC = array.new_float(0)
var float[] ltfV = array.new_float(0)
var int     vpStart = 0

[_dO, _dC, _dH, _dL, _dV] = request.security_lower_tf(syminfo.tickerid, pocLowerTf, [open, close, high, low, volume])

f_profileAdd(_o, _h, _l, _c, _v, _gap) =>
    for _i = 0 to array.size(vpVol) - 1
        float _zTop = array.get(vpBounds, _i)
        float _zBot = _zTop - _gap
        float _bodyTop = math.max(_c, _o)
        float _bodyBot = math.min(_c, _o)
        float _topWick = _h - _bodyTop
        float _botWick = _bodyBot - _l
        float _body    = _bodyTop - _bodyBot
        float _den     = 2 * _topWick + 2 * _botWick + _body
        if _den > 0
            float _bodyVol = _body * _v / _den
            float _topVol  = 2 * _topWick * _v / _den
            float _botVol  = 2 * _botWick * _v / _den
            array.set(vpVol, _i, array.get(vpVol, _i)
                 + f_volSlice(_zBot, _zTop, _bodyBot, _bodyTop, _body, _bodyVol)
                 + f_volSlice(_zBot, _zTop, _bodyTop, _h, _topWick, _topVol) / 2
                 + f_volSlice(_zBot, _zTop, _bodyBot, _l, _botWick, _botVol) / 2)

// nieuwe sessie volgens de gekozen anker
bool _pocNew = pocSession == "Weekly"   ? weekofyear(time, activeTz) != weekofyear(time[1], activeTz) :
     pocSession == "Tokyo"    ? hour(time, activeTz) == 19 and hour(time[1], activeTz) != 19 :
     pocSession == "London"   ? hour(time, activeTz) == 2  and hour(time[1], activeTz) != 2  :
     pocSession == "New York" ? hour(time, activeTz) == 9  and hour(time[1], activeTz) != 9  :
     dayofweek(time, activeTz) != dayofweek(time[1], activeTz)

float pocVal = na
float vahVal = na
float valVal = na
if usePocFilter
    if _pocNew
        array.fill(vpVol, 0.0)
        array.clear(ltfO)
        array.clear(ltfH)
        array.clear(ltfL)
        array.clear(ltfC)
        array.clear(ltfV)
        vpStart := bar_index
    if array.size(_dO) > 0
        for _i = 0 to array.size(_dO) - 1
            array.push(ltfO, array.get(_dO, _i))
            array.push(ltfH, array.get(_dH, _i))
            array.push(ltfL, array.get(_dL, _i))
            array.push(ltfC, array.get(_dC, _i))
            array.push(ltfV, array.get(_dV, _i))
    int _lb = math.max(1, bar_index - vpStart)
    float _pHi = ta.highest(high, _lb + 1)
    float _pLo = ta.lowest(low, _lb + 1)
    if _pHi > _pLo and array.size(ltfO) > 0
        float _gap = (_pHi - _pLo) / pocResolution
        array.fill(vpVol, 0.0)
        for _i = 0 to pocResolution - 1
            array.set(vpBounds, _i, _pHi - _gap * _i)
        for _j = 0 to array.size(ltfO) - 1
            f_profileAdd(array.get(ltfO, _j), array.get(ltfH, _j), array.get(ltfL, _j), array.get(ltfC, _j), array.get(ltfV, _j), _gap)
        // POC = midden van de zwaarste bin
        int _pocIdx = array.indexof(vpVol, array.max(vpVol))
        pocVal := array.get(vpBounds, _pocIdx) - _gap / 2
        // value area: vanaf de POC naar buiten tot het gekozen volumepercentage bereikt is
        float _tot = array.sum(vpVol)
        float _cnt = array.get(vpVol, _pocIdx)
        vahVal := pocVal
        valVal := pocVal
        for _k = 1 to array.size(vpVol)
            if _cnt >= _tot * pocVaWidth / 100.0
                break
            if _pocIdx + _k < array.size(vpVol)
                _cnt += array.get(vpVol, _pocIdx + _k)
                valVal := array.get(vpBounds, _pocIdx + _k) - _gap
            if _pocIdx - _k >= 0
                _cnt += array.get(vpVol, _pocIdx - _k)
                vahVal := array.get(vpBounds, _pocIdx - _k)

float pocLevel = pocRef == "VAH" ? vahVal : pocRef == "VAL" ? valVal : pocVal

float bbwpVal  = f_bbwp(close, bbwpLen, bbwpLookback, bbwpBasisType)
bool  bbwpPass = not useBbwpFilter or (not na(bbwpVal) and bbwpVal >= bbwpMin and bbwpVal <= bbwpMax)

float emaVal     = ta.ema(close, emaLen)
bool  emaLongOK  = not useEmaFilter or close > emaVal
bool  emaShortOK = not useEmaFilter or close < emaVal

// MFI (candle-value money flow, niet de klassieke Money Flow Index)
float _mfiO   = ohlc4
float _mfiH   = math.max(high, open, close)
float _mfiL   = math.min(low, open, close)
float _mfiC   = (nz(close[1], close) + nz(open[1], open)) / 2
float _mfiRng = _mfiH - _mfiL
// Vlakke bar -> geen range -> geen uitspraak. nz() zou hier een 0 verzinnen, en 0 telt in
// dit veto als richting.
float _mfiCV  = _mfiRng == 0 ? na : (_mfiC - _mfiO) / _mfiRng
float mfiVal  = ta.hma(nz(_mfiCV, nz(_mfiCV[1], 0)), mfiPeriod) * -1
bool  mfiLongOK  = not useMfiFilter or mfiVal > 0
bool  mfiShortOK = not useMfiFilter or mfiVal < 0

bool  pocLongOK  = not usePocFilter or (not na(pocLevel) and close > pocLevel)
bool  pocShortOK = not usePocFilter or (not na(pocLevel) and close < pocLevel)

float _dpHi = ta.highest(high, dpLookback)
float _dpLo = ta.lowest(low, dpLookback)
float dpPos = _dpHi - _dpLo <= 0 ? na : 100.0 * (close - _dpLo) / (_dpHi - _dpLo)
bool  dpLongOK  = not useDpFilter or (not na(dpPos) and dpPos <= dpMid)
bool  dpShortOK = not useDpFilter or (not na(dpPos) and dpPos >= dpMid)

// Alles wat een kant mag tegenhouden, op één plek. De poorten verderop lezen alleen deze
// twee, zodat er nooit een filter op de ene poort wel en op de andere niet hangt.
bool sigLongOK  = allowLongs  and bbwpPass and emaLongOK  and mfiLongOK  and pocLongOK  and dpLongOK
bool sigShortOK = allowShorts and bbwpPass and emaShortOK and mfiShortOK and pocShortOK and dpShortOK

// ============================================================================
// === DAILY RISK / EQUITY (geünificeerd, gelatcht) ===========================
// ============================================================================
var float riskBaseNetProfit = na
var float riskDayPeak = 0.0
var bool  dayHalted = false
var bool  flattenedToday = false
var string haltReason = ""
if isNewTradingDay
    float _yday = strategy.netprofit - nz(riskBaseNetProfit, strategy.netprofit)
    if isPA and time > lastPayoutTime and not na(riskBaseNetProfit)
        if _yday > 0
            profitSince += _yday
            bestDaySince := math.max(bestDaySince, _yday)
            if _yday >= minQualDayUSD
                qualDays += 1
    if phaseOn and ddModel == "EOD"
        acctHwm := math.max(nz(acctHwm, math.max(acctPnlOffset, acctHwmOffset)), acctPnlOffset + strategy.netprofit - paResetPnLPrev)
    riskBaseNetProfit := strategy.netprofit
    riskDayPeak := 0.0
    dayHalted := false
    flattenedToday := false
    haltReason := ""
todayRealizedPnL = strategy.netprofit - nz(riskBaseNetProfit, strategy.netprofit)
runningPnL = todayRealizedPnL + strategy.openprofit
riskDayPeak := math.max(riskDayPeak, runningPnL)
todayDD = riskDayPeak - runningPnL
lossBasis = includeOpenInLoss ? math.min(todayRealizedPnL, runningPnL) : todayRealizedPnL
targetHit   = enableDailyTarget and todayRealizedPnL >= dailyProfitTarget
lossHit     = enableDailyLossLimit and lossBasis <= -dailyLossLimitEff
drawdownHit = enableDailyDrawdown and todayDD >= dailyDrawdownLimit
lockArmed   = enableEquityLock and riskDayPeak >= equityLockThreshold
lockHit     = lockArmed and runningPnL <= riskDayPeak * equityLockPerc / 100.0
dllHit      = (isPA or (isEval and ddModel == "EOD")) and runningPnL <= -acctDLL
bool _dexTrailOn = dayExitMode == "Day-trail (keep peak)" or dayExitMode == "Trail + cap"
bool _dexCapOn   = dayExitMode == "Day-cap (hard target)" or dayExitMode == "Trail + cap"
bool dayTrailArmed = dayTrailModel == "Legacy: activation = giveback" ? riskDayPeak > dayTrailUSDEff : riskDayPeak >= dayTrailActivationUSDEff
float dayTrailGivebackEff = dayTrailModel == "Legacy: activation = giveback" ? dayTrailUSDEff : dayTrailGivebackUSDEff
dayTrailHit = _dexTrailOn and dayTrailArmed and runningPnL <= riskDayPeak - dayTrailGivebackEff
dayCapHit   = _dexCapOn and riskDayPeak >= dayCapUSDEff
// --- risk-gate: sessie-state op GEREALISEERDE P&L ---------------------------
var float rgBaseNet    = na
var float rgPeak       = 0.0
var float rgExitLvl    = na
var bool  rgTrailArmed = false
var int   rgClosedSeen = 0
int  _rgHour = hour(time, activeTz)
bool rgRoll  = na(rgBaseNet) or (_rgHour == rgRollHour and nz(hour(time[1], activeTz), -1) != rgRollHour)
if rgRoll
    rgBaseNet    := strategy.netprofit
    rgPeak       := 0.0
    rgExitLvl    := na
    rgTrailArmed := false
    rgClosedSeen := strategy.closedtrades
float rgCum = strategy.netprofit - nz(rgBaseNet, strategy.netprofit)
if useRiskGate and strategy.closedtrades > rgClosedSeen
    rgClosedSeen := strategy.closedtrades
    if not rgTrailArmed and rgTriggerT > 0 and rgCum >= rgTriggerT
        rgTrailArmed := true
        rgPeak       := rgCum
        rgExitLvl    := rgCum - rgBufferB
    else if rgTrailArmed and rgCum > rgPeak
        rgPeak    := rgCum
        rgExitLvl := rgPeak - rgBufferB
bool  rgDllOpen = rgDllBasis == "Realized + open (cuts the trade)"
float rgLive    = rgCum + (rgDllOpen ? nz(strategy.openprofit) : 0.0)
bool rgDllHit   = useRiskGate and rgDLL > 0 and rgLive <= -rgDLL
bool rgTrailHit = useRiskGate and rgTrailArmed and not na(rgExitLvl) and rgCum <= rgExitLvl
bool rgWindowOK = true   // entry-venster verwijderd 25-08 (besluit Ferry); de time gate doet dit werk

if not dayHalted and (targetHit or lossHit or drawdownHit or lockHit or dllHit or dayTrailHit or dayCapHit or rgDllHit or rgTrailHit)
    dayHalted := true
    haltReason := rgDllHit ? "Risk-gate DLL" : rgTrailHit ? "Risk-gate trail" : dayCapHit ? "Day-cap" : dayTrailHit ? "Day-trail" : targetHit ? "Daily Target" : lossHit ? "Daily Loss" : drawdownHit ? "Daily Drawdown" : lockHit ? "Equity Lock" : "PA Daily Loss Limit"

// === ACCOUNT ENGINE (trailing floor / eval goal / payout) ====================
float acctPnL      = acctPnlOffset + strategy.netprofit - paResetPnLPrev + strategy.openprofit
float acctRealized = acctPnlOffset + strategy.netprofit - paResetPnLPrev

var float maeSodProfit = na
if isNewTradingDay or na(maeSodProfit)
    maeSodProfit := acctPnlOffset + strategy.netprofit
float maeSafetyNet = acctTrailDD + 100
float maePct = maeSodProfit >= 2 * maeSafetyNet ? maeGrownPct : maeBasePct
float maeAllowUSD = (maePct / 100.0) * math.max(nz(maeSodProfit, 0), acctTrailDD) * (1 - maeMarginPct / 100.0)
if phaseOn
    acctHwm := na(acctHwm) ? math.max(acctPnlOffset, acctHwmOffset) : ddModel == "Intraday" ? math.max(acctHwm, acctPnL) : acctHwm
bool  acctLocked = phaseOn and acctHwm >= acctTrailDD + 100
float acctFloor  = not phaseOn ? na : acctLocked ? 100.0 : acctHwm - acctTrailDD
float ddRoom     = phaseOn ? acctPnL - acctFloor : na
bool  consistencyOK = profitSince > 0 and bestDaySince / profitSince < consistencyPct / 100.0
f_ladderCap(_n) =>
    _n == 1 ? 1500.0 : _n == 2 ? 1500.0 : _n == 3 ? 2000.0 : _n == 4 ? 2500.0 : _n == 5 ? 2500.0 : 3000.0
int   effPayoutNr = (isPA and paBacktestModeEff) ? math.min(paPayoutsThisCycle + 1, 6) : payoutNr
float curLadderCap = f_ladderCap(effPayoutNr)
bool  payoutEligible = isPA and acctLocked and acctRealized >= acctTrailDD + 100 + payoutBuffer + minPayout and qualDays >= 5 and consistencyOK
float withdrawable = acctRealized - (acctTrailDD + 100)
pmtBlock := isPA and useWaitForCap and withdrawable >= curLadderCap
pmtBlockReason := "PAYOUT CAP REACHED — request payout, then raise payout number"
bool  fullCapReady = payoutEligible and withdrawable >= curLadderCap
bool  payoutReady = useWaitForCap ? fullCapReady : payoutEligible
if phaseOn and not acctHalted
    if acctPnL <= acctFloor
        if isPA and paBacktestModeEff
            paBreachCount += 1
            paResetCount  += 1
            paResetPnLPrev := strategy.netprofit
            acctHwm       := na
            profitSince   := 0.0
            bestDaySince  := 0.0
            qualDays      := 0
            paPayoutsThisCycle := 0
        else
            acctHalted := true
            acctHaltReason := "TRAILING BREACH (model)"
    else if isEval and acctRealized >= acctGoal
        acctHalted := true
        acctHaltReason := "EVAL PASSED 🎉"
var bool payoutAlerted = false
if payoutReady and not payoutAlerted
    payoutAlerted := true
    if plainAlertsOK
        alert(f_msgHead() + " | 💰 PAYOUT " + str.tostring(effPayoutNr) + " READY" + (useWaitForCap ? " (VOLLE CAP $" + str.tostring(curLadderCap, "#") + ")" : "") + " | withdrawable $" + str.tostring(withdrawable, "#"), alert.freq_once_per_bar)
if not payoutReady
    payoutAlerted := false

if isPA and paBacktestModeEff and payoutReady and barstate.isconfirmed
    float _take = useWaitForCap ? curLadderCap : math.min(withdrawable, curLadderCap)
    paTotalBanked += _take
    paPayoutsThisCycle += 1
    paResetPnLPrev := paResetPnLPrev + _take
    profitSince   := 0.0
    bestDaySince  := 0.0
    qualDays      := 0
    if paPayoutsThisCycle >= 6
        paMilkCount += 1
        paResetCount += 1
        paPayoutsThisCycle := 0
        acctHwm := na
        paResetPnLPrev := strategy.netprofit

var bool  evalStarted = false
var float evalBal    = na
var int  attemptTradeNo  = 0
var bool attemptFirstLoss = false
// v6.8.x FIX (A1): re-arm recovery-trail counters each trading day. They were
// only reset inside the disabled evalTrack path, so the recovery-trail fired
// only on the 2nd trade of the entire run. Now it re-arms per session.
if isNewTradingDay
    attemptTradeNo := 0
    attemptFirstLoss := false
var int  lastClosedSeen   = 0
var float distTarget = na
var float distFail   = na
var bool  regimeFav  = false

var bool acctStartArmed = false
var bool startNotified = false
if not acctStartArmed
    bool _dateOK = not tradeFromStart or time >= evalStartTime
    bool _regOK  = not startNeedRegime or not useRegime or regimeFav
    if _dateOK and _regOK
        acctStartArmed := true
bool preStartBlock = (tradeFromStart or startNeedRegime) and not acctStartArmed
canTrade = timeGatePass and evtGateOK and rgWindowOK and not dayHalted and not inFlatWindow and not acctHalted and not preStartBlock


// ============================================================================
// === SIZING =================================================================
// ============================================================================
f_calcQty(_slDistPrice) =>
    float _q = contractSizeEff
    if sizingMode != "Fixed contracts"
        float _riskUSD = sizingMode == "Fixed $ risk" ? riskValue : strategy.equity * riskValue / 100.0
        float _perUnit = _slDistPrice * syminfo.pointvalue
        _q := _perUnit > 0 ? _riskUSD / _perUnit : 0.0
    _q := math.min(_q, maxQty)
    allowFractionalQty ? math.round(_q, 4) : math.floor(_q)

// ============================================================================
// === SIGNAL =================================================================
// ============================================================================
isFlat = strategy.position_size == 0 and strategy.opentrades == 0
var bool posRiskOff = false

bool long0  = bullCandle and bullCvdPass and sigLongOK and canLong  and vetoLongOK  and sweepLongOK and canTrade and orGateLong  and dirHourLongPass and barstate.isconfirmed
bool short0 = bearCandle and bearCvdPass and sigShortOK and canShort and vetoShortOK and sweepShortOK and canTrade and orGateShort and dirHourShortPass and barstate.isconfirmed

// === v6.1: FVG CONFIRMATION MEMORY ==========================================
var array<int>   memBar = array.new<int>()
var array<int>   memDir = array.new<int>()
var array<float> memMid = array.new<float>()
var array<float> memTop = array.new<float>()
var array<float> memBot = array.new<float>()
int   memSigDir = 0
float memSigMid = na
float memSigTop = na
float memSigBot = na
int   memSigAge = 0
if confirmBars > 0 and barstate.isconfirmed
    bool _pruning = true
    while _pruning
        if array.size(memBar) == 0
            _pruning := false
        else if bar_index - array.get(memBar, 0) > confirmBars
            array.shift(memBar)
            array.shift(memDir)
            array.shift(memMid)
            array.shift(memTop)
            array.shift(memBot)
        else
            _pruning := false

    if useFillCheck and array.size(memBar) > 0
        int _m = array.size(memBar)
        for _p = _m - 1 to 0
            float _gmid = array.get(memMid, _p)
            if low <= _gmid and high >= _gmid
                array.remove(memBar, _p)
                array.remove(memDir, _p)
                array.remove(memMid, _p)
                array.remove(memTop, _p)
                array.remove(memBot, _p)
    bool gateMemOK = (isFlat or (gateOpenOnRiskOff and posRiskOff)) and canTrade
    if not (long0 or short0) and gateMemOK and array.size(memBar) > 0
        int _n = array.size(memBar)
        for _j = 0 to _n - 1
            int _k = _n - 1 - _j
            int _age = bar_index - array.get(memBar, _k)
            if _age >= 1 and _age <= confirmBars
                int _d = array.get(memDir, _k)
                bool _ok = _d == 1 ? (bullCvdPass and sigLongOK and canLong and vetoLongOK and sweepLongOK and orGateLong and dirHourLongPass) :
                     (bearCvdPass and sigShortOK and canShort and vetoShortOK and sweepShortOK and orGateShort and dirHourShortPass)
                if _ok
                    memSigDir := _d
                    memSigMid := array.get(memMid, _k)
                    memSigTop := array.get(memTop, _k)
                    memSigBot := array.get(memBot, _k)
                    memSigAge := _age
                    array.remove(memBar, _k)
                    array.remove(memDir, _k)
                    array.remove(memMid, _k)
                    array.remove(memTop, _k)
                    array.remove(memBot, _k)
                    break
    bool consumed0 = (long0 or short0) and (isFlat or (gateOpenOnRiskOff and posRiskOff))
    if fvgDirection != 0 and fvgPasses and not consumed0
        array.push(memBar, bar_index)
        array.push(memDir, fvgDirection)
        array.push(memMid, fvgMid)
        array.push(memTop, fvgTop)
        array.push(memBot, fvgBottom)

longSignal  = long0  or memSigDir == 1
shortSignal = short0 or memSigDir == -1
float sigGapMid = (long0 or short0) ? fvgMid    : memSigMid
float sigGapTop = (long0 or short0) ? fvgTop    : memSigTop
float sigGapBot = (long0 or short0) ? fvgBottom : memSigBot

float sigFvgTicks = not na(sigGapTop) and not na(sigGapBot) ? math.abs(sigGapTop - sigGapBot) / syminfo.mintick : na
int   sigStreakLen = longSignal ? cvdBullStreakDisplay : shortSignal ? cvdBearStreakDisplay : 0
int   sigFvgAge = (long0 or short0) ? 0 : memSigAge
string sigDiag = "FVG" + str.tostring(sigFvgTicks, "#") + "|CVD" + str.tostring(sigStreakLen) + "|AGE" + str.tostring(sigFvgAge) + "|H" + str.tostring(hour(time, activeTz)) + "|D" + str.tostring(dayofweek(time, activeTz))

bool isLimitMode = entryMode == "Limit @ 50% FVG"
float sigEntryPx = isLimitMode ? sigGapMid : close
float sigStopPx = na
if longSignal
    sigStopPx := stopMode == "Swing structure" ? math.min(nz(lastPivLow, sigGapBot), sigGapBot) - f_distPrice(swingBufSize) : sigEntryPx - f_distPrice(slSizeLegacyEff)
if shortSignal
    sigStopPx := stopMode == "Swing structure" ? math.max(nz(lastPivHigh, sigGapTop), sigGapTop) + f_distPrice(swingBufSize) : sigEntryPx + f_distPrice(slSizeLegacyEff)
float sigStopDist = math.abs(sigEntryPx - sigStopPx)
bool stopValid = not na(sigStopPx) and sigStopDist > syminfo.mintick and sigStopDist <= f_distPrice(maxStopSizeEff)
float sigQty = f_calcQty(sigStopDist)
bool qtyOk = sigQty >= (allowFractionalQty ? 1e-4 : 1.0)

bool maeActive = useMaeGuard and isPA
float maeQtyMax = maeActive and sigStopDist > 0 ? math.floor(maeAllowUSD / (sigStopDist * syminfo.pointvalue)) : 1e9
bool maeGuardOK = not maeActive or maeQtyMax >= 1
float _lwProg = evalTrack and evalStarted and evalProfitTgt > 0 and not na(evalBal) ? (evalBal - evalStartBal) / evalProfitTgt : 0.0
float _prog = isEval and acctGoal > 0 ? acctRealized / acctGoal : _lwProg
bool deriskOn = useDerisk and (isEval or (evalTrack and evalStarted))
float deriskQtyMax = deriskOn ? (_prog >= deriskLvl2 / 100 ? deriskQty2 : _prog >= deriskLvl1 / 100 ? deriskQty1 : 1e9) : 1e9
float _paNet = acctTrailDD + 100
float _progPa = isPA and _paNet > 0 ? acctRealized / _paNet : 0.0
float deriskPaMax = useDeriskPA and isPA and acctRealized < _paNet and _progPa >= deriskPaLvl / 100 ? deriskPaQty : 1e9
float sigQtyCap = math.min(math.min(maeActive ? math.max(maeQtyMax, 0) : 1e9, deriskQtyMax), deriskPaMax)
float sigQtyEff = math.min(sigQty, sigQtyCap)

f_tpFixDist(_q) =>
    float _d = f_distPrice(tpSizeEff)
    if useGoalTp and isEval and not acctHalted and acctRealized < acctGoal and _q > 0
        _d := math.min(_d, (acctGoal - acctRealized) / (_q * syminfo.pointvalue) + 3 * syminfo.mintick)
    math.max(_d, 4 * syminfo.mintick)

float sigTpPx = na
if longSignal or shortSignal
    int _d = longSignal ? 1 : -1
    sigTpPx := tpModeEff == "Swing structure" ? (_d == 1 ? lastPivHigh : lastPivLow) :
         tpModeEff == "R-multiple" ? sigEntryPx + _d * rMultIn * sigStopDist :
         sigEntryPx + _d * f_tpFixDist(sigQtyEff)
bool tpValid = not na(sigTpPx) and (longSignal ? sigTpPx > sigEntryPx + syminfo.mintick : sigTpPx < sigEntryPx - syminfo.mintick)

float nextTradeRisk = sigStopDist * sigQtyEff * syminfo.pointvalue
bool ddGuardOK = not phaseOn or not useDDGuard or (not na(ddRoom) and ddRoom >= nextTradeRisk * guardMult)

// ============================================================================
// === ALERT BUILDERS =========================================================
// ============================================================================
f_trailOn(_slD) => useTrailEff and _slD > 0
f_pmtJSON(_action, _qty, _price, _slD, _tpD, _ordType) =>
    "{" + "\"symbol\":\"" + syminfo.ticker + "\",\"date\":\"" + str.format("{0,date,yyyy-MM-dd HH:mm:ss}", timenow) + "\",\"data\":\"" + _action + "\",\"quantity\":\"" + str.tostring(_qty) + "\",\"risk_percentage\":0,\"price\":\"" + str.tostring(_price) + "\",\"tp\":0,\"percentage_tp\":0,\"dollar_tp\":" + str.tostring(_tpD) + ",\"sl\":0,\"dollar_sl\":" + str.tostring(_slD) + ",\"percentage_sl\":0,\"trail\":" + (f_trailOn(_slD) ? "1" : "0") + ",\"trail_stop\":" + str.tostring(f_trailOn(_slD) ? f_distPrice(trBufEff) : 0) + ",\"trail_trigger\":" + str.tostring(f_trailOn(_slD) ? f_distPrice(trStartEff) : 0) + ",\"trail_freq\":" + str.tostring(f_trailOn(_slD) ? f_distPrice(trailUpdateStep) : 0) + ",\"update_tp\":false,\"update_sl\":false,\"breakeven\":" + ((useBEeff and _slD > 0) ? str.tostring(f_distPrice(beTrigEff)) : "0") + ",\"token\":\"" + pmtToken + "\",\"pyramid\":false,\"reverse_order_close\":true,\"order_type\":\"" + _ordType + "\",\"multiple_accounts\":[{\"token\":\"" + pmtToken + "\",\"account_id\":\"" + accountID + "\",\"risk_percentage\":0,\"quantity_multiplier\":1}]}"
f_pcSym() => str.length(pcSymbol) > 0 ? pcSymbol : syminfo.ticker
f_sendExec(_action, _qty, _price, _slD, _tpD, _ordType) =>
    bool _pmtRoute = usePMT or useRithmic
    if _pmtRoute and pmtBlock and _action != "close"
        label.new(bar_index, high, "⛔ PMT BLOCKED — " + pmtBlockReason, style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.small)
    if _pmtRoute and (not pmtBlock or _action == "close")
        alert(f_pmtJSON(_action, _qty, _price, _slD, _tpD, _ordType), alert.freq_once_per_bar)
    // PineConnector (MT4/5): comma command "{license},{buy|sell|exit},{symbol}[,sl=,tp=,risk=]".
    // _slD/_tpD are PRICE distances at the call site -> reconstruct absolute SL/TP prices.
    if usePineConnector
        if _action == "close"
            alert(pcLicense + ",exit," + f_pcSym(), alert.freq_once_per_bar)
        else
            float _slPx = _action == "buy" ? _price - _slD : _price + _slD
            float _tpPx = _action == "buy" ? _price + _tpD : _price - _tpD
            alert(pcLicense + "," + _action + "," + f_pcSym() + ",sl=" + str.tostring(_slPx, format.mintick) + ",tp=" + str.tostring(_tpPx, format.mintick) + ",risk=" + str.tostring(pcRisk), alert.freq_once_per_bar)
    if useMiddleware
        string _mwEv = _action == "close" ? "EXIT" : "ENTRY"
        alert("{\"secret\":\"" + mwSecret + "\",\"strategy\":\"" + mwStrategy + "\",\"event\":\"" + _mwEv + "\",\"action\":\"" + _action + "\",\"symbol\":\"" + syminfo.ticker + "\",\"price\":" + str.tostring(_price) + ",\"order_type\":\"" + _ordType + "\",\"dollar_sl\":" + str.tostring(_slD) + ",\"dollar_tp\":" + str.tostring(_tpD) + ",\"qty\":" + str.tostring(_qty) + "}", alert.freq_once_per_bar)
f_sendDiscord(_title, _desc) =>
    if useDiscord
        _tag = roleID == "" ? "" : "\"content\":\"<@&" + roleID + ">\","

        _user = "\"username\":\"" + (botName == "" ? SCRIPT_NAME : botName) + "\","
        _ava  = avatarURL == "" ? "" : "\"avatar_url\":\"" + avatarURL + "\","
        _url  = titleURL == "" ? "" : "\"url\":\"" + titleURL + "\","
        alert("{" + _user + _ava + _tag + "\"embeds\":[{\"title\":\"" + _title + "\"," + _url + "\"color\":3447003,\"description\":\"" + _desc + "\",\"footer\":{\"text\":\"" + syminfo.ticker + "\"}}]}", alert.freq_once_per_bar)


f_evalTail(bool _started, float _dT, float _dF, string _acct) =>
    _started ?
         "\\n📍 " + _acct +
         (not na(_dT) ? " | →🎯 $" + str.tostring(_dT, "#") : "") +
         (not na(_dF) ? " | →⚠️ $" + str.tostring(_dF, "#") : "") +
         " (≈ benadering)" : ""

// === v6.0: order alert_message — same structure as the CSV journal + CFG ====
var string cfgStr = ""
if barstate.isfirst
    cfgStr := "ver=" + currentVersion + ";acct=" + jrnlAcct + ";qty=" + str.tostring(contractSizeEff, "#.#") + ";entry=" + (isLimitMode ? "limit50" : "market") + ";expiry=" + str.tostring(expiryBars) + ";fvg=" + str.tostring(gapMinSizeEff, "#") + "-" + str.tostring(gapMaxSizeEff, "#") + ";confW=" + str.tostring(confirmBars) + ";stop=" + stopMode + ";pivK=" + str.tostring(pivotK) + ";buf=" + str.tostring(swingBufSize, "#") + ";maxStop=" + str.tostring(maxStopSizeEff, "#") + ";tp=" + tpMode + (tpMode == "Fixed (units)" ? "(" + str.tostring(tpSize, "#") + ")" : "") + ";R=" + str.tostring(rMultIn, "#.#") + ";goalTp=" + (useGoalTp and isEval ? "1" : "0") + ";guard=" + (useDDGuard ? "1" : "0") + ";BEeff=" + (useBEeff ? str.tostring(beTrigEff, "#") + "/" + str.tostring(beOffEff, "#") : "off") + ";trailEff=" + (useTrailEff ? str.tostring(trStartEff, "#") + "/" + str.tostring(trBufEff, "#") : "off") + ";tpEff=" + tpModeEff + "(" + str.tostring(tpSizeEff, "#") + ")" + ";vwapVeto=" + (useVwapVeto ? "1" : "0") + ";cvd=" + (useCVDFilterEff ? "1" : "0") + ";streak=" + (useCvdStreak ? str.tostring(cvdTrendCountEff) : "off") + ";bias=" + (useBiasFilter ? "1" : "0") + ";sweep=" + (useSweepFilter ? "1" : "0") + ";DLL=" + (enableDailyLossLimit ? str.tostring(dailyLossLimit, "#") : "off") + ";phase=" + accountPhase + ";firm=" + (useFirmPreset ? firmPreset : "manual") + ";ddModel=" + ddModel + ";trailDD=" + str.tostring(acctTrailDD, "#") + ";paDLL=" + str.tostring(acctDLL, "#") + ";mae=" + (useMaeGuard ? str.tostring(maeBasePct, "#") + "/" + str.tostring(maeGrownPct, "#") + "-m" + str.tostring(maeMarginPct, "#") : "off") + ";derisk=" + (useDerisk ? str.tostring(deriskLvl1, "#") + "->" + str.tostring(deriskQty1) + "/" + str.tostring(deriskLvl2, "#") + "->" + str.tostring(deriskQty2) : "off") + ";deriskPA=" + (useDeriskPA ? str.tostring(deriskPaLvl, "#") + "->" + str.tostring(deriskPaQty) : "off") + ";mktRegime=" + marketRegimeMode + ";dayTrailModel=" + dayTrailModel + ";dayTrailAct=" + str.tostring(dayTrailActivationUSDEff, "#") + ";dayTrailGive=" + str.tostring(dayTrailGivebackEff, "#") + ";dayScale=" + dailyScaleMode + ";rg=" + (useRiskGate ? str.tostring(rgDLL, "#") + "/" + str.tostring(rgTriggerT, "#") + "/" + str.tostring(rgBufferB, "#") : "off") + ";filters=" + (useBbwpFilter ? "bbwp" : "") + (useEmaFilter ? "ema" : "") + (useMfiFilter ? "mfi" : "") + (usePocFilter ? "poc" : "") + (useDpFilter ? "dp" : "") + (allowLongs and allowShorts ? "" : allowLongs ? "L" : "S") + ";tz=" + activeTz

var bool cfgSent = false
if sendCfgOnStart and barstate.isrealtime and not cfgSent
    cfgSent := true
    if useJournal and not execInstance
        string _cfgRow = str.format("{0,date,yyyy-MM-dd HH:mm:ss}", timenow) + "," + accountID + "," + jrnlAcct + "," + syminfo.ticker + ",CONFIG,-,-,-,-,-,-,-,-," + cfgStr
        alert(jrnlJsonWrap ? "{\"type\":\"config\",\"csv\":\"" + _cfgRow + "\"}" : _cfgRow, alert.freq_once_per_bar)
    else if useDiscord
        f_sendDiscord("⚙️ " + syminfo.ticker + " CONFIG", jrnlAcct + " | " + cfgStr)
    else if plainAlertsOK
        alert(f_msgHead() + " | CONFIG | " + cfgStr, alert.freq_once_per_bar)

var bool payoutDiscordSent = false
if payoutReady and not payoutDiscordSent
    payoutDiscordSent := true
    f_sendDiscord("💰 " + syminfo.ticker + " PAYOUT " + str.tostring(effPayoutNr) + " READY", jrnlAcct + " | " + (useWaitForCap ? "FULL CAP $" + str.tostring(curLadderCap, "#") + " available | " : "") + "Withdrawable $" + str.tostring(withdrawable, "#") + " | realized $" + str.tostring(acctRealized, "#"))
var bool capLocked = false
if lockOnCap and isPA and useWaitForCap and not capLocked and strategy.position_size != 0
    float _lockBufC = lockBufTicks * syminfo.mintick * syminfo.pointvalue * math.abs(strategy.position_size)
    if (acctRealized + strategy.openprofit) - (acctTrailDD + 100) >= curLadderCap + _lockBufC
        capLocked := true
        exitReasonNext := "CAP-LOCK"
        strategy.close_all(comment="CAP-LOCK")
        f_sendExec("close", math.abs(strategy.position_size), close, 0, 0, "MKT")
        f_sendDiscord("🔐 " + syminfo.ticker + " CAP LOCK", jrnlAcct + " | " + "Projected withdrawable covers the FULL ladder cap (+" + str.tostring(lockBufTicks, "#") + "t cost buffer). Closing all — payout secured.")
if not payoutReady
    payoutDiscordSent := false

var int deriskNotifState = 0
int _dState = deriskOn ? (_prog >= deriskLvl2 / 100 ? 2 : _prog >= deriskLvl1 / 100 ? 1 : 0) : 0
if notifyDerisk and _dState > deriskNotifState
    f_sendDiscord("🪜 " + syminfo.ticker + " DERISK L" + str.tostring(_dState), jrnlAcct + " | progress " + str.tostring(_prog * 100, "#") + "% of goal — size capped to " + str.tostring(_dState == 2 ? deriskQty2 : deriskQty1, "#") + " contract(s).")
deriskNotifState := _dState
var int paNotifState = 0
int _pState = useDeriskPA and isPA and acctRealized < _paNet and _progPa >= deriskPaLvl / 100 ? 1 : 0
if notifyDerisk and _pState > paNotifState
    f_sendDiscord("🪜 " + syminfo.ticker + " PA DERISK", jrnlAcct + " | " + str.tostring(_progPa * 100, "#") + "% of safety net — size capped to " + str.tostring(deriskPaQty, "#") + " contract(s) until lock.")
paNotifState := _pState

f_orderMsg(string _event, int _dir, float _entry, float _sl, float _tp, float _qty) =>
    not alertMsgAuto ? "" : _event + "," + (_dir == 1 ? "LONG" : "SHORT") + "," + jrnlAcct + "," + syminfo.ticker + "," + str.tostring(_entry, format.mintick) + "," + str.tostring(_sl, format.mintick) + "," + str.tostring(_tp, format.mintick) + "," + str.tostring(_qty, "#.##") + (alertIncludeCfg ? "|CFG|" + cfgStr : "")

f_journal(string _event, int _dir, string _status, float _entry, float _stop, float _target, float _qty, float _pnl, bool _started, float _bal, float _dT, float _dF, bool _regOn, bool _regFav) =>
    if useJournal and not execInstance
        _dirTxt = _dir == 1 ? "LONG" : _dir == -1 ? "SHORT" : "-"
        _reg = not _regOn ? "-" : _regFav ? "FAVORABLE" : "UNFAVORABLE"
        _balTxt = _started ? str.tostring(_bal, "#.##") : ""
        _dTTxt  = (_started and not na(_dT)) ? str.tostring(_dT, "#.##") : ""
        _dFTxt  = (_started and not na(_dF)) ? str.tostring(_dF, "#.##") : ""
        _row = str.format("{0,date,yyyy-MM-dd HH:mm:ss}", timenow) + "," + accountID + "," + jrnlAcct + "," +
             syminfo.ticker + "," + _event + "," + _dirTxt + "," + _status + "," +
             (na(_entry) ? "" : str.tostring(_entry, format.mintick)) + "," +
             (na(_stop) ? "" : str.tostring(_stop, format.mintick)) + "," +
             (na(_target) ? "" : str.tostring(_target, format.mintick)) + "," +
             (na(_qty) ? "" : str.tostring(_qty, "#.##")) + "," +
             (na(_pnl) ? "" : str.tostring(_pnl, "#.##")) + "," + _reg + "," +
             _balTxt + "," + _dTTxt + "," + _dFTxt
        alert(jrnlJsonWrap ? "{\"type\":\"journal\",\"csv\":\"" + _row + "\"}" : _row, alert.freq_once_per_bar)

// ============================================================================
// === ORDER ENGINE ===========================================================
// ============================================================================
var array<box> unfilledBoxes = array.new<box>()
f_markUnfilled(_fromBar, _px, _replaced) =>
    if showExpired and inDrawWin and not na(_px)
        _b = box.new(_fromBar, _px + 2 * syminfo.mintick, bar_index, _px - 2 * syminfo.mintick,
             border_color=_replaced ? color.new(color.orange, 30) : color.new(color.gray, 30),
             border_style=line.style_dashed, bgcolor=color.new(color.gray, 90),
             text=_replaced ? "↻" : "✕", text_color=color.new(color.gray, 20), text_size=size.tiny)
        array.push(unfilledBoxes, _b)
        if array.size(unfilledBoxes) > 60
            box.delete(array.shift(unfilledBoxes))

var int   pendDir = 0
var int   pendBar = na
var float pendLimit = na
var float pendStop = na
var float t_tpD = na
var float t_tpPx = na
var float t_qty = na

gateOK = isFlat or (gateOpenOnRiskOff and posRiskOff)

// === v6.0: BLOCKERS ENGINE ==================================================
bool rawLong  = (bullCandle and bullCvdPass and sigLongOK and canLong  and vetoLongOK  and sweepLongOK and barstate.isconfirmed) or memSigDir == 1
bool rawShort = (bearCandle and bearCvdPass and sigShortOK and canShort and vetoShortOK and sweepShortOK and barstate.isconfirmed) or memSigDir == -1
f_persistentBlockers() =>
    string _b = ""
    if preStartBlock
        _b += "Before start date, "
    if monEarlyBlock
        _b += "Monday 00-02 ET, "
    else if not timeGatePass
        _b += "Time gate, "
    if inFlatWindow
        _b += "Flat window, "
    if dayHalted
        _b += "Day halt: " + haltReason + ", "
    if acctHalted
        _b += "Account: " + acctHaltReason + ", "
    _b
f_signalBlockers() =>
    string _b = ""
    if not maeGuardOK
        _b += "MAE guard (risk > cap), "
    if not ddGuardOK
        _b += "DD guard, "
    if not stopValid
        _b += "Stop invalid, "
    if not qtyOk
        _b += "Qty < 1, "
    _b
string persistBlk = f_persistentBlockers()
bool rawSig = rawLong or rawShort
string sigBlk = rawSig ? f_signalBlockers() : ""
string occBlk = rawSig and not gateOK ? (isFlat ? "" : "In position, ") : ""
string allBlk = persistBlk + sigBlk + occBlk
bool sigBlockedEvt = rawSig and not preStartBlock and (str.length(persistBlk) > 0 or str.length(sigBlk) > 0)
var string lastBlockedInfo = "—"
if sigBlockedEvt
    lastBlockedInfo := (rawLong ? "LONG " : "SHORT ") + str.format_time(time, "dd-MM HH:mm", "America/New_York") + " · " + str.substring(persistBlk + sigBlk, 0, math.max(0, str.length(persistBlk + sigBlk) - 2))
if sigBlockedEvt and notifyBlocked
    string _reasons = str.substring(persistBlk + sigBlk, 0, math.max(0, str.length(persistBlk + sigBlk) - 2))
    if plainAlertsOK
        alert(f_msgHead() + " | ⛔ SIGNAL BLOCKED | " + (rawLong ? "LONG" : "SHORT") + " " + syminfo.ticker + " | strategy rules met, blocked by: " + _reasons, alert.freq_once_per_bar)
    if useDiscord
        f_sendDiscord("⛔ " + syminfo.ticker + " SIGNAL BLOCKED", jrnlAcct + " | " + (rawLong ? "Long" : "Short") + " setup meets all strategy rules but was blocked by: " + _reasons)
if (longSignal or shortSignal) and gateOK and stopValid and tpValid and qtyOk and ddGuardOK and maeGuardOK and (not onlyFirstTrade or not hasTraded)
    if isLimitMode and pendDir != 0
        f_markUnfilled(pendBar, pendLimit, true)
    t_tpD := f_tpFixDist(sigQtyEff)
    t_tpPx := sigTpPx
    t_qty := sigQtyEff
    pendDir := longSignal ? 1 : -1
    if useOrBreakout and orOneSetup
        if longSignal
            orUsedLong := true
        else
            orUsedShort := true
    pendBar := bar_index
    if notifyStart and not startNotified
        startNotified := true
        f_sendDiscord("🚀 " + syminfo.ticker + " ACCOUNT STARTED", jrnlAcct + " | " + str.format_time(timenow, "yyyy-MM-dd HH:mm:ss", activeTz) + " | regime " + (useRegime ? (regimeFav ? "FAVORABLE" : "UNFAVORABLE") : "off") + " | first order: " + (longSignal ? "LONG " : "SHORT ") + str.tostring(t_qty, "#.##") + "ct @ " + str.tostring(isLimitMode ? sigEntryPx : close, format.mintick))
    pendLimit := isLimitMode ? sigEntryPx : na
    pendStop := sigStopPx
    if longSignal
        if isLimitMode
            strategy.entry("Long", strategy.long, qty=t_qty, limit=pendLimit, comment=sigDiag + "|SL" + str.tostring(sigStopDist / syminfo.mintick, "#") + "t", alert_message=f_orderMsg("ENTRY", 1, pendLimit, pendStop, t_tpPx, t_qty))
            strategy.exit("XL", from_entry="Long", stop=pendStop, limit=t_tpPx, alert_message=f_orderMsg("EXIT", 1, pendLimit, pendStop, t_tpPx, t_qty))
        else
            strategy.entry("Long", strategy.long, qty=t_qty, comment=sigDiag + "|SL" + str.tostring(sigStopDist / syminfo.mintick, "#") + "t", alert_message=f_orderMsg("ENTRY", 1, close, pendStop, t_tpPx, t_qty))
            strategy.exit("XL", from_entry="Long", stop=pendStop, limit=t_tpPx, alert_message=f_orderMsg("EXIT", 1, close, pendStop, t_tpPx, t_qty))
        f_sendExec("buy", t_qty, isLimitMode ? pendLimit : close, sigStopDist, math.abs(t_tpPx - sigEntryPx), isLimitMode ? "LMT" : "MKT")
        f_sendDiscord("📈 " + syminfo.ticker + " LONG " + (isLimitMode ? "LIMIT" : "MARKET"),
             jrnlAcct + " | " +
             "Entry " + str.tostring(sigEntryPx, format.mintick) + " | Stop " + str.tostring(pendStop, format.mintick) + " | TP " + str.tostring(t_tpPx, format.mintick) + " (" + tpMode + ")" + " | Qty " + str.tostring(t_qty) + " | " + phase + f_evalTail(evalStarted, distTarget, distFail, jrnlAcct))
    if shortSignal
        if isLimitMode
            strategy.entry("Short", strategy.short, qty=t_qty, limit=pendLimit, comment=sigDiag + "|SL" + str.tostring(sigStopDist / syminfo.mintick, "#") + "t", alert_message=f_orderMsg("ENTRY", -1, pendLimit, pendStop, t_tpPx, t_qty))
            strategy.exit("XS", from_entry="Short", stop=pendStop, limit=t_tpPx, alert_message=f_orderMsg("EXIT", -1, pendLimit, pendStop, t_tpPx, t_qty))
        else
            strategy.entry("Short", strategy.short, qty=t_qty, comment=sigDiag + "|SL" + str.tostring(sigStopDist / syminfo.mintick, "#") + "t", alert_message=f_orderMsg("ENTRY", -1, close, pendStop, t_tpPx, t_qty))
            strategy.exit("XS", from_entry="Short", stop=pendStop, limit=t_tpPx, alert_message=f_orderMsg("EXIT", -1, close, pendStop, t_tpPx, t_qty))
        f_sendExec("sell", t_qty, isLimitMode ? pendLimit : close, sigStopDist, math.abs(t_tpPx - sigEntryPx), isLimitMode ? "LMT" : "MKT")
        f_sendDiscord("📉 " + syminfo.ticker + " SHORT " + (isLimitMode ? "LIMIT" : "MARKET"),
             jrnlAcct + " | " +
             "Entry " + str.tostring(sigEntryPx, format.mintick) + " | Stop " + str.tostring(pendStop, format.mintick) + " | TP " + str.tostring(t_tpPx, format.mintick) + " (" + tpMode + ")" + " | Qty " + str.tostring(t_qty) + " | " + phase + f_evalTail(evalStarted, distTarget, distFail, jrnlAcct))

if isFlat and pendDir != 0 and (bar_index - pendBar > expiryBars or inFlatWindow or dayHalted)
    strategy.cancel("Long")
    strategy.cancel("Short")
    f_markUnfilled(pendBar, pendLimit, false)
    f_sendExec("close", t_qty, close, 0, 0, "MKT")
    f_sendDiscord("⏳ " + syminfo.ticker + " LIMIT EXPIRED", jrnlAcct + " | " + "Pending " + (pendDir == 1 ? "long" : "short") + " cancelled @ " + str.tostring(pendLimit, format.mintick))
    f_journal("EXPIRED", pendDir, "NOT_FILLED", pendLimit, pendStop, float(na), t_qty, float(na), evalStarted, evalBal, distTarget, distFail, useRegime, regimeFav)
    pendDir := 0
    pendLimit := na
    pendStop := na

// ============================================================================
// === POSITION MANAGEMENT ====================================================
// ============================================================================
posSize = strategy.position_size
inLong  = posSize > 0
inShort = posSize < 0
entryAvg = strategy.position_avg_price
var float jEntryPx = na
if strategy.position_size != 0 and not na(entryAvg)
    jEntryPx := entryAvg
var float posHi = na
var float posLo = na
var float curStop = na
var float curLimit = na
newLong  = posSize > 0 and nz(posSize[1]) <= 0
newShort = posSize < 0 and nz(posSize[1]) >= 0
flatNow  = posSize == 0

if flatNow
    posRiskOff := false

if newLong or newShort
    pendDir := 0
    hasTraded := true
    posHi := newLong  ? math.max(entryAvg, close) : high
    posLo := newShort ? math.min(entryAvg, close) : low
    curStop  := pendStop
    float _riskFill = math.abs(entryAvg - pendStop)
    curLimit := tpModeEff == "Swing structure" ? t_tpPx :
         tpModeEff == "R-multiple" ? (newLong ? entryAvg + rMultIn * _riskFill : entryAvg - rMultIn * _riskFill) :
         (newLong ? entryAvg + t_tpD : entryAvg - t_tpD)
    if newLong
        strategy.exit("XL", from_entry="Long", stop=curStop, limit=curLimit, alert_message=f_orderMsg("EXIT", 1, entryAvg, curStop, curLimit, math.abs(posSize)))
    if newShort
        strategy.exit("XS", from_entry="Short", stop=curStop, limit=curLimit, alert_message=f_orderMsg("EXIT", -1, entryAvg, curStop, curLimit, math.abs(posSize)))
    f_journal("FILL", newLong ? 1 : -1, "FILLED", entryAvg, curStop, curLimit, math.abs(posSize), float(na), evalStarted, evalBal, distTarget, distFail, useRegime, regimeFav)
    if notifyFills
        posTrailOn := false
        posRecovOn := false
        exitReasonNext := ""
        f_sendDiscord((newLong ? "📥 " : "📥 ") + syminfo.ticker + " FILL " + (newLong ? "LONG" : "SHORT"), jrnlAcct + " | " + str.tostring(math.abs(posSize), "#.##") + "ct @ " + str.tostring(entryAvg, format.mintick) + " | SL " + str.tostring(curStop, format.mintick) + " | TP " + str.tostring(curLimit, format.mintick))

var box zoneRisk = na
var box zoneReward = na
var label tradeInfo = na
if strategy.closedtrades > lastClosedSeen
    int _ci = strategy.closedtrades - 1
    float _cp = strategy.closedtrades.profit(_ci)
    attemptTradeNo := attemptTradeNo + 1
    if attemptTradeNo == 1 and _cp < 0
        attemptFirstLoss := true
    lastClosedSeen := strategy.closedtrades
var array<box>   drawHistB = array.new<box>()
var array<label> drawHistL = array.new<label>()
f_capDrawings() =>
    while array.size(drawHistB) > 40
        box.delete(array.shift(drawHistB))
    while array.size(drawHistL) > 80
        label.delete(array.shift(drawHistL))
if showExitLabels and flatNow and nz(posSize[1]) != 0 and strategy.closedtrades > 0 and inDrawWin

    int   _ti  = strategy.closedtrades - 1
    float _xp  = strategy.closedtrades.exit_price(_ti)
    float _ep  = strategy.closedtrades.entry_price(_ti)
    float _pf  = strategy.closedtrades.profit(_ti)
    bool  _wasLong = nz(posSize[1]) > 0
    bool  _win = _pf >= 0
    int   _x0  = strategy.closedtrades.entry_bar_index(_ti)
    int   _xm  = math.round(math.avg(_x0, bar_index))

    if not na(zoneRisk)
        box.set_right(zoneRisk, bar_index)
        box.set_right(zoneReward, bar_index)
        array.push(drawHistB, zoneRisk)
        array.push(drawHistB, zoneReward)
    if not na(zoneRisk)
        float _slLvl = _wasLong ? box.get_bottom(zoneRisk) : box.get_top(zoneRisk)
        int   _slT   = math.round(math.abs(_ep - _slLvl) / syminfo.mintick)
        array.push(drawHistL, label.new(_xm, math.avg(_ep, _slLvl), "SL " + str.tostring(_slT) + "t · $" +
             str.tostring(math.abs(_ep - _slLvl) * syminfo.pointvalue, "#"),
             style=label.style_none, textcolor=vNegTxt, size=size.small, textalign=text.align_center))
    if not na(zoneReward)
        float _tpLvl = _wasLong ? box.get_top(zoneReward) : box.get_bottom(zoneReward)
        int   _tpT   = math.round(math.abs(_tpLvl - _ep) / syminfo.mintick)
        array.push(drawHistL, label.new(_xm, math.avg(_ep, _tpLvl), "TP " + str.tostring(_tpT) + "t · $" +
             str.tostring(math.abs(_tpLvl - _ep) * syminfo.pointvalue, "#"),
             style=label.style_none, textcolor=vPosTxt, size=size.small, textalign=text.align_center))
    float _lmfeT = (_wasLong ? nz(posHi, _xp) - nz(jEntryPx, _ep) : nz(jEntryPx, _ep) - nz(posLo, _xp)) / syminfo.mintick
    float _lmaeT = (_wasLong ? nz(jEntryPx, _ep) - nz(posLo, nz(jEntryPx, _ep)) : nz(posHi, nz(jEntryPx, _ep)) - nz(jEntryPx, _ep)) / syminfo.mintick
    array.push(drawHistL, label.new(_xm, _xp, text=(_win ? "+$" : "-$") + str.tostring(math.abs(_pf), "#.0") +
         "\nMFE " + str.tostring(math.max(_lmfeT, 0), "#") + "t · MAE " + str.tostring(math.max(_lmaeT, 0), "#") + "t",
         style=_wasLong == _win ? label.style_label_down : label.style_label_up,
         color=_win ? color.new(color.green, 20) : color.new(color.red, 20),
         textcolor=color.white, size=size.small, textalign=text.align_center))
    f_capDrawings()

if flatNow and nz(posSize[1]) != 0 and strategy.closedtrades > 0
    float _jxp  = strategy.closedtrades.exit_price(strategy.closedtrades - 1)
    float _jpnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    int   _jdir = nz(posSize[1]) > 0 ? 1 : -1
    f_journal("EXIT", _jdir, "CLOSED", float(na), float(na), _jxp, float(na), _jpnl, evalStarted, evalBal, distTarget, distFail, useRegime, regimeFav)
    float _xmfeT = (_jdir == 1 ? nz(posHi, _jxp) - nz(jEntryPx, _jxp) : nz(jEntryPx, _jxp) - nz(posLo, _jxp)) / syminfo.mintick
    float _xmaeT = (_jdir == 1 ? nz(jEntryPx, _jxp) - nz(posLo, nz(jEntryPx, _jxp)) : nz(posHi, nz(jEntryPx, _jxp)) - nz(jEntryPx, _jxp)) / syminfo.mintick
    bool _tpHit = not na(curLimit) and (_jdir == 1 ? _jxp >= curLimit - 2 * syminfo.mintick : _jxp <= curLimit + 2 * syminfo.mintick)
    string _xr = exitReasonNext != "" ? exitReasonNext : _tpHit ? "TP" : posRecovOn ? "RECOV-TRAIL" : posTrailOn ? "TRAIL" : posRiskOff ? "BE-STOP" : "SL"
    exitReasonNext := ""
    if notifyFills
        f_sendDiscord("📤 " + syminfo.ticker + " EXIT " + (_jpnl >= 0 ? "🟢" : "🔴"), jrnlAcct + " | " + (_jdir == 1 ? "long" : "short") + " closed @ " + str.tostring(_jxp, format.mintick) + " | " + _xr + " | PnL " + (_jpnl >= 0 ? "+$" : "-$") + str.tostring(math.abs(_jpnl), "#.##") + " | MFE " + str.tostring(_xmfeT, "#") + "t · MAE " + str.tostring(_xmaeT, "#") + "t")

if flatNow and not (newLong or newShort)
    posHi := na
    posLo := na
    curStop := na
    curLimit := na

if inLong and not newLong
    posHi := math.max(nz(posHi, close), high)
    posLo := math.min(nz(posLo, low), low)
if inShort and not newShort
    posHi := math.max(nz(posHi, high), high)
    posLo := math.min(nz(posLo, close), low)

if inLong
    float mfe = posHi - entryAvg
    float cand = curStop
    if useBEeff and mfe >= f_distPrice(beTrigEff)
        cand := math.max(cand, entryAvg + f_distPrice(beOffEff))
        if not posRiskOff
            posRiskOff := true
            if notifyRiskOff
                f_sendDiscord("🛡️ " + syminfo.ticker + " RISK OFF", jrnlAcct + " | " + "Long moved to break-even (+" + str.tostring(beOffsetSize) + "). Initial risk off the table." + f_evalTail(evalStarted, distTarget, distFail, jrnlAcct))
                f_journal("RISKOFF", 1, "BE", entryAvg, cand, curLimit, math.abs(posSize), float(na), evalStarted, evalBal, distTarget, distFail, useRegime, regimeFav)
    if useTrailEff and mfe >= f_distPrice(trStartEff)
        cand := math.max(cand, posHi - f_distPrice(trBufEff))
        if not posTrailOn
            posTrailOn := true
            if notifyRiskOff
                f_sendDiscord("🎯 " + syminfo.ticker + " TRAIL ACTIVE", jrnlAcct + " | " + "Long trail armed — stop now tracks the peak.")

    if useRecovTrail and isEval and attemptTradeNo == 1 and attemptFirstLoss and mfe >= f_distPrice(recovTrailStart)
        cand := math.max(cand, posHi - f_distPrice(recovTrailBuf))
        posRecovOn := true
    curStop := math.max(nz(curStop, cand), cand)
    string _xcL = "MFE" + str.tostring(mfe / syminfo.mintick, "#") + "t|MAE" + str.tostring(math.max(entryAvg - nz(posLo, entryAvg), 0) / syminfo.mintick, "#") + "t"
    strategy.exit("XL", from_entry="Long", stop=curStop, limit=curLimit, comment_profit="TP|" + _xcL, comment_loss=(posRecovOn ? "RECOV|" : posTrailOn ? "TRAIL|" : posRiskOff ? "BE|" : "SL|") + _xcL)
if inShort
    float mfe = entryAvg - posLo
    float cand = curStop
    if useBEeff and mfe >= f_distPrice(beTrigEff)
        cand := math.min(cand, entryAvg - f_distPrice(beOffEff))
        if not posRiskOff
            posRiskOff := true
            if notifyRiskOff
                f_sendDiscord("🛡️ " + syminfo.ticker + " RISK OFF", jrnlAcct + " | " + "Short moved to break-even (+" + str.tostring(beOffsetSize) + "). Initial risk off the table." + f_evalTail(evalStarted, distTarget, distFail, jrnlAcct))
                f_journal("RISKOFF", -1, "BE", entryAvg, cand, curLimit, math.abs(posSize), float(na), evalStarted, evalBal, distTarget, distFail, useRegime, regimeFav)
    if useTrailEff and mfe >= f_distPrice(trStartEff)
        cand := math.min(cand, posLo + f_distPrice(trBufEff))
        if not posTrailOn
            posTrailOn := true
            if notifyRiskOff
                f_sendDiscord("🎯 " + syminfo.ticker + " TRAIL ACTIVE", jrnlAcct + " | " + "Short trail armed — stop now tracks the peak.")

    if useRecovTrail and isEval and attemptTradeNo == 1 and attemptFirstLoss and mfe >= f_distPrice(recovTrailStart)
        cand := math.min(cand, posLo + f_distPrice(recovTrailBuf))
        posRecovOn := true
    curStop := math.min(nz(curStop, cand), cand)
    string _xcS = "MFE" + str.tostring(mfe / syminfo.mintick, "#") + "t|MAE" + str.tostring(math.max(nz(posHi, entryAvg) - entryAvg, 0) / syminfo.mintick, "#") + "t"
    strategy.exit("XS", from_entry="Short", stop=curStop, limit=curLimit, comment_profit="TP|" + _xcS, comment_loss=(posRecovOn ? "RECOV|" : posTrailOn ? "TRAIL|" : posRiskOff ? "BE|" : "SL|") + _xcS)

if barstate.isconfirmed and inFlatWindow and not flattenedToday
    flattenedToday := true
    if posSize != 0
        strategy.close_all(comment="Auto Flat")
        f_sendExec("close", t_qty, close, 0, 0, "MKT")
        exitReasonNext := "AUTO-FLAT"
    f_sendDiscord("🕔 " + syminfo.ticker + " AUTO FLAT", jrnlAcct + " | " + "Forced flat @ ~" + str.tostring(close, format.mintick))

var bool haltCloseSent = false
if isNewTradingDay
    haltCloseSent := false
if dayHalted and not haltCloseSent
    haltCloseSent := true
    strategy.cancel("Long")
    strategy.cancel("Short")
    pendDir := 0
    if posSize != 0
        strategy.close_all(comment=haltReason)
        f_sendExec("close", t_qty, close, 0, 0, "MKT")
    exitReasonNext := haltReason
    f_sendDiscord("🔒 " + syminfo.ticker + " DAY HALT", jrnlAcct + " | " + haltReason + " | Today: $" + str.tostring(runningPnL, "#.##"))
    if plainAlertsOK
        alert(f_msgHead() + " | 🔒 DAY HALT (" + haltReason + ") | PnL $" + str.tostring(runningPnL, "#.##"), alert.freq_once_per_bar)

var bool acctCloseSent = false
if acctHalted and not acctCloseSent
    acctCloseSent := true
    strategy.cancel("Long")
    strategy.cancel("Short")
    pendDir := 0
    if posSize != 0
        strategy.close_all(comment=acctHaltReason)
        f_sendExec("close", t_qty, close, 0, 0, "MKT")
    exitReasonNext := "ACCOUNT-HALT"
    f_sendDiscord("🏁 " + syminfo.ticker + " ACCOUNT HALT", jrnlAcct + " | " + acctHaltReason + " | acct PnL $" + str.tostring(acctRealized, "#"))
    if plainAlertsOK
        alert(f_msgHead() + " | 🏁 " + acctHaltReason + " | acct PnL $" + str.tostring(acctRealized, "#"), alert.freq_once_per_bar)

// ============================================================================
// === v5: REGIME INDICATOR ===================================================
// ============================================================================
var bool regimeInit = false
float erNet  = math.abs(close - close[regimeErLen])
float erPath = math.sum(math.abs(close - close[1]), regimeErLen)
float erVal  = erPath > 0 ? erNet / erPath : 0.0
float regThrUp = regimeErThr + regimeErHyst
float regThrDn = regimeErThr - regimeErHyst
bool  regimeWant = regimeFav ? (erVal > regThrDn) : (erVal > regThrUp)
var int regimeWantCnt = 0
if useRegime and barstate.isconfirmed
    if not regimeInit
        regimeFav := erVal > regimeErThr
        regimeInit := true
    else if regimeWant != regimeFav
        regimeWantCnt := regimeWantCnt + 1
        if regimeWantCnt >= regimeMinHold
            regimeFav := regimeWant
            regimeWantCnt := 0
            if notifyRegime
                if regimeFav
                    f_sendDiscord("🟢📈 " + syminfo.ticker + " REGIME → FAVORABLE", jrnlAcct + " | " + "ER " + str.tostring(erVal, "#.00") + " > " + str.tostring(regThrUp, "#.00") + ". Trending — historically friendlier conditions. ⚠️ indication, not a guarantee.")
                else
                    f_sendDiscord("🔴📉 " + syminfo.ticker + " REGIME → UNFAVORABLE", jrnlAcct + " | " + "ER " + str.tostring(erVal, "#.00") + " ≤ " + str.tostring(regThrDn, "#.00") + ". Chop — be conservative with new accounts. ⚠️ indication, not a guarantee.")
    else
        regimeWantCnt := 0

// ============================================================================
// === v5: EVAL / PA TRACKING =================================================
// ============================================================================
var float evalPeak      = na
var float evalEodPeak   = na
var float evalFloor     = na
var bool  evalPassed    = false
var bool  evalFailed    = false
var bool  paReached     = false

bool evalAtStart = evalTrack and not evalStarted and time >= evalStartTime
if evalAtStart
    evalStarted   := true
    evalPeak      := evalStartBal
    evalEodPeak   := evalStartBal
    evalFloor     := evalTrailDD > 0 ? evalStartBal - evalTrailDD : na

var float evalClosedPnL = 0.0
var int   evalLastCount = 0
if evalStarted and strategy.closedtrades > evalLastCount
    for i = evalLastCount to strategy.closedtrades - 1
        float _xt = strategy.closedtrades.exit_time(i)
        if _xt >= evalStartTime and (not evalUseEnd or _xt <= evalEndTime)
            evalClosedPnL := evalClosedPnL + strategy.closedtrades.profit(i)
    evalLastCount := strategy.closedtrades

float evalOpenPnL = (evalStarted and strategy.position_size != 0 and strategy.opentrades > 0 and strategy.opentrades.entry_time(0) >= evalStartTime) ? strategy.openprofit : 0.0

evalBal := evalStarted ? evalStartBal + evalClosedPnL + evalOpenPnL : na

float evalGain = evalStarted ? evalClosedPnL + evalOpenPnL : na

distTarget := (evalStarted and evalProfitTgt > 0) ? evalProfitTgt - evalGain : na
distFail   := (evalStarted and evalTrailDD > 0 and not na(evalFloor)) ? evalBal - evalFloor : na

if evalTrack and evalStarted and not evalPassed and not evalFailed
    evalPeak := math.max(nz(evalPeak, evalStartBal), evalBal)
    if evalTrailDD > 0 and not evalTrailEod
        evalFloor := math.max(nz(evalFloor, evalStartBal - evalTrailDD), evalPeak - evalTrailDD)
    if evalTrailDD > 0 and evalTrailEod and isNewTradingDay
        evalEodPeak := math.max(nz(evalEodPeak, evalStartBal), evalBal)
        evalFloor := math.max(nz(evalFloor, evalStartBal - evalTrailDD), evalEodPeak - evalTrailDD)
    if evalProfitTgt > 0 and evalGain >= evalProfitTgt
        evalPassed := true
        attemptTradeNo := 0
        attemptFirstLoss := false
        if notifyEval
            f_sendDiscord("🎉🏆 " + syminfo.ticker + " PASSED", jrnlAcct + " | " + "Profit target reached! Gain $" + str.tostring(evalGain, "#") + " ≥ $" + str.tostring(evalProfitTgt, "#") + " (balance $" + str.tostring(evalBal, "#") + "). Account funded! 🚀")
    if not evalPassed and evalTrailDD > 0 and not na(evalFloor) and evalBal <= evalFloor
        evalFailed := true
        attemptTradeNo := 0
        attemptFirstLoss := false
        if notifyEval
            f_sendDiscord("💀 " + syminfo.ticker + " FAILED", jrnlAcct + " | " + "Trailing drawdown hit. Balance $" + str.tostring(evalBal, "#") + " ≤ floor $" + str.tostring(evalFloor, "#") + ". Account blown. 🪦")
    if not paReached and evalPaThresh > 0 and evalGain >= evalPaThresh
        paReached := true
        if notifyEval
            f_sendDiscord("💰✨ " + syminfo.ticker + " PA THRESHOLD", jrnlAcct + " | " + "Payout threshold reached! Gain $" + str.tostring(evalGain, "#") + " ≥ $" + str.tostring(evalPaThresh, "#") + " (balance $" + str.tostring(evalBal, "#") + "). 🤑")


plotshape(showSignals and longSignal, "Long Signal", shape.triangleup, location.belowbar, color=color.new(color.green, 0), size=size.small)
plotshape(showSignals and shortSignal, "Short Signal", shape.triangledown, location.abovebar, color=color.new(color.red, 0), size=size.small)
bool pendingActive = isFlat and pendDir != 0
plot(showPending and pendingActive ? pendLimit : na, "Pending Limit", color=color.new(color.orange, 0), style=plot.style_circles, linewidth=2)
plot(showPending and pendingActive ? pendStop : na, "Planned Stop", color=color.new(color.red, 50), style=plot.style_circles, linewidth=1)
plot(showTradeLevels and not flatNow ? curStop : na, "Active Stop", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)
plot(showTradeLevels and not flatNow ? curLimit : na, "Take Profit", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)
plot(showTradeLevels and not flatNow ? entryAvg : na, "Entry", color=color.new(color.blue, 0), style=plot.style_linebr, linewidth=1)
plot(vwapVal, "VWAP", color=color.new(color.purple, 40), linewidth=1)
// === v6.0: FULL-LOGIC GATE VISUALISATION ====================================
bool gateLongOpen  = canTrade and bullCvdPass and sigLongOK and canLong  and vetoLongOK  and sweepLongOK
bool gateShortOpen = canTrade and bearCvdPass and sigShortOK and canShort and vetoShortOK and sweepShortOK
color _gateAmber = visIsDark ? #C9A227 : #8F6400
int _flashT = math.max(70, gateBgTransp - 8)
color gateBgCol = sigBlockedEvt ? color.new(_gateAmber, _flashT) :
     gateLongOpen and gateShortOpen ? color.new(_gateAmber, gateBgTransp) :
     gateLongOpen ? color.new(vPOS, gateBgTransp) :
     gateShortOpen ? color.new(vNEG, gateBgTransp) : na
bgcolor(showGateBg ? gateBgCol : na, title="Trade Gate open")
bgcolor(showTimeGateBg and timeGatePass and not inFlatWindow ? color.new(vText, 95) : na, title="TimeGate open")
bgcolor(showFiltersBg and (sigLongOK or sigShortOK) ? color.new(#2F80ED, 94) : na, title="Filters valid")
// === ACCOUNT-EVENT MARKERS ==================================================
// Chart markers only. Each event is drawn once, on the bar where the state flips;
// the halt/payout logic itself lives in the account layer above and is untouched.
f_evtLabel(string _txt, color _col) =>
    array.push(drawHistL, label.new(bar_index, high, _txt, style=label.style_label_down,
         color=_col, textcolor=color.white, size=size.small, textalign=text.align_left))
    f_capDrawings()
bool _haltEdge = dayHalted and not dayHalted[1]
if inDrawWin and barstate.isconfirmed
    if lblDll and _haltEdge and (haltReason == "PA Daily Loss Limit" or haltReason == "Risk-gate DLL" or haltReason == "Daily Loss")
        f_evtLabel("⛔ DLL · " + haltReason + " $" + str.tostring(runningPnL, "#"), color.new(vNEG, 20))
    if lblDayCap and _haltEdge and (haltReason == "Day-cap" or haltReason == "Day-trail" or haltReason == "Daily Target")
        f_evtLabel("🎯 Day cap · " + haltReason + " $" + str.tostring(riskDayPeak, "#"), color.new(vPOS, 20))
    if lblPayout and payoutReady and not payoutReady[1]
        f_evtLabel("💰 Payout P" + str.tostring(effPayoutNr) + " ready · $" + str.tostring(withdrawable, "#") + "/$" + str.tostring(curLadderCap, "#"), color.new(color.olive, 20))
    if lblBreach and acctHalted and not acctHalted[1]
        f_evtLabel("🏁 Account breached · " + acctHaltReason, color.new(color.maroon, 10))
    if lblTrail and ((rgTrailArmed and not rgTrailArmed[1]) or (dayTrailArmed and not dayTrailArmed[1]))
        f_evtLabel("🪤 Trail armed · exit $" + str.tostring(nz(rgExitLvl, riskDayPeak - dayTrailGivebackEff), "#"), color.new(color.teal, 20))
// === v5.5: TRADE-ZONES (licht gevulde entry<->SL en entry<->TP banden) ======
if (newLong or newShort)
    if showTradeZones and inDrawWin
        zoneRisk := box.new(bar_index, math.max(entryAvg, curStop), bar_index, math.min(entryAvg, curStop), border_width=0, bgcolor=zRiskBg)
        zoneReward := box.new(bar_index, math.max(entryAvg, curLimit), bar_index, math.min(entryAvg, curLimit), border_width=0, bgcolor=zRewardBg)
    if showTradeLabels and inDrawWin
        tradeInfo := label.new(bar_index + 2, entryAvg, "", style=label.style_none, textcolor=vText, size=size.small, textalign=text.align_left)
        array.push(drawHistL, tradeInfo)
if not flatNow and posSize != 0
    if showTradeZones and not na(zoneRisk)
        box.set_right(zoneRisk, bar_index)
        box.set_top(zoneRisk, math.max(entryAvg, curStop))
        box.set_bottom(zoneRisk, math.min(entryAvg, curStop))
        box.set_right(zoneReward, bar_index)
    if showTradeLabels and not na(tradeInfo)
        int _slT = math.round(math.abs(entryAvg - curStop) / syminfo.mintick)
        float _riskUsd = math.abs(entryAvg - curStop) * syminfo.pointvalue * math.abs(posSize)
        float _rr = math.abs(entryAvg - curStop) > syminfo.mintick / 2 ? math.abs(curLimit - entryAvg) / math.abs(entryAvg - curStop) : na
        label.set_xy(tradeInfo, bar_index + 2, entryAvg)
        label.set_textcolor(tradeInfo, vText)
        label.set_text(tradeInfo,
             (posSize > 0 ? "▲ LONG " : "▼ SHORT ") + str.tostring(math.abs(posSize), "#") + "ct @ " + str.tostring(entryAvg, format.mintick) +
             "\nSL " + str.tostring(curStop, format.mintick) + " · " + str.tostring(_slT) + "t · $" + str.tostring(_riskUsd, "#") +
             "\nTP " + str.tostring(curLimit, format.mintick) + (na(_rr) ? "" : " · " + str.tostring(_rr, "#.#") + "R"))

// ============================================================================
// === DASHBOARD ==============================================================
// ============================================================================
txtColor = vText
hdrTxt = visIsDark ? color.rgb(219,137,43) : #8A5A00
hdrBg  = visIsDark ? color.rgb(33,63,100,70) : color.new(#DCE4F2, 20)
dashBg = visIsDark ? color.rgb(40,59,83,70) : color.new(#F0F3FA, 15)
f_valCol(_x) => _x > 0 ? vPosTxt : _x < 0 ? vNegTxt : txtColor
dashPosition = dashPos == "Top Right" ? position.top_right : dashPos == "Top Left" ? position.top_left : dashPos == "Bottom Right" ? position.bottom_right : position.bottom_left
var table dash = table.new(dashPosition, 4, 8, bgcolor=dashBg, border_color=color.new(color.gray,100), border_width=1)
if showDashboard and barstate.islast
    trades = strategy.wintrades + strategy.losstrades
    wr = trades > 0 ? strategy.wintrades * 100.0 / trades : na
    pf = math.abs(strategy.grossloss) > 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na
    if dashLayout == "Wide (4 columns)"
        table.cell(dash, 0, 0, jrnlAcct, text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize,
             tooltip="Composed account name (same logic as the CSV journal): first 2 letters + last 3 digits of the Account ID, start balance in k, start date. This is the name used in journal rows, message headers and CONFIG lines.")
        table.cell(dash, 1, 0, "Net " + str.tostring(strategy.netprofit, format.mintick), text_color=f_valCol(strategy.netprofit), text_size=txtSize)
        table.cell(dash, 2, 0, "PF " + (na(pf) ? "—" : str.tostring(pf, "#.00")), text_color=txtColor, text_size=txtSize)
        table.cell(dash, 3, 0, "MaxDD " + str.tostring(strategy.max_drawdown, format.mintick), text_color=txtColor, text_size=txtSize)
        table.cell(dash, 0, 1, "Trades " + str.tostring(trades), text_color=txtColor, text_size=txtSize)
        table.cell(dash, 1, 1, "WR " + (na(wr) ? "—" : str.tostring(wr, "#.0") + "%"), text_color=txtColor, text_size=txtSize)
        table.cell(dash, 2, 1, "Entry: " + (isLimitMode ? "Limit50" : "Market") + " · TP: " + tpMode, text_color=txtColor, text_size=txtSize)
        table.cell(dash, 3, 1, "Stop: " + stopMode, text_color=txtColor, text_size=txtSize)
        table.cell(dash, 0, 2, isPA and paBacktestModeEff ? "PAYOUTS" : "TODAY", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 2, isPA and paBacktestModeEff ? "💰 cum $" + str.tostring(paTotalBanked, "#") : "PnL " + str.tostring(todayRealizedPnL, "#.0"), text_color=isPA and paBacktestModeEff ? vPosTxt : f_valCol(todayRealizedPnL), text_size=txtSize)
        table.cell(dash, 2, 2, dayExitMode != "Off" and riskDayPeak > 0 ? "pk $" + str.tostring(riskDayPeak, "#") + (_dexTrailOn ? " A" + str.tostring(dayTrailModel == "Legacy: activation = giveback" ? dayTrailUSDEff : dayTrailActivationUSDEff, "#") + "/G" + str.tostring(dayTrailGivebackEff, "#") : "") : isPA and paBacktestModeEff ? "cyc " + str.tostring(paPayoutsThisCycle) + "/6" : "DD " + str.tostring(todayDD, "#.0"), text_color=txtColor, text_size=txtSize)
        table.cell(dash, 3, 2, dayHalted ? "🔒 " + haltReason : "✅ Trading", text_color=dayHalted ? vNegTxt : vPosTxt, text_size=txtSize)
        table.cell(dash, 0, 3, "ORDER/POS", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 3, inLong ? "🟢 LONG" : inShort ? "🔴 SHORT" : pendingActive ? "🟠 PENDING " + (pendDir==1?"L":"S") : "⚪ FLAT", text_color=txtColor, text_size=txtSize)
        table.cell(dash, 2, 3, pendingActive ? "Lim " + str.tostring(pendLimit, format.mintick) : "P/L " + str.tostring(strategy.openprofit, "#.0"), text_color=txtColor, text_size=txtSize)
        table.cell(dash, 3, 3, flatNow and not pendingActive ? "—" : "SL " + str.tostring(flatNow ? pendStop : curStop, format.mintick), text_color=txtColor, text_size=txtSize)
        table.cell(dash, 0, 4, "CONTEXT", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 4, "Bias " + (bias == 1 ? "📈" : bias == -1 ? "📉" : "⚪") + " " + phase, text_color=txtColor, text_size=txtSize)
        table.cell(dash, 2, 4, "VWAP " + (close > vwapVal ? "above" : "below") + (useVwapVeto ? " (veto)" : ""), text_color=txtColor, text_size=txtSize)
        string _gateTxt = inFlatWindow ? "⛔ Flat window" : timeGatePass ? "🟢 Gate open" : "⚪ Gate closed"
        table.cell(dash, 3, 4, _gateTxt, text_color=txtColor, text_size=txtSize)
        if phaseOn
            table.cell(dash, 0, 5, accountPhase, text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
            table.cell(dash, 1, 5, isPA and paBacktestModeEff ? "🧪 BT: " + str.tostring(paMilkCount) + "×melk · " + str.tostring(paBreachCount) + "×breach · $" + str.tostring(paTotalBanked, "#") : acctHalted ? "🏁 " + acctHaltReason : "DD room $" + str.tostring(ddRoom, "#"), text_color=acctHalted ? hdrTxt : ddRoom < acctTrailDD*0.25 ? vNegTxt : txtColor, text_size=txtSize)
            table.cell(dash, 2, 5, acctLocked ? "🔓 Locked (+$100)" : "Floor " + str.tostring(acctFloor, "#"), text_color=txtColor, text_size=txtSize)
            string _payTxt = isEval ? "Goal $" + str.tostring(math.max(acctGoal - acctRealized, 0), "#") + " to go" : payoutReady ? "💰 P" + str.tostring(effPayoutNr) + " CAP $" + str.tostring(curLadderCap, "#") + " ✓" : payoutEligible and useWaitForCap ? "⏳ P" + str.tostring(effPayoutNr) + " $" + str.tostring(withdrawable, "#") + "/$" + str.tostring(curLadderCap, "#") : "Qual " + str.tostring(qualDays) + "/5 · Cons " + (profitSince > 0 ? str.tostring(100*bestDaySince/profitSince, "#") + "%" : "—")
            table.cell(dash, 3, 5, _payTxt,
                 text_color=payoutReady ? color.lime : (payoutEligible and useWaitForCap ? color.orange : txtColor), text_size=txtSize)

        table.cell(dash, 0, 6, "REGIME / EVAL", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 6, not useRegime ? "Regime —" : regimeFav ? "🟢 FAVORABLE" : "🔴 UNFAVORABLE",
             text_color=not useRegime ? txtColor : regimeFav ? color.lime : color.red, text_size=txtSize)
        table.cell(dash, 2, 6, useRegime ? "ER " + str.tostring(erVal, "#.00") : "",
             text_color=txtColor, text_size=txtSize)
        table.cell(dash, 0, 7, "GATE", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 7, gateLongOpen and gateShortOpen ? "🟡 BOTH open" : gateLongOpen ? "🟢 LONG open" : gateShortOpen ? "🔴 SHORT open" : "⚪ Closed", text_color=txtColor, text_size=txtSize)
        table.cell(dash, 2, 7, str.length(persistBlk) > 0 ? "⛔ " + str.substring(persistBlk, 0, str.length(persistBlk) - 2) : "No blockers", text_color=str.length(persistBlk) > 0 ? vNegTxt : txtColor, text_size=txtSize)
        table.cell(dash, 3, 7, "Last blocked: " + lastBlockedInfo, text_color=txtColor, text_size=txtSize)
        table.cell(dash, 3, 6, not evalTrack ? "Eval —" :
             not evalStarted ? "⏳ start " + str.tostring(dayofmonth(evalStartTime, activeTz)) + "-" + str.tostring(month(evalStartTime, activeTz)) :
             evalPassed ? "🏆 PASSED" : evalFailed ? "💀 FAILED" :
             "→T $" + str.tostring(distTarget, "#") + " · →F $" + str.tostring(distFail, "#"),
             text_color=evalPassed ? color.lime : evalFailed ? color.red :
                  (not evalStarted ? txtColor : not na(distFail) and distFail < evalTrailDD*0.25 ? color.red :
                   not na(distFail) and distFail < evalTrailDD*0.5 ? color.orange : color.lime),
             text_size=txtSize)
    else
        string cPerf = "Net " + str.tostring(strategy.netprofit, format.mintick) + " · PF " + (na(pf) ? "—" : str.tostring(pf, "#.00")) +
             "\nTrades " + str.tostring(trades) + " · WR " + (na(wr) ? "—" : str.tostring(wr, "#.0") + "%") +
             "\nMaxDD " + str.tostring(strategy.max_drawdown, format.mintick)
        table.cell(dash, 0, 0, jrnlAcct, text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize,
             tooltip="Composed account name (same logic as the CSV journal). Compact layout: values stacked per cell for phone screens.")
        table.cell(dash, 1, 0, cPerf, text_color=f_valCol(strategy.netprofit), text_size=txtSize, text_halign=text.align_left)
        string cToday = (isPA and paBacktestModeEff ? "💰 cum $" + str.tostring(paTotalBanked, "#") + " · cyc " + str.tostring(paPayoutsThisCycle) + "/6" : "PnL " + str.tostring(todayRealizedPnL, "#.0") + " · DD " + str.tostring(todayDD, "#.0")) +
             "\n" + (isPA and paBacktestModeEff ? "🧪 " + str.tostring(paMilkCount) + "×melk · " + str.tostring(paBreachCount) + "×br" : dayHalted ? "🔒 " + haltReason : "✅ Trading")
        table.cell(dash, 0, 1, isPA and paBacktestModeEff ? "PAYOUTS" : "TODAY", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 1, cToday, text_color=isPA and paBacktestModeEff ? vPosTxt : f_valCol(todayRealizedPnL), text_size=txtSize, text_halign=text.align_left)
        string cPos = (inLong ? "🟢 LONG" : inShort ? "🔴 SHORT" : pendingActive ? "🟠 PENDING " + (pendDir == 1 ? "L" : "S") : "⚪ FLAT") +
             "\n" + (pendingActive ? "Lim " + str.tostring(pendLimit, format.mintick) : "P/L " + str.tostring(strategy.openprofit, "#.0")) +
             (flatNow and not pendingActive ? "" : "\nSL " + str.tostring(flatNow ? pendStop : curStop, format.mintick))
        table.cell(dash, 0, 2, "POS", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 2, cPos, text_color=txtColor, text_size=txtSize, text_halign=text.align_left)
        string cCtx = "Bias " + (bias == 1 ? "📈" : bias == -1 ? "📉" : "⚪") + " " + phase +
             "\nVWAP " + (close > vwapVal ? "above" : "below") + (useVwapVeto ? " (veto)" : "") +
             "\n" + (inFlatWindow ? "⛔ Flat window" : timeGatePass ? "🟢 Gate open" : "⚪ Gate closed")
        table.cell(dash, 0, 3, "CTX", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 3, cCtx, text_color=txtColor, text_size=txtSize, text_halign=text.align_left)
        if phaseOn
            string cPhase = (isPA and paBacktestModeEff ? "🧪 " + str.tostring(paMilkCount) + "×melk·" + str.tostring(paBreachCount) + "×br·$" + str.tostring(paTotalBanked, "#") : acctHalted ? "🏁 " + acctHaltReason : "DD room $" + str.tostring(ddRoom, "#")) +
                 "\n" + (acctLocked ? "🔓 Locked (+$100)" : "Floor " + str.tostring(acctFloor, "#")) +
                 "\n" + (isEval ? "Goal $" + str.tostring(math.max(acctGoal - acctRealized, 0), "#") + " to go" :
                 payoutReady ? "💰 P" + str.tostring(effPayoutNr) + " CAP $" + str.tostring(curLadderCap, "#") + " ✓" : payoutEligible and useWaitForCap ? "⏳ $" + str.tostring(withdrawable, "#") + "/$" + str.tostring(curLadderCap, "#") : "Qual " + str.tostring(qualDays) + "/5 · Cons " + (profitSince > 0 ? str.tostring(100 * bestDaySince / profitSince, "#") + "%" : "—"))
            table.cell(dash, 0, 4, accountPhase, text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
            table.cell(dash, 1, 4, cPhase, text_color=payoutReady ? color.lime : acctHalted ? hdrTxt : ddRoom < acctTrailDD * 0.25 ? vNegTxt : txtColor, text_size=txtSize, text_halign=text.align_left)
        string cEvalLn = not evalTrack ? "Eval —" :
             not evalStarted ? "⏳ start " + str.tostring(dayofmonth(evalStartTime, activeTz)) + "-" + str.tostring(month(evalStartTime, activeTz)) :
             evalPassed ? "🏆 PASSED" : evalFailed ? "💀 FAILED" :
             "→T $" + str.tostring(distTarget, "#") + " · →F $" + str.tostring(distFail, "#")
        string cReg = (not useRegime ? "Regime —" : (regimeFav ? "🟢 FAVORABLE" : "🔴 UNFAVORABLE") + " · ER " + str.tostring(erVal, "#.00")) +
             "\n" + cEvalLn
        table.cell(dash, 0, 5, "REG/EVAL", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 5, cReg, text_color=not useRegime ? txtColor : regimeFav ? color.lime : color.red, text_size=txtSize, text_halign=text.align_left)
        string cGate = (gateLongOpen and gateShortOpen ? "🟡 BOTH open" : gateLongOpen ? "🟢 LONG open" : gateShortOpen ? "🔴 SHORT open" : "⚪ Closed") +
             "\n" + (str.length(persistBlk) > 0 ? "⛔ " + str.substring(persistBlk, 0, str.length(persistBlk) - 2) : "No blockers") +
             "\nLast: " + lastBlockedInfo
        table.cell(dash, 0, 6, "GATE", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 6, cGate, text_color=str.length(persistBlk) > 0 ? vNegTxt : txtColor, text_size=txtSize, text_halign=text.align_left)
