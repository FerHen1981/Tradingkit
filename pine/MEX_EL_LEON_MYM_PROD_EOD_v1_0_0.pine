//@version=6
// FULL BUILD: original execution/alerts/account layers retained. PRODUCTION Liquidity-Core defaults mirror the calibrated simulator.
// v6.8.14 (optimised): memory-safe visuals (drawLast) + recovery-trail A1 fix + FX tick-volume delta note.
// v2.1.0 (25-08, review Ferry): visuals herbouwd. Groep 12 VISUALS - Strategy draagt nu
//   dashboard + Signals/TP-SL Levels/Order Levels/Unfilled Orders + trade labels met
//   Params, PnL/MFE/MAE en vijf account-eventmarkers (DLL, day cap, payout, breach, trail).
//   Groep 13 VISUALS - Indicators is teruggebracht tot twee FVG-dropdowns (Filled/Unfilled/
//   Both, In range/All) en drie achtergrondlagen (Filters valid, TimeGate open, Trade Gate
//   open). Kleuren, Max Boxes, draw-last en gate-transparantie zijn constanten geworden.
//   Hersteld: de long-entry driehoek ontbrak in de HELE v1_0_0-vloot - "Show Signals"
//   plotte alleen shorts. Alles in deze release is tekenwerk; geen signaal- of accountlogica.
// v2.2.0 (25-08): paneelnummering aaneengesloten 0-13 conform INPUT_SPEC_v2. Reference
//   Timezone en Trading Boundary kregen hun eigen groep (1 en 2), Alerts 11->10, Visuals
//   Strategy 12->11, Visuals Indicators 13->12, Developer 14->13. Het TIME GATE-blok en de
//   visuals-inputs zijn fysiek verplaatst zodat de paneelvolgorde numeriek loopt; alleen
//   declaratievolgorde van inputs, geen enkele berekening verplaatst.
// v2.3.0 (25-08, D-41): elke Discord-kaart draagt nu het account vooraan in de description,
//   zodat de per-kanaal routing van D-28/2 funded en eval uit elkaar kan houden. Het waren er
//   19 per script, niet de elf uit de melding: RISK OFF, TRAIL ACTIVE, REGIME en de entries
//   hadden hetzelfde gat. De receiver leest de eerste kolom en herkent alleen LLddd- (zoals
//   PA016-0k-260813); wijkt jrnlAcct af, dan viel de routing STIL terug op de globale webhook.
//   Daarom staat er nu ook een zichtbare waarschuwing op de laatste bar als het account leeg
//   of afwijkend is. Alleen berichtinhoud; geen signaal-, order- of accountlogica geraakt.
// v2.3.1 (25-08): f_firmRules komt weer uit data/propfirms.json in plaats van uit de hand
//   (D-65/D-08). Mogelijk gemaakt door het besluit van Ferry: Apex 4.0 = $2.000 trailing
//   drawdown, legacy = $2.500. De registry droeg 2.500 op ALLE Apex 50K-programma's, ook de
//   vier 4.0-programma's waar deze vloot op draait; die staan nu op 2.000 met lock 2.100.
//   Voor de twee presets die de vloot gebruikt verandert er niets - die stonden al op 2.000.
//   Wel nieuw in de dropdown: de vier legacy-programma's. Consistency op eval-programma's
//   gaat van 50 naar 0: dat is een PA-regel, een eval heeft hem niet, en in dit script komt
//   consistencyPct alleen binnen via payoutEligible dat isPA eist - dus zonder gevolg.
// v6.8.15: auto-guard the delta filter on non-futures assets (forex/CFD/spot).
// v6.8.16: inputs restructured + firm-preset dropdown (futures).
// v6.9.0: roll/OpEx/news factory — selectable event-regime filters (preset per strategy · account-type · phase).
// v6.9.1: "→ Middleware" route — emits a lean signal to the fan-out middleware (one alert per strategy).
// v6.9.13 MES scratch Production: 6 MES · FVG10-22t · proxy-CVD6 · SL120t · 1.75R · expiry6 · all sessions · daily OFF · EOD PA.
// Research parity rule: canonical CVD is deterministic OHLCV polarity, NOT ta.requestVolumeDelta().
var string SCRIPT_NAME = "MΞX EL LEON · MYM PROD EOD"
var string currentVersion = "v2.3.1"
strategy("MΞX EL LEON · MYM PROD EOD · " + currentVersion, shorttitle="LEO-MYM-P", overlay=true,
     initial_capital=50000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     calc_on_every_tick=false,
     calc_on_order_fills=true,
     process_orders_on_close=false,
     use_bar_magnifier=true,
     max_bars_back=500,
     max_boxes_count=500, max_labels_count=500,
     margin_long=0, margin_short=0,
     slippage=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.37)

import TradingView/ta/8

// === GROUPS ==================================================================
var string GROUP_UNIT  = "4 · TRADE — Position sizing"
var string GROUP_ENTRY = "5 · TRADE — Entry & stop"
var string GROUP_RISK  = "6 · TRADE — Management"
var string GROUP_RG    = "8 · ACCOUNT — Guard: daily risk-gate"
var string GROUP_PHASE = "8 · ACCOUNT — Guard"
var string GROUP_BIAS  = "9 · SIGNAL — Filters"
var string GROUP_SIG   = "9 · SIGNAL — Filters"
var string GROUP_CVD   = "9 · SIGNAL — Filters"
var string GROUP_FVG   = "9 · SIGNAL — Filters"
var string GROUP_TIME  = "3 · TIME GATE"
var string GROUP_TZ    = "1 · TIME — Reference timezone"
var string GROUP_BND   = "2 · TIME — Trading boundary"
var string GROUP_VIS   = "12 · VISUALS — Indicators"
var string GROUP_DASH  = "11 · VISUALS — Strategy"
var string GROUP_EXEC  = "10 · SIGNAL — Alerts"
var string GROUP_ALRT  = GROUP_EXEC
var string GROUP_MREG  = "3 · TIME GATE"

// === MEX STABILITY PRESET (additive; all legacy/live layers remain intact) =====
// stability-preset verwijderd 25-08. Hij stond op Manual, dus deze drie waarden vielen al
// door naar de gewone inputs -- de gecompileerde beslissing is identiek.

// Regime-factory identity for THIS script (strategy · account-type · phase). The "Auto" preset resolves to this.

// === TIMEZONE / DAY ==========================================================
var string GROUP_ACCT = "0 · ACCOUNT — Identity"

// === v6.8: retired features — hard-disabled (inputs removed; engine paths inert) =========
bool   useRelVolFilter= false
bool   useOrBreakout  = false
bool   orOneSetup     = true
int    orStartMin     = 570
int    orEndMin       = 630
string orBreakoutUnit = "Points"
float  orBreakoutT    = 10.0
bool   useRegime      = false
int    regimeErLen    = 30
int    regimeMinHold  = 15
float  regimeErThr    = 0.25
float  regimeErHyst   = 0.05
bool   gateOpenOnRiskOff = true
bool   startNeedRegime   = false
float  evalPaThresh   = 0.0
bool   guardEval      = false
bool   guardPA        = false
bool   useGoalTp      = false
bool   useDerisk      = false
bool   useDeriskPA    = false
float  deriskLvl1     = 67.0
float  deriskLvl2     = 90.0
float  deriskPaLvl    = 75.0
int    deriskQty1     = 3
int    deriskQty2     = 1
int    deriskPaQty    = 1
string exitPreset     = "Custom"

accountID = input.string("", "PMT/Tradovate Account ID", group=GROUP_ACCT,
     tooltip="PMT/Tradovate account ID. Declared first on purpose: it is the FIRST value in the alert name/prefill, so every alert in the TradingView sidebar starts with the account it belongs to. Also feeds the automatic journal account name (first 2 letters + last 3 digits).")

input_tz = input.string("America/New_York", "Reference Timezone",
     options=["Pacific/Honolulu","America/Anchorage","America/Los_Angeles","America/Denver","America/Chicago","America/New_York","America/Sao_Paulo","Etc/UTC","Europe/London","Europe/Berlin","Europe/Amsterdam","Europe/Athens","Europe/Moscow","Asia/Dubai","Asia/Karachi","Asia/Dhaka","Asia/Bangkok","Asia/Singapore","Asia/Tokyo","Australia/Sydney","Pacific/Auckland"],
     group=GROUP_TZ, tooltip="Timezone for the time gate, flat window and day boundary. Keep America/New_York — all", display=display.none)
string activeTz = input_tz
dayBoundaryMode = input.string("Exchange session (ETH)", "Trading day boundary",
     options=["Exchange session (ETH)","Regular hours (RTH)","Calendar day (timezone)"], group=GROUP_BND, tooltip="Where the trading day rolls over. Exchange session (default) = 18:00 ET futures session open, matching Apex and the research engine. Calendar day: midnight in the reference timezone.", display=display.none)

f_getHour()     => hour(time, activeTz)
f_getMinute()   => minute(time, activeTz)
f_minuteOfDay() => f_getHour() * 60 + f_getMinute()
f_calDayId()    => year(time, activeTz) * 10000 + month(time, activeTz) * 100 + dayofmonth(time, activeTz)
var int prevCalDayId = na
bool newCalDay = na(prevCalDayId) or f_calDayId() != prevCalDayId
prevCalDayId := f_calDayId()
// RTH rolt op de cash-open (09:30), ETH op de futures-sessie. Dit bepaalt WAAR de dag
// omslaat -- waar de sessie-P&L, de dagteller en de halt resetten -- niet welke bars je
// mag handelen. Entry-filtering op RTH/ETH is bewust een aparte vraag.
int  _dayMod  = f_minuteOfDay()
bool _rthRoll = _dayMod >= 570 and nz(_dayMod[1], _dayMod) < 570
bool isNewTradingDay = barstate.isfirst or (dayBoundaryMode == "Regular hours (RTH)" ? _rthRoll : dayBoundaryMode == "Calendar day (timezone)" ? newCalDay : timeframe.change("1D"))

// === TIME GATE (alleen Manual; in-sample modes verwijderd) ===================
tradeSunday    = input.bool(true, "Sun", inline="wd", group=GROUP_TIME, display=display.none)
tradeMonday    = input.bool(true,  "Mon", inline="wd", group=GROUP_TIME, display=display.none)
tradeTuesday   = input.bool(true,  "Tue", inline="wd", group=GROUP_TIME, display=display.none)
tradeWednesday = input.bool(true,  "Wed", inline="wd", group=GROUP_TIME, display=display.none)
tradeThursday  = input.bool(true,  "Thu", inline="wd", group=GROUP_TIME, display=display.none)
tradeFriday    = input.bool(true,  "Fri", inline="wd", group=GROUP_TIME, display=display.none)
tradeSaturday  = input.bool(false, "Sat (crypto)", inline="wd", group=GROUP_TIME, tooltip="Weekday toggles for the time gate. The Monday 00:00-02:00 filter below is separate and day-specific.", display=display.none)
timeHour00 = input.bool(true, "00", inline="h0", group=GROUP_TIME), timeHour01 = input.bool(true, "01", inline="h0", group=GROUP_TIME), timeHour02 = input.bool(true, "02", inline="h0", group=GROUP_TIME), timeHour03 = input.bool(true, "03", inline="h0", group=GROUP_TIME), timeHour04 = input.bool(true, "04", inline="h0", group=GROUP_TIME), timeHour05 = input.bool(true, "05", inline="h0", group=GROUP_TIME, tooltip="00.", display=display.none)
timeHour06 = input.bool(true, "06", inline="h1", group=GROUP_TIME), timeHour07 = input.bool(true, "07", inline="h1", group=GROUP_TIME), timeHour08 = input.bool(true, "08", inline="h1", group=GROUP_TIME), timeHour09 = input.bool(true, "09", inline="h1", group=GROUP_TIME), timeHour10 = input.bool(true, "10", inline="h1", group=GROUP_TIME), timeHour11 = input.bool(true, "11", inline="h1", group=GROUP_TIME, tooltip="06.", display=display.none)
timeHour12 = input.bool(true, "12", inline="h2", group=GROUP_TIME), timeHour13 = input.bool(true, "13", inline="h2", group=GROUP_TIME), timeHour14 = input.bool(true, "14", inline="h2", group=GROUP_TIME), timeHour15 = input.bool(true, "15", inline="h2", group=GROUP_TIME), timeHour16 = input.bool(true, "16", inline="h2", group=GROUP_TIME), timeHour17 = input.bool(false, "17", inline="h2", group=GROUP_TIME, tooltip="12.", display=display.none)
timeHour18 = input.bool(true, "18", inline="h3", group=GROUP_TIME), timeHour19 = input.bool(true, "19", inline="h3", group=GROUP_TIME), timeHour20 = input.bool(true, "20", inline="h3", group=GROUP_TIME), timeHour21 = input.bool(true, "21", inline="h3", group=GROUP_TIME), timeHour22 = input.bool(true, "22", inline="h3", group=GROUP_TIME), timeHour23 = input.bool(true, "23", inline="h3", group=GROUP_TIME, tooltip="18.", display=display.none)
// Revalidated all-24h Stability Core defaults: LONG 09/10/11/20/21/23 · SHORT 10/11/21. All 24 switches remain user-editable.
// === MARKET REGIME GATE ======================================================
// Research-defined structural sessions; no individual hour/day cherry-picking.
marketRegimeMode = input.string("All sessions", "Market regime", options=["All sessions","Liquidity Core","Custom"], group=GROUP_MREG,
     tooltip="Liquidity Core = London 02:00-05:00 ET + US pre-cash/morning 07:00-12:00 ET + Globex reopen 18:00-19:00 ET. These windows were defined by market structure, not individual-hour optimization.")
// Negen economisch vooraf gedefinieerde vensters, tijden in de referentie-timezone.
// De eerste drie zijn samen "Liquidity Core" en zijn NIET aangepast: die definitie zit
// onder alles wat er tot nu toe op gemeten is.
customGlobexOpen = input.bool(true,  "Globex reopen 18:00-19:00", inline="mr1", group=GROUP_MREG)
customAsia       = input.bool(false, "Asia 19:00-02:00",          inline="mr1", group=GROUP_MREG)
customLondon     = input.bool(true,  "London 02:00-05:00",        inline="mr2", group=GROUP_MREG)
customUsMorning  = input.bool(true,  "US 07:00-12:00",            inline="mr2", group=GROUP_MREG)
customInitBal    = input.bool(false, "Initial balance 09:30-10:30", inline="mr3", group=GROUP_MREG)
customNyAm       = input.bool(false, "NY AM 09:30-11:30",         inline="mr3", group=GROUP_MREG)
customLunch      = input.bool(false, "Lunch 11:30-13:00",         inline="mr4", group=GROUP_MREG)
customNyPm       = input.bool(false, "NY PM 13:00-15:00",         inline="mr4", group=GROUP_MREG)
customPowerHour  = input.bool(false, "Power hour 15:00-16:00",    inline="mr5", group=GROUP_MREG,
     tooltip="US overlaps Initial Balance, NY AM and Lunch on purpose: the windows are OR-ed, so a coarse block can sit next to finer ones.")

// Force flat en de sessie-roll vallen samen op de CME-grens en hebben altijd dezelfde
// waarde gehad. Alleen de schakelaar is nog een keuze; de tijden zijn vast.
useAutoFlat = input.bool(true, "Force flat 16:55 – 18:00", group=GROUP_TIME,
     tooltip="No new entries inside the window, and open positions are flattened. This is the CME session break; the times are fixed.")
int flatHour     = 16
int flatMinute   = 55
int resumeHour   = 18
int resumeMinute = 0

// === UNITS & SIZING ==========================================================
unitMode  = input.string("Ticks", "Distance Unit", options=["Ticks","Points","%","ATR"], group=GROUP_UNIT, tooltip="Unit for all distance inputs (stops, gaps, buffers).", display=display.none)
atrLen    = input.int(14, "ATR Length (ATR unit)", minval=1, group=GROUP_UNIT, tooltip="ATR length, only used when Distance Unit is set to ATR.", display=display.none)
sizingMode = input.string("Fixed contracts", "Sizing Mode", options=["Fixed contracts","Fixed $ risk","% equity risk"], group=GROUP_UNIT,
     tooltip="With the swing stop the stop distance varies per trade; $-risk or %-risk sizing keeps risk per trade constant and is recommended in that case.", display=display.none)
contractSize       = input.float(3, "Fixed Qty", minval=0, group=GROUP_UNIT, tooltip="Fixed number of contracts per trade. The MAE guard may scale this down per trade on a PA.")
riskValue          = input.float(250, "Risk per Trade ($ of %)", minval=0, group=GROUP_UNIT, tooltip="Risk per trade when using $-risk or %-risk sizing instead of fixed contracts.", display=display.none)
allowFractionalQty = input.bool(false, "Allow Fractional Qty (crypto)", group=GROUP_UNIT, tooltip="Allow fractional position sizes (crypto only — futures require whole contracts).", display=display.none)
maxQty             = input.float(100, "Max Qty Cap", minval=0, group=GROUP_UNIT, tooltip="Hard cap on position size regardless of the sizing mode.", display=display.none)
float contractSizeEff = contractSize

atrVal = ta.atr(atrLen)
f_distPrice(_u) =>
    switch unitMode
        "Ticks"  => _u * syminfo.mintick
        "Points" => _u
        "%"      => close * _u / 100.0
        => _u * atrVal

// === ENTRY & STOP ENGINE =====================================================
entryMode = input.string("Limit @ 50% FVG", "Entry Mode", options=["Limit @ 50% FVG","Market (legacy)"], group=GROUP_ENTRY,
     tooltip="Limit: resting order at the gap retrace level; better price, no entry slippage, ~78% of signals still get filled.")
expiryBars = input.int(24, "Limit Order Expiry (bars)", minval=1, group=GROUP_ENTRY,
     tooltip="Bars a resting limit order stays valid before it is cancelled.")
stopMode  = input.string("Fixed (legacy)", "Stop Mode", options=["Swing structure","Fixed (legacy)"], group=GROUP_ENTRY, tooltip="Swing structure: stop beyond the last confirmed pivot AND the gap edge, plus buffer. Fixed: static distance.", display=display.none)
int   pivotK = 3         // alleen in Swing-stopmodus; nooit aangeraakt, dus vast
float swingBufSize = 2.0 // idem
// MYM Production scratch parity: Distance Unit = Ticks; SL480 = 480 index points = $240 gross risk per 1 MYM.
maxStopSize  = input.float(480, "Max Stop Distance (units) — else no trade", minval=1, group=GROUP_ENTRY, tooltip="Signals with a wider stop than this are skipped entirely.", display=display.none)
slSizeLegacy = input.float(480, "Fixed Stop (units, legacy mode)", minval=0.01, group=GROUP_ENTRY, tooltip="Static stop distance, only used in Fixed stop mode.", display=display.none)
float maxStopSizeEff = maxStopSize
float slSizeLegacyEff = slSizeLegacy

// === TRADE MANAGEMENT ========================================================
tpMode  = input.string("R-multiple", "Take-Profit Mode", options=["R-multiple","Swing structure","Fixed (units)"], group=GROUP_RISK,
     tooltip="Swing structure: target = last confirmed opposite pivot. R-multiple: target = R x stop distance. Fixed: static distance in units.", display=display.none)
rMultIn = input.float(1.25, "R-Multiple (R-multiple mode)", minval=0.1, step=0.25, group=GROUP_RISK,
     tooltip="Target as a multiple of the stop distance (R-multiple mode).")
tpSize  = input.float(122, "Take Profit (units, Fixed mode)", minval=0.01, group=GROUP_RISK, tooltip="Static target distance (Fixed TP mode only).", display=display.none)
useBreakEven    = input.bool(false, "Enable Break-even", group=GROUP_RISK,
     tooltip="Default ON (v3.6). Optional with Swing TP (expectancy-neutral, lower DD); with R-multiple it is part of the exit engine. Live: server-side via broker bracket.", display=display.none)
beTriggerSize   = input.float(15, "BE Trigger MFE (units)", minval=0.01, group=GROUP_RISK, tooltip="MFE required before the stop moves to break-even.", display=display.none)
beOffsetSize    = input.float(12,  "BE Offset (units)", minval=0, group=GROUP_RISK, tooltip="Offset above/below entry for the break-even stop.", display=display.none)
useTrail        = input.bool(false, "Enable Trailing", group=GROUP_RISK,
     tooltip="Default ON (v3.6): ESSENTIAL in R-multiple mode ($11.70 vs $6.80/trade; maxDD $4.2k vs $15.1k without). Optional with Swing TP but reduces DD.", display=display.none)
trailStartSize  = input.float(120, "Trail Activation MFE (units)", minval=0.01, group=GROUP_RISK, tooltip="MFE required before the trailing stop activates.", display=display.none)
trailBufferSize = input.float(16, "Trail Buffer (units)", minval=0.01, group=GROUP_RISK, tooltip="Distance the trail keeps from the running extreme.", display=display.none)
// === v6.4.4M: HERSTEL-TRAIL (alleen trade #2 na een verlies in dezelfde eval-poging) ===
useFillCheck    = input.bool(true, "FVG fill check (gap invalid once mid is touched)", group=GROUP_RISK,
     tooltip="Removes an FVG from the confirmation memory once price touches its mid (partially filled = invalid).")
useRecovTrail   = false
recovTrailStart = 40.0
recovTrailBuf   = 16.0
string tpModeEff   = tpMode
float  tpSizeEff   = tpSize
bool   useBEeff    = useBreakEven
float  beTrigEff   = beTriggerSize
float  beOffEff    = beOffsetSize
bool   useTrailEff = useTrail
float  trStartEff  = trailStartSize
float  trBufEff    = trailBufferSize

float trailUpdateStep = 2.0


// === DAILY RISK / EQUITY =====================================================
enableDailyLossLimit = false
dailyLossLimit       = 700.0
includeOpenInLoss    = true
enableDailyTarget    = false
dailyProfitTarget    = 350.0
enableDailyDrawdown    = false
dailyDrawdownLimit    = 750.0
enableEquityLock    = false
equityLockThreshold    = 300.0
equityLockPerc    = 90.0
onlyFirstTrade       = false

// === INTRADAY DAY-EXIT (v6.4.4i — sim-gevalideerde dagwinst-behoud) ==========
var string GROUP_DEX = "7 · ACCOUNT — Management"
dayExitMode = input.string("Off", "Day-profit exit mode", options=["Off","Day-trail (keep peak)","Day-cap (hard target)","Trail + cap"], group=GROUP_DEX,
     tooltip="Off = no day-profit exit. Day-trail closes the day on a pullback from the intraday day-PnL peak. Day-cap closes the day at the hard target. Trail + cap: both.")
dayTrailModel = input.string("Activation + giveback", "Day-trail model", options=["Legacy: activation = giveback","Activation + giveback"], group=GROUP_DEX,
     tooltip="Legacy reproduces the old rule: the same USD value both arms the trail and is the allowed pullback. Activation + giveback separates those two concepts, e.g. arm after +$200 and allow only $100 giveback.")
dayTrailUSD = input.float(200, "Legacy day-trail value ($)", minval=10, step=10, group=GROUP_DEX,
     tooltip="Used only by Legacy model: arms once peak exceeds this value and closes after the same amount of giveback.")
dayTrailActivationUSD = input.float(500, "Day-trail activation ($)", minval=0, step=10, group=GROUP_DEX,
     tooltip="Activation + giveback model: intraday running-PnL peak required before the daily profit trail is armed.")
dayTrailGivebackUSD = input.float(150, "Day-trail giveback ($)", minval=10, step=10, group=GROUP_DEX,
     tooltip="Activation + giveback model: maximum allowed pullback from the intraday running-PnL peak after activation.")
dayCapUSD   = input.float(750, "Day-cap hard target ($)", minval=50, step=25, group=GROUP_DEX,
     tooltip="Hard day-profit target that closes the day (cap modes).")
string dailyScaleMode = "Fixed USD"
float dailyScaleMult = dailyScaleMode == "Per contract" ? math.max(contractSizeEff, 1.0) : 1.0
float dayTrailUSDEff = dayTrailUSD * dailyScaleMult
float dayTrailActivationUSDEff = dayTrailActivationUSD * dailyScaleMult
float dayTrailGivebackUSDEff = dayTrailGivebackUSD * dailyScaleMult
float dayCapUSDEff   = dayCapUSD * dailyScaleMult
float dailyLossLimitEff = dailyLossLimit * dailyScaleMult


// === ACCOUNT PHASE (Apex) ====================================================
ddModel       = input.string("Intraday", "Drawdown Model", options=["EOD","Intraday"], group=GROUP_PHASE,
     tooltip="EOD (Apex 4.0 default): trailing ratchets on the daily closing balance only; open profit peaks do not count. Intraday (legacy): ratchets in real time with the live peak.", display=display.none)
payoutBuffer  = input.float(500, "Extra buffer above safety net ($)", step=100, group=GROUP_PHASE,
     tooltip="Payout-ready only when realized >= safety net + this buffer + min. payout. VALIDATION (PA-phase sweep $500-12,000, 300+ fresh PAs, horizon 500 sessions): death rate is FLAT across the whole range (27-31%) because PA mortality sits pre-lock, before any buffer exists; a bigger buffer only traps money in accounts that later die — payout/PA falls monotonically from $721 (buffer $500) to $416 ($12,000). Optimum: $500-1,000. Withdraw early and often; banked money is the only money that is truly yours.", display=display.none)

// === v6.4.4: WAIT-FOR-CAP PAYOUT-DISCIPLINE ================================
var string GROUP_WFC = "8 · ACCOUNT — Guard"
bool useWaitForCap = true   // altijd op de volle laddertrede aanvragen
payoutNr      = input.int(1, "Next payout number (1-6)", minval=1, maxval=6, group=GROUP_WFC,
     tooltip="Which payout you are building toward (1-6). Sets the ladder cap. Increase after each approved payout.")
accountPhase  = input.string("Funded", "Account phase", options=["Developer","Eval","Funded"], group=GROUP_PHASE,
     tooltip="Research: no account rules (default; backtests unchanged). Eval: goal + trailing. PA: trailing until lock, DLL, consistency/payout monitor — and the MAE guard, group 8.")
// Breach-markeren in plaats van echt halten hoort bij Developer, niet bij een losse
// schakelaar: op Funded en Eval moet een breach het account gewoon stilzetten, anders meet
// je een backtest die verder handelt op kapitaal dat in werkelijkheid weg is.
bool paBacktestMode = accountPhase == "Developer"
// Historical bars: lifecycle simulation may reset after breach/payout. Realtime bars: always behave as live PA (breach halts).
bool paBacktestModeEff = paBacktestMode and not barstate.isrealtime
acctTrailDD   = input.float(2000, "Trailing Drawdown ($)", step=100, group=GROUP_PHASE, tooltip="Trailing drawdown of your account plan.", display=display.none)
acctGoal      = 3000.0
acctDLL       = input.float(1000, "PA Daily Loss Limit ($)", step=50, group=GROUP_PHASE, tooltip="PA daily loss limit; the phase layer halts the day when hit.", display=display.none)
consistencyPct= input.float(50, "Consistency rule (%)", minval=10, maxval=100, group=GROUP_PHASE, tooltip="Max share of total profit one day may contribute at payout request (Apex: 30-50% depending on plan).", display=display.none)
minPayout     = input.float(500, "Min. Payout ($)", step=50, group=GROUP_PHASE, tooltip="Minimum payout amount per Apex rules.", display=display.none)
minQualDayUSD = input.float(250, "Min. profit for qualifying day ($)", step=10, group=GROUP_PHASE, tooltip="Minimum daily profit for a day to count as qualifying toward payout.", display=display.none)
acctPnlOffset = input.float(0, "Live sync: current account PnL vs start ($)", group=GROUP_PHASE,
     tooltip="For live use: enter the account's actual PnL so floor/goal are correct. Backtest: 0.", display=display.none)
acctHwmOffset = input.float(0, "Live sync: current HWM vs start ($)", group=GROUP_PHASE, tooltip="For live use with EOD trailing: the account high-water mark so the floor calculates correctly. Backtest: 0.", display=display.none)
lastPayoutTime= input.time(timestamp("2024-01-01T00:00:00"), "Last payout (consistency anchor)", group=GROUP_PHASE, tooltip="Consistency and qualifying-day counters measure from this moment. Set to your last payout date; leave at default for a fresh account.", display=display.none)

// === 0 · FIRM PRESET — auto-fills account rules from data/propfirms.json ======
// Futures (trailing-DD) firms only. Forex/static firms run via the Python
// backtester until the static-DD Pine engine is added. Manual inputs stay as override.
// === Daily risk-gate (D-45) =================================================
// Twee ONAFHANKELIJKE drempels per sessie, allebei op GEREALISEERDE P&L:
//   DLL   - cum realized <= -DLL         -> halt
//   Trail - na trigger T volgt hij de piek; cum <= piek - B -> halt
// De trail kijkt bewust alleen naar trade-closes: intra-trade ruis mag er niet aan zitten.
// Beide voeden dayHalted, zodat de bestaande machinerie (cancel + close_all + close naar
// PMT + entry-blokkade) ongewijzigd hergebruikt wordt - geen tweede executiepad.
useRiskGate = input.bool(false, "Daily risk-gate", inline="rg1", group=GROUP_RG, tooltip="Off = behaviour of this engine as frozen. On adds a session loss limit and a give-back trail on realized P&L, on top of the account rules below.")
rgDLL       = input.float(150, "DLL $", minval=0, step=10, inline="rg1", group=GROUP_RG)
rgTriggerT  = input.float(10,  "Trail arms above $", minval=0, step=1, inline="rg2", group=GROUP_RG)
rgBufferB   = input.float(100, "give-back $", minval=0, step=1, inline="rg2", group=GROUP_RG)
rgDllBasis  = input.string("Realized + open (cuts the trade)", "DLL basis", options=["Realized + open (cuts the trade)","Realized only (halts after the close)"], group=GROUP_RG,
     tooltip="Realized + open makes the DLL a loss LIMITER: the position closes mid-trade the moment realized+open reaches it. Realized only makes it a halt TRIGGER: the losing trade runs to its stop first and the day closes after. Same number of halted days, very different cost. The trail works on trade closes in both modes.", display=display.none)
int rgRollHour = 18   // CME-roll; valt samen met het einde van de force-flat

useFirmPreset = input.bool(true, "Use firm preset (fills account rules below)", group=GROUP_PHASE, tooltip="Pick a prop-firm program; the drawdown model, trailing DD, eval goal, daily-loss and consistency get set for you. Leave OFF to use the manual inputs.")
firmPreset    = input.string("apex_50k_eod_pa", "Firm program", options=["apex_250k_legacy_eval", "apex_25k_legacy_eval", "apex_50k_eod_eval", "apex_50k_eod_pa", "apex_50k_intraday_eval", "apex_50k_intraday_pa", "apex_50k_legacy_eval", "apex_50k_legacy_pa", "daytraders_s2f_25k_instant", "mffu_50k_eval", "takeprofittrader_50k_eval", "topstep_50k_eval", "tradeify_advanced_25k_instant"], group=GROUP_PHASE, tooltip="Auto-generated from the prop-firm registry. Only trailing-DD (futures) firms are listed here.")
