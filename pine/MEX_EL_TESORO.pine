//@version=6
// v6.8.14 (optimised): memory-safe visuals (drawLast) + recovery-trail A1 fix + FX tick-volume delta note.
// v6.8.15: auto-guard the delta filter on non-futures assets (forex/CFD/spot).
// v6.8.16: inputs restructured + firm-preset dropdown (futures).
// v6.9.0: roll/OpEx/news factory — selectable event-regime filters (preset per strategy · account-type · phase).
// v6.9.1: "→ Middleware" route — emits a lean signal to the fan-out middleware (one alert per strategy).
// v7.9.2: positie-gate krijgt RICHTING. Apex staat geen twee tegengestelde open orders toe; de
//         gate kende geen richting, dus na risk-off stond hij voor beide kanten open en
//         reverseerde een tegengesteld signaal de positie. Nu: flat = beide, in positie zonder
//         risk-off = niets, in positie met risk-off = alleen dezelfde kant. Geen stacking
//         (pyramiding blijft 1). Blockers-rij toont "In position (opposite)".
// v7.9.1: Fase 1 (un-overfit) — Distance Unit and ATR Length are inputs now. With unit=ATR the
//         geometry (FVG/stop/TP) is expressed in ATR multiples, so ONE parameter set is correct
//         on every asset — the generic primitive that replaces per-asset tuning. Default Ticks,
//         so nothing running changes; ATR is calibrated via the backtester next. (v7.9.0's
//         hand-typed per-asset profile was the wrong primitive and is reverted.)
// v7.8.2: default Max Stop Distance 100->130 (research). The filter and the actual stop are now
//         deliberately decoupled: wide 130t gate admits more setups, tight 100t fixed stop keeps
//         the loss economics. Fixed Qty default stays 8 — but note an 8ct/100t run breaches the
//         $2500 trailing DD in backtest (max intrabar DD ~$4.1k); it only shows a profit because
//         PA backtest mode marks breaches instead of closing. Size is a per-account decision.
// v7.8.1: MEX Policy presets renamed to the registry's per-size firm keys (PA013/PA018 are
//         Legacy, PA016 EOD) — they named pre-rename keys, so every firm lookup fell back to
//         defaults: 0 required trading days and a 50% ceiling on a 30% account.
// v7.8.0: payout gate reads the account type's OWN day counters from the registry — days with
//         fills AND days over the qualifying amount, two counters, not one hardcoded 5. The
//         qualifying-day minimum stops being an input: it is a firm rule, not a setting.
var string currentVersion = "v7.9.2"
strategy("MΞX ΞL TΞSORO · FVG engine · " + currentVersion, shorttitle="TΞSORO", overlay=true,
     initial_capital=50000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     calc_on_every_tick=false,
     calc_on_order_fills=true,
     use_bar_magnifier=true,
     max_bars_back=500,
     max_boxes_count=500, max_labels_count=500,
     margin_long=0, margin_short=0,
     slippage=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.67)

import TradingView/ta/8

// === GROUPS ==================================================================
var string GROUP_UNIT  = "2 · TRADE — Position sizing"
var string GROUP_ENTRY = "3 · TRADE — Entry & stop"
var string GROUP_RISK  = "4 · TRADE — Take-profit & exits"
var string GROUP_PHASE = "1 · ACCOUNT — Phase, drawdown & guard"
var string GROUP_BIAS  = "7 · SIGNAL — VWAP / bias"
var string GROUP_CVD   = "6 · SIGNAL — Volume delta"
var string GROUP_FVG   = "5 · SIGNAL — FVG"
var string GROUP_TIME  = "8 · SIGNAL — Time gate"
var string GROUP_VIS   = "10 · RESEARCH — Visuals & labels"
var string GROUP_DASH  = "11 · MONITOR — Dashboard"
var string GROUP_EXEC  = "9 · EXECUTION — Alerts & routing"
var string GROUP_ALRT  = GROUP_EXEC
var string GROUP_EVT   = "8b · SIGNAL — Roll / OpEx / News factory"
// Regime-factory identity for THIS script (strategy · account-type · phase). The "Auto" preset resolves to this.
var string AUTO_PRESET = "GC · Funded"

// === TIMEZONE / DAY ==========================================================
var string GROUP_ACCT = "0 · ACCOUNT — Firm & routing"

// === v6.8: retired features — removed. One name survives: f_journal() writes a regime column,
// permanently false since the regime engine was retired. Removing it would change the CSV schema.
bool   useRegime      = false

accountID = input.string("", "PMT/Tradovate Account ID", group=GROUP_ACCT,
     tooltip="PMT/Tradovate account ID. Declared first on purpose: it is the FIRST value in the alert name/prefill, so every alert in the TradingView sidebar starts with the account it belongs to. Also feeds the automatic journal account name (first 2 letters + last 3 digits).")

input_tz = input.string("America/New_York", "Reference Timezone",
     options=["Pacific/Honolulu","America/Anchorage","America/Los_Angeles","America/Denver","America/Chicago","America/New_York","America/Sao_Paulo","Etc/UTC","Europe/London","Europe/Berlin","Europe/Amsterdam","Europe/Athens","Europe/Moscow","Asia/Dubai","Asia/Karachi","Asia/Dhaka","Asia/Bangkok","Asia/Singapore","Asia/Tokyo","Australia/Sydney","Pacific/Auckland"],
     group=GROUP_TIME, tooltip="Timezone for the time gate, flat window and day boundary. Keep America/New_York — all", display=display.none)
string activeTz = input_tz
dayBoundaryMode = input.string("Exchange session", "Trading-Day Boundary",
     options=["Exchange session","Calendar day (timezone)"], group=GROUP_TIME, tooltip="Where the trading day rolls over. Exchange session (default) = 18:00 ET futures session open, matching Apex and the research engine. Calendar day: midnight in the reference timezone.", display=display.none)

f_getHour()     => hour(time, activeTz)
f_getMinute()   => minute(time, activeTz)
f_minuteOfDay() => f_getHour() * 60 + f_getMinute()
f_calDayId()    => year(time, activeTz) * 10000 + month(time, activeTz) * 100 + dayofmonth(time, activeTz)
var int prevCalDayId = na
bool newCalDay = na(prevCalDayId) or f_calDayId() != prevCalDayId
prevCalDayId := f_calDayId()
bool isNewTradingDay = barstate.isfirst or (dayBoundaryMode == "Exchange session" ? timeframe.change("1D") : newCalDay)

// === UNITS & SIZING ==========================================================
unitMode = input.string("Ticks", "Distance Unit", options=["Ticks","Points","ATR","%"], group=GROUP_UNIT, tooltip="How every distance (FVG band, stop, TP, buffers) is measured. Ticks = mintick, asset-specific. ATR = multiples of ATR(atrLen): ONE set of numbers is then correct on any asset, which is how the engine stays generic without per-asset tuning. Default Ticks keeps the current tuning; ATR is the un-overfit path (calibrate via the backtester before going live).")
atrLen   = input.int(14, "ATR Length (ATR unit)", minval=1, group=GROUP_UNIT, tooltip="Lookback for the ATR that the ATR distance unit uses.")
sizingMode = input.string("Fixed contracts", "Sizing Mode", options=["Fixed contracts","Fixed $ risk","% equity risk"], group=GROUP_UNIT,
     tooltip="With the swing stop the stop distance varies per trade; $-risk or %-risk sizing keeps risk per trade constant and is recommended in that case.", display=display.none)
contractSize       = input.float(8, "Fixed Qty", minval=0, group=GROUP_UNIT, tooltip="Fixed number of contracts per trade. The MAE guard may scale this down per trade on a PA.")
riskValue          = input.float(250, "Risk per Trade ($ of %)", minval=0, group=GROUP_UNIT, tooltip="Risk per trade when using $-risk or %-risk sizing instead of fixed contracts.", display=display.none)
bool   allowFractionalQty = false
maxQty             = input.float(100, "Max Qty Cap", minval=0, group=GROUP_UNIT, tooltip="Hard cap on position size regardless of the sizing mode.", display=display.none)

atrVal = ta.atr(atrLen)
f_distPrice(_u) =>
    switch unitMode
        "Ticks"  => _u * syminfo.mintick
        "Points" => _u
        "%"      => close * _u / 100.0
        => _u * atrVal

// === ENTRY & STOP ENGINE =====================================================
entryMode = input.string("Limit @ 50% FVG", "Entry Mode", options=["Limit @ 50% FVG","Market (legacy)"], group=GROUP_ENTRY,
     tooltip="Limit: resting order at the gap retrace level; better price, no entry slippage, ~78% of signals still get filled.")
expiryBars = input.int(12, "Limit Order Expiry (bars)", minval=1, group=GROUP_ENTRY,
     tooltip="Bars a resting limit order stays valid before it is cancelled.")
stopMode  = input.string("Fixed (legacy)", "Stop Mode", options=["Swing structure","Fixed (legacy)"], group=GROUP_ENTRY, tooltip="Swing structure: stop beyond the last confirmed pivot AND the gap edge, plus buffer. Fixed: static distance.", display=display.none)
pivotK     = input.int(3, "Pivot Strength (bars links/rechts)", minval=1, maxval=10, group=GROUP_ENTRY,
     tooltip="A pivot is only confirmed k bars after the extreme; the script uses confirmed pivots exclusively (no repainting).", display=display.none)
swingBufSize = input.float(2, "Stop Buffer beyond swing (units)", minval=0, group=GROUP_ENTRY, tooltip="Buffer in units beyond the swing/gap level for the stop.", display=display.none)
maxStopSize  = input.float(130, "Max Stop Distance (units) — else no trade", minval=1, group=GROUP_ENTRY, tooltip="Signals with a wider stop than this are skipped entirely. Filter only: the actual stop is set by Stop Mode (Fixed legacy = the Fixed Stop below), so a WIDE filter with a TIGHT fixed stop admits more setups while keeping the tight-stop loss economics.", display=display.none)
slSizeLegacy = input.float(100, "Fixed Stop (units, legacy mode)", minval=0.01, group=GROUP_ENTRY, tooltip="Static stop distance, only used in Fixed stop mode.", display=display.none)

// === TRADE MANAGEMENT ========================================================
tpMode  = input.string("R-multiple", "Take-Profit Mode", options=["R-multiple","Swing structure","Fixed (units)"], group=GROUP_RISK,
     tooltip="Swing structure: target = last confirmed opposite pivot. R-multiple: target = R x stop distance. Fixed: static distance in units.", display=display.none)
rMultIn = input.float(2.5, "R-Multiple (R-multiple mode)", minval=0.1, step=0.5, group=GROUP_RISK,
     tooltip="Target as a multiple of the stop distance (R-multiple mode).")
tpSize  = input.float(122, "Take Profit (units, Fixed mode)", minval=0.01, group=GROUP_RISK, tooltip="Static target distance (Fixed TP mode only).", display=display.none)
useBreakEven    = input.bool(true, "Enable Break-even", group=GROUP_RISK,
     tooltip="Default ON (v3.6). Optional with Swing TP (expectancy-neutral, lower DD); with R-multiple it is part of the exit engine. Live: server-side via broker bracket.", display=display.none)
beTriggerSize   = input.float(20, "BE Trigger MFE (units)", minval=0.01, group=GROUP_RISK, tooltip="MFE required before the stop moves to break-even.", display=display.none)
beOffsetSize    = input.float(8,  "BE Offset (units)", minval=0, group=GROUP_RISK, tooltip="Offset above/below entry for the break-even stop.", display=display.none)
useTrail        = input.bool(true, "Enable Trailing", group=GROUP_RISK,
     tooltip="Default ON (v3.6): ESSENTIAL in R-multiple mode ($11.70 vs $6.80/trade; maxDD $4.2k vs $15.1k without). Optional with Swing TP but reduces DD.", display=display.none)
trailStartSize  = input.float(48, "Trail Activation MFE (units)", minval=0.01, group=GROUP_RISK, tooltip="MFE required before the trailing stop activates.", display=display.none)
trailBufferSize = input.float(24, "Trail Buffer (units)", minval=0.01, group=GROUP_RISK, tooltip="Distance the trail keeps from the running extreme.", display=display.none)
// === v6.4.4M: HERSTEL-TRAIL (alleen trade #2 na een verlies in dezelfde eval-poging) ===
useFillCheck    = input.bool(true, "FVG fill check (gap invalid once mid is touched)", group=GROUP_RISK,
     tooltip="Removes an FVG from the confirmation memory once price touches its mid (partially filled = invalid).")
useRecovTrail   = false
recovTrailStart = 40.0
recovTrailBuf   = 16.0
string tpModeEff   = tpMode
float  tpSizeEff   = tpSize
bool   useBEeff    = useBreakEven
float  beTrigEff   = beTriggerSize
float  beOffEff    = beOffsetSize
bool   useTrailEff = useTrail
float  trStartEff  = trailStartSize
float  trBufEff    = trailBufferSize

float trailUpdateStep = 2.0


// === DAILY RISK / EQUITY =====================================================
enableDailyLossLimit = false
dailyLossLimit       = 700.0
includeOpenInLoss    = true
enableDailyTarget    = false
dailyProfitTarget    = 350.0
enableDailyDrawdown    = false
dailyDrawdownLimit    = 750.0
enableEquityLock    = false
equityLockThreshold    = 300.0
equityLockPerc    = 90.0
onlyFirstTrade       = false

// === INTRADAY DAY-EXIT (v6.4.4i — sim-gevalideerde dagwinst-behoud) ==========
var string GROUP_DEX = "1e · ACCOUNT — Funded: day-profit exit"
dayExitMode = input.string("Day-trail (keep peak)", "Day-profit exit mode", options=["Off","Day-trail (keep peak)","Day-cap (hard target)","Trail + cap"], group=GROUP_DEX,
     tooltip="Off = no day-profit exit. Day-trail closes the day once open day profit pulls back the trail amount from the intraday peak. Day-cap closes the day at the hard target. Trail + cap: both.")
dayTrailUSD = input.float(300, "Day-trail pullback ($)", minval=10, step=10, group=GROUP_DEX,
     tooltip="Day-profit pullback from the intraday peak that closes the day (trail modes).")
dayCapUSD   = input.float(300, "Day-cap hard target ($)", minval=50, step=25, group=GROUP_DEX,
     tooltip="Hard day-profit target that closes the day (cap modes).")


// === ACCOUNT PHASE (Apex) ====================================================
ddModel       = input.string("EOD", "Drawdown Model", options=["EOD","Intraday"], group=GROUP_PHASE,
     tooltip="EOD (Apex 4.0 default): trailing ratchets on the daily closing balance only; open profit peaks do not count. Intraday (legacy): ratchets in real time with the live peak.", display=display.none)
float  payoutBuffer   = 500.0     // gevalideerd optimum $500-1.000

// === v6.4.4: WAIT-FOR-CAP PAYOUT-DISCIPLINE ================================
var string GROUP_WFC = "1c · ACCOUNT — Funded: payouts & discipline"
useWaitForCap = input.bool(true, "Wait-for-cap: request only at full ladder cap", group=GROUP_WFC,
     tooltip="ON: PAYOUT READY only once the balance covers the FULL ladder cap of the current payout. OFF: as soon as a withdrawal is allowed.")
payoutNr      = input.int(1, "Next payout number (1-6)", minval=1, maxval=6, group=GROUP_WFC,
     tooltip="Which payout you are building toward (1-6). Sets the ladder cap. Increase after each approved payout.")
paBacktestMode = input.bool(true, "PA backtest mode (breach marks, does NOT close permanently)", group=GROUP_WFC,
     tooltip="ON (backtest): a PA breach is counted and marked but does not halt the strategy. OFF (live): a breach truly halts the account.")
accountPhase  = input.string("Apex PA", "Account Phase", options=["Research (none)","Apex Eval","Apex PA"], group=GROUP_PHASE,
     tooltip="Research: no account rules (default; backtests unchanged). Eval: goal + trailing. PA: trailing until lock, DLL, consistency/payout monitor — and the MAE guard (group 16).")
acctTrailDD   = input.float(2500, "Trailing Drawdown ($)", step=100, group=GROUP_PHASE, tooltip="Trailing drawdown of your account plan.", display=display.none)
acctGoal      = 3000.0
acctDLL       = input.float(1000, "PA Daily Loss Limit ($)", step=50, group=GROUP_PHASE, tooltip="PA daily loss limit; the phase layer halts the day when hit.", display=display.none)
acctPnlOffset = input.float(0, "Live sync: current account PnL vs start ($)", group=GROUP_PHASE,
     tooltip="For live use: enter the account's actual PnL so floor/goal are correct. Backtest: 0.", display=display.none)
acctHwmOffset = input.float(0, "Live sync: current HWM vs start ($)", group=GROUP_PHASE, tooltip="For live use with EOD trailing: the account high-water mark so the floor calculates correctly. Backtest: 0.", display=display.none)
int    lastPayoutTime = timestamp("2024-01-01T00:00:00")

// === 0 · FIRM PRESET — auto-fills account rules from data/propfirms.json ======
// Futures (trailing-DD) firms only. Forex/static firms run via the Python
// backtester until the static-DD Pine engine is added. Manual inputs stay as override.
firmPreset    = input.string("apex_50k_eod_pa", "Firm program", options=["apex_250k_legacy_eval", "apex_25k_legacy_eval", "apex_50k_eod_eval", "apex_50k_eod_pa", "apex_50k_intraday_eval", "apex_50k_intraday_pa", "apex_50k_legacy_eval", "apex_50k_legacy_pa", "daytraders_s2f_25k_instant", "mffu_50k_eval", "takeprofittrader_50k_eval", "topstep_50k_eval", "tradeify_advanced_25k_instant"], group=GROUP_PHASE, tooltip="Which prop-firm program this account runs. Used only when the MEX preset in group 0 is set to Manual — otherwise the preset decides, so one choice covers the account. Drives the consistency rule, the minimum payout and the payout ladder. Drawdown model, trailing drawdown and daily loss stay manual below, because those deviate per account. Auto-generated from data/propfirms.json; trailing-drawdown futures programs only.")
f_firmRules(string _p) =>
    string _dd = "Intraday"
    float _ml = 2500.0
    float _g = 3000.0
    float _dll = 1000.0
    float _cons = 50.0
    if _p == "apex_250k_legacy_eval"
        _dd := "Intraday"
        _ml := 6500.0
        _g := 15000.0
        _dll := 1000.0
        _cons := 0.0
    else if _p == "apex_25k_legacy_eval"
        _dd := "Intraday"
        _ml := 1500.0
        _g := 1500.0
        _dll := 1000.0
        _cons := 0.0
    else if _p == "apex_50k_eod_eval"
        _dd := "EOD"
        _ml := 2500.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 0.0
    else if _p == "apex_50k_eod_pa"
        _dd := "EOD"
        _ml := 2500.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 50.0
    else if _p == "apex_50k_intraday_eval"
        _dd := "Intraday"
        _ml := 2500.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 0.0
    else if _p == "apex_50k_intraday_pa"
        _dd := "Intraday"
        _ml := 2500.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 50.0
    else if _p == "apex_50k_legacy_eval"
        _dd := "Intraday"
        _ml := 2500.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 0.0
    else if _p == "apex_50k_legacy_pa"
        _dd := "EOD"
        _ml := 2500.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 30.0
    else if _p == "daytraders_s2f_25k_instant"
        _dd := "EOD"
        _ml := 1000.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 50.0
    else if _p == "mffu_50k_eval"
        _dd := "EOD"
        _ml := 2000.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 0.0
    else if _p == "takeprofittrader_50k_eval"
        _dd := "EOD"
        _ml := 2000.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 0.0
    else if _p == "topstep_50k_eval"
        _dd := "EOD"
        _ml := 2000.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 0.0
    else if _p == "tradeify_advanced_25k_instant"
        _dd := "EOD"
        _ml := 1500.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 50.0
    [_dd, _ml, _g, _dll, _cons]
f_firmMinPayout(string _p) =>
    float _mp = 500.0
    if _p == "apex_250k_legacy_eval"
        _mp := 500.0
    else if _p == "apex_25k_legacy_eval"
        _mp := 500.0
    else if _p == "apex_50k_eod_eval"
        _mp := 500.0
    else if _p == "apex_50k_eod_pa"
        _mp := 500.0
    else if _p == "apex_50k_intraday_eval"
        _mp := 500.0
    else if _p == "apex_50k_intraday_pa"
        _mp := 500.0
    else if _p == "apex_50k_legacy_eval"
        _mp := 500.0
    else if _p == "apex_50k_legacy_pa"
        _mp := 500.0
    else if _p == "daytraders_s2f_25k_instant"
        _mp := 500.0
    else if _p == "mffu_50k_eval"
        _mp := 500.0
    else if _p == "takeprofittrader_50k_eval"
        _mp := 500.0
    else if _p == "topstep_50k_eval"
        _mp := 500.0
    else if _p == "tradeify_advanced_25k_instant"
        _mp := 500.0
    _mp
f_firmLadder(string _p, int _n) =>
    float[] _l = array.from(1500.0, 1500.0, 2000.0, 2500.0, 2500.0, 3000.0)
    if _p == "apex_50k_eod_pa"
        _l := array.from(1500.0, 1500.0, 2000.0, 2500.0, 2500.0, 3000.0)
    else if _p == "apex_50k_intraday_pa"
        _l := array.from(1500.0, 1500.0, 2000.0, 2500.0, 2500.0, 3000.0)
    else if _p == "apex_50k_legacy_pa"
        _l := array.from(1500.0, 1500.0, 2000.0, 2500.0, 2500.0, 3000.0)
    array.get(_l, math.max(0, math.min(_n - 1, array.size(_l) - 1)))
f_firmDays(string _p) =>
    int _md = 0
    int _pd = 0
    float _qd = 50.0
    if _p == "apex_250k_legacy_eval"
        _md := 1
        _pd := 0
        _qd := 50.0
    else if _p == "apex_25k_legacy_eval"
        _md := 1
        _pd := 0
        _qd := 50.0
    else if _p == "apex_50k_eod_eval"
        _md := 1
        _pd := 0
        _qd := 50.0
    else if _p == "apex_50k_eod_pa"
        _md := 5
        _pd := 5
        _qd := 50.0
    else if _p == "apex_50k_intraday_eval"
        _md := 1
        _pd := 0
        _qd := 50.0
    else if _p == "apex_50k_intraday_pa"
        _md := 5
        _pd := 5
        _qd := 50.0
    else if _p == "apex_50k_legacy_eval"
        _md := 1
        _pd := 0
        _qd := 50.0
    else if _p == "apex_50k_legacy_pa"
        _md := 8
        _pd := 5
        _qd := 50.0
    else if _p == "daytraders_s2f_25k_instant"
        _md := 1
        _pd := 0
        _qd := 50.0
    else if _p == "mffu_50k_eval"
        _md := 1
        _pd := 0
        _qd := 50.0
    else if _p == "takeprofittrader_50k_eval"
        _md := 1
        _pd := 0
        _qd := 50.0
    else if _p == "topstep_50k_eval"
        _md := 2
        _pd := 0
        _qd := 50.0
    else if _p == "tradeify_advanced_25k_instant"
        _md := 1
        _pd := 0
        _qd := 50.0
    [_md, _pd, _qd]
// <<< GENERATED — do not edit above by hand; run tools/gen_pine_firms.py
// ============================================================================
// === MEX POLICY LAYER — Fleet Config Matrix v1.1 (autogen, niet handmatig wijzigen)
// ============================================================================
string polPreset = input.string("PA013 · MGC q3 · cap $750", "MEX preset (Fleet Matrix v1.1)", options=["PA013 · MGC q3 · cap $750", "PA016 · MGC q3 · cap $700", "PA019 · MGC q3 · cap $650", "PA018 · RUNNER MGC q5 · cap $1500", "Manual (inputs hieronder)"], group="0· MEX POLICY", tooltip="Kies het account, niet de losse waarden. Met een preset actief NEEMT DEZE OVER: Fixed Qty, Max Stop Distance, de harde dagcap, Account Phase en het Firm program — en de Day-trail wordt uitgezet. Die knoppen verderop doen dan niets meer; het dashboard toont onderaan welke bron stuurt. Manual = alle inputs gelden weer, voor research en backtests.")
f_pol(string _p) =>
    switch _p
        "PA013 · MGC q3 · cap $750" => ["MGC", 3.0, 130.0, 750.0, "Apex PA", true, "apex_50k_legacy_pa"]
        "PA016 · MGC q3 · cap $700" => ["MGC", 3.0, 130.0, 700.0, "Apex PA", true, "apex_50k_eod_pa"]
        "PA019 · MGC q3 · cap $650" => ["MGC", 3.0, 130.0, 650.0, "Apex PA", true, "apex_50k_intraday_pa"]
        "PA018 · RUNNER MGC q5 · cap $1500" => ["MGC", 5.0, 130.0, 1500.0, "Apex PA", true, "apex_50k_legacy_pa"]
        => ["ANY", 0.0, 0.0, na, "", false, ""]   // Manual: the dropdown in group 1 decides
[polFam, polQty, polMaxStopT, polCapUSD, polPhase, polLive, polFirmKey] = f_pol(polPreset)
bool polOn = polPreset != "Manual (inputs hieronder)"
string polRoot = syminfo.root != "" ? syminfo.root : str.replace(str.replace(syminfo.ticker, "1!", ""), "2!", "")
// The preset is sized for ONE contract spec. The family check used to accept GC where the
// preset was calibrated for MGC -- ten times the point value, so q3 became $3,000 of risk
// instead of $300 and the MAE guard silently refused every signal. Match the exact root.
bool polInstrOK = not polOn or polFam == "ANY" or polRoot == polFam
// --- firm rules ------------------------------------------------------------------------------
// One choice, not two: with a Fleet-Matrix preset selected the preset names the firm program;
// on Manual the dropdown in group 1 does. Only the rules that are the FIRM's own are taken from
// it -- consistency, minimum payout and the payout ladder. Drawdown model, trailing drawdown and
// daily loss stay manual, because those genuinely differ per account (this one runs a $473 DLL).
string firmKeyEff = polOn and polFirmKey != "" ? polFirmKey : firmPreset
[_fkDD, _fkMax, _fkGoal, _fkDLL, fkCons] = f_firmRules(firmKeyEff)
float consistencyPct = fkCons
float minPayout      = f_firmMinPayout(firmKeyEff)
// Two day counters, and they are NOT the same number: the first counts days with FILLS, the
// second days that cleared minQualDayUSD in profit. Apex legacy wants 8 and 5x$50 -- scoring
// the strict one twice puts every payout further away than the firm does. Firm rules, so they
// come from the registry and are no longer inputs.
[fkMinDays, fkProfitDays, minQualDayUSD] = f_firmDays(firmKeyEff)

string phaseEff = polOn ? polPhase : accountPhase
bool isEval = phaseEff == "Apex Eval"
guardMult     = 1.25
var bool   pmtBlock = false
var bool   posTrailOn = false
var bool   posRecovOn = false
var string exitReasonNext = ""
var string pmtBlockReason = ""
bool isPA   = phaseEff == "Apex PA"
bool useDDGuard = false
bool phaseOn = isEval or isPA
var bool  acctHalted = false
var string acctHaltReason = ""
var float acctHwm = na
var float profitSince = 0.0
var float bestDaySince = 0.0
var int   qualDays = 0
var int   tradedDays = 0        // days with fills since the last payout
var int   dayStartClosed = 0
var int   paBreachCount = 0
var int   paMilkCount   = 0
var int   paResetCount  = 0
var float paTotalBanked = 0.0
var int   paPayoutsThisCycle = 0
var float paResetPnLPrev = 0.0

// === BIAS & VWAP =============================================================
useSweepFilter = false
sweepLookback  = 20
useVwapVeto   = input.bool(true, "VWAP side veto (long above / short below only)", group=GROUP_BIAS,
     tooltip="Enige richtingsfilter die in beide datahelften consistent was: tegen-VWAP-trades waren structureel negatief.")
useBiasFilter = false
htf_tf        = "30"
htfBosLen     = 7
ltfBosLen     = 5
allowScalp    = true
vwapDistMin   = 0.05

// === DELTA FILTER (vereenvoudigd) ===========================================
useCVDFilter  = input.bool(false, "Use Delta Filter", group=GROUP_CVD,
     tooltip="Requires volume data. Per-bar semantics (fixed). Mainly does selection work; the VWAP effect only existed within the delta-filtered subset. SPOT FX (EURUSD, USDJPY, ...): there is no real volume, so this AUTOMATICALLY falls back to TICK-VOLUME delta (a weaker proxy). Backtests show the 4-bar Streak adds little even on futures — on FX consider turning the Streak OFF (below), or this whole filter OFF and leaning on FVG + VWAP + time.")
string cvdLowerTf     = "1"
string deltaBorrowSym = ""
useCvdStreak  = input.bool(true, "Streak", inline="cv", group=GROUP_CVD, display=display.none)
cvdTrendCount = input.int(4, "Count", minval=1, inline="cv", group=GROUP_CVD, tooltip="Consecutive same-direction delta bars required.")

// === FVG =====================================================================
useGapFilter = input.bool(true, "Use FVG Size Range Filter", group=GROUP_FVG,
     tooltip="Size does not predict the outcome, but the range controls trade frequency and thus cost pressure. 9-13 is the", display=display.none)
gapMinSize   = input.float(9,  "Min FVG Size (units)", minval=0.01, group=GROUP_FVG, tooltip="Minimum FVG size. Do not widen — smaller gaps are noise.")
gapMaxSize   = input.float(18, "Max FVG Size (units)", minval=0.01, group=GROUP_FVG, tooltip="Maximum FVG size.")
confirmBarsIn = input.int(0, "Confirmation window (bars)", minval=0, maxval=20, group=GROUP_FVG,
     tooltip="v6.1 FVG confirmation memory. 0 = OFF = exact v6.0 behaviour. With X>0, a size-passing FVG whose confirmation (delta filter, VWAP veto, bias, sweep, time gate) is not present on the gap bar itself stays valid for X bars; the signal fires on the first bar inside the window where all strategy rules pass and the account is flat. One signal per gap, newest gap first; entry limit and stop reference the stored gap. HONEST VALIDATION NOTE: walk-forward funnel simulation (Sep 2018–Jun 2026, 878 paired starts, B exit configuration only): payout/funnel $171 (0) -> $305 (3) -> $355 (5), monotone in X; paired bootstrap at X=3: +$134/funnel, z=1.86 — positive but NOT 95%-significant. Effect is throughput/tempo (+66% trades, near-equal pass rate), not signal quality. Do NOT combine with break-even exits (weaker there, and BE variants stay below B). Fleet recommendation: core stream 0, tempo stream 3, explorer stream 5.")



int confirmBars = confirmBarsIn
// === TIME GATE (session strings; the 31 weekday/hour toggles went in v7.5-MGC-PA) ==
tradingSession = input.session("0000-1700,1800-2400:23456", "Trading window (days + hours)", group=GROUP_TIME,
     tooltip="When new entries are allowed, written as one session string: hours, then days after the colon. 1 = Sunday … 7 = Saturday, so 23456 is Mon-Fri. Several ranges are allowed, which is how the default keeps hour 17 out — it was switched off in v7.3. That hour sits inside the 16:55-18:00 flat window anyway, so it is belt and braces.")
flatWindow     = input.session("1655-1800:1234567", "Force-flat window", group=GROUP_TIME,
     tooltip="Open positions are closed and no new entries are taken inside this window. Leave it empty to switch the force-flat off. This replaces the Force Flat Window toggle and its four hour/minute fields.")
skipMonEarly = input.bool(true, "Skip Monday open (no entries Mon 00:00–02:00 ET)", group=GROUP_TIME,
     tooltip="Blocks new entries during the first two Monday hours (thin liquidity).")

// === ROLL / OPEX / NEWS FACTORY (event-regime filters) ======================
// Validated on 3y OOS: for the mean-reversion engine the losses concentrate in the
// quarterly roll/triple-witching window (esp. quiet, no-news days), while macro news
// (NFP tailwind, FOMC on ES/GC) sits on the profit side. This block lets you AVOID the
// loss-regimes per strategy / account-type / phase. Preset "Auto" = the validated default
// for THIS script; pick another to borrow its config, or "Off / Custom" to drive the
// toggles yourself. Survival over winning — don't fight the bull in the witching-week chaos.
useEvtFilter = input.bool(true, "Enable roll/OpEx/news factory", group=GROUP_EVT,
     tooltip="Master switch. Off = trade every session regardless of roll/OpEx/news regime.")
evtPreset = input.string("Auto (this script)", "Preset (strategy · type · phase)",
     options=["Auto (this script)","ES · Eval","ES · Funded","GC · Eval","GC · Funded","YM · any","NQ · any","Off / Custom"],
     group=GROUP_EVT, tooltip="Auto resolves to the validated default for this script (" + AUTO_PRESET + "). Choose another strategy/account-type to borrow its regime config, or 'Off / Custom' to use the manual toggles below.")
bool   rgAvoidRoll    = true      // alleen actief bij preset "Off / Custom"
int    rgRollDays     = 10
bool   rgRollNewsOvr  = true
bool   rgAvoidWitch   = false
bool   rgAvoidWkAfter = false
bool   rgBlockFOMC    = false
bool   rgBlockNFP     = false

// === VISUALISATION ===========================================================
showVisuals     = input.bool(true, "Chart visuals", inline="v1", group=GROUP_VIS,
     tooltip="Signals, SL/TP levels, the resting limit, unfilled-limit boxes, exit labels, trade info, trade zones and the gate background. One switch: the eight separate toggles were removed in v7.4-MGC-PA — they were only ever used together.")
showFvgBoxes    = input.bool(true, "FVG boxes", inline="v1", group=GROUP_VIS,
     tooltip="Draw the fair-value gaps, and recolor a box once price has tested it.")
drawLast        = input.int(2000, "Visuals: draw only on last N bars (0 = all)", minval=0, group=GROUP_VIS, tooltip="MEMORY FIX: boxes/labels/zones are only drawn on the most recent N bars. Purely cosmetic — strategy results are identical. Prevents 'Memory limit exceeded' on entire-history backtests. Set 0 to draw on all bars (may exceed the memory limit on long histories).", display=display.none)
bool inDrawWin  = drawLast <= 0 or (last_bar_index - bar_index) <= drawLast
// Fixed since v7.4-MGC-PA — these were inputs that never moved off their default. The names stay so
