color zRewardBg = color.new(vPOS, visIsDark ? 90 : 92)

// === EXECUTION / ROUTING =====================================================
// v6.8.13 — independent per-destination toggles; ALL config lives in these inputs
// (single-select "Alert destination" dropdown removed). Enable any combination.
// NOTE: TradingView delivers one alert to ONE webhook URL and Pine cannot POST to
// a URL itself. So TODAY: enable ONE route per alert and put that route's webhook
// on the alert. Enabling several at once is for the planned MIDDLEWARE step: the
// alert URL points only at the middleware, which reads the enabled routes and
// fans out. Per-route webhooks then live in the middleware (Pine can't send them).
routePMT           = input.bool(false, "→ PMT Tradovate", group=GROUP_EXEC, tooltip="PickMyTrade, Tradovate route (PMT JSON). Needs PMT Token + the Account ID (group 0).")
routeRithmic       = input.bool(false, "→ PMT Rithmic", group=GROUP_EXEC, tooltip="PickMyTrade, Rithmic route. Same PMT JSON payload; needs PMT Token + Account ID.")
routePineConnector = input.bool(false, "→ PineConnector (MT4/5)", group=GROUP_EXEC, tooltip="MT4/5 comma command (forex/CFD, e.g. FTMO on EURUSD). Needs license + symbol + risk below.")
routeDiscord       = input.bool(false, "→ Discord", group=GROUP_EXEC, tooltip="Discord embeds (fills/exits/halts/derisk/eval/payout).")
routeJournal       = input.bool(false, "→ Journal (CSV)", group=GROUP_EXEC, tooltip="CSV journal rows for the Notion pipeline.")
usePMT       = routePMT
pmtToken     = input.string("", "PMT Token", group=GROUP_EXEC, tooltip="PickMyTrade API token (Tradovate route).", display=display.none)
useDiscord   = routeDiscord
useRithmic   = routeRithmic
usePineConnector = routePineConnector
pcLicense    = input.string("", "PineConnector license ID", group=GROUP_EXEC, tooltip="Your PineConnector license ID — the number your MT4/5 EA listens on. Used only when Alert destination = PineConnector.", display=display.none)
pcSymbol     = input.string("", "PineConnector symbol (empty = chart)", group=GROUP_EXEC, tooltip="Broker symbol for the MT4/5 order, e.g. EURUSD. Empty = this chart's ticker. Set it when your broker's symbol differs from the chart symbol.", display=display.none)
pcRisk       = input.float(1.0, "PineConnector risk / lots", minval=0, group=GROUP_EXEC, tooltip="The 'risk' value sent to PineConnector (lot size, or risk units, per your EA's configuration).", display=display.none)
routeMiddleware = input.bool(false, "→ Middleware (fan-out)", group=GROUP_EXEC, tooltip="Send one lean signal to your middleware /webhook; it fans out to every account subscribed to this strategy. Put the webhook URL on the TradingView alert itself.")
mwSecret   = input.string("", "Middleware secret", group=GROUP_EXEC, tooltip="Must match MIDDLEWARE_SECRET on your server.", display=display.none)
mwStrategy = input.string("GC", "Middleware strategy key", group=GROUP_EXEC, tooltip="Strategy key the middleware maps to accounts (e.g. GC, ES, NQ). Match accounts.yaml.", display=display.none)
useMiddleware = routeMiddleware
string botName       = "MΞX ΞL TΞSORO"
lockBufTicks = input.float(4, "Lock cost buffer (ticks)", minval=0, group=GROUP_ALRT, tooltip="Extra open-profit buffer (in ticks, per contract) required above the target before the intra-trade lock closes all — covers fees & slippage.")
lockOnCap    = input.bool(true, "Close all when payout cap is reached intra-trade", group=GROUP_ALRT, tooltip="Once projected withdrawable (incl. open PnL) covers the FULL ladder cap plus the cost buffer, close everything (PMT + Discord) and bank the payout.")
avatarURL  = ""
titleURL  = ""
roleID  = ""
notifyRiskOff = useDiscord
notifyEval = useDiscord
notifyFills = useDiscord
notifyStart = useDiscord
notifyBlocked = input.bool(true, "Alert: signal blocked by non-strategy rule", group=GROUP_ALRT,
     tooltip="Fires a TradingView alert (and Discord, if enabled) when a setup satisfies ALL strategy rules (FVG + CVD + bias + VWAP veto + sweep) but is blocked by an operational rule: MAE guard, DD guard, day halt, account halt, time gate or flat window. Being in a position or having a pending order does NOT trigger this alert — that is normal system behaviour.", display=display.none)


// === v5: EVAL / PA TRACKING ==================================================
var string GROUP_EVAL = "1d · ACCOUNT — Eval / research tracking"
evalTrack       = input.bool(false, "Eval tracking on (NOT together with group 4b)", group=GROUP_EVAL, tooltip="Lightweight alternative to the full Apex phase layer (group 4b). Use ONE of the two — never both (duplicate PASSED/FAILED messages).", display=display.none)
tradeFromStart  = input.bool(true, "No entries before start date", group=GROUP_EVAL, tooltip="Gates ENTRIES on the same start date below: before that moment the strategy takes no trades, so the backtester, dashboard and TV key stats reflect ONLY this account. Indicators still warm up on full history. Turn OFF on research charts where you want the full-history backtest. With the default (past) date this toggle has no effect.", display=display.none)
evalStartTime   = input.time(timestamp("01 Jan 2025 00:00 -0400"), "Start date/time (measure from)", group=GROUP_EVAL,
     tooltip="Measurement starts here. PnL from before this moment does NOT count. The date picker interprets in your chart/exchange timezone. NOTE: this is the lightweight tracker (use either this or group 4b, not both).", display=display.none)
evalUseEnd      = input.bool(false, "Use end date (exact tester match)", group=GROUP_EVAL,
     tooltip="OFF (live): the tracker keeps counting to the latest bar — what you want live. ON (verification): counts only up to the end date below, to match a bounded backtester window exactly.", display=display.none)
evalEndTime     = input.time(timestamp("01 Jan 2027 00:00 -0400"), "End date/time (measure through)", group=GROUP_EVAL,
     tooltip="Only active when 'Use end date' is on. Set equal to your backtester period end date for an exact match.", display=display.none)
float  evalStartBal   = 0.0
evalProfitTgt   = acctGoal
evalTrailDD     = acctTrailDD
bool   evalTrailEod   = ddModel == "EOD"

// === v5.4: APEX LEGACY 30% MAE-GUARD =========================================
var string GROUP_MAE = GROUP_PHASE
useMaeGuard  = input.bool(true, "MAE guard on (only active in Apex PA phase)", group=GROUP_MAE,
     tooltip="Apex Legacy 30% Negative P&L (MAE) rule: open negative P&L may never exceed 30% of the profit balance at the START of the day. New/low-profit accounts: 30% of the trailing drawdown (50k: $750). Once EOD profit reaches 2x the safety net (trailing DD + $100): 50%. This guard automatically scales contracts down so stop risk fits, and only blocks a trade if even 1 contract does not fit. Active only when Account Phase (group 4b) is Apex PA, with the live-sync PnL offset filled in.", display=display.none)
float  maeBasePct     = 30.0      // Apex Legacy 30% MAE
float  maeGrownPct    = 50.0      // 50% zodra de EOD-winst 2x het safety net is
maeMarginPct = input.float(10, "Safety margin (%)", minval=0, maxval=50, step=5, group=GROUP_MAE,
     tooltip="Extra buffer below the Apex limit for slippage and open-PnL swings. 10% means the guard uses 90% of the allowed room.", display=display.none)

// === v5: CSV TRADE-JOURNAAL (Notion) =========================================
var string GROUP_JRNL = GROUP_EVAL
useJournal   = routeJournal
jrnlJsonWrap = true
string jrnlAcctName   = ""        // leeg = afgeleid van accountID
// === v6.0: AUTO ALERT MESSAGE ================================================
var string GROUP_AMSG = GROUP_EXEC
alertMsgAuto    = usePMT or useRithmic
sendCfgOnStart  = input.bool(true, "Send CONFIG message on first live bar", group=GROUP_AMSG,
     tooltip="When an alert instance starts running, the script sends ONE fully labeled settings message (key=value for every strategy-relevant parameter) with the standard header. This makes every alert stream self-describing: you can always read back exactly which settings this chart runs, with the parameter name in front of each value. If the CSV journal is enabled, the CONFIG line is shaped as a journal row (event=CONFIG, settings in the last field) so the Notion pipeline stores it cleanly.")
alertIncludeCfg = input.bool(true, "Append full parameter config (|CFG|)", group=GROUP_AMSG,
     tooltip="Appends every relevant script parameter as key=value pairs after a |CFG| marker — same idea as the Properties tab of a backtest export. Your Notion/webhook pipeline can reconstruct exactly which settings produced each fill. Turn off if your webhook target has a small payload limit.", display=display.none)

f_autoAcctName() =>
    string _id = accountID
    int _n = str.length(_id)
    string _pfx = _n >= 2 ? str.upper(str.substring(_id, 0, 2)) : str.upper(_id)
    string _sfx = _n >= 3 ? str.substring(_id, _n - 3, _n) : _id
    string _bal = str.tostring(math.round(evalStartBal / 1000), "#") + "k"
    string _dt = str.format_time(evalStartTime, "yyMMdd", "America/New_York")
    _pfx + _sfx + "-" + _bal + "-" + _dt
string jrnlAcct = str.length(jrnlAcctName) > 0 ? jrnlAcctName : f_autoAcctName()
f_msgHead() =>
    "MPT " + currentVersion + " | " + jrnlAcct + " | " + str.format_time(timenow, "yyyy-MM-dd HH:mm:ss", activeTz)
bool plainAlertsOK = not usePMT and not useRithmic and not usePineConnector and not useDiscord and not useJournal and not useMiddleware
bool execInstance = usePMT or useRithmic or usePineConnector or useMiddleware

// ============================================================================
// === TIME GATE ==============================================================
// ============================================================================
tradeDOW = dayofweek(time, activeTz)
monEarlyBlock = skipMonEarly and tradeDOW == dayofweek.monday and f_minuteOfDay() < 120
bool inTradingSession = not na(time(timeframe.period, tradingSession, activeTz))
timeGatePassRaw = inTradingSession and not monEarlyBlock



timeGatePass = timeGatePassRaw
inFlatWindow = flatWindow != "" and not na(time(timeframe.period, flatWindow, activeTz))

// ============================================================================
// === ROLL / OPEX / NEWS FACTORY — preset resolver + calendar gate ============
// ============================================================================
f_evtPreset(_p) =>
    string _pp = _p == "Auto (this script)" ? AUTO_PRESET : _p
    bool _ar = false
    bool _ro = true
    bool _aw = false
    bool _wa = false
    bool _bf = false
    bool _bn = false
    bool _cu = false
    int  _rd = 10
    if _pp == "ES · Eval" or _pp == "ES · Funded"
        _ar := true
        _wa := true
    else if _pp == "YM · any"
        _ar := true
        _aw := true
    else if _pp == "NQ · any"
        _bf := true
    else if _pp == "Off / Custom"
        _cu := true
    // "GC · Eval" / "GC · Funded" -> all-false: GC is robust across regimes, no event filter
    [_ar, _rd, _ro, _aw, _wa, _bf, _bn, _cu]
[epAr, epRd, epRo, epAw, epWa, epBf, epBn, epCu] = f_evtPreset(evtPreset)
bool evtAvoidRoll  = epCu ? rgAvoidRoll    : epAr
int  evtRollDays   = epCu ? rgRollDays     : epRd
bool evtRollNewsOv = epCu ? rgRollNewsOvr  : epRo
bool evtAvoidWitch = epCu ? rgAvoidWitch   : epAw
bool evtAvoidWkAft = epCu ? rgAvoidWkAfter : epWa
bool evtBlockFOMC  = epCu ? rgBlockFOMC    : epBf
bool evtBlockNFP   = epCu ? rgBlockNFP     : epBn

f_thirdFriDay(_y, _m) =>
    int _wd1 = dayofweek(timestamp(activeTz, _y, _m, 1, 0, 0), activeTz)  // 1=Sun .. 7=Sat
    int _firstFri = 1 + ((6 - _wd1 + 7) % 7)                              // Friday = 6
    _firstFri + 14
int _cy = year(time, activeTz)
int _cm = month(time, activeTz)
int _cd = dayofmonth(time, activeTz)
// nearest quarterly (Mar/Jun/Sep/Dec) 3rd-Friday expiry; signed days (>0 = after expiry)
float _qSigned = na
float _qAbs = 1.0e12
for _yy = _cy - 1 to _cy + 1
    for _qm = 3 to 12 by 3
        float _ts = timestamp(activeTz, _yy, _qm, f_thirdFriDay(_yy, _qm), 0, 0)
        float _dd = (time - _ts) / 86400000.0
        if math.abs(_dd) < _qAbs
            _qAbs := math.abs(_dd)
            _qSigned := _dd
// monthly OpEx (this month's 3rd Friday) — signed within-month days
int _mRel = _cd - f_thirdFriDay(_cy, _cm)
// NFP = 1st Friday of the month
int _wd1m = dayofweek(timestamp(activeTz, _cy, _cm, 1, 0, 0), activeTz)
int _firstFriDay = 1 + ((6 - _wd1m + 7) % 7)
bool isNFP = _cd == _firstFriDay
// FOMC decision days (US, 2022-2026; 2026 projected — update yearly)
var int[] FOMC_YMD = array.from(20220126,20220316,20220504,20220615,20220727,20220921,20221102,20221214, 20230201,20230322,20230503,20230614,20230726,20230920,20231101,20231213, 20240131,20240320,20240501,20240612,20240731,20240918,20241107,20241218, 20250129,20250319,20250507,20250618,20250730,20250917,20251029,20251210, 20260128,20260318,20260429,20260617,20260729,20260916,20261028,20261209)
bool isFOMC = array.includes(FOMC_YMD, _cy * 10000 + _cm * 100 + _cd)
bool isNews = isFOMC or isNFP
bool _blkRoll  = evtAvoidRoll  and (math.abs(_qSigned) <= evtRollDays) and not (evtRollNewsOv and isNews)
bool _blkWitch = evtAvoidWitch and (_qSigned >= -4 and _qSigned <= 1)
bool _blkWkAft = evtAvoidWkAft and (_mRel >= 2 and _mRel <= 8)
bool _blkFOMC  = evtBlockFOMC  and isFOMC
bool _blkNFP   = evtBlockNFP   and isNFP
bool evtBlock  = useEvtFilter and (_blkRoll or _blkWitch or _blkWkAft or _blkFOMC or _blkNFP)
bool evtGateOK = not evtBlock

var bool hasTraded = false
if not timeGatePass
    hasTraded := false

// ============================================================================
// === FVG ENGINE + BOXES =====================================================
// ============================================================================
int fvgDirection = 0
float fvgTop = na
float fvgBottom = na
if bar_index >= 2
    fvgDirection := low[2] >= high ? -1 : low >= high[2] ? 1 : 0
    fvgTop    := fvgDirection > 0 ? low : fvgDirection < 0 ? low[2] : na
    fvgBottom := fvgDirection > 0 ? high[2] : fvgDirection < 0 ? high : na
fvgSizePrice = not na(fvgTop) ? math.abs(fvgTop - fvgBottom) : na
fvgMid = not na(fvgTop) ? (fvgTop + fvgBottom) / 2.0 : na
fvgPasses = not useGapFilter or (not na(fvgSizePrice) and fvgSizePrice >= f_distPrice(gapMinSize) and fvgSizePrice <= f_distPrice(gapMaxSize) and fvgSizePrice > 0)
bullCandle = fvgDirection == 1 and fvgPasses
bearCandle = fvgDirection == -1 and fvgPasses

var array<box> fvgBoxes = array.new<box>()
var array<int> fvgDirs  = array.new<int>()
if showFvgBoxes and barstate.isconfirmed and fvgDirection != 0 and fvgPasses and inDrawWin
    _bx = box.new(bar_index - 2, fvgTop, bar_index, fvgBottom,
         border_color=color.new(fvgDirection > 0 ? bullColor : bearColor, 40),
         bgcolor=fvgDirection > 0 ? bullColor : bearColor)
    array.push(fvgBoxes, _bx)
    array.push(fvgDirs, fvgDirection)
    if array.size(fvgBoxes) > maxBoxes
        box.delete(array.shift(fvgBoxes))
        array.shift(fvgDirs)
if markTested and barstate.isconfirmed and array.size(fvgBoxes) > 0 and inDrawWin
    for i = 0 to array.size(fvgBoxes) - 1
        _b = array.get(fvgBoxes, i)
        _d = array.get(fvgDirs, i)
        if bar_index > box.get_right(_b)
            _tested = _d > 0 ? low <= box.get_top(_b) : high >= box.get_bottom(_b)
            if _tested
                box.set_bgcolor(_b, testedColor)

// ============================================================================
// === SWING STRUCTURE (bevestigde pivots) ====================================
// ============================================================================
float pivL = ta.pivotlow(low, pivotK, pivotK)
float pivH = ta.pivothigh(high, pivotK, pivotK)
float lastPivLow  = fixnan(pivL)
float lastPivHigh = fixnan(pivH)

// ============================================================================
// === BIAS / VWAP (repaint-vrij) =============================================
// ============================================================================
float vwapVal = ta.vwap
float distToVWAP = vwapVal != 0 and not na(vwapVal) ? ((close - vwapVal) / vwapVal) * 100.0 : 0.0
float htfC  = na
float htfHH = na
float htfLL = na
if useBiasFilter
    [c1, hh, ll] = request.security(syminfo.tickerid, htf_tf,
         [close[1], ta.highest(high, htfBosLen)[2], ta.lowest(low, htfBosLen)[2]],
         lookahead=barmerge.lookahead_on)
    htfC := c1
    htfHH := hh
    htfLL := ll
var int htfBias = 0
if useBiasFilter and not na(htfC)
    if htfC > htfHH
        htfBias := 1
    else if htfC < htfLL
        htfBias := -1
var int ltfBias = 0
float ltfHi = ta.highest(high[1], ltfBosLen)
float ltfLo = ta.lowest(low[1], ltfBosLen)
if high > ltfHi
    ltfBias := 1
else if low < ltfLo
    ltfBias := -1
int structBias = ltfBias == htfBias ? ltfBias : 0
string phase = structBias == 1 ? "Expansion ↑" : structBias == -1 ? "Expansion ↓" :
     ltfBias != htfBias and ltfBias != 0 and htfBias != 0 ? "Transition" : "Contraction"
int bias = structBias != 0 ? structBias : htfBias
biasLongOK  = phase == "Expansion ↑" and close > vwapVal and bias == 1
biasShortOK = phase == "Expansion ↓" and close < vwapVal and bias == -1
scalpOK     = allowScalp and (phase == "Contraction" or phase == "Transition") and math.abs(distToVWAP) > vwapDistMin
canLong  = not useBiasFilter or biasLongOK or scalpOK
canShort = not useBiasFilter or biasShortOK or scalpOK

bool sweepLongEvt  = low < lastPivLow[1] and close > lastPivLow[1]
bool sweepShortEvt = high > lastPivHigh[1] and close < lastPivHigh[1]
int  barsSinceSweepLong  = ta.barssince(sweepLongEvt)
int  barsSinceSweepShort = ta.barssince(sweepShortEvt)
bool sweepLongOK  = not useSweepFilter or nz(barsSinceSweepLong, 99999) <= sweepLookback
bool sweepShortOK = not useSweepFilter or nz(barsSinceSweepShort, 99999) <= sweepLookback
plotshape(useSweepFilter and sweepLongEvt, "Sweep Low", shape.diamond, location.belowbar, color=color.new(C_AZURE, 30), size=size.tiny)
plotshape(useSweepFilter and sweepShortEvt, "Sweep High", shape.diamond, location.abovebar, color=color.new(C_ROSE, 30), size=size.tiny)

vetoLongOK  = not useVwapVeto or close > vwapVal
vetoShortOK = not useVwapVeto or close < vwapVal

// ============================================================================
// === DELTA FILTER (per-bar, vereenvoudigd) ==================================
// ============================================================================
// v6.8.10 AUTO-GUARD (non-futures assets): the delta filter needs volume.
// On symbols with no real volume (many CFDs / spot) requestVolumeDelta has no
// data -> auto-disable it. On forex/CFD (tick-volume proxy) auto-relax the
// 4-bar streak to direction-only. Futures/crypto keep the full filter.
bool hasBorrow = str.length(deltaBorrowSym) > 0
bool cvdEff    = useCVDFilter and (hasBorrow or not na(volume))
bool streakEff = useCvdStreak and (hasBorrow or syminfo.type == "futures" or syminfo.type == "crypto")
float perBarDelta = na
if cvdEff
    if hasBorrow
        [_upV, _dnV] = request.security_lower_tf(deltaBorrowSym, cvdLowerTf, [close > open ? volume : 0.0, close < open ? volume : 0.0])
        perBarDelta := array.sum(_upV) - array.sum(_dnV)
    else
        [vdO, vdH, vdL, vdC] = ta.requestVolumeDelta(cvdLowerTf, "1D")
        perBarDelta := vdC - vdO
bullDirOk = perBarDelta > 0
bearDirOk = perBarDelta < 0
int barsSinceNotBull = ta.barssince(not bullDirOk)
int barsSinceNotBear = ta.barssince(not bearDirOk)
bullStreakOk = not streakEff or nz(barsSinceNotBull, 99999) >= cvdTrendCount
bearStreakOk = not streakEff or nz(barsSinceNotBear, 99999) >= cvdTrendCount
bullCvdPass = not cvdEff or (bullDirOk and bullStreakOk)
bearCvdPass = not cvdEff or (bearDirOk and bearStreakOk)

// ============================================================================
// === DAILY RISK / EQUITY (geünificeerd, gelatcht) ===========================
// ============================================================================
var float riskBaseNetProfit = na
var float riskDayPeak = 0.0
var bool  dayHalted = false
var bool  flattenedToday = false
var string haltReason = ""
if isNewTradingDay
    float _yday = strategy.netprofit - nz(riskBaseNetProfit, strategy.netprofit)
    if isPA and time > lastPayoutTime and not na(riskBaseNetProfit)
        if strategy.closedtrades > dayStartClosed
            tradedDays += 1
        if _yday > 0
            profitSince += _yday
            bestDaySince := math.max(bestDaySince, _yday)
            if _yday >= minQualDayUSD
                qualDays += 1
    if phaseOn and ddModel == "EOD"
        acctHwm := math.max(nz(acctHwm, math.max(acctPnlOffset, acctHwmOffset)), acctPnlOffset + strategy.netprofit - paResetPnLPrev)
    riskBaseNetProfit := strategy.netprofit
    dayStartClosed := strategy.closedtrades
    riskDayPeak := 0.0
    dayHalted := false
    flattenedToday := false
    haltReason := ""
todayRealizedPnL = strategy.netprofit - nz(riskBaseNetProfit, strategy.netprofit)
runningPnL = todayRealizedPnL + strategy.openprofit
riskDayPeak := math.max(riskDayPeak, runningPnL)
todayDD = riskDayPeak - runningPnL
lossBasis = includeOpenInLoss ? math.min(todayRealizedPnL, runningPnL) : todayRealizedPnL
targetHit   = enableDailyTarget and todayRealizedPnL >= dailyProfitTarget
lossHit     = enableDailyLossLimit and lossBasis <= -dailyLossLimit
drawdownHit = enableDailyDrawdown and todayDD >= dailyDrawdownLimit
lockArmed   = enableEquityLock and riskDayPeak >= equityLockThreshold
lockHit     = lockArmed and runningPnL <= riskDayPeak * equityLockPerc / 100.0
dllHit      = (isPA or (isEval and ddModel == "EOD")) and runningPnL <= -acctDLL
bool _dexTrailOn = (dayExitMode == "Day-trail (keep peak)" or dayExitMode == "Trail + cap") and not (polOn and not na(polCapUSD))
bool _dexCapOn   = dayExitMode == "Day-cap (hard target)" or dayExitMode == "Trail + cap"
dayTrailHit = _dexTrailOn and riskDayPeak > dayTrailUSD and runningPnL <= riskDayPeak - dayTrailUSD
dayCapHit   = polOn and not na(polCapUSD) ? riskDayPeak >= polCapUSD : (_dexCapOn and riskDayPeak >= dayCapUSD)
if not dayHalted and (targetHit or lossHit or drawdownHit or lockHit or dllHit or dayTrailHit or dayCapHit)
    dayHalted := true
    haltReason := dayCapHit ? "Day-cap" : dayTrailHit ? "Day-trail" : targetHit ? "Daily Target" : lossHit ? "Daily Loss" : drawdownHit ? "Daily Drawdown" : lockHit ? "Equity Lock" : "PA Daily Loss Limit"

// === ACCOUNT ENGINE (trailing floor / eval goal / payout) ====================
float acctPnL      = acctPnlOffset + strategy.netprofit - paResetPnLPrev + strategy.openprofit
float acctRealized = acctPnlOffset + strategy.netprofit - paResetPnLPrev

var float maeSodProfit = na
if isNewTradingDay or na(maeSodProfit)
    maeSodProfit := acctPnlOffset + strategy.netprofit
float maeSafetyNet = acctTrailDD + 100
float maePct = maeSodProfit >= 2 * maeSafetyNet ? maeGrownPct : maeBasePct
float maeAllowUSD = (maePct / 100.0) * math.max(nz(maeSodProfit, 0), acctTrailDD) * (1 - maeMarginPct / 100.0)
if phaseOn
    acctHwm := na(acctHwm) ? math.max(acctPnlOffset, acctHwmOffset) : ddModel == "Intraday" ? math.max(acctHwm, acctPnL) : acctHwm
bool  acctLocked = phaseOn and acctHwm >= acctTrailDD + 100
float acctFloor  = not phaseOn ? na : acctLocked ? 100.0 : acctHwm - acctTrailDD
float ddRoom     = phaseOn ? acctPnL - acctFloor : na
bool  consistencyOK = consistencyPct <= 0 or (profitSince > 0 and bestDaySince / profitSince < consistencyPct / 100.0)    // <= 0 = no consistency rule (evals)
f_ladderCap(_n) =>
    f_firmLadder(firmKeyEff, _n)
int   effPayoutNr = (isPA and paBacktestMode) ? math.min(paPayoutsThisCycle + 1, 6) : payoutNr
float curLadderCap = f_ladderCap(effPayoutNr)
bool  payoutEligible = isPA and acctLocked and acctRealized >= acctTrailDD + 100 + payoutBuffer + minPayout and tradedDays >= fkMinDays and qualDays >= fkProfitDays and consistencyOK
float withdrawable = acctRealized - (acctTrailDD + 100)
pmtBlock := isPA and useWaitForCap and withdrawable >= curLadderCap
pmtBlockReason := "PAYOUT CAP REACHED — request payout, then raise payout number"
bool  fullCapReady = payoutEligible and withdrawable >= curLadderCap
bool  payoutReady = useWaitForCap ? fullCapReady : payoutEligible
if phaseOn and not acctHalted
    if acctPnL <= acctFloor
        if isPA and paBacktestMode
            paBreachCount += 1
            paResetCount  += 1
            paResetPnLPrev := strategy.netprofit
            acctHwm       := na
            profitSince   := 0.0
            bestDaySince  := 0.0
            qualDays      := 0
            tradedDays    := 0
            paPayoutsThisCycle := 0
        else
            acctHalted := true
            acctHaltReason := "TRAILING BREACH (model)"
    else if isEval and acctRealized >= acctGoal
        acctHalted := true
        acctHaltReason := "EVAL PASSED 🎉"
var bool payoutAlerted = false
if payoutReady and not payoutAlerted
    payoutAlerted := true
    if plainAlertsOK
        alert(f_msgHead() + " | 💰 PAYOUT " + str.tostring(effPayoutNr) + " READY" + (useWaitForCap ? " (VOLLE CAP $" + str.tostring(curLadderCap, "#") + ")" : "") + " | withdrawable $" + str.tostring(withdrawable, "#"), alert.freq_once_per_bar)
if not payoutReady
    payoutAlerted := false

if isPA and paBacktestMode and payoutReady and barstate.isconfirmed
    float _take = useWaitForCap ? curLadderCap : math.min(withdrawable, curLadderCap)
    paTotalBanked += _take
    paPayoutsThisCycle += 1
    paResetPnLPrev := paResetPnLPrev + _take
    profitSince   := 0.0
    bestDaySince  := 0.0
    qualDays      := 0
    tradedDays    := 0
    if paPayoutsThisCycle >= 6
        paMilkCount += 1
        paResetCount += 1
        paPayoutsThisCycle := 0
        acctHwm := na
        paResetPnLPrev := strategy.netprofit

var bool  evalStarted = false
var float evalBal    = na
var int  attemptTradeNo  = 0
var bool attemptFirstLoss = false
// v6.8.x FIX (A1): re-arm recovery-trail counters each trading day. They were
// only reset inside the disabled evalTrack path, so the recovery-trail fired
// only on the 2nd trade of the entire run. Now it re-arms per session.
if isNewTradingDay
    attemptTradeNo := 0
    attemptFirstLoss := false
var int  lastClosedSeen   = 0
var float distTarget = na
var float distFail   = na
var bool  regimeFav  = false

var bool acctStartArmed = false
var bool startNotified = false
if not acctStartArmed
    bool _dateOK = not tradeFromStart or time >= evalStartTime
    if _dateOK
        acctStartArmed := true
bool preStartBlock = tradeFromStart and not acctStartArmed
canTrade = timeGatePass and evtGateOK and not dayHalted and not inFlatWindow and not acctHalted and not preStartBlock and polInstrOK and (not polOn or polLive)
if barstate.islast and polOn and (not polInstrOK or not polLive)
    var label _polWarn = na
    label.delete(_polWarn)
    _polWarn := label.new(bar_index, high, not polLive ? "⛔ PRESET GEPARKEERD — geen trades" :
         "⛔ VERKEERD CONTRACT — preset '" + polPreset + "' is gemaakt voor " + polFam +
         ", chart is " + polRoot + ". Sizing en dagcap kloppen hier niet.",
         style=label.style_label_down, color=color.new(C_ROSE, 10), textcolor=color.white)


// ============================================================================
// === SIZING =================================================================
// ============================================================================
f_calcQty(_slDistPrice) =>
    float _q = polOn ? polQty : contractSize
    if sizingMode != "Fixed contracts"
        float _riskUSD = sizingMode == "Fixed $ risk" ? riskValue : strategy.equity * riskValue / 100.0
        float _perUnit = _slDistPrice * syminfo.pointvalue
        _q := _perUnit > 0 ? _riskUSD / _perUnit : 0.0
    _q := math.min(_q, maxQty)
    allowFractionalQty ? math.round(_q, 4) : math.floor(_q)

// ============================================================================
// === SIGNAL =================================================================
// ============================================================================
isFlat = strategy.position_size == 0 and strategy.opentrades == 0
var bool posRiskOff = false

// --- POSITIE-GATE MET RICHTING ----------------------------------------------------------------
// Apex staat geen twee tegengestelde open orders toe. De gate kende geen richting, dus zodra een
// positie risk-off was stond hij voor BEIDE kanten open en liet een tegengesteld signaal
// strategy.entry de positie reverseren. Regel: flat = beide richtingen; in positie zonder
// risk-off = niets; in positie met risk-off = alleen dezelfde kant als de open positie.
int  posDir      = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
bool gateAnyDir  = isFlat
bool gateSameDir = not isFlat and posRiskOff
f_gateFor(int _dir) => gateAnyDir or (gateSameDir and _dir == posDir)

bool long0  = bullCandle and bullCvdPass and canLong  and vetoLongOK  and sweepLongOK and canTrade and barstate.isconfirmed
bool short0 = bearCandle and bearCvdPass and canShort and vetoShortOK and sweepShortOK and canTrade and barstate.isconfirmed

// === v6.1: FVG CONFIRMATION MEMORY ==========================================
var array<int>   memBar = array.new<int>()
var array<int>   memDir = array.new<int>()
var array<float> memMid = array.new<float>()
var array<float> memTop = array.new<float>()
var array<float> memBot = array.new<float>()
int   memSigDir = 0
float memSigMid = na
float memSigTop = na
float memSigBot = na
int   memSigAge = 0
if confirmBars > 0 and barstate.isconfirmed
    bool _pruning = true
    while _pruning
        if array.size(memBar) == 0
            _pruning := false
        else if bar_index - array.get(memBar, 0) > confirmBars
            array.shift(memBar)
            array.shift(memDir)
            array.shift(memMid)
            array.shift(memTop)
            array.shift(memBot)
        else
            _pruning := false

    if useFillCheck and array.size(memBar) > 0
        int _m = array.size(memBar)
        for _p = _m - 1 to 0
            float _gmid = array.get(memMid, _p)
            if low <= _gmid and high >= _gmid
                array.remove(memBar, _p)
                array.remove(memDir, _p)
                array.remove(memMid, _p)
                array.remove(memTop, _p)
                array.remove(memBot, _p)
    bool gateMemOK = (gateAnyDir or gateSameDir) and canTrade
    if not (long0 or short0) and gateMemOK and array.size(memBar) > 0
        int _n = array.size(memBar)
        for _j = 0 to _n - 1
            int _k = _n - 1 - _j
            int _age = bar_index - array.get(memBar, _k)
            if _age >= 1 and _age <= confirmBars
                int _d = array.get(memDir, _k)
                bool _ok = _d == 1 ? (bullCvdPass and canLong and vetoLongOK and sweepLongOK) :
                     (bearCvdPass and canShort and vetoShortOK and sweepShortOK)
                if _ok
                    memSigDir := _d
                    memSigMid := array.get(memMid, _k)
                    memSigTop := array.get(memTop, _k)
                    memSigBot := array.get(memBot, _k)
                    memSigAge := _age
                    array.remove(memBar, _k)
                    array.remove(memDir, _k)
                    array.remove(memMid, _k)
                    array.remove(memTop, _k)
                    array.remove(memBot, _k)
                    break
    bool consumed0 = (long0 and f_gateFor(1)) or (short0 and f_gateFor(-1))
    if fvgDirection != 0 and fvgPasses and not consumed0
        array.push(memBar, bar_index)
        array.push(memDir, fvgDirection)
        array.push(memMid, fvgMid)
        array.push(memTop, fvgTop)
        array.push(memBot, fvgBottom)

longSignal  = long0  or memSigDir == 1
shortSignal = short0 or memSigDir == -1
float sigGapMid = (long0 or short0) ? fvgMid    : memSigMid
float sigGapTop = (long0 or short0) ? fvgTop    : memSigTop
float sigGapBot = (long0 or short0) ? fvgBottom : memSigBot

float sigFvgTicks = not na(sigGapTop) and not na(sigGapBot) ? math.abs(sigGapTop - sigGapBot) / syminfo.mintick : na
int   sigStreakLen = longSignal ? nz(barsSinceNotBull, 0) : shortSignal ? nz(barsSinceNotBear, 0) : 0
int   sigFvgAge = (long0 or short0) ? 0 : memSigAge
string sigDiag = "FVG" + str.tostring(sigFvgTicks, "#") + "|CVD" + str.tostring(sigStreakLen) + "|AGE" + str.tostring(sigFvgAge) + "|H" + str.tostring(hour(time, activeTz)) + "|D" + str.tostring(dayofweek(time, activeTz))

bool isLimitMode = entryMode == "Limit @ 50% FVG"
float sigEntryPx = isLimitMode ? sigGapMid : close
float sigStopPx = na
if longSignal
    sigStopPx := stopMode == "Swing structure" ? math.min(nz(lastPivLow, sigGapBot), sigGapBot) - f_distPrice(swingBufSize) : sigEntryPx - f_distPrice(slSizeLegacy)
if shortSignal
    sigStopPx := stopMode == "Swing structure" ? math.max(nz(lastPivHigh, sigGapTop), sigGapTop) + f_distPrice(swingBufSize) : sigEntryPx + f_distPrice(slSizeLegacy)
float sigStopDist = math.abs(sigEntryPx - sigStopPx)
bool stopValid = not na(sigStopPx) and sigStopDist > syminfo.mintick and sigStopDist <= (polOn ? polMaxStopT * syminfo.mintick : f_distPrice(maxStopSize))
float sigQty = f_calcQty(sigStopDist)
bool qtyOk = sigQty >= (allowFractionalQty ? 1e-4 : 1.0)

bool maeActive = useMaeGuard and isPA
float maeQtyMax = maeActive and sigStopDist > 0 ? math.floor(maeAllowUSD / (sigStopDist * syminfo.pointvalue)) : 1e9
bool maeGuardOK = not maeActive or maeQtyMax >= 1
float _lwProg = evalTrack and evalStarted and evalProfitTgt > 0 and not na(evalBal) ? (evalBal - evalStartBal) / evalProfitTgt : 0.0
float _prog = isEval and acctGoal > 0 ? acctRealized / acctGoal : _lwProg
float sigQtyCap = maeActive ? math.max(maeQtyMax, 0) : 1e9
float sigQtyEff = math.min(sigQty, sigQtyCap)

f_tpFixDist(_q) =>
    float _d = f_distPrice(tpSizeEff)
    math.max(_d, 4 * syminfo.mintick)

float sigTpPx = na
if longSignal or shortSignal
    int _d = longSignal ? 1 : -1
    sigTpPx := tpModeEff == "Swing structure" ? (_d == 1 ? lastPivHigh : lastPivLow) :
         tpModeEff == "R-multiple" ? sigEntryPx + _d * rMultIn * sigStopDist :
         sigEntryPx + _d * f_tpFixDist(sigQtyEff)
bool tpValid = not na(sigTpPx) and (longSignal ? sigTpPx > sigEntryPx + syminfo.mintick : sigTpPx < sigEntryPx - syminfo.mintick)

float nextTradeRisk = sigStopDist * sigQtyEff * syminfo.pointvalue
bool ddGuardOK = not phaseOn or not useDDGuard or (not na(ddRoom) and ddRoom >= nextTradeRisk * guardMult)

// ============================================================================
// === ALERT BUILDERS =========================================================
// ============================================================================
f_trailOn(_slD) => useTrailEff and _slD > 0
f_pmtJSON(_action, _qty, _price, _slD, _tpD, _ordType) =>
    "{" + "\"symbol\":\"" + syminfo.ticker + "\",\"date\":\"" + str.format("{0,date,yyyy-MM-dd HH:mm:ss}", timenow) + "\",\"data\":\"" + _action + "\",\"quantity\":\"" + str.tostring(_qty) + "\",\"risk_percentage\":0,\"price\":\"" + str.tostring(_price) + "\",\"tp\":0,\"percentage_tp\":0,\"dollar_tp\":" + str.tostring(_tpD) + ",\"sl\":0,\"dollar_sl\":" + str.tostring(_slD) + ",\"percentage_sl\":0,\"trail\":" + (f_trailOn(_slD) ? "1" : "0") + ",\"trail_stop\":" + str.tostring(f_trailOn(_slD) ? f_distPrice(trBufEff) : 0) + ",\"trail_trigger\":" + str.tostring(f_trailOn(_slD) ? f_distPrice(trStartEff) : 0) + ",\"trail_freq\":" + str.tostring(f_trailOn(_slD) ? f_distPrice(trailUpdateStep) : 0) + ",\"update_tp\":false,\"update_sl\":false,\"breakeven\":" + ((useBEeff and _slD > 0) ? str.tostring(f_distPrice(beTrigEff)) : "0") + ",\"token\":\"" + pmtToken + "\",\"pyramid\":false,\"reverse_order_close\":true,\"order_type\":\"" + _ordType + "\",\"multiple_accounts\":[{\"token\":\"" + pmtToken + "\",\"account_id\":\"" + accountID + "\",\"risk_percentage\":0,\"quantity_multiplier\":1}]}"
f_pcSym() => str.length(pcSymbol) > 0 ? pcSymbol : syminfo.ticker
f_sendExec(_action, _qty, _price, _slD, _tpD, _ordType) =>
    bool _pmtRoute = usePMT or useRithmic
    if _pmtRoute and pmtBlock and _action != "close"
        label.new(bar_index, high, "⛔ PMT BLOCKED — " + pmtBlockReason, style=label.style_label_down, color=color.new(C_ROSE, 20), textcolor=color.white, size=size.small)
    if _pmtRoute and (not pmtBlock or _action == "close")
        alert(f_pmtJSON(_action, _qty, _price, _slD, _tpD, _ordType), alert.freq_once_per_bar)
    // PineConnector (MT4/5): comma command "{license},{buy|sell|exit},{symbol}[,sl=,tp=,risk=]".
    // _slD/_tpD are PRICE distances at the call site -> reconstruct absolute SL/TP prices.
    if usePineConnector
        if _action == "close"
            alert(pcLicense + ",exit," + f_pcSym(), alert.freq_once_per_bar)
        else
            float _slPx = _action == "buy" ? _price - _slD : _price + _slD
            float _tpPx = _action == "buy" ? _price + _tpD : _price - _tpD
            alert(pcLicense + "," + _action + "," + f_pcSym() + ",sl=" + str.tostring(_slPx, format.mintick) + ",tp=" + str.tostring(_tpPx, format.mintick) + ",risk=" + str.tostring(pcRisk), alert.freq_once_per_bar)
    if useMiddleware
        string _mwEv = _action == "close" ? "EXIT" : "ENTRY"
        alert("{\"secret\":\"" + mwSecret + "\",\"strategy\":\"" + mwStrategy + "\",\"event\":\"" + _mwEv + "\",\"action\":\"" + _action + "\",\"symbol\":\"" + syminfo.ticker + "\",\"price\":" + str.tostring(_price) + ",\"order_type\":\"" + _ordType + "\",\"dollar_sl\":" + str.tostring(_slD) + ",\"dollar_tp\":" + str.tostring(_tpD) + ",\"qty\":" + str.tostring(_qty) + "}", alert.freq_once_per_bar)
f_sendDiscord(_title, _desc) =>
    if useDiscord
        _tag = roleID == "" ? "" : "\"content\":\"<@&" + roleID + ">\","

        _user = botName == "" ? "" : "\"username\":\"" + botName + "\","
        _ava  = avatarURL == "" ? "" : "\"avatar_url\":\"" + avatarURL + "\","
        _url  = titleURL == "" ? "" : "\"url\":\"" + titleURL + "\","
        alert("{" + _user + _ava + _tag + "\"embeds\":[{\"title\":\"" + _title + "\"," + _url + "\"color\":3447003,\"description\":\"" + _desc + "\",\"footer\":{\"text\":\"" + syminfo.ticker + "\"}}]}", alert.freq_once_per_bar)


f_evalTail(bool _started, float _dT, float _dF, string _acct) =>
    _started ?
         "\\n📍 " + _acct +
         (not na(_dT) ? " | →🎯 $" + str.tostring(_dT, "#") : "") +
         (not na(_dF) ? " | →⚠️ $" + str.tostring(_dF, "#") : "") +
         " (≈ benadering)" : ""

// === v6.0: order alert_message — same structure as the CSV journal + CFG ====
var string cfgStr = ""
if barstate.isfirst
    cfgStr := "ver=" + currentVersion + ";acct=" + jrnlAcct + ";qty=" + str.tostring(contractSize, "#.#") + ";entry=" + (isLimitMode ? "limit50" : "market") + ";expiry=" + str.tostring(expiryBars) + ";fvg=" + str.tostring(gapMinSize, "#") + "-" + str.tostring(gapMaxSize, "#") + ";confW=" + str.tostring(confirmBars) + ";stop=" + stopMode + ";pivK=" + str.tostring(pivotK) + ";buf=" + str.tostring(swingBufSize, "#") + ";maxStop=" + str.tostring(maxStopSize, "#") + ";tp=" + tpMode + (tpMode == "Fixed (units)" ? "(" + str.tostring(tpSize, "#") + ")" : "") + ";R=" + str.tostring(rMultIn, "#.#") + ";goalTp=0" + ";guard=" + (useDDGuard ? "1" : "0") + ";BEeff=" + (useBEeff ? str.tostring(beTrigEff, "#") + "/" + str.tostring(beOffEff, "#") : "off") + ";trailEff=" + (useTrailEff ? str.tostring(trStartEff, "#") + "/" + str.tostring(trBufEff, "#") : "off") + ";tpEff=" + tpModeEff + "(" + str.tostring(tpSizeEff, "#") + ")" + ";vwapVeto=" + (useVwapVeto ? "1" : "0") + ";cvd=" + (useCVDFilter ? "1" : "0") + ";streak=" + (useCvdStreak ? str.tostring(cvdTrendCount) : "off") + ";bias=" + (useBiasFilter ? "1" : "0") + ";sweep=" + (useSweepFilter ? "1" : "0") + ";monFilter=" + (skipMonEarly ? "1" : "0") + ";DLL=" + (enableDailyLossLimit ? str.tostring(dailyLossLimit, "#") : "off") + ";phase=" + accountPhase + ";mae=" + (useMaeGuard ? str.tostring(maeBasePct, "#") + "/" + str.tostring(maeGrownPct, "#") + "-m" + str.tostring(maeMarginPct, "#") : "off") + ";derisk=off" + ";deriskPA=off" + ";tz=" + activeTz

var bool cfgSent = false
if sendCfgOnStart and barstate.isrealtime and not cfgSent
    cfgSent := true
    if useJournal and not execInstance
        string _cfgRow = str.format("{0,date,yyyy-MM-dd HH:mm:ss}", timenow) + "," + accountID + "," + jrnlAcct + "," + syminfo.ticker + ",CONFIG,-,-,-,-,-,-,-,-," + cfgStr
        alert(jrnlJsonWrap ? "{\"type\":\"config\",\"csv\":\"" + _cfgRow + "\"}" : _cfgRow, alert.freq_once_per_bar)
    else if useDiscord
        f_sendDiscord("⚙️ " + syminfo.ticker + " CONFIG", cfgStr)
    else if plainAlertsOK
        alert(f_msgHead() + " | CONFIG | " + cfgStr, alert.freq_once_per_bar)

var bool payoutDiscordSent = false
if payoutReady and not payoutDiscordSent
    payoutDiscordSent := true
    f_sendDiscord("💰 " + syminfo.ticker + " PAYOUT " + str.tostring(effPayoutNr) + " READY", (useWaitForCap ? "FULL CAP $" + str.tostring(curLadderCap, "#") + " available | " : "") + "Withdrawable $" + str.tostring(withdrawable, "#") + " | realized $" + str.tostring(acctRealized, "#"))
var bool capLocked = false
if lockOnCap and isPA and useWaitForCap and not capLocked and strategy.position_size != 0
    float _lockBufC = lockBufTicks * syminfo.mintick * syminfo.pointvalue * math.abs(strategy.position_size)
    if (acctRealized + strategy.openprofit) - (acctTrailDD + 100) >= curLadderCap + _lockBufC
        capLocked := true
        exitReasonNext := "CAP-LOCK"
        strategy.close_all(comment="CAP-LOCK")
        f_sendExec("close", math.abs(strategy.position_size), close, 0, 0, "MKT")
        f_sendDiscord("🔐 " + syminfo.ticker + " CAP LOCK", "Projected withdrawable covers the FULL ladder cap (+" + str.tostring(lockBufTicks, "#") + "t cost buffer). Closing all — payout secured.")
if not payoutReady
    payoutDiscordSent := false


f_orderMsg(string _event, int _dir, float _entry, float _sl, float _tp, float _qty) =>
    not alertMsgAuto ? "" : _event + "," + (_dir == 1 ? "LONG" : "SHORT") + "," + jrnlAcct + "," + syminfo.ticker + "," + str.tostring(_entry, format.mintick) + "," + str.tostring(_sl, format.mintick) + "," + str.tostring(_tp, format.mintick) + "," + str.tostring(_qty, "#.##") + (alertIncludeCfg ? "|CFG|" + cfgStr : "")

f_journal(string _event, int _dir, string _status, float _entry, float _stop, float _target, float _qty, float _pnl, bool _started, float _bal, float _dT, float _dF, bool _regOn, bool _regFav) =>
    if useJournal and not execInstance
        _dirTxt = _dir == 1 ? "LONG" : _dir == -1 ? "SHORT" : "-"
        _reg = not _regOn ? "-" : _regFav ? "FAVORABLE" : "UNFAVORABLE"
        _balTxt = _started ? str.tostring(_bal, "#.##") : ""
        _dTTxt  = (_started and not na(_dT)) ? str.tostring(_dT, "#.##") : ""
        _dFTxt  = (_started and not na(_dF)) ? str.tostring(_dF, "#.##") : ""
        _row = str.format("{0,date,yyyy-MM-dd HH:mm:ss}", timenow) + "," + accountID + "," + jrnlAcct + "," +
             syminfo.ticker + "," + _event + "," + _dirTxt + "," + _status + "," +
             (na(_entry) ? "" : str.tostring(_entry, format.mintick)) + "," +
             (na(_stop) ? "" : str.tostring(_stop, format.mintick)) + "," +
             (na(_target) ? "" : str.tostring(_target, format.mintick)) + "," +
             (na(_qty) ? "" : str.tostring(_qty, "#.##")) + "," +
             (na(_pnl) ? "" : str.tostring(_pnl, "#.##")) + "," + _reg + "," +
             _balTxt + "," + _dTTxt + "," + _dFTxt
        alert(jrnlJsonWrap ? "{\"type\":\"journal\",\"csv\":\"" + _row + "\"}" : _row, alert.freq_once_per_bar)

// ============================================================================
// === ORDER ENGINE ===========================================================
// ============================================================================
var array<box> unfilledBoxes = array.new<box>()
f_markUnfilled(_fromBar, _px, _replaced) =>
    if showExpired and inDrawWin and not na(_px)
        _b = box.new(_fromBar, _px + 2 * syminfo.mintick, bar_index, _px - 2 * syminfo.mintick,
             border_color=_replaced ? color.new(C_GOLD, 30) : color.new(color.gray, 30),
             border_style=line.style_dashed, bgcolor=color.new(color.gray, 90),
             text=_replaced ? "↻" : "✕", text_color=color.new(color.gray, 20), text_size=size.tiny)
        array.push(unfilledBoxes, _b)
        if array.size(unfilledBoxes) > 60
            box.delete(array.shift(unfilledBoxes))

var int   pendDir = 0
var int   pendBar = na
var float pendLimit = na
var float pendStop = na
var float t_tpD = na
var float t_tpPx = na
var float t_qty = na

// "mag er überhaupt iets" — de blockers-tekst gebruikt dit; de order toetst per richting
gateOK = f_gateFor(1) or f_gateFor(-1)

// === v6.0: BLOCKERS ENGINE ==================================================
bool rawLong  = (bullCandle and bullCvdPass and canLong  and vetoLongOK  and sweepLongOK and barstate.isconfirmed) or memSigDir == 1
bool rawShort = (bearCandle and bearCvdPass and canShort and vetoShortOK and sweepShortOK and barstate.isconfirmed) or memSigDir == -1
f_persistentBlockers() =>
    string _b = ""
    if preStartBlock
        _b += "Before start date, "
    if monEarlyBlock
        _b += "Monday 00-02 ET, "
    else if not timeGatePass
        _b += "Time gate, "
    if inFlatWindow
        _b += "Flat window, "
    if dayHalted
        _b += "Day halt: " + haltReason + ", "
    if acctHalted
        _b += "Account: " + acctHaltReason + ", "
    _b
f_signalBlockers() =>
    string _b = ""
    if not maeGuardOK
        _b += "MAE guard (risk > cap), "
    if not ddGuardOK
        _b += "DD guard, "
    if not stopValid
        _b += "Stop invalid, "
    if not qtyOk
        _b += "Qty < 1, "
    _b
string persistBlk = f_persistentBlockers()
bool rawSig = rawLong or rawShort
string sigBlk = rawSig ? f_signalBlockers() : ""
bool rawDirBlocked = (rawLong and not f_gateFor(1)) or (rawShort and not f_gateFor(-1))
string occBlk = rawSig and rawDirBlocked ? (isFlat ? "" : (gateSameDir ? "In position (opposite), " : "In position, ")) : ""
string allBlk = persistBlk + sigBlk + occBlk
bool sigBlockedEvt = rawSig and not preStartBlock and (str.length(persistBlk) > 0 or str.length(sigBlk) > 0)
var string lastBlockedInfo = "—"
if sigBlockedEvt
    lastBlockedInfo := (rawLong ? "LONG " : "SHORT ") + str.format_time(time, "dd-MM HH:mm", "America/New_York") + " · " + str.substring(persistBlk + sigBlk, 0, math.max(0, str.length(persistBlk + sigBlk) - 2))
if sigBlockedEvt and notifyBlocked
    string _reasons = str.substring(persistBlk + sigBlk, 0, math.max(0, str.length(persistBlk + sigBlk) - 2))
    if plainAlertsOK
        alert(f_msgHead() + " | ⛔ SIGNAL BLOCKED | " + (rawLong ? "LONG" : "SHORT") + " " + syminfo.ticker + " | strategy rules met, blocked by: " + _reasons, alert.freq_once_per_bar)
    if useDiscord
        f_sendDiscord("⛔ " + syminfo.ticker + " SIGNAL BLOCKED", (rawLong ? "Long" : "Short") + " setup meets all strategy rules but was blocked by: " + _reasons)
if ((longSignal and f_gateFor(1)) or (shortSignal and f_gateFor(-1))) and stopValid and tpValid and qtyOk and ddGuardOK and maeGuardOK and (not onlyFirstTrade or not hasTraded)
    if isLimitMode and pendDir != 0
        f_markUnfilled(pendBar, pendLimit, true)
        // The replaced pending limit lives ON at the broker: TradingView swaps the order by id,
        // PMT does not — it only ever sees a new bracket. Cancel the old one before the new one
        // goes out, otherwise it stays live and a second position stacks on top of it.
        f_sendExec("close", t_qty, close, 0, 0, "MKT")
        f_sendDiscord("🚫 " + syminfo.ticker + " PENDING CANCELLED", "Superseded by a new signal — old limit @ " + str.tostring(pendLimit, format.mintick) + " cancelled at the broker.")
    t_tpD := f_tpFixDist(sigQtyEff)
    t_tpPx := sigTpPx
    t_qty := sigQtyEff
    pendDir := longSignal ? 1 : -1
    pendBar := bar_index
    if notifyStart and not startNotified
        startNotified := true
        f_sendDiscord("🚀 " + syminfo.ticker + " ACCOUNT STARTED", jrnlAcct + " | " + str.format_time(timenow, "yyyy-MM-dd HH:mm:ss", activeTz) + " | regime " + (useRegime ? (regimeFav ? "FAVORABLE" : "UNFAVORABLE") : "off") + " | first order: " + (longSignal ? "LONG " : "SHORT ") + str.tostring(t_qty, "#.##") + "ct @ " + str.tostring(isLimitMode ? sigEntryPx : close, format.mintick))
    pendLimit := isLimitMode ? sigEntryPx : na
    pendStop := sigStopPx
    if longSignal
        if isLimitMode
            strategy.entry("Long", strategy.long, qty=t_qty, limit=pendLimit, comment=sigDiag + "|SL" + str.tostring(sigStopDist / syminfo.mintick, "#") + "t", alert_message=f_orderMsg("ENTRY", 1, pendLimit, pendStop, t_tpPx, t_qty))
            strategy.exit("XL", from_entry="Long", stop=pendStop, limit=t_tpPx, alert_message=f_orderMsg("EXIT", 1, pendLimit, pendStop, t_tpPx, t_qty))
        else
            strategy.entry("Long", strategy.long, qty=t_qty, comment=sigDiag + "|SL" + str.tostring(sigStopDist / syminfo.mintick, "#") + "t", alert_message=f_orderMsg("ENTRY", 1, close, pendStop, t_tpPx, t_qty))
            strategy.exit("XL", from_entry="Long", stop=pendStop, limit=t_tpPx, alert_message=f_orderMsg("EXIT", 1, close, pendStop, t_tpPx, t_qty))
        f_sendExec("buy", t_qty, isLimitMode ? pendLimit : close, sigStopDist, math.abs(t_tpPx - sigEntryPx), isLimitMode ? "LMT" : "MKT")
        f_sendDiscord("📈 " + syminfo.ticker + " LONG " + (isLimitMode ? "LIMIT" : "MARKET"),
             "Entry " + str.tostring(sigEntryPx, format.mintick) + " | Stop " + str.tostring(pendStop, format.mintick) + " | TP " + str.tostring(t_tpPx, format.mintick) + " (" + tpMode + ")" + " | Qty " + str.tostring(t_qty) + " | " + phase + f_evalTail(evalStarted, distTarget, distFail, jrnlAcct))
    if shortSignal
        if isLimitMode
            strategy.entry("Short", strategy.short, qty=t_qty, limit=pendLimit, comment=sigDiag + "|SL" + str.tostring(sigStopDist / syminfo.mintick, "#") + "t", alert_message=f_orderMsg("ENTRY", -1, pendLimit, pendStop, t_tpPx, t_qty))
            strategy.exit("XS", from_entry="Short", stop=pendStop, limit=t_tpPx, alert_message=f_orderMsg("EXIT", -1, pendLimit, pendStop, t_tpPx, t_qty))
        else
            strategy.entry("Short", strategy.short, qty=t_qty, comment=sigDiag + "|SL" + str.tostring(sigStopDist / syminfo.mintick, "#") + "t", alert_message=f_orderMsg("ENTRY", -1, close, pendStop, t_tpPx, t_qty))
            strategy.exit("XS", from_entry="Short", stop=pendStop, limit=t_tpPx, alert_message=f_orderMsg("EXIT", -1, close, pendStop, t_tpPx, t_qty))
        f_sendExec("sell", t_qty, isLimitMode ? pendLimit : close, sigStopDist, math.abs(t_tpPx - sigEntryPx), isLimitMode ? "LMT" : "MKT")
        f_sendDiscord("📉 " + syminfo.ticker + " SHORT " + (isLimitMode ? "LIMIT" : "MARKET"),
             "Entry " + str.tostring(sigEntryPx, format.mintick) + " | Stop " + str.tostring(pendStop, format.mintick) + " | TP " + str.tostring(t_tpPx, format.mintick) + " (" + tpMode + ")" + " | Qty " + str.tostring(t_qty) + " | " + phase + f_evalTail(evalStarted, distTarget, distFail, jrnlAcct))

if isFlat and pendDir != 0 and (bar_index - pendBar > expiryBars or inFlatWindow or dayHalted)
    strategy.cancel("Long")
    strategy.cancel("Short")
    f_markUnfilled(pendBar, pendLimit, false)
    f_sendExec("close", t_qty, close, 0, 0, "MKT")
    f_sendDiscord("⏳ " + syminfo.ticker + " LIMIT EXPIRED", "Pending " + (pendDir == 1 ? "long" : "short") + " cancelled @ " + str.tostring(pendLimit, format.mintick))
    f_journal("EXPIRED", pendDir, "NOT_FILLED", pendLimit, pendStop, float(na), t_qty, float(na), evalStarted, evalBal, distTarget, distFail, useRegime, regimeFav)
    pendDir := 0
    pendLimit := na
    pendStop := na

// ============================================================================
// === POSITION MANAGEMENT ====================================================
// ============================================================================
posSize = strategy.position_size
inLong  = posSize > 0
inShort = posSize < 0
entryAvg = strategy.position_avg_price
var float jEntryPx = na
if strategy.position_size != 0 and not na(entryAvg)
    jEntryPx := entryAvg
var float posHi = na
var float posLo = na
var float curStop = na
var float curLimit = na
newLong  = posSize > 0 and nz(posSize[1]) <= 0
newShort = posSize < 0 and nz(posSize[1]) >= 0
flatNow  = posSize == 0

if flatNow
    posRiskOff := false

if newLong or newShort
    pendDir := 0
    hasTraded := true
    posHi := newLong  ? math.max(entryAvg, close) : high
    posLo := newShort ? math.min(entryAvg, close) : low
    curStop  := pendStop
    float _riskFill = math.abs(entryAvg - pendStop)
    curLimit := tpModeEff == "Swing structure" ? t_tpPx :
         tpModeEff == "R-multiple" ? (newLong ? entryAvg + rMultIn * _riskFill : entryAvg - rMultIn * _riskFill) :
         (newLong ? entryAvg + t_tpD : entryAvg - t_tpD)
    if newLong
        strategy.exit("XL", from_entry="Long", stop=curStop, limit=curLimit, alert_message=f_orderMsg("EXIT", 1, entryAvg, curStop, curLimit, math.abs(posSize)))
    if newShort
        strategy.exit("XS", from_entry="Short", stop=curStop, limit=curLimit, alert_message=f_orderMsg("EXIT", -1, entryAvg, curStop, curLimit, math.abs(posSize)))
    f_journal("FILL", newLong ? 1 : -1, "FILLED", entryAvg, curStop, curLimit, math.abs(posSize), float(na), evalStarted, evalBal, distTarget, distFail, useRegime, regimeFav)
    if notifyFills
        posTrailOn := false
        posRecovOn := false
        exitReasonNext := ""
        f_sendDiscord((newLong ? "📥 " : "📥 ") + syminfo.ticker + " FILL " + (newLong ? "LONG" : "SHORT"), jrnlAcct + " | " + str.tostring(math.abs(posSize), "#.##") + "ct @ " + str.tostring(entryAvg, format.mintick) + " | SL " + str.tostring(curStop, format.mintick) + " | TP " + str.tostring(curLimit, format.mintick))

var box zoneRisk = na
var box zoneReward = na
var label tradeInfo = na
if strategy.closedtrades > lastClosedSeen
    int _ci = strategy.closedtrades - 1
    float _cp = strategy.closedtrades.profit(_ci)
    attemptTradeNo := attemptTradeNo + 1
    if attemptTradeNo == 1 and _cp < 0
        attemptFirstLoss := true
    lastClosedSeen := strategy.closedtrades
var array<box>   drawHistB = array.new<box>()
var array<label> drawHistL = array.new<label>()
f_capDrawings() =>
    while array.size(drawHistB) > 40
        box.delete(array.shift(drawHistB))
    while array.size(drawHistL) > 80
        label.delete(array.shift(drawHistL))
if showExitLabels and flatNow and nz(posSize[1]) != 0 and strategy.closedtrades > 0 and inDrawWin

    int   _ti  = strategy.closedtrades - 1
    float _xp  = strategy.closedtrades.exit_price(_ti)
    float _ep  = strategy.closedtrades.entry_price(_ti)
    float _pf  = strategy.closedtrades.profit(_ti)
    bool  _wasLong = nz(posSize[1]) > 0
    bool  _win = _pf >= 0
    int   _x0  = strategy.closedtrades.entry_bar_index(_ti)
    int   _xm  = math.round(math.avg(_x0, bar_index))

    if not na(zoneRisk)
        box.set_right(zoneRisk, bar_index)
        box.set_right(zoneReward, bar_index)
        array.push(drawHistB, zoneRisk)
        array.push(drawHistB, zoneReward)
    if not na(zoneRisk)
        float _slLvl = _wasLong ? box.get_bottom(zoneRisk) : box.get_top(zoneRisk)
        int   _slT   = math.round(math.abs(_ep - _slLvl) / syminfo.mintick)
        array.push(drawHistL, label.new(_xm, math.avg(_ep, _slLvl), "SL " + str.tostring(_slT) + "t · $" +
             str.tostring(math.abs(_ep - _slLvl) * syminfo.pointvalue, "#"),
             style=label.style_none, textcolor=vNegTxt, size=size.small, textalign=text.align_center))
    if not na(zoneReward)
        float _tpLvl = _wasLong ? box.get_top(zoneReward) : box.get_bottom(zoneReward)
        int   _tpT   = math.round(math.abs(_tpLvl - _ep) / syminfo.mintick)
        array.push(drawHistL, label.new(_xm, math.avg(_ep, _tpLvl), "TP " + str.tostring(_tpT) + "t · $" +
             str.tostring(math.abs(_tpLvl - _ep) * syminfo.pointvalue, "#"),
             style=label.style_none, textcolor=vPosTxt, size=size.small, textalign=text.align_center))
    array.push(drawHistL, label.new(_xm, _xp, text=(_win ? "+$" : "-$") + str.tostring(math.abs(_pf), "#.0"),
         style=_wasLong == _win ? label.style_label_down : label.style_label_up,
         color=_win ? color.new(C_AZURE, 20) : color.new(C_ROSE, 20),
         textcolor=color.white, size=size.small))
    f_capDrawings()

if flatNow and nz(posSize[1]) != 0 and strategy.closedtrades > 0
    float _jxp  = strategy.closedtrades.exit_price(strategy.closedtrades - 1)
    float _jpnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    int   _jdir = nz(posSize[1]) > 0 ? 1 : -1
    f_journal("EXIT", _jdir, "CLOSED", float(na), float(na), _jxp, float(na), _jpnl, evalStarted, evalBal, distTarget, distFail, useRegime, regimeFav)
    float _xmfeT = (_jdir == 1 ? nz(posHi, _jxp) - nz(jEntryPx, _jxp) : nz(jEntryPx, _jxp) - nz(posLo, _jxp)) / syminfo.mintick
    float _xmaeT = (_jdir == 1 ? nz(jEntryPx, _jxp) - nz(posLo, nz(jEntryPx, _jxp)) : nz(posHi, nz(jEntryPx, _jxp)) - nz(jEntryPx, _jxp)) / syminfo.mintick
    bool _tpHit = not na(curLimit) and (_jdir == 1 ? _jxp >= curLimit - 2 * syminfo.mintick : _jxp <= curLimit + 2 * syminfo.mintick)
    string _xr = exitReasonNext != "" ? exitReasonNext : _tpHit ? "TP" : posRecovOn ? "RECOV-TRAIL" : posTrailOn ? "TRAIL" : posRiskOff ? "BE-STOP" : "SL"
    exitReasonNext := ""
    if notifyFills
        f_sendDiscord("📤 " + syminfo.ticker + " EXIT " + (_jpnl >= 0 ? "🟢" : "🔴"), jrnlAcct + " | " + (_jdir == 1 ? "long" : "short") + " closed @ " + str.tostring(_jxp, format.mintick) + " | " + _xr + " | PnL " + (_jpnl >= 0 ? "+$" : "-$") + str.tostring(math.abs(_jpnl), "#.##") + " | MFE " + str.tostring(_xmfeT, "#") + "t · MAE " + str.tostring(_xmaeT, "#") + "t")

if flatNow and not (newLong or newShort)
    posHi := na
    posLo := na
    curStop := na
    curLimit := na

if inLong and not newLong
    posHi := math.max(nz(posHi, close), high)
    posLo := math.min(nz(posLo, low), low)
if inShort and not newShort
    posHi := math.max(nz(posHi, high), high)
    posLo := math.min(nz(posLo, close), low)

if inLong
    float mfe = posHi - entryAvg
    float cand = curStop
    if useBEeff and mfe >= f_distPrice(beTrigEff)
        cand := math.max(cand, entryAvg + f_distPrice(beOffEff))
        if not posRiskOff
            posRiskOff := true
            if notifyRiskOff
                f_sendDiscord("🛡️ " + syminfo.ticker + " RISK OFF", "Long moved to break-even (+" + str.tostring(beOffsetSize) + "). Initial risk off the table." + f_evalTail(evalStarted, distTarget, distFail, jrnlAcct))
                f_journal("RISKOFF", 1, "BE", entryAvg, cand, curLimit, math.abs(posSize), float(na), evalStarted, evalBal, distTarget, distFail, useRegime, regimeFav)
    if useTrailEff and mfe >= f_distPrice(trStartEff)
        cand := math.max(cand, posHi - f_distPrice(trBufEff))
        if not posTrailOn
            posTrailOn := true
            if notifyRiskOff
                f_sendDiscord("🎯 " + syminfo.ticker + " TRAIL ACTIVE", "Long trail armed — stop now tracks the peak.")

    if useRecovTrail and isEval and attemptTradeNo == 1 and attemptFirstLoss and mfe >= f_distPrice(recovTrailStart)
        cand := math.max(cand, posHi - f_distPrice(recovTrailBuf))
        posRecovOn := true
    curStop := math.max(nz(curStop, cand), cand)
    string _xcL = "MFE" + str.tostring(mfe / syminfo.mintick, "#") + "t|MAE" + str.tostring(math.max(entryAvg - nz(posLo, entryAvg), 0) / syminfo.mintick, "#") + "t"
    strategy.exit("XL", from_entry="Long", stop=curStop, limit=curLimit, comment_profit="TP|" + _xcL, comment_loss=(posRecovOn ? "RECOV|" : posTrailOn ? "TRAIL|" : posRiskOff ? "BE|" : "SL|") + _xcL)
if inShort
    float mfe = entryAvg - posLo
    float cand = curStop
    if useBEeff and mfe >= f_distPrice(beTrigEff)
        cand := math.min(cand, entryAvg - f_distPrice(beOffEff))
        if not posRiskOff
            posRiskOff := true
            if notifyRiskOff
                f_sendDiscord("🛡️ " + syminfo.ticker + " RISK OFF", "Short moved to break-even (+" + str.tostring(beOffsetSize) + "). Initial risk off the table." + f_evalTail(evalStarted, distTarget, distFail, jrnlAcct))
                f_journal("RISKOFF", -1, "BE", entryAvg, cand, curLimit, math.abs(posSize), float(na), evalStarted, evalBal, distTarget, distFail, useRegime, regimeFav)
    if useTrailEff and mfe >= f_distPrice(trStartEff)
        cand := math.min(cand, posLo + f_distPrice(trBufEff))
        if not posTrailOn
            posTrailOn := true
            if notifyRiskOff
                f_sendDiscord("🎯 " + syminfo.ticker + " TRAIL ACTIVE", "Short trail armed — stop now tracks the peak.")

    if useRecovTrail and isEval and attemptTradeNo == 1 and attemptFirstLoss and mfe >= f_distPrice(recovTrailStart)
        cand := math.min(cand, posLo + f_distPrice(recovTrailBuf))
        posRecovOn := true
    curStop := math.min(nz(curStop, cand), cand)
    string _xcS = "MFE" + str.tostring(mfe / syminfo.mintick, "#") + "t|MAE" + str.tostring(math.max(nz(posHi, entryAvg) - entryAvg, 0) / syminfo.mintick, "#") + "t"
    strategy.exit("XS", from_entry="Short", stop=curStop, limit=curLimit, comment_profit="TP|" + _xcS, comment_loss=(posRecovOn ? "RECOV|" : posTrailOn ? "TRAIL|" : posRiskOff ? "BE|" : "SL|") + _xcS)

if barstate.isconfirmed and inFlatWindow and not flattenedToday
    flattenedToday := true
    if posSize != 0
        strategy.close_all(comment="Auto Flat")
        f_sendExec("close", t_qty, close, 0, 0, "MKT")
        exitReasonNext := "AUTO-FLAT"
    f_sendDiscord("🕔 " + syminfo.ticker + " AUTO FLAT", "Forced flat @ ~" + str.tostring(close, format.mintick))

var bool haltCloseSent = false
if isNewTradingDay
    haltCloseSent := false
if dayHalted and not haltCloseSent
    haltCloseSent := true
    strategy.cancel("Long")
    strategy.cancel("Short")
    pendDir := 0
    if posSize != 0
        strategy.close_all(comment=haltReason)
        f_sendExec("close", t_qty, close, 0, 0, "MKT")
    exitReasonNext := haltReason
    f_sendDiscord("🔒 " + syminfo.ticker + " DAY HALT", haltReason + " | Today: $" + str.tostring(todayRealizedPnL, "#.##"))
    if plainAlertsOK
        alert(f_msgHead() + " | 🔒 DAY HALT (" + haltReason + ") | PnL $" + str.tostring(todayRealizedPnL, "#.##"), alert.freq_once_per_bar)

var bool acctCloseSent = false
if acctHalted and not acctCloseSent
    acctCloseSent := true
    strategy.cancel("Long")
    strategy.cancel("Short")
    pendDir := 0
    if posSize != 0
        strategy.close_all(comment=acctHaltReason)
        f_sendExec("close", t_qty, close, 0, 0, "MKT")
    exitReasonNext := "ACCOUNT-HALT"
    f_sendDiscord("🏁 " + syminfo.ticker + " ACCOUNT HALT", acctHaltReason + " | acct PnL $" + str.tostring(acctRealized, "#"))
    if plainAlertsOK
        alert(f_msgHead() + " | 🏁 " + acctHaltReason + " | acct PnL $" + str.tostring(acctRealized, "#"), alert.freq_once_per_bar)

// ============================================================================
// === v5: EVAL / PA TRACKING =================================================
// ============================================================================
var float evalPeak      = na
var float evalEodPeak   = na
var float evalFloor     = na
var bool  evalPassed    = false
var bool  evalFailed    = false

bool evalAtStart = evalTrack and not evalStarted and time >= evalStartTime
if evalAtStart
    evalStarted   := true
    evalPeak      := evalStartBal
    evalEodPeak   := evalStartBal
    evalFloor     := evalTrailDD > 0 ? evalStartBal - evalTrailDD : na

var float evalClosedPnL = 0.0
var int   evalLastCount = 0
if evalStarted and strategy.closedtrades > evalLastCount
    for i = evalLastCount to strategy.closedtrades - 1
        float _xt = strategy.closedtrades.exit_time(i)
        if _xt >= evalStartTime and (not evalUseEnd or _xt <= evalEndTime)
            evalClosedPnL := evalClosedPnL + strategy.closedtrades.profit(i)
    evalLastCount := strategy.closedtrades

float evalOpenPnL = (evalStarted and strategy.position_size != 0 and strategy.opentrades > 0 and strategy.opentrades.entry_time(0) >= evalStartTime) ? strategy.openprofit : 0.0

evalBal := evalStarted ? evalStartBal + evalClosedPnL + evalOpenPnL : na

float evalGain = evalStarted ? evalClosedPnL + evalOpenPnL : na

distTarget := (evalStarted and evalProfitTgt > 0) ? evalProfitTgt - evalGain : na
distFail   := (evalStarted and evalTrailDD > 0 and not na(evalFloor)) ? evalBal - evalFloor : na

if evalTrack and evalStarted and not evalPassed and not evalFailed
    evalPeak := math.max(nz(evalPeak, evalStartBal), evalBal)
    if evalTrailDD > 0 and not evalTrailEod
        evalFloor := math.max(nz(evalFloor, evalStartBal - evalTrailDD), evalPeak - evalTrailDD)
    if evalTrailDD > 0 and evalTrailEod and isNewTradingDay
        evalEodPeak := math.max(nz(evalEodPeak, evalStartBal), evalBal)
        evalFloor := math.max(nz(evalFloor, evalStartBal - evalTrailDD), evalEodPeak - evalTrailDD)
    if evalProfitTgt > 0 and evalGain >= evalProfitTgt
        evalPassed := true
        attemptTradeNo := 0
        attemptFirstLoss := false
        if notifyEval
            f_sendDiscord("🎉🏆 " + syminfo.ticker + " PASSED", "Profit target reached! Gain $" + str.tostring(evalGain, "#") + " ≥ $" + str.tostring(evalProfitTgt, "#") + " (balance $" + str.tostring(evalBal, "#") + "). Account funded! 🚀")
    if not evalPassed and evalTrailDD > 0 and not na(evalFloor) and evalBal <= evalFloor
        evalFailed := true
        attemptTradeNo := 0
        attemptFirstLoss := false
        if notifyEval
            f_sendDiscord("💀 " + syminfo.ticker + " FAILED", "Trailing drawdown hit. Balance $" + str.tostring(evalBal, "#") + " ≤ floor $" + str.tostring(evalFloor, "#") + ". Account blown. 🪦")


plotshape(showSignals and shortSignal, "Short Signal", shape.triangledown, location.abovebar, color=color.new(C_ROSE, 0), size=size.small)
bool pendingActive = isFlat and pendDir != 0
plot(showPending and pendingActive ? pendLimit : na, "Pending Limit", color=color.new(C_GOLD, 0), style=plot.style_circles, linewidth=2)
plot(showPending and pendingActive ? pendStop : na, "Planned Stop", color=color.new(C_ROSE, 50), style=plot.style_circles, linewidth=1)
plot(showTradeLevels and not flatNow ? curStop : na, "Active Stop", color=color.new(C_ROSE, 0), style=plot.style_linebr, linewidth=2)
plot(showTradeLevels and not flatNow ? curLimit : na, "Take Profit", color=color.new(C_AZURE, 0), style=plot.style_linebr, linewidth=2)
plot(showTradeLevels and not flatNow ? entryAvg : na, "Entry", color=color.new(C_SAND, 0), style=plot.style_linebr, linewidth=1)
plot(vwapVal, "VWAP", color=color.new(C_GOLDD, 40), linewidth=1)
// === v6.0: FULL-LOGIC GATE VISUALISATION ====================================
bool gateLongOpen  = canTrade and bullCvdPass and canLong  and vetoLongOK  and sweepLongOK
bool gateShortOpen = canTrade and bearCvdPass and canShort and vetoShortOK and sweepShortOK
color _gateAmber = visIsDark ? #C9A227 : #8F6400
int _flashT = math.max(70, gateBgTransp - 8)
color gateBgCol = sigBlockedEvt ? color.new(_gateAmber, _flashT) :
     gateLongOpen and gateShortOpen ? color.new(_gateAmber, gateBgTransp) :
     gateLongOpen ? color.new(vPOS, gateBgTransp) :
     gateShortOpen ? color.new(vNEG, gateBgTransp) : na
bgcolor(showGateBg ? gateBgCol : na, title="Strategy gate")
// === v5.5: TRADE-ZONES (licht gevulde entry<->SL en entry<->TP banden) ======
if (newLong or newShort)
    if showTradeZones and inDrawWin
        zoneRisk := box.new(bar_index, math.max(entryAvg, curStop), bar_index, math.min(entryAvg, curStop), border_width=0, bgcolor=zRiskBg)
        zoneReward := box.new(bar_index, math.max(entryAvg, curLimit), bar_index, math.min(entryAvg, curLimit), border_width=0, bgcolor=zRewardBg)
    if showTradeLabels and inDrawWin
        tradeInfo := label.new(bar_index + 2, entryAvg, "", style=label.style_none, textcolor=vText, size=size.small, textalign=text.align_left)
        array.push(drawHistL, tradeInfo)
if not flatNow and posSize != 0
    if showTradeZones and not na(zoneRisk)
        box.set_right(zoneRisk, bar_index)
        box.set_top(zoneRisk, math.max(entryAvg, curStop))
        box.set_bottom(zoneRisk, math.min(entryAvg, curStop))
        box.set_right(zoneReward, bar_index)
    if showTradeLabels and not na(tradeInfo)
        int _slT = math.round(math.abs(entryAvg - curStop) / syminfo.mintick)
        float _riskUsd = math.abs(entryAvg - curStop) * syminfo.pointvalue * math.abs(posSize)
        float _rr = math.abs(entryAvg - curStop) > syminfo.mintick / 2 ? math.abs(curLimit - entryAvg) / math.abs(entryAvg - curStop) : na
        label.set_xy(tradeInfo, bar_index + 2, entryAvg)
        label.set_textcolor(tradeInfo, vText)
        label.set_text(tradeInfo,
             (posSize > 0 ? "▲ LONG " : "▼ SHORT ") + str.tostring(math.abs(posSize), "#") + "ct @ " + str.tostring(entryAvg, format.mintick) +
             "\nSL " + str.tostring(curStop, format.mintick) + " · " + str.tostring(_slT) + "t · $" + str.tostring(_riskUsd, "#") +
             "\nTP " + str.tostring(curLimit, format.mintick) + (na(_rr) ? "" : " · " + str.tostring(_rr, "#.#") + "R"))

// ============================================================================
// === DASHBOARD ==============================================================
// ============================================================================
txtColor = vText
color dimTxt = visIsDark ? color.new(C_SAND, 40) : color.new(C_ONSAND, 40)
color posTxt = C_AZURE
color negTxt = C_ROSE
hdrTxt = visIsDark ? C_GOLD : C_GOLDD
hdrBg  = visIsDark ? color.new(C_DEEP, 8) : color.new(C_L_HDR, 20)
dashBg = visIsDark ? color.new(C_DEEP, 6) : color.new(C_L_BG, 15)
f_valCol(_x) => _x > 0 ? vPosTxt : _x < 0 ? vNegTxt : txtColor
dashPosition = dashPos == "Top Right" ? position.top_right : dashPos == "Top Left" ? position.top_left : dashPos == "Bottom Right" ? position.bottom_right : position.bottom_left
var table dash = table.new(dashPosition, 4, 8, bgcolor=dashBg, border_color=C_SEP, border_width=1)
if showDashboard and barstate.islast
    trades = strategy.wintrades + strategy.losstrades
    wr = trades > 0 ? strategy.wintrades * 100.0 / trades : na
    pf = math.abs(strategy.grossloss) > 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na
    if dashLayout == "Minimaal (MΞX)"
        bool _gateOpen = timeGatePass and not dayHalted and not inFlatWindow and not acctHalted
        table.cell(dash, 0, 0, botName, text_color=color.new(C_SAND, 55), bgcolor=color.new(C_DEEP, 6), text_size=txtSize, text_halign=text.align_left)
        table.cell(dash, 1, 0, jrnlAcct, text_color=color.new(C_SAND, 55), bgcolor=color.new(C_DEEP, 6), text_size=txtSize, text_halign=text.align_right)
        table.cell(dash, 0, 1, "Regime", text_color=dimTxt, text_size=txtSize, text_halign=text.align_left)
        table.cell(dash, 1, 1, phase, text_color=txtColor, text_size=txtSize, text_halign=text.align_right)
        table.cell(dash, 0, 2, "FVG band", text_color=dimTxt, text_size=txtSize, text_halign=text.align_left)
        table.cell(dash, 1, 2, str.tostring(gapMinSize, "#") + "–" + str.tostring(gapMaxSize, "#"), text_color=txtColor, text_size=txtSize, text_halign=text.align_right)
        table.cell(dash, 0, 3, "CVD streak", text_color=dimTxt, text_size=txtSize, text_halign=text.align_left)
        table.cell(dash, 1, 3, useCVDFilter ? str.tostring(cvdTrendCount) : "uit", text_color=txtColor, text_size=txtSize, text_halign=text.align_right)
        table.cell(dash, 0, 4, "VWAP", text_color=dimTxt, text_size=txtSize, text_halign=text.align_left)
        table.cell(dash, 1, 4, (close > vwapVal ? "above" : "below") + (useVwapVeto ? " · veto" : ""), text_color=txtColor, text_size=txtSize, text_halign=text.align_right)
        table.cell(dash, 0, 5, "Gate", text_color=dimTxt, text_size=txtSize, text_halign=text.align_left)
        table.cell(dash, 1, 5, _gateOpen ? "OPEN" : "CLOSED", text_color=_gateOpen ? C_GOLD : negTxt, text_size=txtSize, text_halign=text.align_right)
        string _srcTxt = polOn ? polPreset : "Manual"
        string _srcVal = polOn ? firmKeyEff :
             "q" + str.tostring(contractSize, "#") + " · stop " + str.tostring(maxStopSize, "#") + "t · " + dayExitMode
        table.cell(dash, 0, 7, "Sturing", text_color=dimTxt, text_size=txtSize, text_halign=text.align_left)
        table.cell(dash, 1, 7, _srcTxt + " · " + _srcVal, text_color=polOn ? C_GOLD : txtColor, text_size=txtSize, text_halign=text.align_right)
        if strategy.position_size != 0
            table.cell(dash, 0, 6, posSize > 0 ? G_LONG + "LONG" : G_SHORT + "SHORT", text_color=posSize > 0 ? posTxt : negTxt, text_size=txtSize, text_halign=text.align_left)
            table.cell(dash, 1, 6, str.tostring(math.abs(posSize), "#") + "ct · " + str.tostring(strategy.openprofit, "#"), text_color=f_valCol(strategy.openprofit), text_size=txtSize, text_halign=text.align_right)
    else if dashLayout == "Wide (4 columns)"
        table.cell(dash, 0, 0, jrnlAcct, text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize,
             tooltip="Composed account name (same logic as the CSV journal): first 2 letters + last 3 digits of the Account ID, start balance in k, start date. This is the name used in journal rows, message headers and CONFIG lines.")
        table.cell(dash, 1, 0, "Net " + str.tostring(strategy.netprofit, format.mintick), text_color=f_valCol(strategy.netprofit), text_size=txtSize)
        table.cell(dash, 2, 0, "PF " + (na(pf) ? "—" : str.tostring(pf, "#.00")), text_color=txtColor, text_size=txtSize)
        table.cell(dash, 3, 0, "MaxDD " + str.tostring(strategy.max_drawdown, format.mintick), text_color=txtColor, text_size=txtSize)
        table.cell(dash, 0, 1, "Trades " + str.tostring(trades), text_color=txtColor, text_size=txtSize)
        table.cell(dash, 1, 1, "WR " + (na(wr) ? "—" : str.tostring(wr, "#.0") + "%"), text_color=txtColor, text_size=txtSize)
        table.cell(dash, 2, 1, "Entry: " + (isLimitMode ? "Limit50" : "Market") + " · TP: " + tpMode, text_color=txtColor, text_size=txtSize)
        table.cell(dash, 3, 1, "Stop: " + stopMode, text_color=txtColor, text_size=txtSize)
        table.cell(dash, 0, 2, isPA and paBacktestMode ? "PAYOUTS" : "TODAY", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 2, isPA and paBacktestMode ? "💰 cum $" + str.tostring(paTotalBanked, "#") : "PnL " + str.tostring(todayRealizedPnL, "#.0"), text_color=isPA and paBacktestMode ? vPosTxt : f_valCol(todayRealizedPnL), text_size=txtSize)
        table.cell(dash, 2, 2, dayExitMode != "Off" and riskDayPeak > 0 ? "pk $" + str.tostring(riskDayPeak, "#") + (_dexTrailOn ? " -" + str.tostring(dayTrailUSD, "#") : "") : isPA and paBacktestMode ? "cyc " + str.tostring(paPayoutsThisCycle) + "/6" : "DD " + str.tostring(todayDD, "#.0"), text_color=txtColor, text_size=txtSize)
        table.cell(dash, 3, 2, dayHalted ? "🔒 " + haltReason : "✅ Trading", text_color=dayHalted ? vNegTxt : vPosTxt, text_size=txtSize)
        table.cell(dash, 0, 3, "ORDER/POS", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 3, inLong ? "🟢 LONG" : inShort ? "🔴 SHORT" : pendingActive ? "🟠 PENDING " + (pendDir==1?"L":"S") : "⚪ FLAT", text_color=txtColor, text_size=txtSize)
        table.cell(dash, 2, 3, pendingActive ? "Lim " + str.tostring(pendLimit, format.mintick) : "P/L " + str.tostring(strategy.openprofit, "#.0"), text_color=txtColor, text_size=txtSize)
        table.cell(dash, 3, 3, flatNow and not pendingActive ? "—" : "SL " + str.tostring(flatNow ? pendStop : curStop, format.mintick), text_color=txtColor, text_size=txtSize)
        table.cell(dash, 0, 4, "CONTEXT", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 4, "Bias " + (bias == 1 ? "📈" : bias == -1 ? "📉" : "⚪") + " " + phase, text_color=txtColor, text_size=txtSize)
        table.cell(dash, 2, 4, "VWAP " + (close > vwapVal ? "above" : "below") + (useVwapVeto ? " (veto)" : ""), text_color=txtColor, text_size=txtSize)
        string _gateTxt = inFlatWindow ? "⛔ Flat window" : timeGatePass ? "🟢 Gate open" : "⚪ Gate closed"
        table.cell(dash, 3, 4, _gateTxt, text_color=txtColor, text_size=txtSize)
        if phaseOn
            table.cell(dash, 0, 5, accountPhase, text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
            table.cell(dash, 1, 5, isPA and paBacktestMode ? "🧪 BT: " + str.tostring(paMilkCount) + "×melk · " + str.tostring(paBreachCount) + "×breach · $" + str.tostring(paTotalBanked, "#") : acctHalted ? "🏁 " + acctHaltReason : "DD room $" + str.tostring(ddRoom, "#"), text_color=acctHalted ? hdrTxt : ddRoom < acctTrailDD*0.25 ? vNegTxt : txtColor, text_size=txtSize)
            table.cell(dash, 2, 5, acctLocked ? "🔓 Locked (+$100)" : "Floor " + str.tostring(acctFloor, "#"), text_color=txtColor, text_size=txtSize)
            string _payTxt = isEval ? "Goal $" + str.tostring(math.max(acctGoal - acctRealized, 0), "#") + " to go" : payoutReady ? "💰 P" + str.tostring(effPayoutNr) + " CAP $" + str.tostring(curLadderCap, "#") + " ✓" : payoutEligible and useWaitForCap ? "⏳ P" + str.tostring(effPayoutNr) + " $" + str.tostring(withdrawable, "#") + "/$" + str.tostring(curLadderCap, "#") : "Days " + str.tostring(tradedDays) + "/" + str.tostring(fkMinDays) + " · Qual " + str.tostring(qualDays) + "/" + str.tostring(fkProfitDays) + " · Cons " + (profitSince > 0 ? str.tostring(100*bestDaySince/profitSince, "#") + "%" : "—")
            table.cell(dash, 3, 5, _payTxt,
                 text_color=payoutReady ? color.lime : (payoutEligible and useWaitForCap ? color.orange : txtColor), text_size=txtSize)

        table.cell(dash, 0, 6, "REGIME / EVAL", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 6, "Regime —", text_color=txtColor, text_size=txtSize)
        table.cell(dash, 2, 6, "",
             text_color=txtColor, text_size=txtSize)
        table.cell(dash, 0, 7, "GATE", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 7, gateLongOpen and gateShortOpen ? "🟡 LONG+SHORT allowed" : gateLongOpen ? "🟢 LONG allowed" : gateShortOpen ? "🔴 SHORT allowed" : "⚪ none allowed", text_color=txtColor, text_size=txtSize)
        table.cell(dash, 2, 7, str.length(persistBlk) > 0 ? "⛔ " + str.substring(persistBlk, 0, str.length(persistBlk) - 2) : "No blockers", text_color=str.length(persistBlk) > 0 ? vNegTxt : txtColor, text_size=txtSize)
        table.cell(dash, 3, 7, "Last blocked: " + lastBlockedInfo, text_color=txtColor, text_size=txtSize)
        table.cell(dash, 3, 6, not evalTrack ? "Eval —" :
             not evalStarted ? "⏳ start " + str.tostring(dayofmonth(evalStartTime, activeTz)) + "-" + str.tostring(month(evalStartTime, activeTz)) :
             evalPassed ? "🏆 PASSED" : evalFailed ? "💀 FAILED" :
             "→T $" + str.tostring(distTarget, "#") + " · →F $" + str.tostring(distFail, "#"),
             text_color=evalPassed ? color.lime : evalFailed ? color.red :
                  (not evalStarted ? txtColor : not na(distFail) and distFail < evalTrailDD*0.25 ? color.red :
                   not na(distFail) and distFail < evalTrailDD*0.5 ? color.orange : color.lime),
             text_size=txtSize)
    else
        string cPerf = "Net " + str.tostring(strategy.netprofit, format.mintick) + " · PF " + (na(pf) ? "—" : str.tostring(pf, "#.00")) +
             "\nTrades " + str.tostring(trades) + " · WR " + (na(wr) ? "—" : str.tostring(wr, "#.0") + "%") +
             "\nMaxDD " + str.tostring(strategy.max_drawdown, format.mintick)
        table.cell(dash, 0, 0, jrnlAcct, text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize,
             tooltip="Composed account name (same logic as the CSV journal). Compact layout: values stacked per cell for phone screens.")
        table.cell(dash, 1, 0, cPerf, text_color=f_valCol(strategy.netprofit), text_size=txtSize, text_halign=text.align_left)
        string cToday = (isPA and paBacktestMode ? "💰 cum $" + str.tostring(paTotalBanked, "#") + " · cyc " + str.tostring(paPayoutsThisCycle) + "/6" : "PnL " + str.tostring(todayRealizedPnL, "#.0") + " · DD " + str.tostring(todayDD, "#.0")) +
             "\n" + (isPA and paBacktestMode ? "🧪 " + str.tostring(paMilkCount) + "×melk · " + str.tostring(paBreachCount) + "×br" : dayHalted ? "🔒 " + haltReason : "✅ Trading")
        table.cell(dash, 0, 1, isPA and paBacktestMode ? "PAYOUTS" : "TODAY", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 1, cToday, text_color=isPA and paBacktestMode ? vPosTxt : f_valCol(todayRealizedPnL), text_size=txtSize, text_halign=text.align_left)
        string cPos = (inLong ? "🟢 LONG" : inShort ? "🔴 SHORT" : pendingActive ? "🟠 PENDING " + (pendDir == 1 ? "L" : "S") : "⚪ FLAT") +
             "\n" + (pendingActive ? "Lim " + str.tostring(pendLimit, format.mintick) : "P/L " + str.tostring(strategy.openprofit, "#.0")) +
             (flatNow and not pendingActive ? "" : "\nSL " + str.tostring(flatNow ? pendStop : curStop, format.mintick))
        table.cell(dash, 0, 2, "POS", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 2, cPos, text_color=txtColor, text_size=txtSize, text_halign=text.align_left)
        string cCtx = "Bias " + (bias == 1 ? "📈" : bias == -1 ? "📉" : "⚪") + " " + phase +
             "\nVWAP " + (close > vwapVal ? "above" : "below") + (useVwapVeto ? " (veto)" : "") +
             "\n" + (inFlatWindow ? "⛔ Flat window" : timeGatePass ? "🟢 Gate open" : "⚪ Gate closed")
        table.cell(dash, 0, 3, "CTX", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 3, cCtx, text_color=txtColor, text_size=txtSize, text_halign=text.align_left)
        if phaseOn
            string cPhase = (isPA and paBacktestMode ? "🧪 " + str.tostring(paMilkCount) + "×melk·" + str.tostring(paBreachCount) + "×br·$" + str.tostring(paTotalBanked, "#") : acctHalted ? "🏁 " + acctHaltReason : "DD room $" + str.tostring(ddRoom, "#")) +
                 "\n" + (acctLocked ? "🔓 Locked (+$100)" : "Floor " + str.tostring(acctFloor, "#")) +
                 "\n" + (isEval ? "Goal $" + str.tostring(math.max(acctGoal - acctRealized, 0), "#") + " to go" :
                 payoutReady ? "💰 P" + str.tostring(effPayoutNr) + " CAP $" + str.tostring(curLadderCap, "#") + " ✓" : payoutEligible and useWaitForCap ? "⏳ $" + str.tostring(withdrawable, "#") + "/$" + str.tostring(curLadderCap, "#") : "Days " + str.tostring(tradedDays) + "/" + str.tostring(fkMinDays) + " · Qual " + str.tostring(qualDays) + "/" + str.tostring(fkProfitDays) + " · Cons " + (profitSince > 0 ? str.tostring(100 * bestDaySince / profitSince, "#") + "%" : "—"))
            table.cell(dash, 0, 4, accountPhase, text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
            table.cell(dash, 1, 4, cPhase, text_color=payoutReady ? color.lime : acctHalted ? hdrTxt : ddRoom < acctTrailDD * 0.25 ? vNegTxt : txtColor, text_size=txtSize, text_halign=text.align_left)
        string cEvalLn = not evalTrack ? "Eval —" :
             not evalStarted ? "⏳ start " + str.tostring(dayofmonth(evalStartTime, activeTz)) + "-" + str.tostring(month(evalStartTime, activeTz)) :
             evalPassed ? "🏆 PASSED" : evalFailed ? "💀 FAILED" :
             "→T $" + str.tostring(distTarget, "#") + " · →F $" + str.tostring(distFail, "#")
        string cReg = "Regime —\n" + cEvalLn
        table.cell(dash, 0, 5, "REG/EVAL", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 5, cReg, text_color=txtColor, text_size=txtSize, text_halign=text.align_left)
        string cGate = (gateLongOpen and gateShortOpen ? "🟡 LONG+SHORT allowed" : gateLongOpen ? "🟢 LONG allowed" : gateShortOpen ? "🔴 SHORT allowed" : "⚪ none allowed") +
             "\n" + (str.length(persistBlk) > 0 ? "⛔ " + str.substring(persistBlk, 0, str.length(persistBlk) - 2) : "No blockers") +
             "\nLast: " + lastBlockedInfo
        table.cell(dash, 0, 6, "GATE", text_color=hdrTxt, bgcolor=hdrBg, text_size=txtSize)
        table.cell(dash, 1, 6, cGate, text_color=str.length(persistBlk) > 0 ? vNegTxt : txtColor, text_size=txtSize, text_halign=text.align_left)
