color testedColor     = color.new(#F2EBDA, 90)   // C_SAND

// === DASHBOARD ===============================================================
showDashboard = input.bool(true, "Show Dashboard", inline="d1", group=GROUP_DASH, display=display.none)
dashPos       = input.string("Bottom Right", "Position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], inline="d1", group=GROUP_DASH, display=display.none)
visTheme      = input.string("Auto", "Theme", options=["Auto","Dark","Light"], inline="d1", group=GROUP_DASH,
     tooltip="Auto reads the chart background. Applies to dashboard, trade info, exit text and zones.", display=display.none)
txtSize       = input.string(size.tiny, "Text", options=[size.huge,size.large,size.small,size.tiny,size.auto,size.normal], inline="d1", group=GROUP_DASH, tooltip="Dashboard text size.", display=display.none)
dashLayout    = input.string("Minimaal (MΞX)", "Layout", options=["Minimaal (MΞX)","Wide (4 columns)","Compact (mobile)"], group=GROUP_DASH,
     tooltip="Wide: the classic 4-column dashboard. Compact (mobile): two narrow columns with the same information stacked on separate lines inside each cell — fits a phone screen without horizontal squeezing. Visual only; no strategy impact.", display=display.none)

// === v5.5: THEMA-PALET =======================================================
float _bgLum = 0.299 * color.r(chart.bg_color) + 0.587 * color.g(chart.bg_color) + 0.114 * color.b(chart.bg_color)
bool visIsDark = visTheme == "Dark" ? true : visTheme == "Light" ? false : _bgLum < 128
// ============================================================================
