     tooltip="Default ON (v3.6): ESSENTIAL in R-multiple mode ($11.70 vs $6.80/trade; maxDD $4.2k vs $15.1k without). Optional with Swing TP but reduces DD.", display=display.none)
trailStartSize  = input.float(48, "Trail Activation MFE (units)", minval=0.01, group=GROUP_RISK, tooltip="MFE required before the trailing stop activates.", display=display.none)
trailBufferSize = input.float(24, "Trail Buffer (units)", minval=0.01, group=GROUP_RISK, tooltip="Distance the trail keeps from the running extreme.", display=display.none)
// === v6.4.4M: HERSTEL-TRAIL (alleen trade #2 na een verlies in dezelfde eval-poging) ===
useFillCheck    = input.bool(true, "FVG fill check (gap invalid once mid is touched)", group=GROUP_RISK,
     tooltip="Removes an FVG from the confirmation memory once price touches its mid (partially filled = invalid).")
useRecovTrail   = input.bool(false, "Recovery trail on trade #2 after a loss (Eval)", group=GROUP_RISK,
     tooltip="Eval only: on the second trade of an attempt after a first-trade loss, trail partial profit instead of running to the full target.")
recovTrailStart = input.float(40, "Recovery trail activation (units)", minval=1, inline="rt", group=GROUP_RISK,
     tooltip="Peak (units) at which the recovery trail arms.", display=display.none)
recovTrailBuf   = input.float(16, "Recovery trail buffer (units)", minval=1, inline="rt", group=GROUP_RISK,
     tooltip="Distance the recovery trail keeps from the peak.", display=display.none)

string tpModeEff   = tpMode
float  tpSizeEff   = tpSize
bool   useBEeff    = useBreakEven
float  beTrigEff   = beTriggerSize
float  beOffEff    = beOffsetSize
bool   useTrailEff = useTrail
float  trStartEff  = trailStartSize
float  trBufEff    = trailBufferSize

float trailUpdateStep = 2.0


// === DAILY RISK / EQUITY =====================================================
includeOpenInLoss    = true
enableDailyTarget    = false
dailyProfitTarget    = 350.0
enableDailyDrawdown    = false
dailyDrawdownLimit    = 750.0
enableEquityLock    = false
equityLockThreshold    = 300.0
equityLockPerc    = 90.0
onlyFirstTrade       = false

// === INTRADAY DAY-EXIT (v6.4.4i — sim-gevalideerde dagwinst-behoud) ==========
var string GROUP_DEX = "7 · ACCOUNT — Management"
dayExitMode = input.string("Off", "Day-profit exit mode", options=["Off","Day-trail (keep peak)","Day-cap (hard target)","Trail + cap"], group=GROUP_DEX,
     tooltip="Off = no day-profit exit; this is the frozen EL TORO setting. Day-trail closes the day on a pullback from the intraday peak, Day-cap on a hard target, Trail + cap arms both. The MEX preset overrides the cap when it carries one.", display=display.none)
dayTrailUSD = input.float(150.0, "Day-trail give-back ($)", minval=10, step=10, group=GROUP_DEX,
     tooltip="Legacy model: the trail arms once the day peak exceeds this value and closes the day after giving the same amount back. Only active when the mode above uses the trail.", display=display.none)
dayCapUSD   = input.float(300.0, "Day-cap hard target ($)", minval=50, step=25, group=GROUP_DEX,
     tooltip="Day profit at which the day is closed. Only active when the mode above uses the cap.", display=display.none)
ddModel       = input.string("Intraday", "Drawdown Model", options=["EOD","Intraday"], group=GROUP_PHASE,
     tooltip="EOD (Apex 4.0 default): trailing ratchets on the daily closing balance only; open profit peaks do not count. Intraday (legacy): ratchets in real time with the live peak.", display=display.none)
payoutBuffer  = 500.0
var string GROUP_WFC = "8 · ACCOUNT — Guard"
// D-124 (06-10): dit was `bool useWaitForCap = true` (negen scripts) resp. `= false` (de
// vier TORO's) -- een harde constante die stuurt of een funded account nog handelt, zonder
// knop om het te zien of te zetten. Achtste instantie van dat patroon na D-68, D-75, D-108,
// D-110, D-111, D-115 en D-123.
// ⚠️ DEFAULT `true` IS DE HELE VOORWAARDE. Uit zetten laat een account dóórhandelen
// voorbij zijn payout-cap, en dat is precies wat de ladder moet voorkomen. Het is een
// noodknop, geen instelling om aan te draaien.
useWaitForCap = input.bool(true, "Wait for the full ladder step before payout", group=GROUP_WFC,
     tooltip="AAN (en dat hoort zo): de payout wordt pas aangevraagd op de volle laddertrede, en entries stoppen zodra die trede bereikt is EN de payout ook werkelijk aanvraagbaar is (D-125). UIT: er wordt eerder payout-gerechtigd gemeld en de cap-blokkade valt weg -- het account handelt dan door voorbij zijn cap. Alleen uitzetten als je weet waarom.")
// 📌 Op dit script stond de constante op `false` en de input staat op `true`. Dat is op de
// default-chart INERT: `pmtBlock` hangt hier op `evalPassed`, en elke andere plek die
// `useWaitForCap` leest eist `isPA` -- wat op fase "Eval" onwaar is. Zet iemand deze chart
// tóch op Funded, dan is `true` de veilige kant. Nagemeten per call-site, niet aangenomen.
payoutNr      = 1
paBacktestMode = true
accountPhase  = input.string("Eval", "Account phase", options=["Developer","Eval","Funded"], group=GROUP_PHASE,
     tooltip="Research: no account rules (default; backtests unchanged). Eval: goal + trailing. PA: trailing until lock, DLL, consistency/payout monitor — and the MAE guard (group 16).")
acctTrailDD   = input.float(2000, "Trailing Drawdown ($)", step=100, group=GROUP_PHASE, tooltip="Apex 4.0: $2.000 trailing, vergrendelt op $2.100 (registry data/propfirms.json, besluit Ferry 26-08). Draait dit script op een LEGACY eval, zet hem dan handmatig op 2500.", display=display.none)
acctGoal      = input.float(3000, "Eval Profit Goal ($)", step=100, group=GROUP_PHASE, tooltip="Eval profit target for the phase tracker (Apex 50k: $3,000).", display=display.none)
acctDLL       = 1000.0
consistencyPct= 50.0
minPayout     = 500.0
minQualDayUSD = 50.0
// === D-110 stap 1 — Ferry's EIGEN dagrem, met de formule uit D-109/D-110 =====
// Besluit Ferry 29-09: de firm-DLL is informatie, geen rem -- een account handelt tot de
// target of tot MIJN limiet. Die eigen limiet stond tot nu toe als constante `false` (in
// twaalf scripts) of als input met default `false` (MATADOR): de machinerie eronder
// (lossHit -> dayHalted) werkte, maar niets voedde haar. Hij staat nu AAN, met de in
// DECISIONS.md vastgelegde formule:
//     owner_dll = stop-per-contract x stops-per-dag x qty          (100 x 4 x qty)
//   -> $400 / $800 / $1.200 / $1.600 / $2.000 bij qty 1 t/m 5.
// ⛔ De TWEEDE term van D-110 ("nooit meer dan 1/3 van de ruimte") staat hier BEWUST NIET.
//    Die heeft de balans en het liquidatieniveau nodig; de balans komt uit T3 en niet uit
//    Pine. Hem hier benaderen zou een tweede, stille saldobron maken -- precies wat D-110
//    verbiedt. Die term hoort in de middleware, na fase 4.
// ⚠️ VOLGORDE, en dat is de hele opdracht: dit is STAP 1. De firm-rem (`dllHit` op
//    `acctDLL`) blijft in deze commit staan. Twee remmen naast elkaar is veilig -- de
//    strengste wint. `dllHit` verdwijnt pas in stap 2, en pas nadat deze rem aantoonbaar
//    de bindende is. Andersom zou het account zonder enige Pine-rem tot de firmalimiet
//    lopen, en die BREACHT een eval in plaats van hem te pauzeren.
enableDailyLossLimit = input.bool(true, "Owner DLL - enable", group=GROUP_PHASE,
     tooltip="Ferry's eigen dagverlieslimiet (D-109/D-110). AAN = de dag stopt op de eigen limiet hieronder. Dit is NIET de firmalimiet: die staat bij 'PA Daily Loss Limit' en is sinds D-109 alleen nog weergave.")
ownerDllSlUSD = input.float(100, "Owner DLL - stop per contract ($)", minval=0, step=25, group=GROUP_PHASE,
     tooltip="Eerste factor van de formule. $100 is een eigenschap van de STOP, niet van de accountgrootte -- daarom is hij uniform over de vloot (D-110, geverifieerd tegen zeven punten uit het fleet-doc).", display=display.none)
ownerDllStops = input.float(4, "Owner DLL - stops per dag", minval=0, step=1, group=GROUP_PHASE,
     tooltip="Tweede factor: hoeveel volle stops een dag mag kosten voor hij dichtgaat. Vier is de vastgelegde waarde.", display=display.none)
dailyLossLimit = input.float(0, "Owner DLL - override ($, 0 = formule)", minval=0, step=50, group=GROUP_PHASE,
     tooltip="Laat op 0 om de formule te gebruiken. Een waarde > 0 overschrijft hem voor dit ene script; de formule wordt dan genegeerd.", display=display.none)
float ownerDllUSD       = ownerDllSlUSD * ownerDllStops * math.max(contractSize, 1.0)
// De samenvoeging met de firmalimiet staat NIET hier maar verderop, direct na het
// firm-preset: `acctDLL` krijgt zijn waarde pas daar (`acctDLL := pfDLL`), dus hier
// zou hij nog de rauwe inputdefault dragen. Zoek op `firmDllActive`.
acctPnlOffset = input.float(0, "Live sync: current account PnL vs start ($)", group=GROUP_PHASE,
     tooltip="For live use: enter the account's actual PnL so floor/goal are correct. Backtest: 0.", display=display.none)
acctHwmOffset = input.float(0, "Live sync: current HWM vs start ($)", group=GROUP_PHASE, tooltip="For live use with EOD trailing: the account high-water mark so the floor calculates correctly. Backtest: 0.", display=display.none)
lastPayoutTime= timestamp("2024-01-01T00:00:00")

// === Daily risk-gate (D-45) =================================================
// Twee ONAFHANKELIJKE drempels per sessie, allebei op GEREALISEERDE P&L:
//   DLL   - cum realized <= -DLL         -> halt
//   Trail - na trigger T volgt hij de piek; cum <= piek - B -> halt
// De trail kijkt bewust alleen naar trade-closes: intra-trade ruis mag er niet aan zitten.
// Beide voeden dayHalted, zodat de bestaande machinerie (cancel + close_all + close naar
// PMT + entry-blokkade) ongewijzigd hergebruikt wordt - geen tweede executiepad.
useRiskGate = input.bool(false, "Daily risk-gate", inline="rg1", group=GROUP_RG, tooltip="Off = behaviour of this engine as frozen. On adds a session loss limit and a give-back trail on realized P&L, on top of the account rules below.")
rgDLL       = input.float(150, "DLL $", minval=0, step=10, inline="rg1", group=GROUP_RG)
rgTriggerT  = input.float(10,  "Trail arms above $", minval=0, step=1, inline="rg2", group=GROUP_RG)
rgBufferB   = input.float(100, "give-back $", minval=0, step=1, inline="rg2", group=GROUP_RG)
rgDllBasis  = input.string("Realized + open (cuts the trade)", "DLL basis", options=["Realized + open (cuts the trade)","Realized only (halts after the close)"], group=GROUP_RG,
     tooltip="Realized + open makes the DLL a loss LIMITER: the position closes mid-trade the moment realized+open reaches it. Realized only makes it a halt TRIGGER: the losing trade runs to its stop first and the day closes after. Same number of halted days, very different cost. The trail works on trade closes in both modes.", display=display.none)
int rgRollHour = 18   // CME-roll; valt samen met het einde van de force-flat

