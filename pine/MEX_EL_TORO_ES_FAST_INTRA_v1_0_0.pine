firmPreset    = input.string("apex_50k_intraday_eval", "Firm program", options=["apex_250k_legacy_eval", "apex_250k_legacy_pa", "apex_25k_legacy_eval", "apex_50k_eod_eval", "apex_50k_eod_pa", "apex_50k_intraday_eval", "apex_50k_intraday_pa", "apex_50k_legacy_eval", "apex_50k_legacy_pa", "blueguardian_50k_standard_eval", "blueguardian_50k_standard_pa", "daytraders_s2f_25k_instant", "fundednext_50k_rapid_eval", "fundednext_50k_rapid_pa", "mffu_50k_eval", "mffu_50k_pa", "takeprofittrader_50k_eval", "takeprofittrader_50k_pa", "topone_50k_elite_eval", "topone_50k_elite_pa", "topstep_50k_eval", "tradeday_50k_eval", "tradeday_50k_pa", "tradeify_50k_growth_eval", "tradeify_50k_growth_pa", "tradeify_advanced_25k_instant"], group=GROUP_PHASE, tooltip="Auto-generated from the prop-firm registry. Only trailing-DD (futures) firms are listed here.")
