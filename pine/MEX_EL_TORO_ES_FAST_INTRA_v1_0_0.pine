int    deriskQty2     = 1
int    deriskPaQty    = 1
string exitPreset     = "Custom"

accountID = input.string("", "PMT/Tradovate Account ID", group=GROUP_ACCT,
     tooltip="PMT/Tradovate account ID. Declared first on purpose: it is the FIRST value in the alert name/prefill, so every alert in the TradingView sidebar starts with the account it belongs to. Also feeds the automatic journal account name (first 2 letters + last 3 digits).")

input_tz = input.string("America/New_York", "Reference Timezone",
     options=["Pacific/Honolulu","America/Anchorage","America/Los_Angeles","America/Denver","America/Chicago","America/New_York","America/Sao_Paulo","Etc/UTC","Europe/London","Europe/Berlin","Europe/Amsterdam","Europe/Athens","Europe/Moscow","Asia/Dubai","Asia/Karachi","Asia/Dhaka","Asia/Bangkok","Asia/Singapore","Asia/Tokyo","Australia/Sydney","Pacific/Auckland"],
     group=GROUP_TZ, tooltip="Timezone for the time gate, flat window and day boundary. Keep America/New_York — all", display=display.none)
string activeTz = input_tz

// === TIME-GATE #0 — de ENIGE bron voor het handelsvenster van dit script =====
// Item 31 (CLO, 05-09). Er stonden drie losse datums op drie plekken -- "No entries before
// start date", "Start date/time (measure from)" en "Use end date" + einddatum -- plus de
// tester-range van TradingView zelf. Niemand kon zien welke de handel nu echt begrensde, en
// dat is precies waarom Ferry naar hardcoded logica uitweek. Er is er nu nog EEN:
// [validFrom, validUntil]. Backtest, forward-test en live lezen alle drie ditzelfde venster.
// LET OP: de datumkiezer van TradingView interpreteert in de EXCHANGE-tijdzone van de chart,
// niet in ET. De defaults hieronder staan expliciet in America/New_York, en het dashboard
// toont de grenzen terug in je referentietijdzone -- zo zie je wat er ECHT staat.
validFrom  = input.time(timestamp("America/New_York", 2026, 1, 1, 0, 0, 0), "Valid from", group=GROUP_TZ,
     tooltip="Vóór dit moment neemt het script geen enkele entry. Indicatoren warmen wel op over de volle historie, dus de signalen veranderen niet -- je backtest begint hier alleen te handelen. Zelfde grens voor backtest, forward-test en live.")
validUntil = input.time(timestamp("America/New_York", 2027, 1, 1, 0, 0, 0), "Valid until", group=GROUP_TZ,
     tooltip="Ná dit moment: geen entries meer, hard. Openstaande posities mogen nog 24 uur netjes sluiten; daarna wordt er eenmalig platgemaakt. Je krijgt één Discord-melding op de grens. Zet dit op de datum waarop dit account of deze configuratie afloopt.")
// Het gedrag op de grens ligt vast in item 31 en is bewust GEEN knop: één regel, overal gelijk.
int  EXIT_GRACE_MS = 24 * 60 * 60 * 1000
bool inValidWindow = time >= validFrom and time <= validUntil
bool windowExpired = time > validUntil
bool exitGraceOpen = time <= validUntil + EXIT_GRACE_MS
dayBoundaryMode = input.string("Exchange session (ETH)", "Trading day boundary",
     options=["Exchange session (ETH)","Regular hours (RTH)","Calendar day (timezone)"], group=GROUP_BND, tooltip="Where the trading day rolls over. Exchange session (default) = 18:00 ET futures session open, matching Apex and the research engine. Calendar day: midnight in the reference timezone.", display=display.none)

f_getHour()     => hour(time, activeTz)
f_getMinute()   => minute(time, activeTz)
f_minuteOfDay() => f_getHour() * 60 + f_getMinute()
f_calDayId()    => year(time, activeTz) * 10000 + month(time, activeTz) * 100 + dayofmonth(time, activeTz)
var int prevCalDayId = na
bool newCalDay = na(prevCalDayId) or f_calDayId() != prevCalDayId
prevCalDayId := f_calDayId()
// RTH rolt op de cash-open (09:30), ETH op de futures-sessie. Dit bepaalt WAAR de dag
// omslaat -- waar de sessie-P&L, de dagteller en de halt resetten -- niet welke bars je
// mag handelen. Entry-filtering op RTH/ETH is bewust een aparte vraag.
int  _bndMod  = f_minuteOfDay()
bool _bndRthRoll = _bndMod >= 570 and nz(_bndMod[1], _bndMod) < 570
bool isNewTradingDay = barstate.isfirst or (dayBoundaryMode == "Regular hours (RTH)" ? _bndRthRoll : dayBoundaryMode == "Calendar day (timezone)" ? newCalDay : timeframe.change("1D"))

// === TIME GATE (alleen Manual; in-sample modes verwijderd) ===================
tradeSunday    = input.bool(false, "Sun", inline="wd", group=GROUP_TIME, display=display.none)
tradeMonday    = input.bool(true,  "Mon", inline="wd", group=GROUP_TIME, display=display.none)
tradeTuesday   = input.bool(true,  "Tue", inline="wd", group=GROUP_TIME, display=display.none)
tradeWednesday = input.bool(true,  "Wed", inline="wd", group=GROUP_TIME, display=display.none)
tradeThursday  = input.bool(true,  "Thu", inline="wd", group=GROUP_TIME, display=display.none)
tradeFriday    = input.bool(true,  "Fri", inline="wd", group=GROUP_TIME, display=display.none)
tradeSaturday  = input.bool(false, "Sat (crypto)", inline="wd", group=GROUP_TIME, tooltip="Weekday toggles for the time gate. The Monday 00:00-02:00 filter below is separate and day-specific.", display=display.none)
timeHour00 = input.bool(true, "00", inline="h0", group=GROUP_TIME), timeHour01 = input.bool(true, "01", inline="h0", group=GROUP_TIME), timeHour02 = input.bool(true, "02", inline="h0", group=GROUP_TIME), timeHour03 = input.bool(true, "03", inline="h0", group=GROUP_TIME), timeHour04 = input.bool(true, "04", inline="h0", group=GROUP_TIME), timeHour05 = input.bool(true, "05", inline="h0", group=GROUP_TIME, tooltip="00.", display=display.none)
timeHour06 = input.bool(true, "06", inline="h1", group=GROUP_TIME), timeHour07 = input.bool(true, "07", inline="h1", group=GROUP_TIME), timeHour08 = input.bool(true, "08", inline="h1", group=GROUP_TIME), timeHour09 = input.bool(true, "09", inline="h1", group=GROUP_TIME), timeHour10 = input.bool(true, "10", inline="h1", group=GROUP_TIME), timeHour11 = input.bool(true, "11", inline="h1", group=GROUP_TIME, tooltip="06.", display=display.none)
timeHour12 = input.bool(true, "12", inline="h2", group=GROUP_TIME), timeHour13 = input.bool(true, "13", inline="h2", group=GROUP_TIME), timeHour14 = input.bool(true, "14", inline="h2", group=GROUP_TIME), timeHour15 = input.bool(true, "15", inline="h2", group=GROUP_TIME), timeHour16 = input.bool(false, "16", inline="h2", group=GROUP_TIME), timeHour17 = input.bool(false, "17", inline="h2", group=GROUP_TIME, tooltip="12.", display=display.none)
timeHour18 = input.bool(true, "18", inline="h3", group=GROUP_TIME), timeHour19 = input.bool(true, "19", inline="h3", group=GROUP_TIME), timeHour20 = input.bool(true, "20", inline="h3", group=GROUP_TIME), timeHour21 = input.bool(true, "21", inline="h3", group=GROUP_TIME), timeHour22 = input.bool(true, "22", inline="h3", group=GROUP_TIME), timeHour23 = input.bool(true, "23", inline="h3", group=GROUP_TIME, tooltip="18.", display=display.none)
// === MARKET REGIME GATE ======================================================
// Research-defined structural sessions; no individual hour/day cherry-picking.
marketRegimeMode = input.string("All sessions", "Market regime", options=["All sessions","Liquidity Core","Custom"], group=GROUP_MREG,
     tooltip="Liquidity Core = London 02:00-05:00 ET + US pre-cash/morning 07:00-12:00 ET + Globex reopen 18:00-19:00 ET. These windows were defined by market structure, not individual-hour optimization.")
// Negen economisch vooraf gedefinieerde vensters, tijden in de referentie-timezone.
// De eerste drie zijn samen "Liquidity Core" en zijn NIET aangepast: die definitie zit
// onder alles wat er tot nu toe op gemeten is.
customGlobexOpen = input.bool(true,  "Globex reopen 18:00-19:00", inline="mr1", group=GROUP_MREG)
customAsia       = input.bool(false, "Asia 19:00-02:00",          inline="mr1", group=GROUP_MREG)
customLondon     = input.bool(true,  "London 02:00-05:00",        inline="mr2", group=GROUP_MREG)
customUsMorning  = input.bool(true,  "US 07:00-12:00",            inline="mr2", group=GROUP_MREG)
customInitBal    = input.bool(false, "Initial balance 09:30-10:30", inline="mr3", group=GROUP_MREG)
customNyAm       = input.bool(false, "NY AM 09:30-11:30",         inline="mr3", group=GROUP_MREG)
customLunch      = input.bool(false, "Lunch 11:30-13:00",         inline="mr4", group=GROUP_MREG)
customNyPm       = input.bool(false, "NY PM 13:00-15:00",         inline="mr4", group=GROUP_MREG)
customPowerHour  = input.bool(false, "Power hour 15:00-16:00",    inline="mr5", group=GROUP_MREG,
     tooltip="US overlaps Initial Balance, NY AM and Lunch on purpose: the windows are OR-ed, so a coarse block can sit next to finer ones.")

// Force flat en de sessie-roll vallen samen op de CME-grens en hebben altijd dezelfde
// waarde gehad. Alleen de schakelaar is nog een keuze; de tijden zijn vast.
useAutoFlat = input.bool(true, "Force flat 16:55 – 18:00", group=GROUP_TIME,
     tooltip="No new entries inside the window, and open positions are flattened. This is the CME session break; the times are fixed and coincide with the session roll.", display=display.none)
int flatHour     = 16
int flatMinute   = 55
int resumeHour   = 18
int resumeMinute = 0

// === UNITS & SIZING ==========================================================
unitMode  = input.string("Ticks", "Distance Unit", options=["Ticks","Points","%","ATR"], group=GROUP_UNIT, tooltip="Unit for all distance inputs (stops, gaps, buffers).", display=display.none)
atrLen    = input.int(14, "ATR Length (ATR unit)", minval=1, group=GROUP_UNIT, tooltip="ATR length, only used when Distance Unit is set to ATR.", display=display.none)
sizingMode = input.string("Fixed contracts", "Sizing Mode", options=["Fixed contracts","Fixed $ risk","% equity risk"], group=GROUP_UNIT,
     tooltip="With the swing stop the stop distance varies per trade; $-risk or %-risk sizing keeps risk per trade constant and is recommended in that case.", display=display.none)
contractSize       = input.float(6, "Fixed Qty", minval=0, group=GROUP_UNIT, tooltip="Fixed number of contracts per trade. The MAE guard may scale this down per trade on a PA.")
riskValue          = input.float(250, "Risk per Trade ($ of %)", minval=0, group=GROUP_UNIT, tooltip="Risk per trade when using $-risk or %-risk sizing instead of fixed contracts.", display=display.none)
allowFractionalQty = input.bool(false, "Allow Fractional Qty (crypto)", group=GROUP_UNIT, tooltip="Allow fractional position sizes (crypto only — futures require whole contracts).", display=display.none)
maxQty             = input.float(100, "Max Qty Cap", minval=0, group=GROUP_UNIT, tooltip="Hard cap on position size regardless of the sizing mode.", display=display.none)

atrVal = ta.atr(atrLen)
f_distPrice(_u) =>
    switch unitMode
        "Ticks"  => _u * syminfo.mintick
        "Points" => _u
        "%"      => close * _u / 100.0
        => _u * atrVal

// === ENTRY & STOP ENGINE =====================================================
entryMode = input.string("Limit @ 50% FVG", "Entry Mode", options=["Limit @ 50% FVG","Market (legacy)"], group=GROUP_ENTRY,
     tooltip="Limit: resting order at the gap retrace level; better price, no entry slippage, ~78% of signals still get filled.")
expiryBars = input.int(18, "Limit Order Expiry (bars)", minval=1, group=GROUP_ENTRY,
     tooltip="Bars a resting limit order stays valid before it is cancelled.")
stopMode  = input.string("Fixed (legacy)", "Stop Mode", options=["Swing structure","Fixed (legacy)"], group=GROUP_ENTRY, tooltip="Swing structure: stop beyond the last confirmed pivot AND the gap edge, plus buffer. Fixed: static distance.", display=display.none)
int   pivotK = 3         // alleen in Swing-stopmodus; nooit aangeraakt, dus vast
float swingBufSize = 2.0 // idem
maxStopSize  = input.float(90, "Max Stop Distance (units) — else no trade", minval=1, group=GROUP_ENTRY, tooltip="Signals with a wider stop than this are skipped entirely.", display=display.none)
