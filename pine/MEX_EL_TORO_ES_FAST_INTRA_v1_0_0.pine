f_firmLadder(string _p, int _n) =>
    float[] _l = array.from(1500.0, 1500.0, 2000.0, 2500.0, 2500.0, 3000.0)
    int _unc = 0
    if _p == "apex_250k_legacy_pa"
        _l := array.from(3000.0)
        _unc := 6
    else if _p == "apex_50k_legacy_pa"
        _l := array.from(2000.0)
        _unc := 6
    else if _p == "blueguardian_50k_standard_pa"
        _l := array.from(2500.0, 3000.0)
    else if _p == "topone_50k_elite_pa"
        _l := array.from(2500.0)
    else if _p == "tradeify_50k_growth_pa"
        _l := array.from(3000.0)
    (_unc > 0 and _n >= _unc) ? na : array.get(_l, math.max(0, math.min(_n - 1, array.size(_l) - 1)))
