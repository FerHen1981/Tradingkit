//@version=6
// v6.8.9 (optimised): memory-safe visuals (drawLast) + recovery-trail A1 fix + FX tick-volume delta note.
// v6.8.10: auto-guard the delta filter on non-futures assets (forex/CFD/spot).
// v6.8.11: inputs restructured + firm-preset dropdown (futures).
// v2.2.0 (25-08, uitrol Ferry): dezelfde herstructurering als de v1_0_0-vloot. Paneel
//   aaneengesloten 0-13 conform INPUT_SPEC_v2, Engelse labels, groepen 11 VISUALS -
//   Strategy en 12 VISUALS - Indicators herbouwd (FVG Filled/Unfilled/Both + In range/All,
//   drie achtergrondlagen, vijf account-eventmarkers, MFE/MAE op het exit-label).
//   Nieuw en default UIT: de zes signaalfilters (BBWP, EMA, MFI, volumeprofiel,
//   discount/premium, long/short) en de daily risk-gate uit D-45. Nieuw: de negen
//   regimevensters en de RTH/ETH-dag-grens. Bot Name komt nu uit de scripttitel.
//   Hersteld: de long-entry driehoek ontbrak - "Show Signals" plotte alleen shorts.
//   De MEX policy-laag, eval-tracking, evalTrailEod en Skip Monday blijven staan: die
//   zijn in EL TORO wel degelijk actief. Geen signaal- of accountlogica gewijzigd.
// v2.3.0 (25-08, D-41): elke Discord-kaart draagt nu het account vooraan in de description,
//   zodat de per-kanaal routing van D-28/2 funded en eval uit elkaar kan houden. Het waren er
//   19 per script, niet de elf uit de melding: RISK OFF, TRAIL ACTIVE, REGIME en de entries
//   hadden hetzelfde gat. De receiver leest de eerste kolom en herkent alleen LLddd- (zoals
//   PA016-0k-260813); wijkt jrnlAcct af, dan viel de routing STIL terug op de globale webhook.
//   Daarom staat er nu ook een zichtbare waarschuwing op de laatste bar als het account leeg
//   of afwijkend is. Alleen berichtinhoud; geen signaal-, order- of accountlogica geraakt.
// v2.3.1 (25-08): f_firmRules komt weer uit data/propfirms.json in plaats van uit de hand
//   (D-65/D-08). Mogelijk gemaakt door het besluit van Ferry: Apex 4.0 = $2.000 trailing
//   drawdown, legacy = $2.500. De registry droeg 2.500 op ALLE Apex 50K-programma's, ook de
//   vier 4.0-programma's waar deze vloot op draait; die staan nu op 2.000 met lock 2.100.
//   Voor de twee presets die de vloot gebruikt verandert er niets - die stonden al op 2.000.
//   Wel nieuw in de dropdown: de vier legacy-programma's. Consistency op eval-programma's
//   gaat van 50 naar 0: dat is een PA-regel, een eval heeft hem niet, en in dit script komt
//   consistencyPct alleen binnen via payoutEligible dat isPA eist - dus zonder gevolg.
// v2.3.2 (25-08, D-44): f_pmtJSON stuurt nu OOK breakeven_offset mee. Het veld bestaat in
//   PMT (bevestigd met Ferry's eigen alert-template) en wij stuurden het niet, terwijl
//   beOffEff intern al gebruikt werd om de stop te verzetten. Gevolg tot nu: Pine legde zijn
//   eigen stop op entry+offset, PMT legde hem op entry - een pariteitsgat op elke BE-trade.
//   Zelfde guard en zelfde f_distPrice()-transform als het breakeven-veld, dus de eenheid
//   volgt automatisch uit unitMode. LET OP: staat het risk type van dat symbool/account in
//   PMT op "Price", dan past PMT breakeven en offset helemaal niet toe - controleer dat
//   voor je de fix test, anders test je in het donker.
// EL TORO FAST | NQ | HF | INTRA | one-hit / time-for-money profile.
// Frozen EL TORO profile: ES · FAST · INTRADAY · qty6 · FVG2-8 · CVDOFF · SL90 · TP44 · expiry18.
// Frozen eval defaults: 7 NQ · FVG4-12t · proxy-CVD3 · SL90t · TP90t · expiry9.
// New entries blocked from 16:00 ET; force-flat window remains intact.
// TP90 intentionally preserves >$3,000 net pass buffer under harsher execution than the 1-tick baseline.
// v3.0.0 (26-08, OVERHAUL): het dashboard is opnieuw opgezet in drie lagen onder een vaste
//   kop met het account - INDICATORS (alleen de filters die AAN staan, met hun waarde en
//   een pijl voor de kant die ze suggereren), ACCOUNT (Today met de cijfers van vandaag,
//   Overall sinds het begin van de backtest, en de buffer) en TRADE (alleen bij een open
//   order of positie). Twee kolommen in plaats van vier, centre right, en niet-actief
//   betekent geen regel.
//   Balance, $ tot payout en $ tot breach tonen een STREEPJE zolang de live-sync op 0
//   staat: op een live chart is een verkeerd accountsaldo erger dan geen accountsaldo.
//   Het tekstblok bij een trade draagt nu PnL bovenin, dan Entry -> FVG|CVD|AGE|H|D|SL,
//   dan Exit -> reden|MFE|MAE, en onderaan de volledige regel met alle bedragen.
//   Alerts: regime-shift eruit, CONFIG en de parameterconfig hardcoded aan zonder knop,
//   de middleware-route hardcoded uit (die plaatst geen order op het live pad). NIEUW is
//   de ARMED-kaart zodra een venster uit je selectie opengaat EN er gehandeld kan worden.
//   Visuals: de "Filters valid"-achtergrond is vervangen door een tabelregel, FVG-boxen
//   verdwijnen zodra ze geraakt zijn of 60 bars oud, en de overlay-filters (VWAP, EMA,
//   volumeprofiel, discount/premium) tekenen mee zodra ze in deze configuratie filteren.
//   De tijdvensters zijn in te tekenen met hun naam erboven, net als in de Suite.
// v3.0.1 (26-08): laadtijd en zichtbaarheid.
//   SNELHEID - drie posten draaiden ook als hun filter uit stond. request.* voert Pine
//   ALTIJD uit, ook binnen een if die onwaar is, dus het volumeprofiel haalde elke
//   minuut-bar op terwijl usePocFilter false was; die aanroep vraagt nu de chart-timeframe
//   zodra het filter uit staat. BBWP draaide een lus over 255 bars op elke bar en MFI een
//   HMA, allebei ongebruikt; die staan nu achter hun eigen schakelaar.
//   ZICHTBAARHEID - drie dingen ontbraken, elk om een andere reden. De vensters stonden
//   default UIT. Het FVG-size-filter stond op "In range", en dat is op MNQ 2-8 ticks, dus
//   vrijwel alles viel af; nu "All". En de overlay-indicatoren hingen aan het FILTER in
//   plaats van aan een weergavekeuze: met alle zes de filters default uit tekende er dus
//   niets. Ze hebben nu eigen schakelaars; de tabel blijft tonen welke er echt filteren.
//   "Filled"/"Both" op de FVG-weergave is eruit: geraakte gaps worden opgeruimd, dus die
//   keuzes konden niets meer tonen.
// v3.0.2 (26-08): CE10123 - de titel van een plot moet een CONST string zijn, en
//   "EMA " + str.tostring(emaLen) is simple. Titel is nu vast. pine_lint controleert dit
//   voortaan op plot/plotshape/fill/bgcolor/barcolor/hline.
// v3.0.3 (26-08): nog drie datastromen die draaiden voor niets. request.* en de
//   ta.request*-familie voeren in Pine ALTIJD uit, ook binnen een if die nooit waar wordt.
//   De HTF-bias-aanroep (drie 30-min-series) hing achter useBiasFilter=false en is weg. De
//   CVD-borrow-aanroep hing achter een lege deltaBorrowSym en is weg. ta.requestVolumeDelta
//   vraagt op de proxy-stand nu de chart-timeframe in plaats van elke minuut-bar. Alle drie
//   gedragsneutraal: het waren takken die nooit gelezen werden.
// v3.1.0 (26-08): NUL datastromen over. De twee die er nog waren zijn ook weg.
//   Het volumeprofiel komt nu uit de chart-bars in plaats van uit request.security_lower_tf.
//   Dat is een grovere POC dan de intrabar-versie - een bewuste ruil op een filter dat
//   default uit staat en waar geen enkele meting op rust. De TradingView-volume-delta-tak
//   is uit DIT script verwijderd; hij was niet de default en werd nergens gebruikt, maar
//   ta.requestVolumeDelta draait ook in een tak die nooit gekozen wordt. EL PATRON en
//   EL TESORO houden die tak wel: daar is de motorkeuze een openstaande vraag (optie C).
//   Weergave omlaag zoals afgesproken: draw-last 2000 -> 300, max FVG-boxen 40 -> 20,
//   sessievensters 6 -> 4. Geen analytisch verlies, wel minder tekenwerk per bar.
// v3.1.1 (26-08): de TRADE-laag verscheen alleen bij een open positie of order op de
//   LAATSTE bar, en dat is op een backtestchart bijna nooit - je zag dus nooit dat hij
//   bestond. Hij staat er nu altijd, met drie standen: POSITION, ORDER of FLAT. Inhoud
//   conform de spec: richting, size @ entry, TP / SL, BE / Trail en open PnL. Een
//   niet-opgepikte limietorder toont zijn entry en stop maar nog geen TP - die bestaat
//   op dat moment ook niet.
// v3.2.0 (26-08): trades blijven veel langer op de chart staan. Er waren twee limieten en
//   allebei knepen ze. Het tekenvenster is nu gesplitst: FVG-boxen en sessievensters houden
//   het korte venster (die ontstaan met tientallen per dag en zijn de dure post), de
//   trade-zones, het tekstblok en de exit-labels krijgen hun eigen venster met default 0 =
//   de hele history. En de harde caps van 40 boxen / 80 labels - met drie labels per trade
//   zag je maar zo'n 26 trades terug - staan nu op 480, net onder wat Pine toestaat.
// v3.3.0 (26-08): vier dingen die uit Ferry's live alert-log en accountschermen kwamen.
//   CONFIG-KAART - het CONFIG-blok stond als if/else-if: Journal aan onderdrukte de
//   Discord-kaart stilzwijgend, dus je zag nergens dat de alert leefde. Journal en Discord
//   zijn twee kanalen en geen alternatieven; ze worden nu allebei aangeroepen, net als bij
//   een trade-event, waar elke f_* zijn eigen route al bewaakt.
//   PAYOUT-DAGTELLERS - "qualDays >= 5" stond hardgecodeerd terwijl f_firmDays al door de
//   generator werd uitgeschreven en nergens werd aangeroepen. Een firma draait TWEE tellers
//   en het zijn niet dezelfde getallen: apex_50k_legacy_pa vraagt 8 dagen MET fills EN 5
//   kwalificerende dagen, apex_50k_eod_pa 5 en 5. Op een legacy PA meldde de tabel dus drie
//   handelsdagen te vroeg "payout ready". Er is nu een tweede teller (tradedDays) die dagen
//   met een fill telt, binnen dezelfde payout-cyclus als qualDays, en de winstdrempel voor
//   een kwalificerende dag is math.max(jouw input, de registrywaarde) - de strengste wint.
//   TORO DISCORD-NAAM - de vier EL TORO's stuurden geen username mee, waardoor hun kaarten
//   in Discord onder de naam van de WEBHOOK landden ("Captain Hook") in plaats van onder het
//   script. De negen funded scripts vielen al terug op SCRIPT_NAME; deze vier nu ook.
//   TORO CONFIG-INHOUD - hun cfgStr droeg geen firm, ddModel, trailDD of paDLL, dus je kon
//   uit de alert-stream niet zien met welke accountregels een eval draaide. Nu wel.
// v3.4.0 (07-09, item 31): één centraal handelsvenster per script.
//   Er stonden vier datum-inputs op twee plekken -- "No entries before start date",
//   "Start date/time (measure from)", "Use end date" en de einddatum -- plus de tester-range
//   van TradingView zelf. Welke van die vier de handel begrensde was van buiten niet te zien,
//   en dat is de reden dat Ferry naar hardcoded logica uitweek. Ze zijn alle vier weg.
//   ERVOOR IN DE PLAATS: validFrom + validUntil in groep 1, en verder niets. Backtest,
//   forward-test en live lezen alle drie ditzelfde venster.
//   GEDRAG OP DE GRENS, vastgelegd en bewust geen knop: entries stoppen hard op validUntil
//   en een reeds neergelegde limietorder wordt daar geannuleerd (anders is de stop geen stop);
//   openstaande posities houden 24 uur grace om netjes te sluiten; daarna wordt er eenmalig
//   platgemaakt. Op de grens gaat er één Discord-melding uit.
//   ZICHTBAAR: de ACCOUNT-laag van de tabel heeft een regel "Window" die de stand toont --
//   not started / open until <datum> / EXPIRED met resterende grace-uren / CLOSED. Het venster
//   staat ook in de CONFIG-kaart (validFrom, validUntil, graceH), zodat de middleware zijn
//   dubbelslot tegen dezelfde grenzen kan zetten.
//   LET OP: de datumkiezer van TradingView interpreteert in de EXCHANGE-tijdzone van de chart.
//   De defaults staan expliciet in America/New_York en de tabel toont de grenzen terug in je
//   referentietijdzone, zodat je kunt zien wat er echt staat.
//   NIET meegenomen: "Last payout (consistency anchor)" blijft een eigen input. Dat is geen
//   handelsvenster maar het startpunt van de consistency- en kwalificerende-dagentellers;
//   samenvoegen zou die tellers stukmaken.
// v3.5.0 (29-09, D-108 + D-107): twee correcties op het live pad, geen handelslogica.
//   D-108 -- NUL BETEKENT GEEN LIMIET. De firmablokken zijn opnieuw uit de registry
//   gegenereerd. Die schrijft nu correct 0 waar een programma geen daglimiet of geen
//   consistency-regel kent (de evaluaties), in plaats van de verzonnen fallbacks 1000/50
//   die er sinds D-68 in stonden. Pine las die 0 echter als een limiet VAN nul:
//   runningPnL <= -0 is waar zodra de dag een cent onder nul staat, dus de dag ging
//   meteen op slot. GEREPAREERD: dllHit eist nu acctDLL > 0 en consistencyOK behandelt
//   consistencyPct <= 0 als "geen regel". Ferry's funded programma's veranderen niet;
//   zijn evaluaties verliezen de halt op -$1.000 -- correct volgens de firmaregels, maar
//   het is een bescherming die weggaat.
//   D-107 -- EEN SLUITING PER BAR NAAR BUITEN. Cap-/pass-lock, auto-flat, venster-grace,
//   dag-halt en account-halt konden alle vijf op dezelfde bar f_sendExec("close") sturen;
//   elk had alleen zijn eigen once-guard en geen onderlinge uitsluiting. Een dag-halt op
//   de bar waarop ook het flat-window ingaat stuurde dus TWEE sluitorders naar het live
//   pad, de tweede voor een positie die al dicht was. De bar-lokale vlag flatSentBar laat
//   er per bar precies een door. strategy.close_all() is bewust NIET aangeraakt, zodat de
//   backtest bit-voor-bit gelijk blijft en dit aantoonbaar alleen alert-plumbing is.
//   OOK D-107: vijf van de zes sluitingen stuurden t_qty mee -- de qty die bij de ENTRY
//   is gezet en daarna blijft staan -- in plaats van de werkelijke positie. Na een
//   gederiskte of gecapte fill lopen die uiteen en sluit je te veel (doordraaien naar de
//   andere kant) of te weinig (restpositie blijft staan). De vier halt-paden sturen nu
//   math.abs(posSize). De zesde plek is geen sluiting maar het intrekken van een
//   niet-opgepikte limietorder; daar is t_qty juist en die blijft staan.
//   DERDE STUK (zelfde ronde, na D-104): de firmablokken zijn opnieuw uit de registry
//   gegenereerd nadat Backtest Setup de laatste vier firma's toevoegde. Zes nieuwe
//   programma's erbij; van de achttien bestaande veranderden er twee, en allebei omdat de
//   .pine achterliep op de registry: mffu_50k_eval en takeprofittrader_50k_eval krijgen
//   consistency 50% (stond op 0 = geen regel) en min. handelsdagen 2 resp. 3 (stond op 1).
//   GEEN ENKEL APEX-PROGRAMMA VERANDERT -- alle negen staan er bit-voor-bit gelijk in.
// v3.6.0 (29-09, D-110 stap 1): Ferry's EIGEN dagrem staat aan, de firm-rem blijft.
//   Besluit Ferry (D-109): de firm-DLL is informatie, geen rem -- een account handelt tot
//   de target of tot ZIJN limiet, en de firma stopt het daarna vanzelf. Die eigen limiet
//   bestond hier wel maar stond op `false`, in twaalf scripts zelfs als harde constante:
//   de machinerie werkte, niets voedde haar. Hij staat nu AAN met de vastgelegde formule
//   stop-per-contract x stops-per-dag x qty (100 x 4 x qty), als drie zichtbare inputs
//   plus een override; 0 in de override betekent "gebruik de formule".
//   ⚠️ DIT IS STAP 1 VAN TWEE, en de volgorde is de hele opdracht. `dllHit` op `acctDLL`
//   blijft in deze versie staan. Twee remmen naast elkaar is veilig -- de strengste wint.
//   Zou je de firm-rem nu al weghalen terwijl de eigen rem nog niet de strengste is, dan
//   loopt het account tot de firmalimiet, en die BREACHT een eval in plaats van hem te
//   pauzeren. `pine/tools/owner_dll_check.py` is de poort: die leest de defaults uit de
//   bron en zegt per script of stap 2 daar al mag. Vandaag: op elf van de dertien niet,
//   want op de bevroren contractgrootte is 4 x SL x qty groter dan de firmalimiet.
//   ⛔ De tweede term van de formule ("nooit meer dan 1/3 van de ruimte") staat er BEWUST
//   niet in: die heeft balans en liquidatieniveau nodig, de balans komt uit T3, en een
//   benadering in Pine zou een tweede stille saldobron zijn. Die term hoort na fase 4 in
//   de middleware.
//   NEVENEFFECT: `dailyLossLimitEff` verloor zijn `* dailyScaleMult`. Dat is geen
//   gedragswijziging -- `dailyScaleMode` is in alle dertien de constante "Fixed USD", dus
//   die factor was altijd 1.0. De qty zit nu in de formule zelf, en zo kan hij er niet
//   per ongeluk twee keer in komen.
//   ZICHTBAAR: de CONFIG-kaart toont niet langer de rauwe input maar de effectieve
//   limiet met de formule erachter, bv. DLL=2400(100x4x6).
// v3.7.0 (29-09, D-110 stap 1b): de firmalimiet doet mee IN de eigen rem.
//   Ferry keurde de derde term goed, dus de formule is nu
//       owner_dll = min( SL x stops x qty , firm_dll , ruimte x fractie )
//   Termen 1 en 2 staan in dit script. Term 3 komt er BEWUST niet in: die heeft de
//   balans nodig, de balans komt uit T3, en een benadering hier zou een tweede stille
//   saldobron zijn. Verbatim Ferry: "de controle in het script, de middleware mag de
//   signalering doen."
//   WAAROM DIT ERTOE DOET: met firm_dll in de eigen rem halteert die per definitie OP of
//   VOOR de firmalimiet. `dllHit` kan daardoor nooit eerder vuren en is strikt overbodig
//   geworden -- dat is wat stap 2 opent. De voorwaarden van `dllHit` (`acctDLL > 0` en
//   PA-of-EOD-eval) zijn letterlijk overgenomen in `firmDllActive`, zodat de dekking
//   gelijk is en niet ongeveer gelijk. Staat de eigen rem uit, dan blijft de firmalimiet
//   over -- ook dat is precies wat `dllHit` vandaag doet.
//   TWEE DINGEN DIE HIERDOOR STRENGER WORDEN, en dat is bedoeld:
//   (1) waar de formule losser was dan de firma (qty 3 en hoger) remt het script nu op
//       $1.000 in plaats van op $1.200 t/m $3.200;
//   (2) de rem meet op `lossBasisEff` en niet op `runningPnL`. Met `includeOpenInLoss`
//       AAN is dat min(gerealiseerd, lopend), dus een dag met -$1.000 gerealiseerd en
//       open winst erboven stopt nu wel en stopte eerder niet.
//   `lossBasisEff` neemt bovendien expliciet de min met `runningPnL` zodra de firmaterm
//   meedoet. Met de huidige defaults verandert die min niets; zonder hem zou stap 2
//   dekking verliezen op een chart waar `includeOpenInLoss` uit staat.
//   DE KLOK: die staat sinds v3.6.0 al op nul; deze versie zet hem niet opnieuw.
// v3.8.0 (29-09, D-110 stap 2): `dllHit` is weg. Eén dagrem over.
//   Hij remde op de firmawaarde en stond los van de eigen rem. Sinds v3.7.0 zit diezelfde
//   firmawaarde IN de eigen rem, met exact zijn twee voorwaarden in `firmDllActive`, dus
//   `lossHit` haltte per definitie al op of vóór het punt waarop hij zou vuren. Niet
//   "ongeveer overbodig" maar strikt overbodig -- en dat is de enige reden dat hij nu weg
//   mag. `pine/tools/owner_dll_check.py` toetste dat per script tegen de bron en stond op
//   alle dertien groen vóórdat deze regel verdween; hij bewaakt nu ook dat `dllHit` niet
//   terugkomt.
//   WAT ER NIET VERANDERT: `acctDLL` blijft staan. D-96 heeft de firmawaarde nodig als
//   weergave ("ruimte tot de DLL") en de eigen rem leest hem. Ook de tooltip bij die input
//   blijft, zodat op de chart zichtbaar blijft wat de firma oplegt naast wat jij oplegt.
//   ZICHTBAAR: een dag die op de firmawaarde stopt heet voortaan "Daily Loss" in plaats
//   van "PA Daily Loss Limit" -- dat was de naam van de rem die weg is. De DLL-annotatie
//   op de chart luistert nog steeds mee (op "Daily Loss" en "Risk-gate DLL").
//   ⚠️ RESTRISICO, en dat is ouder dan deze wijziging: op de drie TORO-intraday-evals geldt
//   er geen firmalimiet (Apex legt er geen op), dus daar is de eigen rem ongedekt op
//   $2.400 t/m $2.800 -- boven de $2.000 trailing drawdown. `dllHit` vuurde daar ook al
//   niet, dus zijn vertrek verandert er niets. Het zit in de qty, niet in de formule.
// v3.9.0 (06-10, D-126 + D-125 + D-124): de payout-poort, in één ronde.
//   Drie items die alle drie dezelfde poort raken, dus één versie en één OOS-reset in
//   plaats van drie. De volgorde was bindend: eerst de ladder goed, want zolang die fout
//   is weet je niet wanneer de poort hóórt te sluiten.
//
//   D-126 — DE LADDER KOMT UIT DE REGISTRY. `f_firmLadder(preset, n)` stond hier al,
//   gegenereerd uit `data/propfirms.json` en per programma correct, met NUL call-sites in
//   dertien scripts. De poort remde in plaats daarvan op een handgeschreven `f_ladderCap`
//   die ALTIJD de Apex-50K-ladder teruggaf. Een 250K legacy account stopte daardoor met
//   handelen op $1.500 terwijl zijn cap $3.000 is. `f_ladderCap` is weg.
//   Gemeten: op de `firmPreset`-default van elk script geeft `f_firmLadder` dezelfde zes
//   waarden, dus dit verandert niets op de charts zoals ze nu staan -- het repareert een
//   chart die op een 250K legacy of Blue Guardian programma is gezet.
//
//   D-125 — DE DEADLOCK IS WEG. `pmtBlock` hing op `withdrawable >= curLadderCap` alleen.
//   In de toestand cap-bereikt EN consistency-niet-gehaald gold tegelijk: geen entries
//   (`pmtBlock`) en geen payout (`payoutReady = false`). De uitweg was afgesloten, want de
//   consistency-regel is `bestDaySince / profitSince < 30%` en `bestDaySince` staat vast --
//   de enige knop is `profitSince` omhoog, en dat vraagt precies de trades die de blokkade
//   verhinderde. `pmtBlock` hangt nu op `payoutReady`: de blokkade heeft alleen zin als de
//   payout werkelijk aangevraagd KAN worden. Kan dat niet, dan beschermt hij niets en
//   verbrandt hij bezette account-dagen -- de maat waar dit project op stuurt.
//   ⚠️ Gevolg dat je moet willen: een account boven zijn cap dat nog niet payout-gerechtigd
//   is handelt dóór en kan voorbij de laddertrede komen. Geen breach-risico (de cap
//   begrenst de HOOGTE van een aanvraag, niet het verlies), maar de volle-trede-discipline
//   wijkt in die ene toestand voor de uitweg. Op de TORO-scripts bestaat de deadlock niet:
//   daar hangt de blokkade op `evalPassed`.
//
//   D-124 — `useWaitForCap` IS EEN INPUT, default `true`. Het was een harde constante die
//   stuurt of een funded account nog handelt, zonder knop om het te zien of te zetten --
//   achtste instantie van dat patroon. Default `true` is de hele voorwaarde: uit zetten
//   laat een account dóórhandelen voorbij zijn cap.
//
//   🔑 EN DE POORT DIE DIT HAD VOORKOMEN. `tools/gen_pine_firms.py` faalt nu hard als een
//   `f_firm*`-functie die hij genereert in een script geen enkele call-site heeft. Dat is
//   geen nette-code-regel: een ongebruikte generated functie zet de registry-waarden
//   correct in het bestand terwijl het script op iets anders remt, en precies dat bleef
//   weken onzichtbaar. ⚠️ Op zijn eerste run vond die poort meteen een TWEEDE geval:
//   `f_firmMinPayout` had ook nul call-sites, en `minPayout` zit in `payoutEligible`. Nu
//   gezet uit het preset. Op elk programma dat deze vloot gebruikt is die waarde 500, dus
//   ook dit verandert niets vandaag -- het sluit de keten.
//   📌 Nog open, apart gemeld: `f_contractSpec` heeft eveneens nul call-sites. Die valt
//   buiten de poort (geen `f_firm*`) en is referentiedata die het script niet nodig heeft,
//   want het leest `syminfo.*` van de chart. Weghalen raakt de generatie-regiomarkers en
//   hoort in een eigen ronde.
// v3.10.0 (08-10, D-148 + D-139): het payout-maximum klopt met Apex, en een onbekende
// account-fase sluit alles.
//   D-148 — GEEN OPLOPENDE LADDER. Apex' eigen pagina zegt: het maximum per payout is
//   VAST per accountgrootte ($25k $1.500 · $50k $2.000 · $100k $2.500 · $150k $2.750 ·
//   $250k $3.000 · $300k $3.500) en het VERVALT vanaf de zesde payout, mits de minimum
//   vereiste balans in het account blijft. Wij hadden [1500,1500,2000,2500,2500,3000].
//   Dat kostte twee keer geld: op payout #1 blokkeerde het script op $1.500 terwijl Apex
//   $2.000 toestaat, en voorbij de vijfde payout kende het script nog een plafond van
//   $3.000 dat in werkelijkheid niet bestaat -- precies de fase waar account 018 in zit.
//   `f_firmLadder` draagt nu beide vormen uit de registry (een vast maximum of een rij per
//   payoutnummer) plus het payoutnummer vanaf waar er GEEN maximum is. Geen maximum komt
//   terug als `na`, bewust niet als 0: nul zou "maximum van nul" betekenen en dat is exact
//   de D-108-fout die elke eval stillegde.
//   ⛔ Daardoor moet ELKE lezer van `curLadderCap` zeggen wat "geen maximum" daar betekent,
//   en dat is per plek anders: voor `fullCapReady` is de volle-trede-eis dan VERVULD, voor
//   `pmtBlock` is er niets om op te stoppen, voor de PA-simulatie is de hele opneembare
//   stand de payout, en `lockOnCap` heeft niets om vast te zetten. `capExists` en `capStr`
//   maken dat expliciet; een vergeten plek zou een stille NaN zijn geweest.
//   Nagerekend: apex_50k_legacy_pa P1-P5 $2.000 en P6+ geen maximum; apex_250k_legacy_pa
//   P1-P5 $3.000 en P6+ geen maximum.
//   ⚠️ apex_50k_eod_pa en apex_50k_intraday_pa dragen in de registry nog de oude rij en
//   geen vast maximum, dus daar verandert niets -- en dat is de `firmPreset`-default op
//   zeven van de negen PA-scripts. Een legacy-account hoort op `apex_50k_legacy_pa` te
//   staan; dat is een keuze in het instellingenvenster, geen code.
//
//   D-139 — ONBEKENDE FASE = ALLES DICHT. `phaseOn = isEval or isPA`, en "Research" is geen
//   van beide: dan viel élke accountpoort weg -- trailing, goal, breach-halt. A-82 mat de
//   rekening: eval 274 nam vier stops voor -$9.762 op een account dat na de eerste al dood
//   was, en 268-274 waren zeven evals in twee dagen. `canTrade` eist nu `not phaseUnknown`,
//   dus geen nieuwe entries. SLUITEN BLIJFT WEL MOGELIJK -- een poort die ook de exit
//   dichtzet maakt het erger dan het was.
//   WAAROM EEN CHART DIE WAARDE NOG UITZENDT: `accountPhase` kent hier drie opties en
//   "Research" staat er niet meer bij. TradingView bewaart een opgeslagen inputwaarde die
//   niet meer in de optielijst voorkomt en blijft die gebruiken tot iemand het
//   instellingenvenster opent en opnieuw kiest. De chart ziet er dan bijgewerkt uit, staat
//   op deze versie, en draait tóch zonder poorten. Daarom staat er nu ook een rood label op
//   de laatste bar, buiten de teken-laag: die zit achter een tekenbudget, en een
//   veiligheidsmelding die kan wegvallen omdat dat budget vol is, is er geen.
//   DE OOS-KLOK GAAT OP NUL -- akkoord Ferry 08-10, en dat is hier de prijs waard.
var string SCRIPT_NAME = "MΞX ΞL TORO · ES FAST INTRA"
var string currentVersion = "v3.10.0"
strategy("MΞX ΞL TORO · ES FAST INTRA · " + currentVersion, shorttitle="TOR-ES-FI", overlay=true,
     initial_capital=50000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     calc_on_every_tick=false,
     max_bars_back=500,
     max_lines_count=500, max_boxes_count=500, max_labels_count=500,
     margin_long=0, margin_short=0,
     slippage=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=1.55)

import TradingView/ta/8

// === GROUPS ==================================================================
var string GROUP_UNIT  = "4 · TRADE — Position sizing"
var string GROUP_ENTRY = "5 · TRADE — Entry & stop"
var string GROUP_RISK  = "6 · TRADE — Management"
var string GROUP_DAY   = "L4x · retired"
var string GROUP_PHASE = "8 · ACCOUNT — Guard"
var string GROUP_RG    = "8 · ACCOUNT — Guard: daily risk-gate"
var string GROUP_BIAS  = "9 · SIGNAL — Filters"
var string GROUP_SIG   = "9 · SIGNAL — Filters"
var string GROUP_CVD   = "9 · SIGNAL — Filters"
var string GROUP_FVG   = "9 · SIGNAL — Filters"
var string GROUP_TIME  = "3 · TIME GATE"
var string GROUP_MREG  = "3 · TIME GATE"
var string GROUP_TZ    = "1 · TIME — Validity window"
var string GROUP_BND   = "2 · TIME — Trading boundary"
var string GROUP_VIS   = "12 · VISUALS — Indicators"
var string GROUP_DASH  = "11 · VISUALS — Strategy"
var string GROUP_EXEC  = "10 · SIGNAL — Alerts"
var string GROUP_ALRT  = GROUP_EXEC

// === TIMEZONE / DAY ==========================================================
var string GROUP_ACCT = "0 · ACCOUNT — Identity"

// === v6.8: retired features — hard-disabled (inputs removed; engine paths inert) =========
bool   useOrBreakout  = false
