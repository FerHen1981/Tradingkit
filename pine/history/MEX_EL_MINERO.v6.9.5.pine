        _sl := 1.0
    else if _root == "RTY"
        _mt := 0.1
        _pv := 50.0
        _cm := 1.55
        _sl := 1.0
    else if _root == "SI"
        _mt := 0.005
        _pv := 5000.0
        _cm := 1.75
        _sl := 1.0
    else if _root == "USDJPY"
        _mt := 0.001
        _pv := 100000.0
        _cm := 3.5
        _sl := 1.0
    else if _root == "YM"
        _mt := 1.0
        _pv := 5.0
        _cm := 1.55
        _sl := 1.0
    [_mt, _pv, _cm, _sl]
// <<< GENERATED — do not edit above by hand; run tools/gen_pine_firms.py
// Commission is a CONTRACT SPEC, not a Pine setting: the source is backtest/config.py
// CONTRACTS and the value below is written by tools/gen_pine_firms.py. Pine only accepts a
// constant in strategy(), so on a chart whose symbol differs from this script's own asset
// the constant cannot be right -- the dashboard flags that instead of hiding it.
float SPEC_COMMISSION_SET = 1.75    // generated: GC per side, from backtest/config.py CONTRACTS
[_spMt, _spPv, _spCm, _spSl] = f_contractSpec(syminfo.root != "" ? syminfo.root : syminfo.ticker)
bool specCommOK = _spCm == 0.0 or math.abs(_spCm - SPEC_COMMISSION_SET) < 0.005
if useFirmPreset
    [pfDD, pfMax, pfGoal, pfDLL, pfCons] = f_firmRules(firmPreset)
    ddModel := pfDD
    acctTrailDD := pfMax
    acctGoal := pfGoal
    acctDLL := pfDLL
    consistencyPct := pfCons
