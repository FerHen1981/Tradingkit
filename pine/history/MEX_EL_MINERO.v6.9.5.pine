// === DELTA FILTER (vereenvoudigd) ===========================================
useCVDFilter  = input.bool(false, "Use Delta Filter", group=GROUP_CVD,
     tooltip="Requires volume data. Per-bar semantics (fixed). Mainly does selection work; the VWAP effect only existed within the delta-filtered subset. SPOT FX (EURUSD, USDJPY, ...): there is no real volume, so this AUTOMATICALLY falls back to TICK-VOLUME delta (a weaker proxy). Backtests show the 4-bar Streak adds little even on futures — on FX consider turning the Streak OFF (below), or this whole filter OFF and leaning on FVG + VWAP + time.")
cvdLowerTf    = input.timeframe("1", "Lower Timeframe for Delta", group=GROUP_CVD, tooltip="Lower timeframe scanned to approximate the volume delta (1 = per-minute polarity, matches the research engine).", display=display.none)
deltaBorrowSym = input.symbol("", "Borrow delta from symbol (empty = chart)", group=GROUP_CVD, tooltip="Drive the delta filter from ANOTHER symbol's real volume. Example: on a spot EURUSD chart set CME_MINI:6E1! to use the Euro FX future's genuine volume delta (spot FX has no real volume of its own). Empty = use this chart's own volume. Method: request.security_lower_tf up/down volume on the borrowed symbol — an approximation of native CVD.", display=display.none)
useCvdStreak  = input.bool(true, "Streak", inline="cv", group=GROUP_CVD, display=display.none)
cvdTrendCount = input.int(4, "Count", minval=1, inline="cv", group=GROUP_CVD, tooltip="Consecutive same-direction delta bars required.")

// === FVG =====================================================================
useGapFilter = input.bool(true, "Use FVG Size Range Filter", group=GROUP_FVG,
     tooltip="Size does not predict the outcome, but the range controls trade frequency and thus cost pressure. 9-13 is the", display=display.none)
gapMinSize   = input.float(9,  "Min FVG Size (units)", minval=0.01, group=GROUP_FVG, tooltip="Minimum FVG size. Do not widen — smaller gaps are noise.")
gapMaxSize   = input.float(15, "Max FVG Size (units)", minval=0.01, group=GROUP_FVG, tooltip="Maximum FVG size.")
confirmBarsIn = input.int(2, "Confirmation window (bars)", minval=0, maxval=20, group=GROUP_FVG,
     tooltip="v6.1 FVG confirmation memory. 0 = OFF = exact v6.0 behaviour. With X>0, a size-passing FVG whose confirmation (delta filter, VWAP veto, bias, sweep, time gate) is not present on the gap bar itself stays valid for X bars; the signal fires on the first bar inside the window where all strategy rules pass and the account is flat. One signal per gap, newest gap first; entry limit and stop reference the stored gap. HONEST VALIDATION NOTE: walk-forward funnel simulation (Sep 2018–Jun 2026, 878 paired starts, B exit configuration only): payout/funnel $171 (0) -> $305 (3) -> $355 (5), monotone in X; paired bootstrap at X=3: +$134/funnel, z=1.86 — positive but NOT 95%-significant. Effect is throughput/tempo (+66% trades, near-equal pass rate), not signal quality. Do NOT combine with break-even exits (weaker there, and BE variants stay below B). Fleet recommendation: core stream 0, tempo stream 3, explorer stream 5.")



int confirmBars = confirmBarsIn
