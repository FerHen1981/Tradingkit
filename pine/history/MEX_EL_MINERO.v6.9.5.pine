//@version=6
// v6.8.9 (optimised): memory-safe visuals (drawLast) + recovery-trail A1 fix + FX tick-volume delta note.
// v6.8.10: auto-guard the delta filter on non-futures assets (forex/CFD/spot).
// v6.8.11: inputs restructured + firm-preset dropdown (futures).
// v6.9.0: roll/OpEx/news factory — selectable event-regime filters (preset per strategy · account-type · phase).
// v6.9.1: "→ Middleware" route — emits a lean signal to the fan-out middleware (one alert per strategy).
// v6.9.5: input rework step 2 — 36 weekday/hour/flat-window fields become 2 session strings.
// v6.9.4: input rework step 1 — 15 display inputs collapsed to 2; no drawing code changed.
// v6.9.3: firm registry now generated into the scripts — 12 presets, correct default per script.
// v6.9.2: retired-feature cleanup — 36 permanently-disabled flags and their inert engine paths
//         removed (OR-breakout, PA context filters, regime indicator, derisk ladder, goal-TP,
//         PA threshold). No behaviour change: every removed path was gated on a false constant.
var string currentVersion = "v6.9.5"
strategy("MΞX ΞL MINΞRO · GC Eval EOD · " + currentVersion, shorttitle="ΞL MINΞRO", overlay=true,
     initial_capital=50000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     calc_on_every_tick=false,
     max_bars_back=500,
     max_boxes_count=500, max_labels_count=500,
     margin_long=0, margin_short=0,
     slippage=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=1.75)

import TradingView/ta/8

// === GROUPS ==================================================================
var string GROUP_UNIT  = "2 · TRADE — Position sizing"
var string GROUP_ENTRY = "3 · TRADE — Entry & stop"
var string GROUP_RISK  = "4 · TRADE — Take-profit & exits"
var string GROUP_PHASE = "1 · ACCOUNT — Phase, drawdown & guard"
var string GROUP_BIAS  = "7 · SIGNAL — VWAP / bias"
var string GROUP_CVD   = "6 · SIGNAL — Volume delta"
var string GROUP_FVG   = "5 · SIGNAL — FVG"
var string GROUP_TIME  = "8 · SIGNAL — Time gate"
var string GROUP_VIS   = "10 · RESEARCH — Visuals & labels"
var string GROUP_DASH  = "11 · MONITOR — Dashboard"
var string GROUP_EXEC  = "9 · EXECUTION — Alerts & routing"
var string GROUP_ALRT  = GROUP_EXEC
var string GROUP_EVT   = "8b · SIGNAL — Roll / OpEx / News factory"
// Regime-factory identity for THIS script (strategy · account-type · phase). The "Auto" preset resolves to this.
var string AUTO_PRESET = "GC · Eval"

// === TIMEZONE / DAY ==========================================================
var string GROUP_ACCT = "0 · ACCOUNT — Firm & routing"

// === v6.8: retired features — removed. One name survives: f_journal() writes a regime column,
// permanently false since the regime engine was retired. Removing it would change the CSV schema.
bool   useRegime      = false

accountID = input.string("", "PMT/Tradovate Account ID", group=GROUP_ACCT,
     tooltip="PMT/Tradovate account ID. Declared first on purpose: it is the FIRST value in the alert name/prefill, so every alert in the TradingView sidebar starts with the account it belongs to. Also feeds the automatic journal account name (first 2 letters + last 3 digits).")

input_tz = input.string("America/New_York", "Reference Timezone",
     options=["Pacific/Honolulu","America/Anchorage","America/Los_Angeles","America/Denver","America/Chicago","America/New_York","America/Sao_Paulo","Etc/UTC","Europe/London","Europe/Berlin","Europe/Amsterdam","Europe/Athens","Europe/Moscow","Asia/Dubai","Asia/Karachi","Asia/Dhaka","Asia/Bangkok","Asia/Singapore","Asia/Tokyo","Australia/Sydney","Pacific/Auckland"],
     group=GROUP_TIME, tooltip="Timezone for the time gate, flat window and day boundary. Keep America/New_York — all", display=display.none)
string activeTz = input_tz
dayBoundaryMode = input.string("Exchange session", "Trading-Day Boundary",
     options=["Exchange session","Calendar day (timezone)"], group=GROUP_TIME, tooltip="Where the trading day rolls over. Exchange session (default) = 18:00 ET futures session open, matching Apex and the research engine. Calendar day: midnight in the reference timezone.", display=display.none)

f_getHour()     => hour(time, activeTz)
f_getMinute()   => minute(time, activeTz)
f_minuteOfDay() => f_getHour() * 60 + f_getMinute()
f_calDayId()    => year(time, activeTz) * 10000 + month(time, activeTz) * 100 + dayofmonth(time, activeTz)
var int prevCalDayId = na
bool newCalDay = na(prevCalDayId) or f_calDayId() != prevCalDayId
prevCalDayId := f_calDayId()
bool isNewTradingDay = barstate.isfirst or (dayBoundaryMode == "Exchange session" ? timeframe.change("1D") : newCalDay)

// === UNITS & SIZING ==========================================================
unitMode  = input.string("Ticks", "Distance Unit", options=["Ticks","Points","%","ATR"], group=GROUP_UNIT, tooltip="Unit for all distance inputs (stops, gaps, buffers).", display=display.none)
atrLen    = input.int(14, "ATR Length (ATR unit)", minval=1, group=GROUP_UNIT, tooltip="ATR length, only used when Distance Unit is set to ATR.", display=display.none)
sizingMode = input.string("Fixed contracts", "Sizing Mode", options=["Fixed contracts","Fixed $ risk","% equity risk"], group=GROUP_UNIT,
     tooltip="With the swing stop the stop distance varies per trade; $-risk or %-risk sizing keeps risk per trade constant and is recommended in that case.", display=display.none)
contractSize       = input.float(1, "Fixed Qty", minval=0, group=GROUP_UNIT, tooltip="Fixed number of contracts per trade. The MAE guard may scale this down per trade on a PA.")
riskValue          = input.float(250, "Risk per Trade ($ of %)", minval=0, group=GROUP_UNIT, tooltip="Risk per trade when using $-risk or %-risk sizing instead of fixed contracts.", display=display.none)
allowFractionalQty = input.bool(false, "Allow Fractional Qty (crypto)", group=GROUP_UNIT, tooltip="Allow fractional position sizes (crypto only — futures require whole contracts).", display=display.none)
maxQty             = input.float(100, "Max Qty Cap", minval=0, group=GROUP_UNIT, tooltip="Hard cap on position size regardless of the sizing mode.", display=display.none)

atrVal = ta.atr(atrLen)
f_distPrice(_u) =>
    switch unitMode
        "Ticks"  => _u * syminfo.mintick
        "Points" => _u
        "%"      => close * _u / 100.0
        => _u * atrVal

// === ENTRY & STOP ENGINE =====================================================
entryMode = input.string("Limit @ 50% FVG", "Entry Mode", options=["Limit @ 50% FVG","Market (legacy)"], group=GROUP_ENTRY,
     tooltip="Limit: resting order at the gap retrace level; better price, no entry slippage, ~78% of signals still get filled.")
expiryBars = input.int(12, "Limit Order Expiry (bars)", minval=1, group=GROUP_ENTRY,
     tooltip="Bars a resting limit order stays valid before it is cancelled.")
stopMode  = input.string("Fixed (legacy)", "Stop Mode", options=["Swing structure","Fixed (legacy)"], group=GROUP_ENTRY, tooltip="Swing structure: stop beyond the last confirmed pivot AND the gap edge, plus buffer. Fixed: static distance.", display=display.none)
pivotK     = input.int(3, "Pivot Strength (bars links/rechts)", minval=1, maxval=10, group=GROUP_ENTRY,
     tooltip="A pivot is only confirmed k bars after the extreme; the script uses confirmed pivots exclusively (no repainting).", display=display.none)
swingBufSize = input.float(2, "Stop Buffer beyond swing (units)", minval=0, group=GROUP_ENTRY, tooltip="Buffer in units beyond the swing/gap level for the stop.", display=display.none)
maxStopSize  = input.float(100, "Max Stop Distance (units) — else no trade", minval=1, group=GROUP_ENTRY, tooltip="Signals with a wider stop than this are skipped entirely.", display=display.none)
slSizeLegacy = input.float(100, "Fixed Stop (units, legacy mode)", minval=0.01, group=GROUP_ENTRY, tooltip="Static stop distance, only used in Fixed stop mode.", display=display.none)

// === TRADE MANAGEMENT ========================================================
tpMode  = input.string("R-multiple", "Take-Profit Mode", options=["R-multiple","Swing structure","Fixed (units)"], group=GROUP_RISK,
     tooltip="Swing structure: target = last confirmed opposite pivot. R-multiple: target = R x stop distance. Fixed: static distance in units.", display=display.none)
rMultIn = input.float(1.5, "R-Multiple (R-multiple mode)", minval=0.1, step=0.5, group=GROUP_RISK,
     tooltip="Target as a multiple of the stop distance (R-multiple mode).")
tpSize  = input.float(122, "Take Profit (units, Fixed mode)", minval=0.01, group=GROUP_RISK, tooltip="Static target distance (Fixed TP mode only).", display=display.none)
useBreakEven    = input.bool(false, "Enable Break-even", group=GROUP_RISK,
     tooltip="Default ON (v3.6). Optional with Swing TP (expectancy-neutral, lower DD); with R-multiple it is part of the exit engine. Live: server-side via broker bracket.", display=display.none)
beTriggerSize   = input.float(20, "BE Trigger MFE (units)", minval=0.01, group=GROUP_RISK, tooltip="MFE required before the stop moves to break-even.", display=display.none)
beOffsetSize    = input.float(8,  "BE Offset (units)", minval=0, group=GROUP_RISK, tooltip="Offset above/below entry for the break-even stop.", display=display.none)
useTrail        = input.bool(false, "Enable Trailing", group=GROUP_RISK,
     tooltip="Default ON (v3.6): ESSENTIAL in R-multiple mode ($11.70 vs $6.80/trade; maxDD $4.2k vs $15.1k without). Optional with Swing TP but reduces DD.", display=display.none)
trailStartSize  = input.float(48, "Trail Activation MFE (units)", minval=0.01, group=GROUP_RISK, tooltip="MFE required before the trailing stop activates.", display=display.none)
trailBufferSize = input.float(24, "Trail Buffer (units)", minval=0.01, group=GROUP_RISK, tooltip="Distance the trail keeps from the running extreme.", display=display.none)
// === v6.4.4M: HERSTEL-TRAIL (alleen trade #2 na een verlies in dezelfde eval-poging) ===
useFillCheck    = input.bool(true, "FVG fill check (gap invalid once mid is touched)", group=GROUP_RISK,
     tooltip="Removes an FVG from the confirmation memory once price touches its mid (partially filled = invalid).")
useRecovTrail   = input.bool(true, "Recovery trail on trade #2 after a loss (Eval)", group=GROUP_RISK,
     tooltip="Eval only: on the second trade of an attempt after a first-trade loss, trail partial profit instead of running to the full target.")
recovTrailStart = input.float(40, "Recovery trail activation (units)", minval=1, inline="rt", group=GROUP_RISK,
     tooltip="Peak (units) at which the recovery trail arms.", display=display.none)
recovTrailBuf   = input.float(16, "Recovery trail buffer (units)", minval=1, inline="rt", group=GROUP_RISK,
     tooltip="Distance the recovery trail keeps from the peak.", display=display.none)

string tpModeEff   = tpMode
float  tpSizeEff   = tpSize
bool   useBEeff    = useBreakEven
float  beTrigEff   = beTriggerSize
float  beOffEff    = beOffsetSize
bool   useTrailEff = useTrail
float  trStartEff  = trailStartSize
float  trBufEff    = trailBufferSize

float trailUpdateStep = 2.0


// === DAILY RISK / EQUITY =====================================================
enableDailyLossLimit = false
dailyLossLimit       = 700.0
includeOpenInLoss    = true
enableDailyTarget    = false
dailyProfitTarget    = 350.0
enableDailyDrawdown    = false
dailyDrawdownLimit    = 750.0
enableEquityLock    = false
equityLockThreshold    = 300.0
equityLockPerc    = 90.0
onlyFirstTrade       = false

// === INTRADAY DAY-EXIT (v6.4.4i — sim-gevalideerde dagwinst-behoud) ==========
var string GROUP_DEX = "1e · ACCOUNT — Funded: day-profit exit"
dayExitMode = "Off"
dayTrailUSD = 150.0
dayCapUSD   = 300.0
ddModel       = input.string("EOD", "Drawdown Model", options=["EOD","Intraday"], group=GROUP_PHASE,
     tooltip="EOD (Apex 4.0 default): trailing ratchets on the daily closing balance only; open profit peaks do not count. Intraday (legacy): ratchets in real time with the live peak.", display=display.none)
payoutBuffer  = 500.0
var string GROUP_WFC = "1c · ACCOUNT — Funded: payouts & discipline"
useWaitForCap = false
payoutNr      = 1
paBacktestMode = true
accountPhase  = input.string("Apex Eval", "Account Phase", options=["Research (none)","Apex Eval","Apex PA"], group=GROUP_PHASE,
     tooltip="Research: no account rules (default; backtests unchanged). Eval: goal + trailing. PA: trailing until lock, DLL, consistency/payout monitor — and the MAE guard (group 16).")
acctTrailDD   = input.float(2500, "Trailing Drawdown ($)", step=100, group=GROUP_PHASE, tooltip="Trailing drawdown of your account plan.", display=display.none)
acctGoal      = input.float(3000, "Eval Profit Goal ($)", step=100, group=GROUP_PHASE, tooltip="Eval profit target for the phase tracker (Apex 50k: $3,000).", display=display.none)
acctDLL       = 1000.0
consistencyPct= 50.0
minPayout     = 500.0
minQualDayUSD = 50.0
acctPnlOffset = input.float(0, "Live sync: current account PnL vs start ($)", group=GROUP_PHASE,
     tooltip="For live use: enter the account's actual PnL so floor/goal are correct. Backtest: 0.", display=display.none)
acctHwmOffset = input.float(0, "Live sync: current HWM vs start ($)", group=GROUP_PHASE, tooltip="For live use with EOD trailing: the account high-water mark so the floor calculates correctly. Backtest: 0.", display=display.none)
lastPayoutTime= timestamp("2024-01-01T00:00:00")
// === 0 · FIRM PRESET — auto-fills account rules from data/propfirms.json ======
// Futures (trailing-DD) firms only. Forex/static firms run via the Python
// backtester until the static-DD Pine engine is added. Manual inputs stay as override.
useFirmPreset = input.bool(false, "Use firm preset (fills account rules below)", group=GROUP_PHASE, tooltip="Pick a prop-firm program; the drawdown model, trailing DD, eval goal, daily-loss and consistency get set for you. Leave OFF to use the manual inputs.")
firmPreset    = input.string("apex_50k_eod_eval", "Firm program", options=["apex_250k_legacy_eval", "apex_25k_legacy_eval", "apex_50k_eod_eval", "apex_50k_eod_pa", "apex_50k_intraday_eval", "apex_50k_intraday_pa", "apex_50k_legacy_eval", "apex_50k_legacy_pa", "daytraders_s2f_25k_instant", "mffu_50k_eval", "takeprofittrader_50k_eval", "topstep_50k_eval", "tradeify_advanced_25k_instant"], group=GROUP_PHASE, tooltip="Auto-generated from the prop-firm registry. Only trailing-DD (futures) firms are listed here.")
f_firmRules(string _p) =>
    string _dd = "Intraday"
    float _ml = 2500.0
    float _g = 3000.0
    float _dll = 1000.0
    float _cons = 50.0
    if _p == "apex_250k_legacy_eval"
        _dd := "Intraday"
        _ml := 6500.0
        _g := 15000.0
        _dll := 1000.0
        _cons := 0.0
    else if _p == "apex_25k_legacy_eval"
        _dd := "Intraday"
        _ml := 1500.0
        _g := 1500.0
        _dll := 1000.0
        _cons := 0.0
    else if _p == "apex_50k_eod_eval"
        _dd := "EOD"
        _ml := 2500.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 0.0
    else if _p == "apex_50k_eod_pa"
        _dd := "EOD"
        _ml := 2500.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 50.0
    else if _p == "apex_50k_intraday_eval"
        _dd := "Intraday"
        _ml := 2500.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 0.0
    else if _p == "apex_50k_intraday_pa"
        _dd := "Intraday"
        _ml := 2500.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 50.0
    else if _p == "apex_50k_legacy_eval"
        _dd := "Intraday"
        _ml := 2500.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 0.0
    else if _p == "apex_50k_legacy_pa"
        _dd := "EOD"
        _ml := 2500.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 30.0
    else if _p == "daytraders_s2f_25k_instant"
        _dd := "EOD"
        _ml := 1000.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 50.0
    else if _p == "mffu_50k_eval"
        _dd := "EOD"
        _ml := 2000.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 0.0
    else if _p == "takeprofittrader_50k_eval"
        _dd := "EOD"
        _ml := 2000.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 0.0
    else if _p == "topstep_50k_eval"
        _dd := "EOD"
        _ml := 2000.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 0.0
    else if _p == "tradeify_advanced_25k_instant"
        _dd := "EOD"
        _ml := 1500.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 50.0
    [_dd, _ml, _g, _dll, _cons]
f_firmMinPayout(string _p) =>
    float _mp = 500.0
    if _p == "apex_250k_legacy_eval"
        _mp := 500.0
    else if _p == "apex_25k_legacy_eval"
        _mp := 500.0
    else if _p == "apex_50k_eod_eval"
        _mp := 500.0
    else if _p == "apex_50k_eod_pa"
        _mp := 500.0
    else if _p == "apex_50k_intraday_eval"
        _mp := 500.0
    else if _p == "apex_50k_intraday_pa"
        _mp := 500.0
    else if _p == "apex_50k_legacy_eval"
        _mp := 500.0
    else if _p == "apex_50k_legacy_pa"
        _mp := 500.0
    else if _p == "daytraders_s2f_25k_instant"
        _mp := 500.0
    else if _p == "mffu_50k_eval"
        _mp := 500.0
    else if _p == "takeprofittrader_50k_eval"
        _mp := 500.0
    else if _p == "topstep_50k_eval"
        _mp := 500.0
    else if _p == "tradeify_advanced_25k_instant"
        _mp := 500.0
    _mp
f_firmLadder(string _p, int _n) =>
    float[] _l = array.from(1500.0, 1500.0, 2000.0, 2500.0, 2500.0, 3000.0)
    if _p == "apex_50k_eod_pa"
        _l := array.from(1500.0, 1500.0, 2000.0, 2500.0, 2500.0, 3000.0)
    else if _p == "apex_50k_intraday_pa"
        _l := array.from(1500.0, 1500.0, 2000.0, 2500.0, 2500.0, 3000.0)
    else if _p == "apex_50k_legacy_pa"
        _l := array.from(1500.0, 1500.0, 2000.0, 2500.0, 2500.0, 3000.0)
    array.get(_l, math.max(0, math.min(_n - 1, array.size(_l) - 1)))
f_firmDays(string _p) =>
    int _md = 0
    int _pd = 0
    float _qd = 50.0
    if _p == "apex_250k_legacy_eval"
        _md := 1
        _pd := 0
        _qd := 50.0
    else if _p == "apex_25k_legacy_eval"
        _md := 1
        _pd := 0
        _qd := 50.0
    else if _p == "apex_50k_eod_eval"
        _md := 1
        _pd := 0
        _qd := 50.0
    else if _p == "apex_50k_eod_pa"
        _md := 5
        _pd := 5
        _qd := 50.0
    else if _p == "apex_50k_intraday_eval"
        _md := 1
        _pd := 0
        _qd := 50.0
    else if _p == "apex_50k_intraday_pa"
        _md := 5
        _pd := 5
        _qd := 50.0
    else if _p == "apex_50k_legacy_eval"
        _md := 1
        _pd := 0
        _qd := 50.0
    else if _p == "apex_50k_legacy_pa"
        _md := 8
        _pd := 5
        _qd := 50.0
    else if _p == "daytraders_s2f_25k_instant"
        _md := 1
        _pd := 0
        _qd := 50.0
    else if _p == "mffu_50k_eval"
        _md := 1
        _pd := 0
        _qd := 50.0
    else if _p == "takeprofittrader_50k_eval"
        _md := 1
        _pd := 0
        _qd := 50.0
    else if _p == "topstep_50k_eval"
        _md := 2
        _pd := 0
        _qd := 50.0
    else if _p == "tradeify_advanced_25k_instant"
        _md := 1
        _pd := 0
        _qd := 50.0
    [_md, _pd, _qd]
f_contractSpec(string _root) =>
    float _mt = 0.0
    float _pv = 0.0
    float _cm = 0.0
    float _sl = 0.0
    if _root == "6A"
        _mt := 0.0001
        _pv := 100000.0
        _cm := 1.75
        _sl := 1.0
    else if _root == "6B"
        _mt := 0.0001
        _pv := 62500.0
        _cm := 1.75
        _sl := 1.0
    else if _root == "6C"
        _mt := 5e-05
        _pv := 100000.0
