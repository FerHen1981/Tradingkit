// === ROLL / OPEX / NEWS FACTORY (event-regime filters) ======================
// Validated on 3y OOS: for the mean-reversion engine the losses concentrate in the
// quarterly roll/triple-witching window (esp. quiet, no-news days), while macro news
// (NFP tailwind, FOMC on ES/GC) sits on the profit side. This block lets you AVOID the
// loss-regimes per strategy / account-type / phase. Preset "Auto" = the validated default
// for THIS script; pick another to borrow its config, or "Off / Custom" to drive the
// toggles yourself. Survival over winning — don't fight the bull in the witching-week chaos.
useEvtFilter = input.bool(true, "Enable roll/OpEx/news factory", group=GROUP_EVT,
     tooltip="Master switch. Off = trade every session regardless of roll/OpEx/news regime.")
evtPreset = input.string("Auto (this script)", "Preset (strategy · type · phase)",
     options=["Auto (this script)","ES · Eval","ES · Funded","GC · Eval","GC · Funded","YM · any","NQ · any","Off / Custom"],
     group=GROUP_EVT, tooltip="Auto resolves to the validated default for this script (" + AUTO_PRESET + "). Choose another strategy/account-type to borrow its regime config, or 'Off / Custom' to use the manual toggles below.")
rgAvoidRoll    = input.bool(true,  "Custom · avoid quarterly roll window",   group=GROUP_EVT, tooltip="Used only when preset = Off / Custom. Skip entries within ± the day-window around the quarterly (Mar/Jun/Sep/Dec) 3rd-Friday expiry.")
rgRollDays     = input.int(10,     "Custom · roll window ± days", minval=0, maxval=30, group=GROUP_EVT, tooltip="Half-width of the roll window in calendar days.")
rgRollNewsOvr  = input.bool(true,  "Custom · but trade if it IS a news day", group=GROUP_EVT, tooltip="News (FOMC/NFP) sits on the profit side — keep trading it even inside the roll window.")
rgAvoidWitch   = input.bool(false, "Custom · avoid triple-witching week",    group=GROUP_EVT, tooltip="Skip the trading week of the quarterly expiry (the strongest loss-regime for YM).")
rgAvoidWkAfter = input.bool(false, "Custom · avoid week AFTER monthly OpEx",  group=GROUP_EVT, tooltip="ES bleeds the week after every monthly options expiry (all 4 years <1).")
rgBlockFOMC    = input.bool(false, "Custom · block FOMC days",               group=GROUP_EVT, tooltip="Skip FOMC decision days (a loss-regime for NQ; a profit day for ES/GC — leave off there).")
rgBlockNFP     = input.bool(false, "Custom · block NFP days",                group=GROUP_EVT, tooltip="Skip Non-Farm-Payroll Fridays. Usually a tailwind for index strats — leave off.")

