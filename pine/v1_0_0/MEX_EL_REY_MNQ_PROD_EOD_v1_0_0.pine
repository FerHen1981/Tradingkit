     tooltip="Wide: the classic 4-column dashboard. Compact (mobile): two narrow columns with the same information stacked on separate lines inside each cell — fits a phone screen without horizontal squeezing. Visual only; no strategy impact.", display=display.none)

// === v5.5: THEMA-PALET =======================================================
float _bgLum = 0.299 * color.r(chart.bg_color) + 0.587 * color.g(chart.bg_color) + 0.114 * color.b(chart.bg_color)
bool visIsDark = visTheme == "Dark" ? true : visTheme == "Light" ? false : _bgLum < 128
color vPOS    = #089981
color vNEG    = #F23645
color vText   = visIsDark ? #ECECEC : #1E222D
color vMuted  = visIsDark ? color.new(#B2B5BE, 15) : color.new(#5A5D68, 0)
color vPosTxt = visIsDark ? #34D1B2 : #056656
color vNegTxt = visIsDark ? #FF7A85 : #B22833
color zRiskBg   = color.new(vNEG, visIsDark ? 90 : 92)
color zRewardBg = color.new(vPOS, visIsDark ? 90 : 92)

// === EXECUTION / ROUTING =====================================================
// v6.8.13 — independent per-destination toggles; ALL config lives in these inputs
// (single-select "Alert destination" dropdown removed). Enable any combination.
// NOTE: TradingView delivers one alert to ONE webhook URL and Pine cannot POST to
// a URL itself. So TODAY: enable ONE route per alert and put that route's webhook
// on the alert. Enabling several at once is for the planned MIDDLEWARE step: the
// alert URL points only at the middleware, which reads the enabled routes and
// fans out. Per-route webhooks then live in the middleware (Pine can't send them).
routePMT           = input.bool(false, "→ PMT Tradovate", group=GROUP_EXEC, tooltip="PickMyTrade, Tradovate route (PMT JSON). Needs PMT Token + the Account ID (group 0).")
routeRithmic       = input.bool(false, "→ PMT Rithmic", group=GROUP_EXEC, tooltip="PickMyTrade, Rithmic route. Same PMT JSON payload; needs PMT Token + Account ID.")
routePineConnector = input.bool(false, "→ PineConnector (MT4/5)", group=GROUP_EXEC, tooltip="MT4/5 comma command (forex/CFD, e.g. FTMO on EURUSD). Needs license + symbol + risk below.")
routeDiscord       = input.bool(false, "→ Discord", group=GROUP_EXEC, tooltip="Discord embeds (fills/exits/halts/derisk/eval/payout).")
routeJournal       = input.bool(false, "→ Journal (CSV)", group=GROUP_EXEC, tooltip="CSV journal rows for the Notion pipeline.")
usePMT       = routePMT
pmtToken     = input.string("", "PMT Token", group=GROUP_EXEC, tooltip="PickMyTrade API token (Tradovate route).", display=display.none)
useDiscord   = routeDiscord
useRithmic   = routeRithmic
usePineConnector = routePineConnector
pcLicense    = input.string("", "PineConnector license ID", group=GROUP_EXEC, tooltip="Your PineConnector license ID — the number your MT4/5 EA listens on. Used only when Alert destination = PineConnector.", display=display.none)
pcSymbol     = input.string("", "PineConnector symbol (empty = chart)", group=GROUP_EXEC, tooltip="Broker symbol for the MT4/5 order, e.g. EURUSD. Empty = this chart's ticker. Set it when your broker's symbol differs from the chart symbol.", display=display.none)
pcRisk       = input.float(1.0, "PineConnector risk / lots", minval=0, group=GROUP_EXEC, tooltip="The 'risk' value sent to PineConnector (lot size, or risk units, per your EA's configuration).", display=display.none)
routeMiddleware = input.bool(false, "→ Middleware (fan-out)", group=GROUP_EXEC, tooltip="Send one lean signal to your middleware /webhook; it fans out to every account subscribed to this strategy. Put the webhook URL on the TradingView alert itself.")
mwSecret   = input.string("", "Middleware secret", group=GROUP_EXEC, tooltip="Must match MIDDLEWARE_SECRET on your server.", display=display.none)
mwStrategy = input.string("GC", "Middleware strategy key", group=GROUP_EXEC, tooltip="Strategy key the middleware maps to accounts (e.g. GC, ES, NQ). Match accounts.yaml.", display=display.none)
useMiddleware = routeMiddleware
botName    = input.string("MΞX ΞL TΞSORO", "Bot Name", group=GROUP_ALRT, tooltip="Display name for Discord messages.", display=display.none)
lockBufTicks = input.float(4, "Lock cost buffer (ticks)", minval=0, group=GROUP_ALRT, tooltip="Extra open-profit buffer (in ticks, per contract) required above the target before the intra-trade lock closes all — covers fees & slippage.")
lockOnCap    = input.bool(true, "Close all when payout cap is reached intra-trade", group=GROUP_ALRT, tooltip="Once projected withdrawable (incl. open PnL) covers the FULL ladder cap plus the cost buffer, close everything (PMT + Discord) and bank the payout.")
avatarURL  = ""
titleURL  = ""
roleID  = ""
notifyRiskOff = useDiscord
notifyRegime  = input.bool(false, "Notify: regime-shift", group=GROUP_ALRT, tooltip="Discord message on a regime flip (informational only).", display=display.none)
notifyEval = useDiscord
notifyFills = useDiscord
notifyStart = useDiscord
notifyDerisk = useDiscord
notifyBlocked = input.bool(true, "Alert: signal blocked by non-strategy rule", group=GROUP_ALRT,
     tooltip="Fires a TradingView alert (and Discord, if enabled) when a setup satisfies ALL strategy rules (FVG + CVD + bias + VWAP veto + sweep) but is blocked by an operational rule: MAE guard, DD guard, day halt, account halt, time gate or flat window. Being in a position or having a pending order does NOT trigger this alert — that is normal system behaviour.", display=display.none)


// === v5: EVAL / PA TRACKING ==================================================
var string GROUP_EVAL = "1d · ACCOUNT — Eval / research tracking"
// Eval-tracking verwijderd als knop 25-08 (besluit Ferry: onduidelijk wat het doet, en
// Phase=Custom dekt hetzelfde). De motor eronder staat achter een constante false en is
