// === ROLL / OPEX / NEWS FACTORY (event-regime filters) ======================
// Validated on 3y OOS: for the mean-reversion engine the losses concentrate in the
// quarterly roll/triple-witching window (esp. quiet, no-news days), while macro news
// (NFP tailwind, FOMC on ES/GC) sits on the profit side. This block lets you AVOID the
// loss-regimes per strategy / account-type / phase. Preset "Auto" = the validated default
// for THIS script; pick another to borrow its config, or "Off / Custom" to drive the
// toggles yourself. Survival over winning — don't fight the bull in the witching-week chaos.
// Roll/OpEx/news-factory verwijderd 25-08 (besluit Ferry). De master stond op false, dus
// evtBlock was altijd onwaar en de poort altijd open.
// === VISUALISATION ===========================================================
showSignals     = input.bool(true, "Show Signals", inline="v1", group=GROUP_VIS, display=display.none)
showTradeLevels = input.bool(true, "Show SL/TP Levels", inline="v1", group=GROUP_VIS, display=display.none)
showPending     = input.bool(true, "Show Pending Limit", inline="v1", group=GROUP_VIS, tooltip="Plot the resting limit and planned stop while an order is pending.", display=display.none)
showExpired     = input.bool(true, "Mark Unfilled Limits (box)", inline="v1b", group=GROUP_VIS, display=display.none)
showExitLabels  = input.bool(true, "Show Exit Labels (PnL)", inline="v1b", group=GROUP_VIS, tooltip="Plain-text realized PnL at each exit.", display=display.none)
showTradeLabels = input.bool(true, "Trade info next to zone", inline="v2", group=GROUP_VIS, display=display.none)
showTradeZones  = input.bool(true, "Trade zones (SL/TP fill)", inline="v2", group=GROUP_VIS, display=display.none)
showGateBg      = input.bool(true, "Gate background", inline="v2", group=GROUP_VIS,
     tooltip="Colors the chart background softly when the FULL strategy gate is open: teal = long side tradable, red = short side, amber = both sides open. Includes ALL live conditions: time gate (incl. Monday filter), flat window, day halt, account status, CVD, VWAP veto, bias and sweep filter. A stronger amber flash marks bars where a valid signal fired but was blocked by a non-strategy rule (MAE guard, halts).", display=display.none)
gateBgTransp    = input.int(90, "Gate bg transp.", minval=70, maxval=98, group=GROUP_VIS,
     tooltip="Transparency of the gate background (70 = strong, 98 = barely visible). Hue follows the theme dropdown. The blocked-signal flash renders ~8 steps stronger than this value.", display=display.none)
showFvgBoxes    = input.bool(true, "Show FVG Boxes", inline="v2", group=GROUP_VIS, display=display.none)
markTested      = input.bool(true, "Mark Tested FVGs", inline="v2", group=GROUP_VIS, tooltip="Recolor an FVG box once price has tested it.", display=display.none)
maxBoxes        = input.int(40, "Max FVG Boxes", minval=1, maxval=200, group=GROUP_VIS, tooltip="Maximum number of FVG boxes kept on the chart.", display=display.none)
drawLast        = input.int(2000, "Visuals: draw only on last N bars (0 = all)", minval=0, group=GROUP_VIS, tooltip="MEMORY FIX: boxes/labels/zones are only drawn on the most recent N bars. Purely cosmetic — strategy results are identical. Prevents 'Memory limit exceeded' on entire-history backtests. Set 0 to draw on all bars (may exceed the memory limit on long histories).", display=display.none)
bool inDrawWin  = drawLast <= 0 or (last_bar_index - bar_index) <= drawLast
bullColor       = input.color(color.new(color.green, 85), "Bull", inline="v3", group=GROUP_VIS)
bearColor       = input.color(color.new(color.red, 85), "Bear", inline="v3", group=GROUP_VIS)
testedColor     = input.color(color.new(color.gray, 88), "Tested", inline="v3", group=GROUP_VIS, tooltip="Fill color for tested FVG boxes.")

// === DASHBOARD ===============================================================
showDashboard = input.bool(true, "Show Dashboard", inline="d1", group=GROUP_DASH, display=display.none)
dashPos       = input.string("Bottom Right", "Position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], inline="d1", group=GROUP_DASH, display=display.none)
visTheme      = input.string("Auto", "Theme", options=["Auto","Dark","Light"], inline="d1", group=GROUP_DASH,
     tooltip="Auto reads the chart background. Applies to dashboard, trade info, exit text and zones.", display=display.none)
txtSize       = input.string(size.tiny, "Text", options=[size.huge,size.large,size.small,size.tiny,size.auto,size.normal], inline="d1", group=GROUP_DASH, tooltip="Dashboard text size.", display=display.none)
