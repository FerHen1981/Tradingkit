//@version=6
// FULL BUILD: original execution/alerts/account layers retained. PRODUCTION Liquidity-Core defaults mirror the calibrated simulator.
// v6.8.14 (optimised): memory-safe visuals (drawLast) + recovery-trail A1 fix + FX tick-volume delta note.
// v6.8.15: auto-guard the delta filter on non-futures assets (forex/CFD/spot).
// v6.8.16: inputs restructured + firm-preset dropdown (futures).
// v6.9.0: roll/OpEx/news factory — selectable event-regime filters (preset per strategy · account-type · phase).
// v6.9.1: "→ Middleware" route — emits a lean signal to the fan-out middleware (one alert per strategy).
// v6.9.13 MES scratch Production: 6 MES · FVG10-22t · proxy-CVD6 · SL120t · 1.75R · expiry6 · all sessions · daily OFF · EOD PA.
// Research parity rule: canonical CVD is deterministic OHLCV polarity, NOT ta.requestVolumeDelta().
var string currentVersion = "v1.0.1"
strategy("MΞX EL REY · MNQ PROD EOD · " + currentVersion, shorttitle="REY-MNQ-P", overlay=true,
     initial_capital=50000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     calc_on_every_tick=false,
     calc_on_order_fills=true,
     process_orders_on_close=false,
     use_bar_magnifier=true,
     max_bars_back=500,
     max_boxes_count=500, max_labels_count=500,
     margin_long=0, margin_short=0,
     slippage=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.37)

import TradingView/ta/8

// === GROUPS ==================================================================
var string GROUP_UNIT  = "2 · TRADE — Position sizing"
var string GROUP_ENTRY = "3 · TRADE — Entry & stop"
var string GROUP_RISK  = "4 · TRADE — Take-profit & exits"
var string GROUP_DAY   = "L4x · retired"
var string GROUP_PHASE = "1 · ACCOUNT — Phase, drawdown & guard"
var string GROUP_BIAS  = "7 · SIGNAL — VWAP / bias"
var string GROUP_SIG   = "9 · SIGNAL — Filters"
var string GROUP_CVD   = "6 · SIGNAL — Volume delta"
var string GROUP_FVG   = "5 · SIGNAL — FVG"
var string GROUP_TIME  = "8 · SIGNAL — Time gate"
var string GROUP_VIS   = "10 · RESEARCH — Visuals & labels"
var string GROUP_DASH  = "11 · MONITOR — Dashboard"
var string GROUP_EXEC  = "9 · EXECUTION — Alerts & routing"
var string GROUP_ALRT  = GROUP_EXEC
var string GROUP_EVT   = "8b · SIGNAL — Roll / OpEx / News factory"
var string GROUP_MREG  = "8a · SIGNAL — Market regime gate"
var string GROUP_STAB  = "0b · MEX — Stability presets"

// === MEX STABILITY PRESET (additive; all legacy/live layers remain intact) =====
     tooltip="Default = Manual: the visible inputs below are the actual values used and remain editable. Choose a Lock preset only when you intentionally want the tested stability values to override those inputs. Execution, alerts, account/fleet and event layers remain unchanged.")
// stability-preset verwijderd 25-08. Hij stond op Manual, dus deze drie waarden vielen al
// door naar de gewone inputs -- de gecompileerde beslissing is identiek.

// Regime-factory identity for THIS script (strategy · account-type · phase). The "Auto" preset resolves to this.

// === TIMEZONE / DAY ==========================================================
var string GROUP_ACCT = "0 · ACCOUNT — Firm & routing"

// === v6.8: retired features — hard-disabled (inputs removed; engine paths inert) =========
bool   usePaFilters   = false
bool   useRelVolFilter= false
bool   useBbwpFilter  = false
bool   blockRthOpen   = false
float  relVolMax      = 1.2
float  bbwpMax        = 0.5
int    relVolLen      = 30
int    bbwpStdLen     = 20
int    bbwpLook       = 250
int    rthOpenLo      = 570
int    rthOpenHi      = 600
bool   useOrBreakout  = false
bool   orOneSetup     = true
int    orStartMin     = 570
int    orEndMin       = 630
string orBreakoutUnit = "Points"
float  orBreakoutT    = 10.0
bool   useRegime      = false
int    regimeErLen    = 30
int    regimeMinHold  = 15
float  regimeErThr    = 0.25
float  regimeErHyst   = 0.05
bool   gateOpenOnRiskOff = true
bool   startNeedRegime   = false
float  evalPaThresh   = 0.0
bool   guardEval      = false
bool   guardPA        = false
bool   useGoalTp      = false
bool   useDerisk      = false
bool   useDeriskPA    = false
float  deriskLvl1     = 67.0
float  deriskLvl2     = 90.0
float  deriskPaLvl    = 75.0
int    deriskQty1     = 3
int    deriskQty2     = 1
int    deriskPaQty    = 1
string exitPreset     = "Custom"

accountID = input.string("", "PMT/Tradovate Account ID", group=GROUP_ACCT,
     tooltip="PMT/Tradovate account ID. Declared first on purpose: it is the FIRST value in the alert name/prefill, so every alert in the TradingView sidebar starts with the account it belongs to. Also feeds the automatic journal account name (first 2 letters + last 3 digits).")

input_tz = input.string("America/New_York", "Reference Timezone",
     options=["Pacific/Honolulu","America/Anchorage","America/Los_Angeles","America/Denver","America/Chicago","America/New_York","America/Sao_Paulo","Etc/UTC","Europe/London","Europe/Berlin","Europe/Amsterdam","Europe/Athens","Europe/Moscow","Asia/Dubai","Asia/Karachi","Asia/Dhaka","Asia/Bangkok","Asia/Singapore","Asia/Tokyo","Australia/Sydney","Pacific/Auckland"],
     group=GROUP_TIME, tooltip="Timezone for the time gate, flat window and day boundary. Keep America/New_York — all", display=display.none)
string activeTz = input_tz
dayBoundaryMode = input.string("Exchange session", "Trading-Day Boundary",
     options=["Exchange session","Calendar day (timezone)"], group=GROUP_TIME, tooltip="Where the trading day rolls over. Exchange session (default) = 18:00 ET futures session open, matching Apex and the research engine. Calendar day: midnight in the reference timezone.", display=display.none)

f_getHour()     => hour(time, activeTz)
f_getMinute()   => minute(time, activeTz)
f_minuteOfDay() => f_getHour() * 60 + f_getMinute()
f_calDayId()    => year(time, activeTz) * 10000 + month(time, activeTz) * 100 + dayofmonth(time, activeTz)
var int prevCalDayId = na
bool newCalDay = na(prevCalDayId) or f_calDayId() != prevCalDayId
prevCalDayId := f_calDayId()
bool isNewTradingDay = barstate.isfirst or (dayBoundaryMode == "Exchange session" ? timeframe.change("1D") : newCalDay)

// === UNITS & SIZING ==========================================================
unitMode  = input.string("Ticks", "Distance Unit", options=["Ticks","Points","%","ATR"], group=GROUP_UNIT, tooltip="Unit for all distance inputs (stops, gaps, buffers).", display=display.none)
atrLen    = input.int(14, "ATR Length (ATR unit)", minval=1, group=GROUP_UNIT, tooltip="ATR length, only used when Distance Unit is set to ATR.", display=display.none)
sizingMode = input.string("Fixed contracts", "Sizing Mode", options=["Fixed contracts","Fixed $ risk","% equity risk"], group=GROUP_UNIT,
     tooltip="With the swing stop the stop distance varies per trade; $-risk or %-risk sizing keeps risk per trade constant and is recommended in that case.", display=display.none)
contractSize       = input.float(6, "Fixed Qty", minval=0, group=GROUP_UNIT, tooltip="Fixed number of contracts per trade. The MAE guard may scale this down per trade on a PA.")
riskValue          = input.float(250, "Risk per Trade ($ of %)", minval=0, group=GROUP_UNIT, tooltip="Risk per trade when using $-risk or %-risk sizing instead of fixed contracts.", display=display.none)
allowFractionalQty = input.bool(false, "Allow Fractional Qty (crypto)", group=GROUP_UNIT, tooltip="Allow fractional position sizes (crypto only — futures require whole contracts).", display=display.none)
maxQty             = input.float(100, "Max Qty Cap", minval=0, group=GROUP_UNIT, tooltip="Hard cap on position size regardless of the sizing mode.", display=display.none)
float contractSizeEff = contractSize

atrVal = ta.atr(atrLen)
f_distPrice(_u) =>
    switch unitMode
        "Ticks"  => _u * syminfo.mintick
        "Points" => _u
        "%"      => close * _u / 100.0
        => _u * atrVal

// === ENTRY & STOP ENGINE =====================================================
entryMode = input.string("Limit @ 50% FVG", "Entry Mode", options=["Limit @ 50% FVG","Market (legacy)"], group=GROUP_ENTRY,
     tooltip="Limit: resting order at the gap retrace level; better price, no entry slippage, ~78% of signals still get filled.")
expiryBars = input.int(6, "Limit Order Expiry (bars)", minval=1, group=GROUP_ENTRY,
     tooltip="Bars a resting limit order stays valid before it is cancelled.")
stopMode  = input.string("Fixed (legacy)", "Stop Mode", options=["Swing structure","Fixed (legacy)"], group=GROUP_ENTRY, tooltip="Swing structure: stop beyond the last confirmed pivot AND the gap edge, plus buffer. Fixed: static distance.", display=display.none)
pivotK     = input.int(3, "Pivot Strength (bars links/rechts)", minval=1, maxval=10, group=GROUP_ENTRY,
     tooltip="A pivot is only confirmed k bars after the extreme; the script uses confirmed pivots exclusively (no repainting).", display=display.none)
swingBufSize = input.float(2, "Stop Buffer beyond swing (units)", minval=0, group=GROUP_ENTRY, tooltip="Buffer in units beyond the swing/gap level for the stop.", display=display.none)
// MNQ Production scratch parity: Distance Unit = Ticks; SL200 = 50.00 points = $100 gross risk per 1 MNQ.
maxStopSize  = input.float(200, "Max Stop Distance (units) — else no trade", minval=1, group=GROUP_ENTRY, tooltip="Signals with a wider stop than this are skipped entirely.", display=display.none)
slSizeLegacy = input.float(200, "Fixed Stop (units, legacy mode)", minval=0.01, group=GROUP_ENTRY, tooltip="Static stop distance, only used in Fixed stop mode.", display=display.none)
float maxStopSizeEff = maxStopSize
float slSizeLegacyEff = slSizeLegacy

// === TRADE MANAGEMENT ========================================================
tpMode  = input.string("R-multiple", "Take-Profit Mode", options=["R-multiple","Swing structure","Fixed (units)"], group=GROUP_RISK,
     tooltip="Swing structure: target = last confirmed opposite pivot. R-multiple: target = R x stop distance. Fixed: static distance in units.", display=display.none)
rMultIn = input.float(1.25, "R-Multiple (R-multiple mode)", minval=0.1, step=0.25, group=GROUP_RISK,
     tooltip="Target as a multiple of the stop distance (R-multiple mode).")
tpSize  = input.float(122, "Take Profit (units, Fixed mode)", minval=0.01, group=GROUP_RISK, tooltip="Static target distance (Fixed TP mode only).", display=display.none)
useBreakEven    = input.bool(false, "Enable Break-even", group=GROUP_RISK,
     tooltip="Default ON (v3.6). Optional with Swing TP (expectancy-neutral, lower DD); with R-multiple it is part of the exit engine. Live: server-side via broker bracket.", display=display.none)
beTriggerSize   = input.float(15, "BE Trigger MFE (units)", minval=0.01, group=GROUP_RISK, tooltip="MFE required before the stop moves to break-even.", display=display.none)
beOffsetSize    = input.float(12,  "BE Offset (units)", minval=0, group=GROUP_RISK, tooltip="Offset above/below entry for the break-even stop.", display=display.none)
useTrail        = input.bool(false, "Enable Trailing", group=GROUP_RISK,
     tooltip="Default ON (v3.6): ESSENTIAL in R-multiple mode ($11.70 vs $6.80/trade; maxDD $4.2k vs $15.1k without). Optional with Swing TP but reduces DD.", display=display.none)
trailStartSize  = input.float(120, "Trail Activation MFE (units)", minval=0.01, group=GROUP_RISK, tooltip="MFE required before the trailing stop activates.", display=display.none)
trailBufferSize = input.float(16, "Trail Buffer (units)", minval=0.01, group=GROUP_RISK, tooltip="Distance the trail keeps from the running extreme.", display=display.none)
// === v6.4.4M: HERSTEL-TRAIL (alleen trade #2 na een verlies in dezelfde eval-poging) ===
useFillCheck    = input.bool(true, "FVG fill check (gap invalid once mid is touched)", group=GROUP_RISK,
     tooltip="Removes an FVG from the confirmation memory once price touches its mid (partially filled = invalid).")
useRecovTrail   = false
recovTrailStart = 40.0
recovTrailBuf   = 16.0
string tpModeEff   = tpMode
float  tpSizeEff   = tpSize
bool   useBEeff    = useBreakEven
float  beTrigEff   = beTriggerSize
float  beOffEff    = beOffsetSize
bool   useTrailEff = useTrail
float  trStartEff  = trailStartSize
float  trBufEff    = trailBufferSize

float trailUpdateStep = 2.0


// === DAILY RISK / EQUITY =====================================================
enableDailyLossLimit = false
dailyLossLimit       = 700.0
includeOpenInLoss    = true
enableDailyTarget    = false
dailyProfitTarget    = 350.0
enableDailyDrawdown    = false
dailyDrawdownLimit    = 750.0
enableEquityLock    = false
equityLockThreshold    = 300.0
equityLockPerc    = 90.0
onlyFirstTrade       = false

// === INTRADAY DAY-EXIT (v6.4.4i — sim-gevalideerde dagwinst-behoud) ==========
var string GROUP_DEX = "1e · ACCOUNT — Funded: day-profit exit"
dayExitMode = input.string("Off", "Day-profit exit mode", options=["Off","Day-trail (keep peak)","Day-cap (hard target)","Trail + cap"], group=GROUP_DEX,
     tooltip="Off = no day-profit exit. Day-trail closes the day on a pullback from the intraday day-PnL peak. Day-cap closes the day at the hard target. Trail + cap: both.")
dayTrailModel = input.string("Activation + giveback", "Day-trail model", options=["Legacy: activation = giveback","Activation + giveback"], group=GROUP_DEX,
     tooltip="Legacy reproduces the old rule: the same USD value both arms the trail and is the allowed pullback. Activation + giveback separates those two concepts, e.g. arm after +$200 and allow only $100 giveback.")
dayTrailUSD = input.float(200, "Legacy day-trail value ($)", minval=10, step=10, group=GROUP_DEX,
     tooltip="Used only by Legacy model: arms once peak exceeds this value and closes after the same amount of giveback.")
dayTrailActivationUSD = input.float(500, "Day-trail activation ($)", minval=0, step=10, group=GROUP_DEX,
     tooltip="Activation + giveback model: intraday running-PnL peak required before the daily profit trail is armed.")
dayTrailGivebackUSD = input.float(150, "Day-trail giveback ($)", minval=10, step=10, group=GROUP_DEX,
     tooltip="Activation + giveback model: maximum allowed pullback from the intraday running-PnL peak after activation.")
dayCapUSD   = input.float(750, "Day-cap hard target ($)", minval=50, step=25, group=GROUP_DEX,
     tooltip="Hard day-profit target that closes the day (cap modes).")
dailyScaleMode = input.string("Fixed USD", "Daily level scaling", options=["Fixed USD","Per contract"], group=GROUP_DEX, tooltip="Fixed USD keeps account-level daily limits unchanged when qty changes. Per contract multiplies the daily loss/trail/cap levels by effective contract quantity.")
float dailyScaleMult = dailyScaleMode == "Per contract" ? math.max(contractSizeEff, 1.0) : 1.0
float dayTrailUSDEff = dayTrailUSD * dailyScaleMult
float dayTrailActivationUSDEff = dayTrailActivationUSD * dailyScaleMult
float dayTrailGivebackUSDEff = dayTrailGivebackUSD * dailyScaleMult
float dayCapUSDEff   = dayCapUSD * dailyScaleMult
float dailyLossLimitEff = dailyLossLimit * dailyScaleMult


// === ACCOUNT PHASE (Apex) ====================================================
ddModel       = input.string("Intraday", "Drawdown Model", options=["EOD","Intraday"], group=GROUP_PHASE,
     tooltip="EOD (Apex 4.0 default): trailing ratchets on the daily closing balance only; open profit peaks do not count. Intraday (legacy): ratchets in real time with the live peak.", display=display.none)
payoutBuffer  = input.float(500, "Extra buffer above safety net ($)", step=100, group=GROUP_PHASE,
     tooltip="Payout-ready only when realized >= safety net + this buffer + min. payout. VALIDATION (PA-phase sweep $500-12,000, 300+ fresh PAs, horizon 500 sessions): death rate is FLAT across the whole range (27-31%) because PA mortality sits pre-lock, before any buffer exists; a bigger buffer only traps money in accounts that later die — payout/PA falls monotonically from $721 (buffer $500) to $416 ($12,000). Optimum: $500-1,000. Withdraw early and often; banked money is the only money that is truly yours.", display=display.none)

// === v6.4.4: WAIT-FOR-CAP PAYOUT-DISCIPLINE ================================
var string GROUP_WFC = "1c · ACCOUNT — Funded: payouts & discipline"
useWaitForCap = input.bool(true, "Wait-for-cap: request only at full ladder cap", group=GROUP_WFC,
     tooltip="ON: PAYOUT READY only once the balance covers the FULL ladder cap of the current payout. OFF: as soon as a withdrawal is allowed.")
payoutNr      = input.int(1, "Next payout number (1-6)", minval=1, maxval=6, group=GROUP_WFC,
     tooltip="Which payout you are building toward (1-6). Sets the ladder cap. Increase after each approved payout.")
paBacktestMode = input.bool(true, "PA backtest mode (breach marks, does NOT close permanently)", group=GROUP_WFC,
     tooltip="ON (backtest): a PA breach is counted and marked but does not halt the strategy. OFF (live): a breach truly halts the account.")
// Historical bars: lifecycle simulation may reset after breach/payout. Realtime bars: always behave as live PA (breach halts).
bool paBacktestModeEff = paBacktestMode and not barstate.isrealtime
accountPhase  = input.string("Apex PA", "Account Phase", options=["Research (none)","Apex Eval","Apex PA"], group=GROUP_PHASE,
     tooltip="Research: no account rules (default; backtests unchanged). Eval: goal + trailing. PA: trailing until lock, DLL, consistency/payout monitor — and the MAE guard (group 16).")
acctTrailDD   = input.float(2000, "Trailing Drawdown ($)", step=100, group=GROUP_PHASE, tooltip="Trailing drawdown of your account plan.", display=display.none)
acctGoal      = 3000.0
acctDLL       = input.float(1000, "PA Daily Loss Limit ($)", step=50, group=GROUP_PHASE, tooltip="PA daily loss limit; the phase layer halts the day when hit.", display=display.none)
consistencyPct= input.float(50, "Consistency rule (%)", minval=10, maxval=100, group=GROUP_PHASE, tooltip="Max share of total profit one day may contribute at payout request (Apex: 30-50% depending on plan).", display=display.none)
minPayout     = input.float(500, "Min. Payout ($)", step=50, group=GROUP_PHASE, tooltip="Minimum payout amount per Apex rules.", display=display.none)
minQualDayUSD = input.float(250, "Min. profit for qualifying day ($)", step=10, group=GROUP_PHASE, tooltip="Minimum daily profit for a day to count as qualifying toward payout.", display=display.none)
acctPnlOffset = input.float(0, "Live sync: current account PnL vs start ($)", group=GROUP_PHASE,
     tooltip="For live use: enter the account's actual PnL so floor/goal are correct. Backtest: 0.", display=display.none)
acctHwmOffset = input.float(0, "Live sync: current HWM vs start ($)", group=GROUP_PHASE, tooltip="For live use with EOD trailing: the account high-water mark so the floor calculates correctly. Backtest: 0.", display=display.none)
lastPayoutTime= input.time(timestamp("2024-01-01T00:00:00"), "Last payout (consistency anchor)", group=GROUP_PHASE, tooltip="Consistency and qualifying-day counters measure from this moment. Set to your last payout date; leave at default for a fresh account.", display=display.none)

// === 0 · FIRM PRESET — auto-fills account rules from data/propfirms.json ======
// Futures (trailing-DD) firms only. Forex/static firms run via the Python
// backtester until the static-DD Pine engine is added. Manual inputs stay as override.
useFirmPreset = input.bool(true, "Use firm preset (fills account rules below)", group=GROUP_PHASE, tooltip="Pick a prop-firm program; the drawdown model, trailing DD, eval goal, daily-loss and consistency get set for you. Leave OFF to use the manual inputs.")
firmPreset    = input.string("apex_50k_eod_pa", "Firm program", options=["apex_50k_eod_eval", "apex_50k_eod_pa", "apex_50k_intraday_eval", "apex_50k_intraday_pa", "daytraders_s2f_25k_instant", "mffu_50k_eval", "takeprofittrader_50k_eval", "topstep_50k_eval", "tradeify_advanced_25k_instant"], group=GROUP_PHASE, tooltip="Auto-generated from the prop-firm registry. Only trailing-DD (futures) firms are listed here.")
f_firmRules(string _p) =>
    string _dd = "Intraday"
    float _ml = 2500.0
    float _g = 3000.0
    float _dll = 1000.0
    float _cons = 50.0
    if _p == "apex_50k_eod_eval"
        _dd := "EOD"
        _ml := 2000.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 50.0
    else if _p == "apex_50k_eod_pa"
        _dd := "EOD"
        _ml := 2000.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 50.0
    else if _p == "apex_50k_intraday_eval"
        _dd := "Intraday"
        _ml := 2000.0
        _g := 3000.0
        _dll := 0.0
        _cons := 50.0
    else if _p == "apex_50k_intraday_pa"
        // Apex 50K Intraday PA (current): $2,000 real-time trailing DD,
        // threshold locks at +$100 once HWM reaches +$2,100; tier DLL starts at $1,000.
        _dd := "Intraday"
        _ml := 2000.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 50.0
    else if _p == "daytraders_s2f_25k_instant"
        _dd := "EOD"
        _ml := 1000.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 50.0
    else if _p == "mffu_50k_eval"
        _dd := "EOD"
        _ml := 2000.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 50.0
    else if _p == "takeprofittrader_50k_eval"
        _dd := "EOD"
        _ml := 2000.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 50.0
    else if _p == "topstep_50k_eval"
        _dd := "EOD"
        _ml := 2000.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 50.0
    else if _p == "tradeify_advanced_25k_instant"
        _dd := "EOD"
        _ml := 1500.0
        _g := 3000.0
        _dll := 1000.0
        _cons := 50.0
    [_dd, _ml, _g, _dll, _cons]
if useFirmPreset
    [pfDD, pfMax, pfGoal, pfDLL, pfCons] = f_firmRules(firmPreset)
    ddModel := pfDD
    acctTrailDD := pfMax
    acctGoal := pfGoal
    acctDLL := pfDLL
    consistencyPct := pfCons

// ============================================================================
// === MEX POLICY LAYER — Fleet Config Matrix v1.1 (autogen, niet handmatig wijzigen)
// ============================================================================
// MEX Policy-laag (Fleet Matrix) verwijderd 25-08. Hij stond op "Manual", dus polOn was
// onwaar en elke tak hieronder viel al naar de handmatige inputs. Het firm program onder
// ACCOUNT - Guard doet nu wat deze laag deed.
string phaseEff = accountPhase
bool isEval = phaseEff == "Apex Eval"
guardMult     = 1.25
var bool   pmtBlock = false
var bool   posTrailOn = false
var bool   posRecovOn = false
var string exitReasonNext = ""
var string pmtBlockReason = ""
bool isPA   = phaseEff == "Apex PA"
useDDGuard = (isPA and guardPA) or (isEval and guardEval)
bool phaseOn = isEval or isPA
var bool  acctHalted = false
var string acctHaltReason = ""
var float acctHwm = na
var float profitSince = 0.0
var float bestDaySince = 0.0
var int   qualDays = 0
var int   paBreachCount = 0
var int   paMilkCount   = 0
var int   paResetCount  = 0
var float paTotalBanked = 0.0
var int   paPayoutsThisCycle = 0
var float paResetPnLPrev = 0.0

// === BIAS & VWAP =============================================================
useSweepFilter = false
sweepLookback  = 20
useVwapVeto   = input.bool(false, "VWAP side veto (long above / short below only)", group=GROUP_BIAS,
     tooltip="Enige richtingsfilter die in beide datahelften consistent was: tegen-VWAP-trades waren structureel negatief.")

// === 9 · SIGNAL — Filters ====================================================
// Elke regel is een filter: schakelaar plus zijn parameters op één rij. Allemaal default
// UIT of neutraal, dus in deze stand is het gedrag identiek aan voor deze toevoeging.
// BBWP = volatiliteitspercentiel (Bollinger; percentiel-variant van The_Caretaker).
useBbwpFilter = input.bool(false, "BBWP", inline="sf_bbwp", group=GROUP_SIG, tooltip="Volatility percentile: what share of the lookback had a NARROWER band than now. Raise min to skip dead volatility, lower max to skip exhaustion.")
bbwpMin       = input.float(0,   "min", minval=0, maxval=100, step=1, inline="sf_bbwp", group=GROUP_SIG)
bbwpMax       = input.float(100, "max", minval=0, maxval=100, step=1, inline="sf_bbwp", group=GROUP_SIG)
bbwpBasisType = input.string("SMA", "BBWP basis", options=["SMA","EMA","VWMA"], group=GROUP_SIG, display=display.none)
bbwpLen       = input.int(20,  "BBWP length",   minval=1, group=GROUP_SIG, display=display.none)
bbwpLookback  = input.int(255, "BBWP lookback", minval=2, group=GROUP_SIG, tooltip="Bars the current width is ranked against.", display=display.none)

useEmaFilter  = input.bool(false, "EMA trend", inline="sf_ema", group=GROUP_SIG, tooltip="Longs only above the EMA, shorts only below it.")
emaLen        = input.int(200, "len", minval=1, inline="sf_ema", group=GROUP_SIG)

useMfiFilter  = input.bool(false, "MFI side", inline="sf_mfi", group=GROUP_SIG, tooltip="Candle-value money flow. Longs only while it is above zero, shorts only below. The multiplier from the original is omitted: a positive scale factor cannot change the sign.")
mfiPeriod     = input.int(60, "HMA", minval=1, inline="sf_mfi", group=GROUP_SIG)

usePocFilter  = input.bool(false, "Volume profile", inline="sf_poc", group=GROUP_SIG, tooltip="Session volume profile (MEX Volume Pack). Longs only above the reference level, shorts only below. Uses intrabar data, so the level moves while the bar forms - the gate reads it on bar close.")
pocRef        = input.string("POC", "vs", options=["POC","VAH","VAL"], inline="sf_poc", group=GROUP_SIG)
pocSession    = input.string("Daily", "session", options=["Daily","Weekly","Tokyo","London","New York"], inline="sf_poc", group=GROUP_SIG)
pocResolution = input.int(30, "Profile resolution", minval=5, maxval=100, group=GROUP_SIG, tooltip="More bins = finer profile, more computation.", display=display.none)
pocVaWidth    = input.int(70, "Value area volume %", minval=1, maxval=100, group=GROUP_SIG, display=display.none)
pocLowerTf    = input.timeframe("1", "Intrabar timeframe", group=GROUP_SIG, tooltip="Lower timeframe the profile is built from.", display=display.none)

useDpFilter   = input.bool(false, "Discount/Premium", inline="sf_dp", group=GROUP_SIG, tooltip="Position inside the recent range. Longs only in the discount half, shorts only in the premium half.")
dpLookback    = input.int(60, "bars", minval=5, inline="sf_dp", group=GROUP_SIG)
dpMid         = input.float(50, "mid %", minval=1, maxval=99, step=1, inline="sf_dp", group=GROUP_SIG)

allowLongs    = input.bool(true, "Longs",  inline="sf_dir", group=GROUP_SIG)
allowShorts   = input.bool(true, "Shorts", inline="sf_dir", group=GROUP_SIG, tooltip="Master direction switches. Off = that side never enters.")
useBiasFilter = false
htf_tf        = "30"
htfBosLen     = 7
ltfBosLen     = 5
allowScalp    = true
vwapDistMin   = 0.05

// === DELTA / CVD FILTER ======================================================
// Canonical scratch-research default:
// "Research OHLCV proxy" reproduces the Python/.NET multi-market proxy exactly:
// close>open = +1, close<open = -1, doji -> previous close, unresolved -> carry polarity.
// CVD N = N consecutive proxy-direction bars aligned with FVG direction.
// The TradingView volume-delta engine is retained as an optional experiment only.
useCVDFilter  = input.bool(true, "Use Delta Filter", group=GROUP_CVD,
     tooltip="Default uses the deterministic OHLCV research proxy for Python/.NET/Pine parity. TradingView volume delta remains available as an optional experimental engine.")
cvdEngine     = input.string("Research OHLCV proxy", "Delta engine",
     options=["Research OHLCV proxy","TradingView volume delta"], group=GROUP_CVD,
     tooltip="Keep Research OHLCV proxy for this MES parity test. TradingView volume delta is NOT the research baseline.")
cvdLowerTf    = input.timeframe("1", "Lower Timeframe for Delta", group=GROUP_CVD, tooltip="Used only by the optional TradingView volume-delta engine.", display=display.none)
deltaBorrowSym = input.symbol("", "Borrow delta from symbol (empty = chart)", group=GROUP_CVD, tooltip="Drive the delta filter from ANOTHER symbol's real volume. Example: on a spot EURUSD chart set CME_MINI:6E1! to use the Euro FX future's genuine volume delta (spot FX has no real volume of its own). Empty = use this chart's own volume. Method: request.security_lower_tf up/down volume on the borrowed symbol — an approximation of native CVD.", display=display.none)
useCvdStreak  = input.bool(true, "Streak", inline="cv", group=GROUP_CVD, display=display.none)
cvdTrendCount = input.int(8, "Count", minval=1, inline="cv", group=GROUP_CVD, tooltip="Consecutive same-direction delta bars required.")
bool useCVDFilterEff = useCVDFilter
int cvdTrendCountEff = cvdTrendCount

// === FVG =====================================================================
useGapFilter = input.bool(true, "Use FVG Size Range Filter", group=GROUP_FVG,
     tooltip="Size does not predict the outcome, but the range controls trade frequency and thus cost pressure. 9-13 is the", display=display.none)
// MNQ Production scratch parity: FVG 2–8 ticks = 0.50–2.00 price points.
gapMinSize   = input.float(2, "Min FVG Size (units)", minval=0.01, group=GROUP_FVG, tooltip="Minimum FVG size. Do not widen — smaller gaps are noise.")
gapMaxSize   = input.float(8, "Max FVG Size (units)", minval=0.01, group=GROUP_FVG, tooltip="Maximum FVG size.")
float gapMinSizeEff = gapMinSize
float gapMaxSizeEff = gapMaxSize
confirmBarsIn = input.int(0, "Confirmation window (bars)", minval=0, maxval=20, group=GROUP_FVG,
     tooltip="v6.1 FVG confirmation memory. 0 = OFF = exact v6.0 behaviour. With X>0, a size-passing FVG whose confirmation (delta filter, VWAP veto, bias, sweep, time gate) is not present on the gap bar itself stays valid for X bars; the signal fires on the first bar inside the window where all strategy rules pass and the account is flat. One signal per gap, newest gap first; entry limit and stop reference the stored gap. HONEST VALIDATION NOTE: walk-forward funnel simulation (Sep 2018–Jun 2026, 878 paired starts, B exit configuration only): payout/funnel $171 (0) -> $305 (3) -> $355 (5), monotone in X; paired bootstrap at X=3: +$134/funnel, z=1.86 — positive but NOT 95%-significant. Effect is throughput/tempo (+66% trades, near-equal pass rate), not signal quality. Do NOT combine with break-even exits (weaker there, and BE variants stay below B). Fleet recommendation: core stream 0, tempo stream 3, explorer stream 5.")



int confirmBars = confirmBarsIn
