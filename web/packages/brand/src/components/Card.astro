---
/**
 * The workhorse surface. Optionally becomes a link card (whole card clickable)
 * without nesting interactive elements, by stretching a pseudo-element from
 * the single real anchor in the title.
 */
interface Props {
  eyebrow?: string;
  title?: string;
  href?: string;
  /** Accent hairline along the top edge — use to mark a featured card. */
  featured?: boolean;
  as?: "article" | "div" | "li";
}

const {
  eyebrow,
  title,
  href,
  featured = false,
  as: Tag = "article",
} = Astro.props;
---

<Tag class:list={["card", { "card--featured": featured, "card--link": href }]}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  {title && (
    <h3 class="card__title">
      {href ? <a href={href}>{title}</a> : title}
    </h3>
  )}
  <div class="card__body">
    <slot />
  </div>
  <slot name="foot" />
</Tag>

<style>
  .card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .card--featured {
    border-top: 2px solid var(--accent);
  }

  .card--link {
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .card--link:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }

  .card__title {
    font-size: var(--t-h3);
  }

  .card__title a {
    color: inherit;
    text-decoration: none;
  }

  /* Stretch the anchor over the whole card so the entire surface is the
     target, while the DOM still contains exactly one link. */
  .card--link .card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card__body {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .card__body:empty {
    display: none;
  }
</style>
