---
/**
 * Cumulative-performance curve — a single series over time, so: area + 2px
 * line, no legend (the title names the series), emphasis rather than
 * categorical colour.
 *
 * The series carries no currency. Publicly it plots cumulative R, which is the
 * one measure that is both unit-free and honestly summable across markets:
 * every trade is already normalised by the risk it took, so no account balance
 * has to be revealed for the track record to be readable.
 *
 * Geometry is computed at build time; the client script only adds the hover
 * layer, so the chart renders fully without JavaScript.
 */
interface Point {
  /** Period label, e.g. "2024-03". */
  t: string;
  v: number;
}

interface Props {
  points: Point[];
  title: string;
  /** Explains what the series is and what it excludes. */
  caption?: string;
  height?: number;
  /** The line the reader measures against — 0 for cumulative R. */
  baseline?: number;
  /** Appended to every rendered value, e.g. "R". */
  valueSuffix?: string;
}

const {
  points,
  title,
  caption,
  height = 280,
  baseline = 0,
  valueSuffix = "R",
} = Astro.props;

const W = 760;
const H = height;
const PAD = { top: 18, right: 58, bottom: 30, left: 46 };
const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;

const values = points.map((p) => p.v);
const rawMin = Math.min(...values, baseline);
const rawMax = Math.max(...values, baseline);
const span = rawMax - rawMin || 1;

/** Round the domain out to clean tick numbers so the axis reads 0 / 20 / 40. */
const step = (() => {
  const target = span / 4;
  const mag = 10 ** Math.floor(Math.log10(target));
  return [1, 2, 2.5, 5, 10].map((m) => m * mag).find((s) => s >= target) ?? mag * 10;
})();

const yMin = Math.floor(rawMin / step) * step;
const yMax = Math.ceil(rawMax / step) * step;

const ticks: number[] = [];
for (let v = yMin; v <= yMax + step / 2; v += step) ticks.push(Number(v.toFixed(4)));

const x = (i: number) =>
  PAD.left + (points.length === 1 ? plotW / 2 : (i / (points.length - 1)) * plotW);
const y = (v: number) => PAD.top + plotH - ((v - yMin) / (yMax - yMin || 1)) * plotH;

const linePath = points.map((p, i) => `${i === 0 ? "M" : "L"}${x(i).toFixed(2)},${y(p.v).toFixed(2)}`).join(" ");
const areaPath = `${linePath} L${x(points.length - 1).toFixed(2)},${y(yMin).toFixed(2)} L${x(0).toFixed(2)},${y(yMin).toFixed(2)} Z`;

const last = points[points.length - 1];
const first = points[0];
const change = last ? last.v - baseline : 0;

/**
 * Label roughly every sixth point, and always the last one. Because the final
 * label is forced, a stepped label that lands right next to it has to give way
 * or the two overprint.
 */
const labelEvery = Math.max(1, Math.ceil(points.length / 6));
const lastX = x(points.length - 1);
const MIN_LABEL_GAP = 64;
const xLabels = [
  ...points
    .map((p, i) => ({ ...p, i }))
    .filter(({ i }) => i % labelEvery === 0 && lastX - x(i) >= MIN_LABEL_GAP),
  { ...points[points.length - 1], i: points.length - 1 },
];

const fmtValue = (v: number) =>
  `${new Intl.NumberFormat("nl-NL", {
    minimumFractionDigits: 1,
    maximumFractionDigits: 1,
  }).format(v)}${valueSuffix}`;

const uid = `eq-${Math.random().toString(36).slice(2, 9)}`;
---

<figure
  class="chart"
  data-equity={JSON.stringify({
    points,
    suffix: valueSuffix,
    geom: { PAD, plotW, plotH, W, H, yMin, yMax },
  })}
>
  <figcaption class="chart__head">
    <span class="chart__title">{title}</span>
    <span class="chart__now num">
      {fmtValue(last?.v ?? baseline)}
      <span class:list={["chart__delta", change >= 0 ? "pos" : "neg"]}>
        {change >= 0 ? "+" : "−"}{fmtValue(Math.abs(change))} t.o.v. start
      </span>
    </span>
  </figcaption>

  <div class="chart__plot">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-labelledby={`${uid}-t`}
      tabindex="0"
      preserveAspectRatio="xMidYMid meet"
    >
      <title id={`${uid}-t`}>
        {title}: van {fmtValue(first?.v ?? baseline)} bij {first?.t} naar{" "}
        {fmtValue(last?.v ?? baseline)} bij {last?.t}.
      </title>

      {/* Recessive grid — hairline, solid, one step off the surface. */}
      <g class="grid">
        {ticks.map((t) => (
          <line x1={PAD.left} x2={PAD.left + plotW} y1={y(t)} y2={y(t)} />
        ))}
      </g>

      {/* The reference the whole chart is read against. */}
      <line class="base" x1={PAD.left} x2={PAD.left + plotW} y1={y(baseline)} y2={y(baseline)} />

      <path class="area" d={areaPath} />
      <path class="line" d={linePath} vector-effect="non-scaling-stroke" />

      <circle class="end" cx={x(points.length - 1)} cy={y(last?.v ?? baseline)} r="4" />

      <g class="ylab">
        {ticks.map((t) => (
          <text x={PAD.left - 10} y={y(t)} dy="0.32em" text-anchor="end">
            {new Intl.NumberFormat("nl-NL", { maximumFractionDigits: 0 }).format(t)}
          </text>
        ))}
      </g>

      <g class="xlab">
        {xLabels.map((p) => (
          <text x={x(p.i)} y={H - 10} text-anchor={p.i === 0 ? "start" : p.i === points.length - 1 ? "end" : "middle"}>
            {p.t}
          </text>
        ))}
      </g>

      {/* Hover layer — hidden until the pointer or keyboard engages. */}
      <g class="cursor" hidden>
        <line class="cursor__x" y1={PAD.top} y2={PAD.top + plotH} />
        <circle class="cursor__dot" r="5" />
      </g>
    </svg>

    <div class="tip" role="status" hidden>
      <span class="tip__v num"></span>
      <span class="tip__t"></span>
    </div>
  </div>

  {caption && <p class="chart__caption">{caption}</p>}

  <details class="chart__table">
    <summary>Toon als tabel</summary>
    <div class="chart__tablewrap">
      <table>
        <thead>
          <tr><th scope="col">Periode</th><th scope="col">Cumulatief</th></tr>
        </thead>
        <tbody>
          {points.map((p) => (
            <tr>
              <th scope="row">{p.t}</th>
              <td class="num">{fmtValue(p.v)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .chart {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--sp-5);
  }

  .chart__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
    margin-bottom: var(--sp-4);
  }

  .chart__title {
    font-family: var(--mono);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }

  .chart__now {
    font-size: 1.25rem;
    font-weight: 640;
    color: var(--ink);
  }

  .chart__delta {
    font-size: 0.8125rem;
    font-weight: 500;
    margin-left: var(--sp-2);
  }

  .chart__plot {
    position: relative;
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  svg:focus-visible {
    outline: var(--focus);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .grid line {
    stroke: var(--chart-grid);
    stroke-width: 1;
  }

  .base {
    stroke: var(--chart-axis);
    stroke-width: 1;
  }

  .area {
    fill: var(--chart-series);
    opacity: 0.1;
  }

  .line {
    fill: none;
    stroke: var(--chart-series);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .end {
    fill: var(--chart-series);
    stroke: var(--surface);
    stroke-width: 2;
  }

  .ylab text,
  .xlab text {
    font-family: var(--mono);
    font-size: 10px;
    fill: var(--chart-axis);
  }

  .cursor__x {
    stroke: var(--chart-axis);
    stroke-width: 1;
  }

  .cursor__dot {
    fill: var(--chart-series);
    stroke: var(--surface);
    stroke-width: 2;
  }

  /* An author `display` declaration outranks the UA's [hidden] rule, so the
     resting state has to be restated here or the tooltip sits on the chart. */
  .tip[hidden] {
    display: none;
  }

  .tip {
    position: absolute;
    top: 0;
    transform: translate(-50%, -8px);
    pointer-events: none;
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    padding: var(--sp-2) var(--sp-3);
    display: flex;
    flex-direction: column;
    gap: 2px;
    white-space: nowrap;
    box-shadow: var(--shadow);
    z-index: 2;
  }

  /* Value leads, label follows — the reader already knows the series. */
  .tip__v {
    font-size: 0.9375rem;
    font-weight: 640;
    color: var(--ink);
  }

  .tip__t {
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .chart__caption {
    margin: var(--sp-4) 0 0;
    font-family: var(--mono);
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--dim);
  }

  .chart__table {
    margin-top: var(--sp-4);
    border-top: 1px solid var(--line);
    padding-top: var(--sp-3);
  }

  .chart__table summary {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
  }

  .chart__tablewrap {
    max-height: 260px;
    overflow: auto;
    margin-top: var(--sp-3);
  }

  .chart__table table {
    font-family: var(--mono);
    font-size: var(--t-small);
  }

  .chart__table th,
  .chart__table td {
    text-align: left;
    font-weight: 400;
    padding: var(--sp-2) var(--sp-3);
    border-bottom: 1px solid var(--line);
  }

  .chart__table td { text-align: right; }

  .chart__table thead th {
    color: var(--muted);
    font-size: var(--t-eyebrow);
    text-transform: uppercase;
    letter-spacing: var(--track-eyebrow);
    position: sticky;
    top: 0;
    background: var(--surface);
  }
</style>

<script>
  const fmt = new Intl.NumberFormat("nl-NL", {
    minimumFractionDigits: 1,
    maximumFractionDigits: 1,
  });

  document.querySelectorAll<HTMLElement>(".chart[data-equity]").forEach((fig) => {
    const raw = fig.dataset.equity;
    if (!raw) return;

    const { points, suffix, geom } = JSON.parse(raw) as {
      points: { t: string; v: number }[];
      suffix: string;
      geom: {
        PAD: { top: number; right: number; bottom: number; left: number };
        plotW: number;
        plotH: number;
        W: number;
        H: number;
        yMin: number;
        yMax: number;
      };
    };

    const svg = fig.querySelector("svg");
    const plot = fig.querySelector<HTMLElement>(".chart__plot");
    const cursor = fig.querySelector<SVGGElement>(".cursor");
    const cx = fig.querySelector<SVGLineElement>(".cursor__x");
    const dot = fig.querySelector<SVGCircleElement>(".cursor__dot");
    const tip = fig.querySelector<HTMLElement>(".tip");
    const tipV = fig.querySelector<HTMLElement>(".tip__v");
    const tipT = fig.querySelector<HTMLElement>(".tip__t");
    if (!svg || !plot || !cursor || !cx || !dot || !tip || !tipV || !tipT) return;

    const { PAD, plotW, plotH, W, yMin, yMax } = geom;
    const xAt = (i: number) =>
      PAD.left + (points.length === 1 ? plotW / 2 : (i / (points.length - 1)) * plotW);
    const yAt = (v: number) =>
      PAD.top + plotH - ((v - yMin) / (yMax - yMin || 1)) * plotH;

    let active = -1;

    const show = (i: number) => {
      const p = points[i];
      if (!p) return;
      active = i;
      const px = xAt(i);
      const py = yAt(p.v);

      cursor.removeAttribute("hidden");
      cx.setAttribute("x1", String(px));
      cx.setAttribute("x2", String(px));
      dot.setAttribute("cx", String(px));
      dot.setAttribute("cy", String(py));

      // Labels come from data — set as text, never as markup.
      tipV.textContent = `${fmt.format(p.v)}${suffix}`;
      tipT.textContent = p.t;
      tip.removeAttribute("hidden");

      // Position in CSS pixels: the SVG scales, so map through its rendered width.
      const scale = svg.getBoundingClientRect().width / W;
      tip.style.left = `${px * scale}px`;
      tip.style.top = `${py * scale}px`;
    };

    const hide = () => {
      active = -1;
      cursor.setAttribute("hidden", "");
      tip.setAttribute("hidden", "");
    };

    // The crosshair snaps to the nearest period — the reader aims at a date,
    // never at a 2px line.
    const nearest = (clientX: number) => {
      const box = svg.getBoundingClientRect();
      const local = ((clientX - box.left) / box.width) * W;
      const ratio = (local - PAD.left) / plotW;
      return Math.max(
        0,
        Math.min(points.length - 1, Math.round(ratio * (points.length - 1)))
      );
    };

    svg.addEventListener("pointermove", (e) => show(nearest(e.clientX)));
    svg.addEventListener("pointerleave", hide);
    svg.addEventListener("focus", () => show(points.length - 1));
    svg.addEventListener("blur", hide);

    svg.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
      e.preventDefault();
      const start = active === -1 ? points.length - 1 : active;
      show(Math.max(0, Math.min(points.length - 1, start + (e.key === "ArrowRight" ? 1 : -1))));
    });
  });
</script>
