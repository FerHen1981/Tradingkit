---
/**
 * Feed item for the editorial site. Shows the date, the reading cost and the
 * series a post belongs to, because those are what a returning reader scans
 * for — not a cropped hero image.
 */
import { formatDate } from "../units.js";

interface Props {
  title: string;
  href: string;
  summary: string;
  date: Date;
  tags?: string[];
  /** Minutes, from the remark reading-time step. */
  readingTime?: number;
  series?: string;
  cover?: string;
  featured?: boolean;
}

const {
  title,
  href,
  summary,
  date,
  tags = [],
  readingTime,
  series,
  cover,
  featured = false,
} = Astro.props;
---

<article class:list={["post", { "post--featured": featured }]}>
  {cover && (
    <a class="post__cover" href={href} tabindex="-1" aria-hidden="true">
      <img src={cover} alt="" loading="lazy" decoding="async" />
    </a>
  )}

  <div class="post__text">
    <div class="post__meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {readingTime && <span>{readingTime} min lezen</span>}
      {series && <span class="post__series">{series}</span>}
    </div>

    <h3 class="post__title"><a href={href}>{title}</a></h3>
    <p class="post__summary">{summary}</p>

    {tags.length > 0 && (
      <ul class="post__tags">
        {tags.map((tag) => (
          <li>#{tag}</li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  .post {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding-block: var(--sp-5);
    border-bottom: 1px solid var(--line);
  }

  .post--featured {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--sp-5);
  }

  @media (min-width: 720px) {
    .post:has(.post__cover) {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--sp-5);
    }
    .post__cover {
      flex: 0 0 clamp(160px, 26%, 260px);
    }
  }

  .post__cover {
    display: block;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .post__cover img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .post__text {
    min-width: 0;
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-4);
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: var(--sp-2);
  }

  .post__series {
    color: var(--accent);
  }

  .post__title {
    font-size: var(--t-h3);
    margin-bottom: var(--sp-2);
  }

  .post__title a {
    color: inherit;
    text-decoration: none;
  }

  .post__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .post__title a:hover {
    color: var(--accent);
  }

  .post__summary {
    color: var(--muted);
    font-size: 0.9375rem;
    max-width: 62ch;
    margin: 0;
  }

  .post__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin: var(--sp-3) 0 0;
    padding: 0;
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--dim);
  }
</style>
