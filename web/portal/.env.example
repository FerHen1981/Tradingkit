# Copy to /etc/mex-portal/portal.env, fill in, then:
#   sudo chown root:mex /etc/mex-portal/portal.env
#   sudo chmod 640 /etc/mex-portal/portal.env
#
# Never commit the filled-in version.

# --- identity ---------------------------------------------------------------
PORTAL_BASE_URL=https://app.mex-traders.com

# Generate with: python -m app.auth
# Rotating this invalidates every outstanding login link. Sessions survive,
# because they live in the database rather than in a signed cookie.
PORTAL_SECRET=

# --- data -------------------------------------------------------------------
# The middleware's live journal. Only ever read, and only to copy it.
JOURNAL_DB=/opt/mex/middleware/journal.db
PORTAL_SNAPSHOT_DB=/var/lib/mex-portal/snapshot.db
PORTAL_SNAPSHOT_SECONDS=300

# --- auth -------------------------------------------------------------------
PORTAL_DB=/var/lib/mex-portal/portal.db
PORTAL_USERS=/etc/mex-portal/users.yaml
PORTAL_LINK_TTL=900
PORTAL_SESSION_TTL=2592000
PORTAL_SECURE_COOKIES=true

# --- mail -------------------------------------------------------------------
# Login links are the only mail this app sends. Deliverability is not optional:
# without SPF, DKIM and DMARC on the sending domain, links land in spam and
# nobody can log in.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=portal@mex-traders.com
SMTP_FROM_NAME=MEX Traders

# Development only — prints the link to the log instead of sending it. The app
# refuses to start with this on while PORTAL_BASE_URL is public.
PORTAL_MAIL_CONSOLE=false

# --- publishing -------------------------------------------------------------
PORTAL_PUBLIC_OUT=/opt/mex/web/sites/mex/src/data/public-stats.json
PORTAL_PUBLIC_DELAY=T+1
# Trades newer than this are withheld from the public file, so the public page
# can never be read as a live feed of open activity.
PORTAL_PUBLIC_LAG_HOURS=24
