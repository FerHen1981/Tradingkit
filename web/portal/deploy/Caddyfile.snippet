# Add to the VPS Caddyfile, alongside the existing middleware site block.
#
# Caddy terminates TLS and obtains the certificate automatically. The portal
# itself listens only on 127.0.0.1:8080, so it is unreachable except through
# this proxy.

app.mex-traders.com {
	encode zstd gzip

	# Trading data must never be cached by an intermediary. The app also sets
	# this header; stating it here means a misconfigured app cannot undo it.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	# Static assets may be cached; everything else may not.
	@static path /static/*
	header @static Cache-Control "public, max-age=3600"

	@dynamic not path /static/*
	header @dynamic Cache-Control "no-store, private"

	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-For {remote_host}
	}

	log {
		output file /var/log/caddy/portal.log
		# A login link arrives as ?token=... and Caddy logs the full URI by
		# default, which would write live one-time tokens to disk and into any
		# log shipper. The filter drops that parameter before the line is
		# written; the rest of the request is still logged normally.
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
				}
			}
		}
	}
}
