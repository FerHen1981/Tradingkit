# app.mex-traders.com — the members portal.
#
#   sudo cp mex-portal.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mex-portal
#
# Deliberately a SEPARATE unit from mex-middleware. The middleware handles live
# trading webhooks; nothing about serving a web page may ever compete with that
# for CPU, memory or file locks. Different process, different port, different
# database, and a hard memory cap so a runaway request cannot starve the box.

[Unit]
Description=MEX Traders members portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mex
Group=mex
WorkingDirectory=/opt/mex/web/portal

# Secrets live here, readable only by the mex user (chmod 600).
EnvironmentFile=/etc/mex-portal/portal.env

ExecStart=/opt/mex/web/portal/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8080 --proxy-headers --forwarded-allow-ips='127.0.0.1'

Restart=always
RestartSec=5

# The portal is strictly lower priority than the trading path.
Nice=5
CPUWeight=40
MemoryMax=512M

# Hardening. The portal reads the middleware's journal and writes only its own
# state directory, so everything else can be locked down.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
StateDirectory=mex-portal
ReadWritePaths=/var/lib/mex-portal
# Read-only view of the middleware's journal — the portal snapshots it, never
# writes to it. Adjust the path if your middleware lives elsewhere.
ReadOnlyPaths=/opt/mex/middleware

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mex-portal

[Install]
WantedBy=multi-user.target
