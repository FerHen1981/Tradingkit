# Runs the public snapshot once a day, after the US session has settled.
#
# 09:00 UTC is 05:00 in Willemstad (AST, no daylight saving) — well after the
# close, so a full trading day is always complete and reconciled by then.

[Unit]
Description=Daily public stats publish

[Timer]
OnCalendar=*-*-* 09:00:00 UTC
# If the box was off at 09:00, run as soon as it is back.
Persistent=true
# Spread the start slightly so it never coincides exactly with other timers.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
