---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";

import Base from "../../layouts/Base.astro";
import SourceList from "@mex/brand/components/SourceList.astro";
import Callout from "@mex/brand/components/Callout.astro";
import { formatDate } from "@mex/brand/units";

import {
  allTerms,
  backlinks,
  categoryLabel,
  resolveRelated,
  resolveSources,
  type Term,
} from "../../lib/glossary";

export const getStaticPaths = (async () => {
  const terms = await allTerms();
  return terms.map((term) => ({
    params: { slug: term.id },
    props: { term, all: terms },
  }));
}) satisfies GetStaticPaths;

interface Props {
  term: Term;
  all: Term[];
}

const { term, all } = Astro.props;
const { Content } = await render(term);

const sources = resolveSources(term.data.sources);
const related = resolveRelated(term, all);
const alsoLinked = backlinks(term, all);
const sameCategory = all
  .filter((t) => t.data.category === term.data.category && t.id !== term.id)
  .slice(0, 8);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  name: term.data.term,
  description: term.data.short,
  inDefinedTermSet: new URL("/begrippen", Astro.site ?? "https://www.pipsandpalmtrees.com").href,
  ...(term.data.aliases.length ? { alternateName: term.data.aliases } : {}),
};
---

<Base
  title={term.data.term}
  description={term.data.short}
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <article>
    <header class="head">
      <div class="wrap wrap--narrow">
        <nav class="crumbs" aria-label="Kruimelpad">
          <a href="/begrippen">Begrippenlijst</a>
          <span aria-hidden="true">/</span>
          <span>{categoryLabel(term.data.category)}</span>
        </nav>

        <h1>{term.data.term}</h1>

        {term.data.aliases.length > 0 && (
          <p class="aliases">
            Ook wel: {term.data.aliases.join(" · ")}
          </p>
        )}

        <p class="definition">{term.data.short}</p>

        <p class="badges">
          {term.data.authority ? (
            <span class="badge badge--authority">Officiële bron</span>
          ) : (
            <span class="badge">Praktijkterm</span>
          )}
          {term.data.updated && (
            <span class="badge badge--quiet">
              Bijgewerkt {formatDate(term.data.updated)}
            </span>
          )}
        </p>
      </div>
    </header>

    <div class="wrap wrap--narrow body">
      <div class="prose">
        <Content />
      </div>

      <SourceList sources={sources} practiceNote={!term.data.authority && sources.length === 0} />

      {(related.length > 0 || alsoLinked.length > 0) && (
        <section class="links">
          <h2 class="links__title">Zie ook</h2>
          <ul class="links__list">
            {related.map((t) => (
              <li><a href={`/begrippen/${t.id}`}>{t.data.term}</a></li>
            ))}
            {alsoLinked.map((t) => (
              <li><a href={`/begrippen/${t.id}`}>{t.data.term}</a></li>
            ))}
          </ul>
        </section>
      )}

      {sameCategory.length > 0 && (
        <section class="links">
          <h2 class="links__title">Meer uit {categoryLabel(term.data.category)}</h2>
          <ul class="links__list links__list--quiet">
            {sameCategory.map((t) => (
              <li><a href={`/begrippen/${t.id}`}>{t.data.term}</a></li>
            ))}
          </ul>
        </section>
      )}

      <Callout variant="legal">
        Uitleg, geen advies. Deze omschrijving vervangt de bron niet en houdt geen
        rekening met jouw situatie. Regels, tarieven en voorwaarden veranderen;
        controleer altijd de actuele tekst bij de bron.
      </Callout>
    </div>
  </article>
</Base>

<style>
  .head {
    padding-block: clamp(2rem, 1.4rem + 3vw, 3.5rem) var(--sp-5);
    border-bottom: 1px solid var(--line);
  }

  .crumbs {
    display: flex;
    gap: var(--sp-2);
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: var(--sp-4);
  }

  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }

  .head h1 { font-size: var(--t-h1); }

  .aliases {
    margin: var(--sp-2) 0 0;
    font-family: var(--mono);
    font-size: var(--t-small);
    color: var(--dim);
  }

  .definition {
    margin: var(--sp-4) 0 0;
    font-size: var(--t-lead);
    color: var(--ink);
    max-width: 62ch;
    border-left: 2px solid var(--accent);
    padding-left: var(--sp-4);
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: var(--sp-5) 0 0;
  }

  .badge {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0.2rem 0.7rem;
  }

  .badge--authority {
    color: var(--accent-2);
    border-color: color-mix(in srgb, var(--accent-2) 40%, transparent);
  }

  .badge--quiet { color: var(--dim); }

  .body { padding-block: var(--sp-6) var(--sp-8); }

  .links {
    margin-top: var(--sp-6);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--line);
  }

  .links__title {
    font-family: var(--mono);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
    margin-bottom: var(--sp-3);
  }

  .links__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
  }

  .links__list a {
    display: inline-block;
    font-size: var(--t-small);
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0.3rem 0.8rem;
  }

  .links__list a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .links__list--quiet a {
    color: var(--muted);
    border-color: color-mix(in srgb, var(--line) 60%, transparent);
  }
</style>
