---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";

import Base from "../../layouts/Base.astro";
import VideoEmbed from "@mex/brand/components/VideoEmbed.astro";
import Callout from "@mex/brand/components/Callout.astro";
import { formatDate } from "@mex/brand/units";

import { allPosts, postPath, readingTime, type Post } from "../../lib/posts";

export const getStaticPaths = (async () => {
  const posts = await allPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      // Newest first, so "newer" is the previous index.
      newer: posts[index - 1] ?? null,
      older: posts[index + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  newer: Post | null;
  older: Post | null;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const minutes = readingTime(post.body);
---

<Base
  title={post.data.title}
  description={post.data.summary}
  image={post.data.cover}
  type="article"
  publishedAt={post.data.date}
>
  <article>
    <header class="head">
      <div class="wrap wrap--narrow">
        <div class="head__meta">
          <time datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date)}
          </time>
          <span>{minutes} min lezen</span>
          {post.data.series && <span class="head__series">{post.data.series}</span>}
        </div>

        <h1>{post.data.title}</h1>
        <p class="lead">{post.data.summary}</p>

        {post.data.tags.length > 0 && (
          <ul class="head__tags">
            {post.data.tags.map((tag) => (
              <li><a href={`/tags/${tag}`}>#{tag}</a></li>
            ))}
          </ul>
        )}

        {post.data.updated && (
          <p class="head__updated">
            Bijgewerkt op {formatDate(post.data.updated)}
          </p>
        )}
      </div>
    </header>

    <div class="wrap wrap--narrow body">
      {post.data.video && (
        <VideoEmbed id={post.data.video} title={post.data.title} />
      )}

      <div class="prose">
        <Content />
      </div>

      <Callout variant="legal">
        Persoonlijke ervaring, geen advies. Regels rond belastingen, verblijf en
        handelen verschillen per persoon en veranderen; laat u adviseren over uw
        eigen situatie.
      </Callout>
    </div>

    {(newer || older) && (
      <nav class="wrap wrap--narrow pager" aria-label="Meer posts">
        {older ? (
          <a class="pager__link" href={postPath(older)}>
            <span class="pager__dir">Ouder</span>
            <span class="pager__title">{older.data.title}</span>
          </a>
        ) : <span />}
        {newer && (
          <a class="pager__link pager__link--next" href={postPath(newer)}>
            <span class="pager__dir">Nieuwer</span>
            <span class="pager__title">{newer.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 1.6rem + 4vw, 4.5rem) var(--sp-6);
    border-bottom: 1px solid var(--line);
  }

  .head__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-4);
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: var(--sp-4);
  }

  .head__series { color: var(--accent); }

  .head h1 {
    font-size: var(--t-h1);
    max-width: 22ch;
  }

  .head .lead {
    margin-top: var(--sp-4);
  }

  .head__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin: var(--sp-5) 0 0;
    padding: 0;
    font-family: var(--mono);
    font-size: var(--t-small);
  }

  .head__tags a {
    color: var(--muted);
    text-decoration: none;
  }

  .head__tags a:hover { color: var(--accent); }

  .head__updated {
    margin: var(--sp-4) 0 0;
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--dim);
  }

  .body {
    padding-block: var(--sp-7) var(--sp-8);
  }

  .pager {
    display: grid;
    gap: var(--sp-4);
    padding-bottom: var(--sp-8);
  }

  @media (min-width: 720px) {
    .pager { grid-template-columns: 1fr 1fr; }
  }

  .pager__link {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s ease;
  }

  .pager__link:hover { border-color: var(--accent); }

  .pager__link--next { text-align: right; }

  .pager__dir {
    font-family: var(--mono);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--dim);
  }

  .pager__title {
    font-size: 0.9375rem;
    font-weight: 600;
  }
</style>
