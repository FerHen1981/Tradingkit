---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";

import Base from "../../layouts/Base.astro";
import SourceList from "@mex/brand/components/SourceList.astro";
import Callout from "@mex/brand/components/Callout.astro";
import { formatDate } from "@mex/brand/units";

import { resolveSources } from "../../lib/glossary";
import {
  allGuides,
  guidePath,
  levelLabel,
  neighbours,
  topicLabel,
  type Guide,
} from "../../lib/guides";

export const getStaticPaths = (async () => {
  const guides = await allGuides();
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide, all: guides },
  }));
}) satisfies GetStaticPaths;

interface Props {
  guide: Guide;
  all: Guide[];
}

const { guide, all } = Astro.props;
const { Content, headings } = await render(guide);

// Only h2 in the table of contents. A deeper tree turns the sidebar into a
// second copy of the article, which nobody reads.
const toc = headings.filter((h) => h.depth === 2);
const sources = resolveSources(guide.data.sources);
const { previous, next } = neighbours(guide, all);

const origin = Astro.site ?? "https://www.pipsandpalmtrees.com";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: guide.data.title,
  description: guide.data.summary,
  dateModified: guide.data.updated.toISOString(),
  inLanguage: "nl-NL",
  url: new URL(guidePath(guide), origin).href,
  ...(sources.length
    ? { citation: sources.map((s) => ({ "@type": "CreativeWork", name: s.title, url: s.url })) }
    : {}),
};
---

<Base
  title={guide.data.title}
  description={guide.data.summary}
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <article>
    <header class="head">
      <div class="wrap">
        <nav class="crumbs" aria-label="Kruimelpad">
          <a href="/gidsen">Gidsen</a>
          <span aria-hidden="true">/</span>
          <span>{topicLabel(guide.data.topic)}</span>
        </nav>

        <h1>{guide.data.title}</h1>
        <p class="lead">{guide.data.summary}</p>

        <p class="meta">
          <span class={`level level--${guide.data.level}`}>
            {levelLabel(guide.data.level)}
          </span>
          <span>Bijgewerkt {formatDate(guide.data.updated)}</span>
        </p>
      </div>
    </header>

    <div class="wrap layout">
      {toc.length > 1 && (
        <nav class="toc" aria-label="Inhoud van deze gids">
          <h2 class="toc__title">In deze gids</h2>
          <ol>
            {toc.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </nav>
      )}

      <div class="body">
        {guide.data.takeaways.length > 0 && (
          <section class="takeaways">
            <h2 class="takeaways__title">Wat je hierna weet</h2>
            <ul>
              {guide.data.takeaways.map((t) => <li>{t}</li>)}
            </ul>
          </section>
        )}

        <div class="prose">
          <Content />
        </div>

        <SourceList sources={sources} />

        <Callout variant="legal">
          Persoonlijke ervaring en algemene uitleg — geen beleggings-, fiscaal,
          juridisch of emigratieadvies. Regels verschillen per persoon en
          veranderen. Laat u adviseren over uw eigen situatie voordat u iets
          besluit.
        </Callout>

        {(previous || next) && (
          <nav class="pager" aria-label="Leerpad">
            {previous ? (
              <a class="pager__link" href={guidePath(previous)}>
                <span class="pager__dir">Vorige</span>
                <span class="pager__title">{previous.data.title}</span>
              </a>
            ) : <span />}
            {next && (
              <a class="pager__link pager__link--next" href={guidePath(next)}>
                <span class="pager__dir">Volgende</span>
                <span class="pager__title">{next.data.title}</span>
              </a>
            )}
          </nav>
        )}
      </div>
    </div>
  </article>
</Base>

<style>
  .head {
    padding-block: clamp(2rem, 1.4rem + 3vw, 3.5rem) var(--sp-5);
    border-bottom: 1px solid var(--line);
  }

  .crumbs {
    display: flex;
    gap: var(--sp-2);
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: var(--sp-4);
  }

  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }

  .head h1 { font-size: var(--t-h1); max-width: 24ch; }
  .head .lead { margin-top: var(--sp-4); }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
    margin: var(--sp-5) 0 0;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .level {
    border-radius: var(--radius-pill);
    padding: 0.2rem 0.65rem;
    border: 1px solid transparent;
  }

  .level--start {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .level--verdieping {
    color: var(--accent-2);
    border-color: color-mix(in srgb, var(--accent-2) 40%, transparent);
  }
  .level--gevorderd {
    color: var(--muted);
    border-color: var(--line);
  }

  .layout {
    padding-block: var(--sp-6) var(--sp-8);
    display: grid;
    gap: var(--sp-6);
  }

  @media (min-width: 1000px) {
    .layout {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: var(--sp-8);
      align-items: start;
    }
    .toc {
      position: sticky;
      top: 5rem;
    }
  }

  .toc__title {
    font-family: var(--mono);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
    margin-bottom: var(--sp-3);
  }

  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
    border-left: 1px solid var(--line);
  }

  .toc a {
    display: block;
    padding-left: var(--sp-3);
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    margin-left: -1px;
  }

  .toc a:hover {
    color: var(--accent);
    border-left-color: var(--accent);
  }

  .body { min-width: 0; }

  .takeaways {
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
    padding: var(--sp-4) var(--sp-5);
    margin-bottom: var(--sp-6);
  }

  .takeaways__title {
    font-family: var(--mono);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: var(--sp-3);
  }

  .takeaways ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .takeaways li + li { margin-top: var(--sp-2); }

  .pager {
    display: grid;
    gap: var(--sp-4);
    margin-top: var(--sp-7);
  }

  @media (min-width: 720px) {
    .pager { grid-template-columns: 1fr 1fr; }
  }

  .pager__link {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
  }

  .pager__link:hover { border-color: var(--accent); }
  .pager__link--next { text-align: right; }

  .pager__dir {
    font-family: var(--mono);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--dim);
  }

  .pager__title { font-size: 0.9375rem; font-weight: 600; }
</style>
